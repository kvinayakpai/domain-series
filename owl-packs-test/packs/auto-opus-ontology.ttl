@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s14: <https://example.org/store014/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/store014/ontology> a owl:Ontology ;
    rdfs:label "Store 014 grocery operations ontology"@en ;
    rdfs:comment "OWL 2 ontology derived automatically and only from the store014 PostgreSQL database (schemas store, warehouse, payments): table and column names, primary keys and data values (data period 2026-05-04 to 2026-06-30). Amounts are Indian rupees (INR)."@en ;
    owl:versionInfo "2026-11-21" .

s14:adjustmentReason a owl:DatatypeProperty ;
    rdfs:label "adjustment reason"@en ;
    rdfs:comment "Free-text reason; 'cycle count variance' and 'short pick: slot count variance' seen."@en ;
    rdfs:domain s14:WarehouseStockAdjustment ;
    rdfs:range xsd:string .

s14:adjustmentUnits a owl:DatatypeProperty ;
    rdfs:label "adjustment units"@en ;
    rdfs:comment "counted - book before."@en ;
    rdfs:domain s14:StockCount ;
    rdfs:range xsd:integer .

s14:amountInr a owl:DatatypeProperty ;
    rdfs:label "amount (INR)"@en ;
    rdfs:comment "Money amount of the attempt, PSP transaction, refund or complaint, in Indian rupees."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( s14:PaymentAttempt s14:UPITransaction s14:UPIRefund s14:CustomerComplaint ) ] ;
    rdfs:range xsd:decimal .

s14:arrivedTimestamp a owl:DatatypeProperty ;
    rdfs:label "arrived time"@en ;
    rdfs:comment "When the truck arrived at the store."@en ;
    rdfs:domain s14:Shipment ;
    rdfs:range xsd:dateTime .

s14:atSlot a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "at slot"@en ;
    rdfs:comment "Slot whose stock was adjusted."@en ;
    rdfs:domain s14:WarehouseStockAdjustment ;
    rdfs:range s14:WarehouseSlot .

s14:attemptTimestamp a owl:DatatypeProperty ;
    rdfs:label "attempt time"@en ;
    rdfs:comment "When the till recorded the attempt."@en ;
    rdfs:domain s14:PaymentAttempt ;
    rdfs:range xsd:dateTime .

s14:billTimestamp a owl:DatatypeProperty ;
    rdfs:label "bill time"@en ;
    rdfs:comment "Time on the bill's sales lines (store.pos_lines.bill_ts). Known only for bills that contain a tracked product."@en ;
    rdfs:domain s14:Bill ;
    rdfs:range xsd:dateTime .

s14:bookBefore a owl:DatatypeProperty ;
    rdfs:label "book before count"@en ;
    rdfs:comment "Book stock just before the count."@en ;
    rdfs:domain s14:StockCount ;
    rdfs:range xsd:integer .

s14:bookOnHand a owl:DatatypeProperty ;
    rdfs:label "book on hand"@en ;
    rdfs:comment "Book stock used by the calculation; equals that day's inventory book close."@en ;
    rdfs:domain s14:ReplenishmentCalculation ;
    rdfs:range xsd:integer .

s14:bookOnHandClose a owl:DatatypeProperty ;
    rdfs:label "book on hand at close"@en ;
    rdfs:comment "Book stock in units at day close; negative values occur."@en ;
    rdfs:domain s14:InventoryBookClose ;
    rdfs:range xsd:integer .

s14:bookedProduct a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "product booked"@en ;
    rdfs:comment "Product the store booked into stock (sku_booked = products.sku)."@en ;
    rdfs:domain s14:GoodsReceiptLine ;
    rdfs:range s14:Product .

s14:bookedUnits a owl:DatatypeProperty ;
    rdfs:label "units booked"@en ;
    rdfs:comment "Units the store booked into stock (units_booked)."@en ;
    rdfs:domain s14:GoodsReceiptLine ;
    rdfs:range xsd:integer .

s14:caseCount a owl:DatatypeProperty ;
    rdfs:label "cases"@en ;
    rdfs:comment "Number of cases (signed for warehouse adjustments)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( s14:StoreOrderLine s14:WarehouseStockAdjustment s14:Pallet s14:ShippingNoticeLine ) ] ;
    rdfs:range xsd:integer .

s14:caseWeightKg a owl:DatatypeProperty ;
    rdfs:label "case weight (kg)"@en ;
    rdfs:comment "Gross weight of one case in kg; present only for DC products."@en ;
    rdfs:domain s14:Product ;
    rdfs:range xsd:decimal .

s14:casesConfirmed a owl:DatatypeProperty ;
    rdfs:label "cases confirmed"@en ;
    rdfs:comment "Cases the picker confirmed; less than ordered on 2 lines."@en ;
    rdfs:domain s14:PickConfirmation ;
    rdfs:range xsd:integer .

s14:casesOrdered a owl:DatatypeProperty ;
    rdfs:label "cases ordered"@en ;
    rdfs:comment "Cases requested on the order line."@en ;
    rdfs:domain s14:PickConfirmation ;
    rdfs:range xsd:integer .

s14:complaintAboutBill a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "about bill"@en ;
    rdfs:comment "Bill the complaint is about (customer_complaints.bill_id)."@en ;
    rdfs:domain s14:CustomerComplaint ;
    rdfs:range s14:Bill .

s14:complaintAboutTransaction a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "about transaction"@en ;
    rdfs:comment "UPI credit the complaint is about (customer_complaints.rrn)."@en ;
    rdfs:domain s14:CustomerComplaint ;
    rdfs:range s14:UPITransaction .

s14:complaintKind a owl:DatatypeProperty ;
    rdfs:label "complaint kind"@en ;
    rdfs:comment "'charged twice' or 'debited but the till said failed'."@en ;
    rdfs:domain s14:CustomerComplaint ;
    rdfs:range xsd:string .

s14:complaintTimestamp a owl:DatatypeProperty ;
    rdfs:label "complaint time"@en ;
    rdfs:comment "When the customer complained."@en ;
    rdfs:domain s14:CustomerComplaint ;
    rdfs:range xsd:dateTime .

s14:completedTimestamp a owl:DatatypeProperty ;
    rdfs:label "completed time"@en ;
    rdfs:comment "When the refund was completed."@en ;
    rdfs:domain s14:UPIRefund ;
    rdfs:range xsd:dateTime .

s14:confirmationMethod a owl:DatatypeProperty ;
    rdfs:label "confirmation method"@en ;
    rdfs:comment "How the pick was confirmed; only 'slot label scan' seen (the slot, not the product, is scanned)."@en ;
    rdfs:domain s14:PickConfirmation ;
    rdfs:range xsd:string .

s14:costPriceInr a owl:DatatypeProperty ;
    rdfs:label "cost price (INR)"@en ;
    rdfs:comment "Cost per unit; used to value warehouse adjustments."@en ;
    rdfs:domain s14:Product ;
    rdfs:range xsd:decimal .

s14:countTrigger a owl:DatatypeProperty ;
    rdfs:label "count trigger"@en ;
    rdfs:comment "Why the count was done: 'scheduled full count' or 'manager request after complaints'."@en ;
    rdfs:domain s14:StockCount ;
    rdfs:range xsd:string .

s14:countedUnits a owl:DatatypeProperty ;
    rdfs:label "counted units"@en ;
    rdfs:comment "Units physically counted."@en ;
    rdfs:domain s14:StockCount ;
    rdfs:range xsd:integer .

s14:crateCount a owl:DatatypeProperty ;
    rdfs:label "crates"@en ;
    rdfs:comment "Number of crates delivered."@en ;
    rdfs:domain s14:FreshDelivery ;
    rdfs:range xsd:integer .

s14:createdTimestamp a owl:DatatypeProperty ;
    rdfs:label "created time"@en ;
    rdfs:comment "When the order was created (22:00 each day)."@en ;
    rdfs:domain s14:StoreOrder ;
    rdfs:range xsd:dateTime .

s14:deliverySlotEnd a owl:DatatypeProperty ;
    rdfs:label "delivery slot end"@en ;
    rdfs:comment "End of the booked delivery window."@en ;
    rdfs:domain s14:Shipment ;
    rdfs:range xsd:dateTime .

s14:deliverySlotStart a owl:DatatypeProperty ;
    rdfs:label "delivery slot start"@en ;
    rdfs:comment "Start of the booked delivery window at the store."@en ;
    rdfs:domain s14:Shipment ;
    rdfs:range xsd:dateTime .

s14:dispatchedTimestamp a owl:DatatypeProperty ;
    rdfs:label "dispatched time"@en ;
    rdfs:comment "When the truck left the warehouse."@en ;
    rdfs:domain s14:Shipment ;
    rdfs:range xsd:dateTime .

s14:flowType a owl:DatatypeProperty ;
    rdfs:label "supply flow"@en ;
    rdfs:comment "How the product reaches the store: 'DC' (via the warehouse) or 'DSD' (direct store delivery)."@en ;
    rdfs:domain s14:Product ;
    rdfs:range xsd:string .

s14:forecastMethod a owl:DatatypeProperty ;
    rdfs:label "forecast method"@en ;
    rdfs:comment "How demand was forecast; only '28-day mean of recorded sales' seen."@en ;
    rdfs:domain s14:ReplenishmentCalculation ;
    rdfs:range xsd:string .

s14:forecastSigma a owl:DatatypeProperty ;
    rdfs:label "forecast sigma"@en ;
    rdfs:comment "Standard deviation of daily demand used for safety stock."@en ;
    rdfs:domain s14:ReplenishmentCalculation ;
    rdfs:range xsd:decimal .

s14:forecastUnitsPerDay a owl:DatatypeProperty ;
    rdfs:label "forecast units per day"@en ;
    rdfs:comment "Expected daily demand."@en ;
    rdfs:domain s14:ReplenishmentCalculation ;
    rdfs:range xsd:decimal .

s14:fulfilsOrderLine a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "fulfils order line"@en ;
    rdfs:comment "Order line picked; matched on order_id and sku (68 of 70 picks; the 2 picks for SO-260531 have no order row in the data)."@en ;
    rdfs:domain s14:PickConfirmation ;
    rdfs:range s14:StoreOrderLine .

s14:grossInr a owl:DatatypeProperty ;
    rdfs:label "gross (INR)"@en ;
    rdfs:comment "Total of UPI credits settled."@en ;
    rdfs:domain s14:UPISettlement ;
    rdfs:range xsd:decimal .

s14:gtin a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "GTIN"@en ;
    rdfs:comment "13-digit barcode number of the product."@en ;
    rdfs:domain s14:Product ;
    rdfs:range xsd:string .

s14:initiatedTimestamp a owl:DatatypeProperty ;
    rdfs:label "initiated time"@en ;
    rdfs:comment "When the UPI collection was started."@en ;
    rdfs:domain s14:UPITransaction ;
    rdfs:range xsd:dateTime .

s14:lineAmountInr a owl:DatatypeProperty ;
    rdfs:label "line amount (INR)"@en ;
    rdfs:comment "quantity x unit price."@en ;
    rdfs:domain s14:SalesLine ;
    rdfs:range xsd:decimal .

s14:matchesNoticeLine a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "matches notice line"@en ;
    rdfs:comment "Notice line the receipt line was booked from; matched on shipment_id + line (70 of 70)."@en ;
    rdfs:domain s14:GoodsReceiptLine ;
    rdfs:range s14:ShippingNoticeLine .

s14:mdrInr a owl:DatatypeProperty ;
    rdfs:label "MDR (INR)"@en ;
    rdfs:comment "Merchant discount rate fee deducted; zero on every day seen."@en ;
    rdfs:domain s14:UPISettlement ;
    rdfs:range xsd:decimal .

s14:netInr a owl:DatatypeProperty ;
    rdfs:label "net (INR)"@en ;
    rdfs:comment "gross - refunds - MDR; can be negative."@en ;
    rdfs:domain s14:UPISettlement ;
    rdfs:range xsd:decimal .

s14:noticeGtin a owl:DatatypeProperty ;
    rdfs:label "GTIN on notice"@en ;
    rdfs:comment "GTIN stated on the shipping notice line; equals the product's GTIN."@en ;
    rdfs:domain s14:ShippingNoticeLine ;
    rdfs:range xsd:string .

s14:noticeWeightKg a owl:DatatypeProperty ;
    rdfs:label "notice weight (kg)"@en ;
    rdfs:comment "Pallet weight stated on the shipping notice = sum(cases x case weight) + 22 kg in every row."@en ;
    rdfs:domain s14:Pallet ;
    rdfs:range xsd:decimal .

s14:noticedProduct a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "product on notice"@en ;
    rdfs:comment "Product the shipping notice said was on the receipt line (asn_sku = products.sku)."@en ;
    rdfs:domain s14:GoodsReceiptLine ;
    rdfs:range s14:Product .

s14:noticedUnits a owl:DatatypeProperty ;
    rdfs:label "units on notice"@en ;
    rdfs:comment "Units the shipping notice said were on the line (asn_units)."@en ;
    rdfs:domain s14:GoodsReceiptLine ;
    rdfs:range xsd:integer .

s14:onOrder a owl:DatatypeProperty ;
    rdfs:label "on order"@en ;
    rdfs:comment "Units already ordered but not received; zero in every row."@en ;
    rdfs:domain s14:ReplenishmentCalculation ;
    rdfs:range xsd:integer .

s14:onPallet a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "on pallet"@en ;
    rdfs:comment "Pallet the line is on (sscc = pallets.sscc)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( s14:ShippingNoticeLine s14:GoodsReceiptLine ) ] ;
    rdfs:range s14:Pallet .

s14:orderReason a owl:DatatypeProperty ;
    rdfs:label "order reason"@en ;
    rdfs:comment "Why the order was raised; only 'auto' seen."@en ;
    rdfs:domain s14:StoreOrder ;
    rdfs:range xsd:string .

s14:orderUpTo a owl:DatatypeProperty ;
    rdfs:label "order-up-to level"@en ;
    rdfs:comment "Target stock level an order tops up to."@en ;
    rdfs:domain s14:ReplenishmentCalculation ;
    rdfs:range xsd:integer .

s14:orderedUnits a owl:DatatypeProperty ;
    rdfs:label "ordered units"@en ;
    rdfs:comment "Units ordered by this calculation (0 = no order)."@en ;
    rdfs:domain s14:ReplenishmentCalculation ;
    rdfs:range xsd:integer .

s14:packSize a owl:DatatypeProperty ;
    rdfs:label "pack size"@en ;
    rdfs:comment "Net content of one consumer unit as text, e.g. '500 ml', '5 kg'."@en ;
    rdfs:domain s14:Product ;
    rdfs:range xsd:string .

s14:palletCount a owl:DatatypeProperty ;
    rdfs:label "pallet count"@en ;
    rdfs:comment "Number of pallets on the shipment; equals the pallets linked to it."@en ;
    rdfs:domain s14:Shipment ;
    rdfs:range xsd:integer .

s14:pickTimestamp a owl:DatatypeProperty ;
    rdfs:label "pick time"@en ;
    rdfs:comment "When the pick was confirmed."@en ;
    rdfs:domain s14:PickConfirmation ;
    rdfs:range xsd:dateTime .

s14:pickedFromSlot a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "picked from slot"@en ;
    rdfs:comment "Slot the cases were picked from (pick_confirmations.slot); always the product's DC slot."@en ;
    rdfs:domain s14:PickConfirmation ;
    rdfs:range s14:WarehouseSlot .

s14:productName a owl:DatatypeProperty ;
    rdfs:label "product name"@en ;
    rdfs:comment "Descriptive name of the product."@en ;
    rdfs:domain s14:Product ;
    rdfs:range xsd:string .

s14:pspStatus a owl:DatatypeProperty ;
    rdfs:label "PSP status"@en ;
    rdfs:comment "Final status at the PSP: success, failed, or returned (money sent back to the customer's bank)."@en ;
    rdfs:domain s14:UPITransaction ;
    rdfs:range xsd:string .

s14:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity"@en ;
    rdfs:comment "Units sold on the line (1-6 seen)."@en ;
    rdfs:domain s14:SalesLine ;
    rdfs:range xsd:integer .

s14:receiptMethod a owl:DatatypeProperty ;
    rdfs:label "receipt method"@en ;
    rdfs:comment "How goods were checked in; only 'pallet label (SSCC) scan against the shipping notice' seen, i.e. contents are taken from the notice, not counted."@en ;
    rdfs:domain s14:GoodsReceipt ;
    rdfs:range xsd:string .

s14:receivedTimestamp a owl:DatatypeProperty ;
    rdfs:label "received time"@en ;
    rdfs:comment "When the store booked the receipt; never before the shipment's arrival."@en ;
    rdfs:domain s14:GoodsReceipt ;
    rdfs:range xsd:dateTime .

s14:receivesShipment a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "receives shipment"@en ;
    rdfs:comment "Shipment the receipt books in (goods_receipts.shipment_id)."@en ;
    rdfs:domain s14:GoodsReceipt ;
    rdfs:range s14:Shipment .

s14:refundForBill a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "refund for bill"@en ;
    rdfs:comment "Bill the refund relates to (upi_refunds.bill_id)."@en ;
    rdfs:domain s14:UPIRefund ;
    rdfs:range s14:Bill .

s14:refundTrigger a owl:DatatypeProperty ;
    rdfs:label "refund trigger"@en ;
    rdfs:comment "Why the refund was raised; only 'customer complaint' seen."@en ;
    rdfs:domain s14:UPIRefund ;
    rdfs:range xsd:string .

s14:refundsInr a owl:DatatypeProperty ;
    rdfs:label "refunds (INR)"@en ;
    rdfs:comment "Refunds deducted from the settlement."@en ;
    rdfs:domain s14:UPISettlement ;
    rdfs:range xsd:decimal .

s14:refundsTransaction a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "refunds transaction"@en ;
    rdfs:comment "UPI credit that was refunded (upi_refunds.rrn = psp_upi_report.rrn)."@en ;
    rdfs:domain s14:UPIRefund ;
    rdfs:range s14:UPITransaction .

s14:reorderPoint a owl:DatatypeProperty ;
    rdfs:label "reorder point"@en ;
    rdfs:comment "Book stock level at or below which an order is raised."@en ;
    rdfs:domain s14:ReplenishmentCalculation ;
    rdfs:range xsd:integer .

s14:requestedTimestamp a owl:DatatypeProperty ;
    rdfs:label "requested time"@en ;
    rdfs:comment "When the refund was requested."@en ;
    rdfs:domain s14:UPIRefund ;
    rdfs:range xsd:dateTime .

s14:resolution a owl:DatatypeProperty ;
    rdfs:label "resolution"@en ;
    rdfs:comment "How it was resolved: refunded by the store after manual matching, or the customer's bank returned the money."@en ;
    rdfs:domain s14:CustomerComplaint ;
    rdfs:range xsd:string .

s14:resolvedByRefund a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "resolved by refund"@en ;
    rdfs:comment "Refund that resolved the complaint; matched on the shared rrn (23 of 26 complaints; amounts equal)."@en ;
    rdfs:domain s14:CustomerComplaint ;
    rdfs:range s14:UPIRefund .

s14:resolvedTimestamp a owl:DatatypeProperty ;
    rdfs:label "resolved time"@en ;
    rdfs:comment "When the complaint was resolved."@en ;
    rdfs:domain s14:CustomerComplaint ;
    rdfs:range xsd:dateTime .

s14:resultedInOrderLine a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "resulted in order line"@en ;
    rdfs:comment "Order line raised by the calculation; matched on sku and forecasts.date = date of store_orders.created_ts, with ordered_units = units (68 of 68 order lines)."@en ;
    rdfs:domain s14:ReplenishmentCalculation ;
    rdfs:range s14:StoreOrderLine .

s14:revenueInr a owl:DatatypeProperty ;
    rdfs:label "revenue (INR)"@en ;
    rdfs:comment "Sales value of the product that day."@en ;
    rdfs:domain s14:DailySales ;
    rdfs:range xsd:decimal .

s14:scannedGtin a owl:DatatypeProperty ;
    rdfs:label "scanned GTIN"@en ;
    rdfs:comment "Barcode scanned at the till; always equals the product's GTIN."@en ;
    rdfs:domain s14:SalesLine ;
    rdfs:range xsd:string .

s14:sellingPriceInr a owl:DatatypeProperty ;
    rdfs:label "selling price (INR)"@en ;
    rdfs:comment "Shelf price per unit; every sales line carries this price."@en ;
    rdfs:domain s14:Product ;
    rdfs:range xsd:decimal .

s14:settledIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "settled in"@en ;
    rdfs:comment "Settlement that paid out the credit. No key column exists; by date, successful credits of day D sum exactly to the gross of settlement D+1 on 26 of 29 days, so this link is approximate."@en ;
    rdfs:domain s14:UPITransaction ;
    rdfs:range s14:UPISettlement .

s14:shelfStatus a owl:DatatypeProperty ;
    rdfs:label "shelf status"@en ;
    rdfs:comment "'on shelf' or 'empty'."@en ;
    rdfs:domain s14:ShelfAudit ;
    rdfs:range xsd:string .

s14:shipsPick a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "ships pick"@en ;
    rdfs:comment "Pick the notice line reports; matched on order_id + line + sku + shipment_id (70 of 70), cases = cases confirmed."@en ;
    rdfs:domain s14:ShippingNoticeLine ;
    rdfs:range s14:PickConfirmation .

s14:statusTimestamp a owl:DatatypeProperty ;
    rdfs:label "status time"@en ;
    rdfs:comment "When the PSP status was set; equals initiated time except for 48 transactions whose till attempt got no response."@en ;
    rdfs:domain s14:UPITransaction ;
    rdfs:range xsd:dateTime .

s14:storedInSlot a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "stored in slot"@en ;
    rdfs:comment "Warehouse pick slot of the product (products.dc_slot)."@en ;
    rdfs:domain s14:DCReplenishedProduct ;
    rdfs:range s14:WarehouseSlot .

s14:tender a owl:DatatypeProperty ;
    rdfs:label "tender"@en ;
    rdfs:comment "Means of payment: 'UPI', 'card' or 'cash'."@en ;
    rdfs:domain s14:PaymentAttempt ;
    rdfs:range xsd:string .

s14:tillStatus a owl:DatatypeProperty ;
    rdfs:label "till status"@en ;
    rdfs:comment "Outcome the till recorded: approved, declined, failed, or 'failed: no response' (UPI only; the till never heard back from the PSP)."@en ;
    rdfs:domain s14:PaymentAttempt ;
    rdfs:range xsd:string .

s14:unitCount a owl:DatatypeProperty ;
    rdfs:label "units"@en ;
    rdfs:comment "Number of consumer units (signed for warehouse adjustments)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( s14:StoreOrderLine s14:WriteOff s14:WarehouseStockAdjustment s14:FreshDelivery s14:ShippingNoticeLine ) ] ;
    rdfs:range xsd:integer .

s14:unitPriceInr a owl:DatatypeProperty ;
    rdfs:label "unit price (INR)"@en ;
    rdfs:comment "Price per unit charged on the line."@en ;
    rdfs:domain s14:SalesLine ;
    rdfs:range xsd:decimal .

s14:unitsPerCase a owl:DatatypeProperty ;
    rdfs:label "units per case"@en ;
    rdfs:comment "Consumer units in one case (store orders and shipping notices use units = cases x this)."@en ;
    rdfs:domain s14:Product ;
    rdfs:range xsd:integer .

s14:unitsSold a owl:DatatypeProperty ;
    rdfs:label "units sold"@en ;
    rdfs:comment "Units of the product sold that day."@en ;
    rdfs:domain s14:DailySales ;
    rdfs:range xsd:integer .

s14:upiCreditCount a owl:DatatypeProperty ;
    rdfs:label "UPI credit count"@en ;
    rdfs:comment "Number of UPI credits in the settlement."@en ;
    rdfs:domain s14:UPISettlement ;
    rdfs:range xsd:integer .

s14:upiTransaction a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "UPI transaction"@en ;
    rdfs:comment "PSP record behind a UPI attempt. Matched on rrn for 19,118 attempts; for 48 'failed: no response' attempts with no RRN, matched to the 48 PSP-only RRNs by equal amount and initiated time within 5 seconds (one-to-one)."@en ;
    rdfs:domain s14:UPIPaymentAttempt ;
    rdfs:range s14:UPITransaction .

s14:useByDate a owl:DatatypeProperty ;
    rdfs:label "use-by date"@en ;
    rdfs:comment "Use-by date of the delivered stock."@en ;
    rdfs:domain s14:FreshDelivery ;
    rdfs:range xsd:date .

s14:usesVehicle a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "uses vehicle"@en ;
    rdfs:comment "Truck for the shipment (shipments.vehicle)."@en ;
    rdfs:domain s14:Shipment ;
    rdfs:range s14:Vehicle .

s14:valueAtCostInr a owl:DatatypeProperty ;
    rdfs:label "value at cost (INR)"@en ;
    rdfs:comment "units x product cost price."@en ;
    rdfs:domain s14:WarehouseStockAdjustment ;
    rdfs:range xsd:decimal .

s14:weightCheck a owl:DatatypeProperty ;
    rdfs:label "weight check"@en ;
    rdfs:comment "Whether the pallet was weighed; only 'not weighed' seen."@en ;
    rdfs:domain s14:Pallet ;
    rdfs:range xsd:string .

s14:adjustedTimestamp a owl:DatatypeProperty ;
    rdfs:label "adjusted time"@en ;
    rdfs:comment "When the warehouse adjustment was booked."@en ;
    rdfs:domain s14:WarehouseStockAdjustment ;
    rdfs:range xsd:dateTime .

s14:attemptNumber a owl:DatatypeProperty ;
    rdfs:label "attempt number"@en ;
    rdfs:comment "Sequence of the payment attempt on the bill (1-4)."@en ;
    rdfs:domain s14:PaymentAttempt ;
    rdfs:range xsd:integer .

s14:auditTimestamp a owl:DatatypeProperty ;
    rdfs:label "audit time"@en ;
    rdfs:comment "When the shelf was checked."@en ;
    rdfs:domain s14:ShelfAudit ;
    rdfs:range xsd:dateTime .

s14:billId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "bill id"@en ;
    rdfs:comment "Bill number; first six digits after 'B' are the bill date yymmdd."@en ;
    rdfs:domain s14:Bill ;
    rdfs:range xsd:string .

s14:countTimestamp a owl:DatatypeProperty ;
    rdfs:label "count time"@en ;
    rdfs:comment "When the count was done."@en ;
    rdfs:domain s14:StockCount ;
    rdfs:range xsd:dateTime .

s14:deliveryTimestamp a owl:DatatypeProperty ;
    rdfs:label "delivery time"@en ;
    rdfs:comment "When the fresh delivery arrived (05:30 daily)."@en ;
    rdfs:domain s14:FreshDelivery ;
    rdfs:range xsd:dateTime .

s14:forStoreOrder a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "for store order"@en ;
    rdfs:comment "Store order the pick or notice line serves (order_id). The order may be absent from store_orders (SO-260531)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( s14:PickConfirmation s14:ShippingNoticeLine ) ] ;
    rdfs:range s14:StoreOrder .

s14:grnId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "GRN id"@en ;
    rdfs:comment "Goods receipt number GRN-<yymmdd>; same date digits as the shipment."@en ;
    rdfs:domain s14:GoodsReceipt ;
    rdfs:range xsd:string .

s14:inShipment a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "in shipment"@en ;
    rdfs:comment "Shipment that carries the pick, notice line or pallet (shipment_id = shipments.shipment_id)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( s14:PickConfirmation s14:ShippingNoticeLine s14:Pallet ) ] ;
    rdfs:range s14:Shipment .

s14:onRoute a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "on route"@en ;
    rdfs:comment "Route of the fresh delivery."@en ;
    rdfs:domain s14:FreshDelivery ;
    rdfs:range s14:DeliveryRoute .

s14:orderId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "order id"@en ;
    rdfs:comment "Store order number SO-<yymmdd>, the date the order was created."@en ;
    rdfs:domain s14:StoreOrder ;
    rdfs:range xsd:string .

s14:partOfBill a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "part of bill"@en ;
    rdfs:comment "Bill the sales line belongs to (pos_lines.bill_id)."@en ;
    rdfs:domain s14:SalesLine ;
    rdfs:range s14:Bill .

s14:partOfGoodsReceipt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "part of goods receipt"@en ;
    rdfs:comment "Receipt the line belongs to (grn_id)."@en ;
    rdfs:domain s14:GoodsReceiptLine ;
    rdfs:range s14:GoodsReceipt .

s14:partOfStoreOrder a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "part of store order"@en ;
    rdfs:comment "Order the line belongs to (store_orders.order_id)."@en ;
    rdfs:domain s14:StoreOrderLine ;
    rdfs:range s14:StoreOrder .

s14:paysForBill a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "pays for bill"@en ;
    rdfs:comment "Bill the attempt tries to pay (pos_payments.bill_id)."@en ;
    rdfs:domain s14:PaymentAttempt ;
    rdfs:range s14:Bill .

s14:refundId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "refund id"@en ;
    rdfs:comment "Refund identifier RF-<6 digits> (the digits are the last six of the refunded RRN)."@en ;
    rdfs:domain s14:UPIRefund ;
    rdfs:range xsd:string .

s14:routeCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "route code"@en ;
    rdfs:comment "Route identifier, e.g. R-07."@en ;
    rdfs:domain s14:DeliveryRoute ;
    rdfs:range xsd:string .

s14:rrn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RRN"@en ;
    rdfs:comment "12-digit UPI retrieval reference number; key of the PSP record and the join key to till attempts, refunds and complaints."@en ;
    rdfs:domain s14:UPITransaction ;
    rdfs:range xsd:string .

s14:settlementDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "settlement date"@en ;
    rdfs:comment "Date the PSP settled money to the store. Key."@en ;
    rdfs:domain s14:UPISettlement ;
    rdfs:range xsd:date .

s14:shipmentId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "shipment id"@en ;
    rdfs:comment "SHP-<yymmdd>, the dispatch date (one day after the order date)."@en ;
    rdfs:domain s14:Shipment ;
    rdfs:range xsd:string .

s14:sku a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "SKU"@en ;
    rdfs:comment "Stock-keeping unit code, e.g. ATTA-WW-1KG. Key of the product."@en ;
    rdfs:domain s14:Product ;
    rdfs:range xsd:string .

s14:slotCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "slot code"@en ;
    rdfs:comment "Slot identifier like A-07-04."@en ;
    rdfs:domain s14:WarehouseSlot ;
    rdfs:range xsd:string .

s14:sscc a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "SSCC"@en ;
    rdfs:comment "18-digit Serial Shipping Container Code on the pallet label."@en ;
    rdfs:domain s14:Pallet ;
    rdfs:range xsd:string .

s14:vehicleCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "vehicle code"@en ;
    rdfs:comment "Truck identifier, e.g. TRK-07."@en ;
    rdfs:domain s14:Vehicle ;
    rdfs:range xsd:string .

s14:writeOffReason a owl:DatatypeProperty ;
    rdfs:label "write-off reason"@en ;
    rdfs:comment "'expired' or 'damaged'."@en ;
    rdfs:domain s14:WriteOff ;
    rdfs:range xsd:string .

s14:CardPaymentAttempt a owl:Class ;
    rdfs:label "Card payment attempt"@en ;
    rdfs:comment "A payment attempt with tender 'card'. No RRN."@en ;
    rdfs:subClassOf s14:PaymentAttempt .

s14:CashPaymentAttempt a owl:Class ;
    rdfs:label "Cash payment attempt"@en ;
    rdfs:comment "A payment attempt with tender 'cash'. No RRN."@en ;
    rdfs:subClassOf s14:PaymentAttempt .

s14:DeliveryRoute a owl:Class ;
    rdfs:label "Delivery route"@en ;
    rdfs:comment "A supplier delivery route code for fresh deliveries (R-07: milk and curd; R-12: bread)."@en ;
    owl:hasKey ( s14:routeCode ) .

s14:DirectStoreDeliveryProduct a owl:Class ;
    rdfs:label "Direct-store-delivery product"@en ;
    rdfs:comment "A product with flow = 'DSD': fresh items (milk, curd, bread) delivered straight to the store in crates on a supplier route, never through the warehouse. Has no warehouse slot and no case weight."@en ;
    rdfs:subClassOf s14:Product .

s14:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:comment "A truck used for shipments (only TRK-07 seen)."@en ;
    owl:hasKey ( s14:vehicleCode ) .

s14:DCReplenishedProduct a owl:Class ;
    rdfs:label "DC-replenished product"@en ;
    rdfs:comment "A product with flow = 'DC': ambient grocery (atta, rice, dal, oil, sugar) ordered by the store, picked from a slot in the warehouse and delivered on pallets. Has a warehouse slot and a case weight."@en ;
    rdfs:subClassOf s14:Product .

s14:InventoryBookClose a owl:Class ;
    rdfs:label "Book stock at close"@en ;
    rdfs:comment "The store system's book (computed) stock on hand for a product at the close of a day (store.inventory_book). Can be negative."@en ;
    owl:hasKey ( s14:businessDate s14:forProduct ) .

s14:ShelfAudit a owl:Class ;
    rdfs:label "Shelf audit"@en ;
    rdfs:comment "A check of whether a product is on the shelf at a moment (store.shelf_audits)."@en ;
    owl:hasKey ( s14:auditTimestamp s14:forProduct ) .

s14:StockChangeEvent a owl:Class ;
    rdfs:label "Stock change event"@en ;
    rdfs:comment "An event that changes a book stock figure: a count correction, a write-off or a warehouse stock adjustment. Grouping class inferred from the three tables that each carry a signed or unsigned quantity change."@en .

s14:UPIPaymentAttempt a owl:Class ;
    rdfs:label "UPI payment attempt"@en ;
    rdfs:comment "A payment attempt with tender 'UPI'. Carries the UPI reference (RRN) when the till got a response from the PSP."@en ;
    rdfs:subClassOf s14:PaymentAttempt .

s14:DailySales a owl:Class ;
    rdfs:label "Daily sales"@en ;
    rdfs:comment "Units sold and revenue per product per day (store.daily_sales). Equals the sum of sales lines for that product and date in every observed row."@en ;
    owl:hasKey ( s14:businessDate s14:forProduct ) .

s14:WarehouseSlot a owl:Class ;
    rdfs:label "Warehouse slot"@en ;
    rdfs:comment "A pick location in the warehouse, code like A-07-04 (aisle-bay-level, inferred from the shape of the code)."@en ;
    owl:hasKey ( s14:slotCode ) .

s14:businessDate a owl:DatatypeProperty ;
    rdfs:label "business date"@en ;
    rdfs:comment "Trading day the record refers to."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( s14:DailySales s14:InventoryBookClose s14:ReplenishmentCalculation s14:WriteOff ) ] ;
    rdfs:range xsd:date .

s14:lineNumber a owl:DatatypeProperty ;
    rdfs:label "line number"@en ;
    rdfs:comment "Position of the line within its bill, receipt, shipping notice or order (1-based)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( s14:SalesLine s14:GoodsReceiptLine s14:ShippingNoticeLine s14:PickConfirmation ) ] ;
    rdfs:range xsd:integer .

s14:GoodsReceipt a owl:Class ;
    rdfs:label "Goods receipt (GRN)"@en ;
    rdfs:comment "The store's receipt of one warehouse shipment (store.goods_receipts, grn_id GRN-<yymmdd>)."@en ;
    owl:hasKey ( s14:grnId ) .

s14:StoreOrder a owl:Class ;
    rdfs:label "Store order"@en ;
    rdfs:comment "An order from the store to the warehouse (store.store_orders, order_id SO-<yymmdd>), created at 22:00 by the automatic ordering run."@en ;
    owl:hasKey ( s14:orderId ) .

s14:WriteOff a owl:Class ;
    rdfs:label "Write-off"@en ;
    rdfs:comment "Units of a product removed from store stock on a day for a reason (store.write_offs): expired or damaged."@en ;
    rdfs:subClassOf s14:StockChangeEvent ;
    owl:hasKey ( s14:businessDate s14:forProduct s14:writeOffReason ) .

s14:Bill a owl:Class ;
    rdfs:label "Bill"@en ;
    rdfs:comment "A customer sale at the till, identified by bill_id (B<yymmdd>-<6 digits>). Appears in store.pos_lines (item lines, only for tracked products) and in payments.pos_payments (payment attempts for the whole bill)."@en ;
    owl:hasKey ( s14:billId ) .

s14:FreshDelivery a owl:Class ;
    rdfs:label "Fresh delivery"@en ;
    rdfs:comment "A direct-to-store delivery of a fresh product on a route (store.fresh_deliveries): units, crates and use-by date."@en ;
    owl:hasKey ( s14:deliveryTimestamp s14:onRoute s14:forProduct ) .

s14:Pallet a owl:Class ;
    rdfs:label "Pallet"@en ;
    rdfs:comment "A shipped pallet identified by its 18-digit SSCC label (warehouse.pallets), with case count and the weight stated on the shipping notice."@en ;
    owl:hasKey ( s14:sscc ) .

s14:StoreOrderLine a owl:Class ;
    rdfs:label "Store order line"@en ;
    rdfs:comment "One product on a store order, in units and whole cases."@en ;
    owl:hasKey ( s14:partOfStoreOrder s14:forProduct ) .

s14:SalesLine a owl:Class ;
    rdfs:label "Sales line"@en ;
    rdfs:comment "One scanned line on a bill (store.pos_lines): a tracked product, its quantity, unit price and line amount."@en ;
    owl:hasKey ( s14:partOfBill s14:lineNumber ) .

s14:StockCount a owl:Class ;
    rdfs:label "Store stock count"@en ;
    rdfs:comment "A physical count of one product in the store (store.stock_counts): book figure before, counted figure and the resulting adjustment."@en ;
    rdfs:subClassOf s14:StockChangeEvent ;
    owl:hasKey ( s14:countTimestamp s14:forProduct ) .

s14:UPISettlement a owl:Class ;
    rdfs:label "UPI settlement"@en ;
    rdfs:comment "A daily settlement of UPI money from the PSP to the store (payments.upi_settlements): count of credits, gross, refunds deducted, MDR fee, net."@en ;
    owl:hasKey ( s14:settlementDate ) .

s14:CustomerComplaint a owl:Class ;
    rdfs:label "Customer complaint"@en ;
    rdfs:comment "A customer complaint about a UPI payment (payments.customer_complaints): 'charged twice' or 'debited but the till said failed', with its resolution."@en .

s14:GoodsReceiptLine a owl:Class ;
    rdfs:label "Goods receipt line"@en ;
    rdfs:comment "One line of a goods receipt: what the shipping notice said (SKU, units) and what the store booked into stock (SKU, units), for a pallet."@en ;
    owl:hasKey ( s14:partOfGoodsReceipt s14:lineNumber ) .

s14:UPIRefund a owl:Class ;
    rdfs:label "UPI refund"@en ;
    rdfs:comment "A refund of a UPI credit back to the customer (payments.upi_refunds). All observed refunds were triggered by a customer complaint."@en ;
    owl:hasKey ( s14:refundId ) .

s14:WarehouseStockAdjustment a owl:Class ;
    rdfs:label "Warehouse stock adjustment"@en ;
    rdfs:comment "A correction of warehouse stock in a slot (warehouse.stock_adjustments), in cases, units and value at cost."@en ;
    rdfs:subClassOf s14:StockChangeEvent ;
    owl:hasKey ( s14:adjustedTimestamp s14:forProduct ) .

s14:PaymentAttempt a owl:Class ;
    rdfs:label "Payment attempt"@en ;
    rdfs:comment "One attempt to pay a bill at the till (payments.pos_payments), numbered 1..4 per bill. Exactly one attempt per bill is 'approved'."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( s14:UPIPaymentAttempt s14:CardPaymentAttempt s14:CashPaymentAttempt ) ] ;
    owl:hasKey ( s14:paysForBill s14:attemptNumber ) .

s14:Shipment a owl:Class ;
    rdfs:label "Shipment"@en ;
    rdfs:comment "A warehouse-to-store truck trip (warehouse.shipments, SHP-<yymmdd>): dispatch time, booked delivery slot, arrival time and pallet count."@en ;
    owl:hasKey ( s14:shipmentId ) .

s14:UPITransaction a owl:Class ;
    rdfs:label "UPI transaction (PSP record)"@en ;
    rdfs:comment "A UPI collection as reported by the payment service provider (payments.psp_upi_report), identified by its 12-digit RRN, with status success, failed or returned."@en ;
    owl:hasKey ( s14:rrn ) .

s14:forProduct a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "for product"@en ;
    rdfs:comment "The product the record is about. Matched on the sku column (sku_scanned in pos_lines) = products.sku; 100% match in every table."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( s14:SalesLine s14:DailySales s14:InventoryBookClose s14:ReplenishmentCalculation s14:StoreOrderLine s14:StockCount s14:WriteOff s14:WarehouseStockAdjustment s14:ShelfAudit s14:FreshDelivery s14:ShippingNoticeLine s14:PickConfirmation ) ] ;
    rdfs:range s14:Product .

s14:ShippingNoticeLine a owl:Class ;
    rdfs:label "Shipping notice line"@en ;
    rdfs:comment "One line of the advance shipping notice the warehouse sends for a shipment (warehouse.shipping_notice_lines): which order, product, GTIN, cases and units are on which pallet."@en ;
    owl:hasKey ( s14:inShipment s14:lineNumber ) .

s14:PickConfirmation a owl:Class ;
    rdfs:label "Pick confirmation"@en ;
    rdfs:comment "Confirmation that cases of a product were picked from a warehouse slot for a store order line (warehouse.pick_confirmations)."@en ;
    owl:hasKey ( s14:forStoreOrder s14:lineNumber ) .

s14:ReplenishmentCalculation a owl:Class ;
    rdfs:label "Replenishment calculation"@en ;
    rdfs:comment "The daily automatic ordering calculation for a DC-replenished product (store.forecasts): forecast demand, its spread, reorder point, order-up-to level, book stock, stock on order and units ordered."@en ;
    owl:hasKey ( s14:businessDate s14:forProduct ) .

s14:Product a owl:Class ;
    rdfs:label "Product"@en ;
    rdfs:comment "A stock-keeping unit tracked in store.products (11 rows). Identified by SKU; carries GTIN barcode, pack size, case size, price and cost. Only these 11 items appear in the item-level tables; the till takes payments for many other items that are not in this table."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( s14:DCReplenishedProduct s14:DirectStoreDeliveryProduct ) ] ;
    owl:hasKey ( s14:sku ) .

[] a owl:AllDisjointClasses ;
    owl:members ( s14:DCReplenishedProduct s14:DirectStoreDeliveryProduct ) .

[] a owl:AllDisjointClasses ;
    owl:members ( s14:StockCount s14:WriteOff s14:WarehouseStockAdjustment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( s14:UPIPaymentAttempt s14:CardPaymentAttempt s14:CashPaymentAttempt ) .

