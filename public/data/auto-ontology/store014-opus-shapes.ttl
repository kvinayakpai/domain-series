s14sh:ShelfAudit-shelfStatus a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "on shelf" "empty" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:shelfStatus .

s14sh:Shipment-PalletCountMatches a sh:SPARQLConstraint ;
    sh:message "palletCount equals the number of pallets in the shipment."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { { SELECT $this (COUNT(?p) AS ?n) WHERE { ?p a s14:Pallet ; s14:inShipment $this } GROUP BY $this } $this s14:palletCount ?pc . FILTER (?pc != ?n) }" .

s14sh:Shipment-SlotOrder a sh:SPARQLConstraint ;
    sh:message "Slot start before slot end, dispatch before arrival."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:deliverySlotStart ?a ; s14:deliverySlotEnd ?b ; s14:dispatchedTimestamp ?d . OPTIONAL { $this s14:arrivedTimestamp ?r } FILTER (?a >= ?b || (BOUND(?r) && ?r <= ?d)) }" .

s14sh:Shipment-arrivedTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:path s14:arrivedTimestamp .

s14sh:Shipment-deliverySlotEnd a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:deliverySlotEnd .

s14sh:Shipment-deliverySlotStart a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:deliverySlotStart .

s14sh:Shipment-dispatchedTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:dispatchedTimestamp .

s14sh:Shipment-palletCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:palletCount .

s14sh:Shipment-shipmentId a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:shipmentId ;
    sh:pattern "^SHP-[0-9]{6}$" .

s14sh:Shipment-usesVehicle a sh:PropertyShape ;
    sh:class s14:Vehicle ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:usesVehicle .

s14sh:ShippingNoticeLine-CasesEqualConfirmedPick a sh:SPARQLConstraint ;
    sh:message "Cases on the notice equal cases confirmed on the pick."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:caseCount ?c ; s14:shipsPick ?k . ?k s14:casesConfirmed ?cc . FILTER (?c != ?cc) }" .

s14sh:ShippingNoticeLine-GtinMatchesProduct a sh:SPARQLConstraint ;
    sh:message "Notice GTIN must be the product's GTIN."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:noticeGtin ?g ; s14:forProduct ?p . ?p s14:gtin ?pg . FILTER (?g != ?pg) }" .

s14sh:ShippingNoticeLine-SameShipmentAsPallet a sh:SPARQLConstraint ;
    sh:message "A notice line's pallet belongs to the same shipment."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:inShipment ?s ; s14:onPallet ?p . ?p s14:inShipment ?s2 . FILTER (?s != ?s2) }" .

s14sh:ShippingNoticeLine-UnitsAreWholeCases a sh:SPARQLConstraint ;
    sh:message "units = cases x units per case."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:unitCount ?u ; s14:caseCount ?c ; s14:forProduct ?p . ?p s14:unitsPerCase ?k . FILTER (?u != ?c * ?k) }" .

s14sh:ShippingNoticeLine-caseCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:caseCount .

s14sh:ShippingNoticeLine-forProduct a sh:PropertyShape ;
    sh:class s14:DCReplenishedProduct ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forProduct .

s14sh:ShippingNoticeLine-forStoreOrder a sh:PropertyShape ;
    sh:class s14:StoreOrder ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forStoreOrder .

s14sh:ShippingNoticeLine-inShipment a sh:PropertyShape ;
    sh:class s14:Shipment ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:inShipment .

s14sh:ShippingNoticeLine-lineNumber a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:lineNumber .

s14sh:ShippingNoticeLine-noticeGtin a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:noticeGtin ;
    sh:pattern "^[0-9]{13}$" .

s14sh:ShippingNoticeLine-onPallet a sh:PropertyShape ;
    sh:class s14:Pallet ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:onPallet .

s14sh:ShippingNoticeLine-shipsPick a sh:PropertyShape ;
    sh:class s14:PickConfirmation ;
    sh:maxCount 1 ;
    sh:path s14:shipsPick .

s14sh:ShippingNoticeLine-unitCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:unitCount .

s14sh:StockCount-AdjustmentIsDifference a sh:SPARQLConstraint ;
    sh:message "adjustment = counted - book before."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:bookBefore ?b ; s14:countedUnits ?c ; s14:adjustmentUnits ?a . FILTER (?a != ?c - ?b) }" .

s14sh:StockCount-adjustmentUnits a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:adjustmentUnits .

s14sh:StockCount-bookBefore a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:bookBefore .

s14sh:StockCount-countTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:countTimestamp .

s14sh:StockCount-countTrigger a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "scheduled full count" "manager request after complaints" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:countTrigger .

s14sh:StockCount-countedUnits a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 0 ;
    sh:path s14:countedUnits .

s14sh:StockCount-forProduct a sh:PropertyShape ;
    sh:class s14:Product ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forProduct .

s14sh:StoreOrder-createdTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
