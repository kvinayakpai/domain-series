    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:partOfBill .

s14sh:SalesLine-quantity a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:quantity .

s14sh:SalesLine-scannedGtin a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:scannedGtin ;
    sh:pattern "^[0-9]{13}$" .

s14sh:SalesLine-unitPriceInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minExclusive 0.0 ;
    sh:path s14:unitPriceInr .

s14sh:ShelfAudit-auditTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:auditTimestamp .

s14sh:ShelfAudit-forProduct a sh:PropertyShape ;
    sh:class s14:Product ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
