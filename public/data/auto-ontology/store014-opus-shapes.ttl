s14sh:Pallet-sscc a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:sscc ;
    sh:pattern "^[0-9]{18}$" .

s14sh:Pallet-weightCheck a sh:PropertyShape ;
    sh:datatype xsd:string ;
