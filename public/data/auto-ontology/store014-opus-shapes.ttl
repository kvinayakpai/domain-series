s14sh:Pallet-CasesEqualNoticeLines a sh:SPARQLConstraint ;
    sh:message "Pallet cases equal the sum of cases on its notice lines."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { { SELECT $this (SUM(?c) AS ?s) WHERE { ?l s14:onPallet $this ; a s14:ShippingNoticeLine ; s14:caseCount ?c } GROUP BY $this } $this s14:caseCount ?pc . FILTER (?pc != ?s) }" .

s14sh:Pallet-caseCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
