    sh:minCount 1 ;
    sh:path s14:tillStatus .

s14sh:PickConfirmation-ConfirmedNotAboveOrdered a sh:SPARQLConstraint ;
    sh:message "Cases confirmed cannot exceed cases ordered."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:casesOrdered ?o ; s14:casesConfirmed ?c . FILTER (?c > ?o) }" .

s14sh:PickConfirmation-PickedFromProductSlot a sh:SPARQLConstraint ;
    sh:message "The pick slot is the product's DC slot."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:pickedFromSlot ?s ; s14:forProduct ?p . ?p s14:storedInSlot ?ps . FILTER (?s != ?ps) }" .

