    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:confirmationMethod .

s14sh:PickConfirmation-forProduct a sh:PropertyShape ;
    sh:class s14:DCReplenishedProduct ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forProduct .

s14sh:PickConfirmation-forStoreOrder a sh:PropertyShape ;
    sh:class s14:StoreOrder ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forStoreOrder .

s14sh:PickConfirmation-fulfilsOrderLine a sh:PropertyShape ;
    sh:class s14:StoreOrderLine ;
    sh:maxCount 1 ;
