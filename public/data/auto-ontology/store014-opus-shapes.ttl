@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s14: <https://example.org/store014/ontology#> .
@prefix s14sh: <https://example.org/store014/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

s14sh:BillShape a sh:NodeShape ;
    rdfs:label "Shape for Bill"@en ;
    sh:property s14sh:Bill-billId,
        s14sh:Bill-billTimestamp ;
    sh:sparql s14sh:Bill-AtMostOneApprovedPayment,
        s14sh:Bill-OneApprovedPayment ;
    sh:targetClass s14:Bill .

s14sh:CardPaymentAttemptShape a sh:NodeShape ;
    rdfs:label "Shape for Card payment attempt"@en ;
    sh:property s14sh:CardPaymentAttempt-tender,
        s14sh:CardPaymentAttempt-tillStatus,
        s14sh:CardPaymentAttempt-upiTransaction ;
    sh:targetClass s14:CardPaymentAttempt .

s14sh:CashPaymentAttemptShape a sh:NodeShape ;
    rdfs:label "Shape for Cash payment attempt"@en ;
    sh:property s14sh:CashPaymentAttempt-tender,
        s14sh:CashPaymentAttempt-tillStatus,
        s14sh:CashPaymentAttempt-upiTransaction ;
    sh:targetClass s14:CashPaymentAttempt .

s14sh:CustomerComplaintShape a sh:NodeShape ;
    rdfs:label "Shape for Customer complaint"@en ;
    sh:property s14sh:CustomerComplaint-amountInr,
        s14sh:CustomerComplaint-complaintAboutBill,
        s14sh:CustomerComplaint-complaintAboutTransaction,
        s14sh:CustomerComplaint-complaintKind,
        s14sh:CustomerComplaint-complaintTimestamp,
        s14sh:CustomerComplaint-resolution,
        s14sh:CustomerComplaint-resolvedByRefund,
        s14sh:CustomerComplaint-resolvedTimestamp ;
    sh:sparql s14sh:CustomerComplaint-RefundSameTransaction ;
    sh:targetClass s14:CustomerComplaint .

s14sh:DCReplenishedProductShape a sh:NodeShape ;
    rdfs:label "Shape for DC-replenished product"@en ;
    sh:property s14sh:DCReplenishedProduct-caseWeightKg,
        s14sh:DCReplenishedProduct-flowType,
        s14sh:DCReplenishedProduct-storedInSlot ;
    sh:targetClass s14:DCReplenishedProduct .

s14sh:DailySalesShape a sh:NodeShape ;
    rdfs:label "Shape for Daily sales"@en ;
    sh:property s14sh:DailySales-businessDate,
        s14sh:DailySales-forProduct,
        s14sh:DailySales-revenueInr,
        s14sh:DailySales-unitsSold ;
    sh:targetClass s14:DailySales .

s14sh:DeliveryRouteShape a sh:NodeShape ;
    rdfs:label "Shape for Delivery route"@en ;
    sh:property s14sh:DeliveryRoute-routeCode ;
    sh:targetClass s14:DeliveryRoute .

s14sh:DirectStoreDeliveryProductShape a sh:NodeShape ;
    rdfs:label "Shape for Direct-store-delivery product"@en ;
    sh:property s14sh:DirectStoreDeliveryProduct-caseWeightKg,
        s14sh:DirectStoreDeliveryProduct-flowType,
        s14sh:DirectStoreDeliveryProduct-storedInSlot ;
    sh:targetClass s14:DirectStoreDeliveryProduct .

s14sh:FreshDeliveryShape a sh:NodeShape ;
    rdfs:label "Shape for Fresh delivery"@en ;
    sh:property s14sh:FreshDelivery-crateCount,
        s14sh:FreshDelivery-deliveryTimestamp,
        s14sh:FreshDelivery-forProduct,
        s14sh:FreshDelivery-onRoute,
        s14sh:FreshDelivery-unitCount,
        s14sh:FreshDelivery-useByDate ;
    sh:sparql s14sh:FreshDelivery-UseByAfterDelivery ;
    sh:targetClass s14:FreshDelivery .

s14sh:GoodsReceiptLineShape a sh:NodeShape ;
    rdfs:label "Shape for Goods receipt line"@en ;
    sh:property s14sh:GoodsReceiptLine-bookedProduct,
        s14sh:GoodsReceiptLine-bookedUnits,
        s14sh:GoodsReceiptLine-lineNumber,
        s14sh:GoodsReceiptLine-matchesNoticeLine,
        s14sh:GoodsReceiptLine-noticedProduct,
        s14sh:GoodsReceiptLine-noticedUnits,
        s14sh:GoodsReceiptLine-onPallet,
        s14sh:GoodsReceiptLine-partOfGoodsReceipt ;
    sh:targetClass s14:GoodsReceiptLine .

s14sh:GoodsReceiptShape a sh:NodeShape ;
    rdfs:label "Shape for Goods receipt (GRN)"@en ;
    sh:property s14sh:GoodsReceipt-grnId,
        s14sh:GoodsReceipt-receiptMethod,
        s14sh:GoodsReceipt-receivedTimestamp,
        s14sh:GoodsReceipt-receivesShipment ;
    sh:sparql s14sh:GoodsReceipt-ReceivedAfterArrival ;
    sh:targetClass s14:GoodsReceipt .

s14sh:InventoryBookCloseShape a sh:NodeShape ;
    rdfs:label "Shape for Book stock at close"@en ;
    sh:property s14sh:InventoryBookClose-bookOnHandClose,
        s14sh:InventoryBookClose-businessDate,
        s14sh:InventoryBookClose-forProduct ;
    sh:targetClass s14:InventoryBookClose .

s14sh:PalletShape a sh:NodeShape ;
    rdfs:label "Shape for Pallet"@en ;
    sh:property s14sh:Pallet-caseCount,
        s14sh:Pallet-inShipment,
        s14sh:Pallet-noticeWeightKg,
        s14sh:Pallet-sscc,
        s14sh:Pallet-weightCheck ;
    sh:sparql s14sh:Pallet-CasesEqualNoticeLines ;
    sh:targetClass s14:Pallet .

s14sh:PaymentAttemptShape a sh:NodeShape ;
    rdfs:label "Shape for Payment attempt"@en ;
    sh:property s14sh:PaymentAttempt-amountInr,
        s14sh:PaymentAttempt-attemptNumber,
        s14sh:PaymentAttempt-attemptTimestamp,
        s14sh:PaymentAttempt-paysForBill,
        s14sh:PaymentAttempt-tender,
        s14sh:PaymentAttempt-tillStatus ;
    sh:targetClass s14:PaymentAttempt .

s14sh:PickConfirmationShape a sh:NodeShape ;
    rdfs:label "Shape for Pick confirmation"@en ;
    sh:property s14sh:PickConfirmation-casesConfirmed,
        s14sh:PickConfirmation-casesOrdered,
        s14sh:PickConfirmation-confirmationMethod,
        s14sh:PickConfirmation-forProduct,
        s14sh:PickConfirmation-forStoreOrder,
        s14sh:PickConfirmation-fulfilsOrderLine,
        s14sh:PickConfirmation-inShipment,
        s14sh:PickConfirmation-lineNumber,
        s14sh:PickConfirmation-pickTimestamp,
        s14sh:PickConfirmation-pickedFromSlot ;
    sh:sparql s14sh:PickConfirmation-ConfirmedNotAboveOrdered,
        s14sh:PickConfirmation-PickedFromProductSlot ;
    sh:targetClass s14:PickConfirmation .

s14sh:ProductShape a sh:NodeShape ;
    rdfs:label "Shape for Product"@en ;
    sh:property s14sh:Product-caseWeightKg,
        s14sh:Product-costPriceInr,
        s14sh:Product-flowType,
        s14sh:Product-gtin,
        s14sh:Product-packSize,
        s14sh:Product-productName,
        s14sh:Product-sellingPriceInr,
        s14sh:Product-sku,
        s14sh:Product-unitsPerCase ;
    sh:targetClass s14:Product .

s14sh:ReplenishmentCalculationShape a sh:NodeShape ;
    rdfs:label "Shape for Replenishment calculation"@en ;
    sh:property s14sh:ReplenishmentCalculation-bookOnHand,
        s14sh:ReplenishmentCalculation-businessDate,
        s14sh:ReplenishmentCalculation-forProduct,
        s14sh:ReplenishmentCalculation-forecastMethod,
        s14sh:ReplenishmentCalculation-forecastSigma,
        s14sh:ReplenishmentCalculation-forecastUnitsPerDay,
        s14sh:ReplenishmentCalculation-onOrder,
        s14sh:ReplenishmentCalculation-orderUpTo,
        s14sh:ReplenishmentCalculation-orderedUnits,
        s14sh:ReplenishmentCalculation-reorderPoint,
        s14sh:ReplenishmentCalculation-resultedInOrderLine ;
    sh:targetClass s14:ReplenishmentCalculation .

s14sh:SalesLineShape a sh:NodeShape ;
    rdfs:label "Shape for Sales line"@en ;
    sh:property s14sh:SalesLine-forProduct,
        s14sh:SalesLine-lineAmountInr,
        s14sh:SalesLine-lineNumber,
        s14sh:SalesLine-partOfBill,
        s14sh:SalesLine-quantity,
        s14sh:SalesLine-scannedGtin,
        s14sh:SalesLine-unitPriceInr ;
    sh:sparql s14sh:SalesLine-GtinMatchesProduct,
        s14sh:SalesLine-LineAmount,
        s14sh:SalesLine-PriceIsShelfPrice ;
    sh:targetClass s14:SalesLine .

s14sh:ShelfAuditShape a sh:NodeShape ;
    rdfs:label "Shape for Shelf audit"@en ;
    sh:property s14sh:ShelfAudit-auditTimestamp,
        s14sh:ShelfAudit-forProduct,
        s14sh:ShelfAudit-shelfStatus ;
    sh:targetClass s14:ShelfAudit .

s14sh:ShipmentShape a sh:NodeShape ;
    rdfs:label "Shape for Shipment"@en ;
    sh:property s14sh:Shipment-arrivedTimestamp,
        s14sh:Shipment-deliverySlotEnd,
        s14sh:Shipment-deliverySlotStart,
        s14sh:Shipment-dispatchedTimestamp,
        s14sh:Shipment-palletCount,
        s14sh:Shipment-shipmentId,
        s14sh:Shipment-usesVehicle ;
    sh:sparql s14sh:Shipment-PalletCountMatches,
        s14sh:Shipment-SlotOrder ;
    sh:targetClass s14:Shipment .

s14sh:ShippingNoticeLineShape a sh:NodeShape ;
    rdfs:label "Shape for Shipping notice line"@en ;
    sh:property s14sh:ShippingNoticeLine-caseCount,
        s14sh:ShippingNoticeLine-forProduct,
        s14sh:ShippingNoticeLine-forStoreOrder,
        s14sh:ShippingNoticeLine-inShipment,
        s14sh:ShippingNoticeLine-lineNumber,
        s14sh:ShippingNoticeLine-noticeGtin,
        s14sh:ShippingNoticeLine-onPallet,
        s14sh:ShippingNoticeLine-shipsPick,
        s14sh:ShippingNoticeLine-unitCount ;
    sh:sparql s14sh:ShippingNoticeLine-CasesEqualConfirmedPick,
        s14sh:ShippingNoticeLine-GtinMatchesProduct,
        s14sh:ShippingNoticeLine-SameShipmentAsPallet,
        s14sh:ShippingNoticeLine-UnitsAreWholeCases ;
    sh:targetClass s14:ShippingNoticeLine .

s14sh:StockCountShape a sh:NodeShape ;
    rdfs:label "Shape for Store stock count"@en ;
    sh:property s14sh:StockCount-adjustmentUnits,
        s14sh:StockCount-bookBefore,
        s14sh:StockCount-countTimestamp,
        s14sh:StockCount-countTrigger,
        s14sh:StockCount-countedUnits,
        s14sh:StockCount-forProduct ;
    sh:sparql s14sh:StockCount-AdjustmentIsDifference ;
    sh:targetClass s14:StockCount .

s14sh:StoreOrderLineShape a sh:NodeShape ;
    rdfs:label "Shape for Store order line"@en ;
    sh:property s14sh:StoreOrderLine-caseCount,
        s14sh:StoreOrderLine-forProduct,
        s14sh:StoreOrderLine-partOfStoreOrder,
        s14sh:StoreOrderLine-unitCount ;
    sh:sparql s14sh:StoreOrderLine-UnitsAreWholeCases ;
    sh:targetClass s14:StoreOrderLine .

s14sh:StoreOrderShape a sh:NodeShape ;
    rdfs:label "Shape for Store order"@en ;
    sh:property s14sh:StoreOrder-createdTimestamp,
        s14sh:StoreOrder-orderId,
        s14sh:StoreOrder-orderReason ;
    sh:targetClass s14:StoreOrder .

s14sh:UPIPaymentAttemptShape a sh:NodeShape ;
    rdfs:label "Shape for UPI payment attempt"@en ;
    sh:property s14sh:UPIPaymentAttempt-tender,
        s14sh:UPIPaymentAttempt-upiTransaction ;
    sh:sparql s14sh:UPIPaymentAttempt-SameAmountAsPsp,
        s14sh:UPIPaymentAttempt-TillPspAgree ;
    sh:targetClass s14:UPIPaymentAttempt .

s14sh:UPIRefundShape a sh:NodeShape ;
    rdfs:label "Shape for UPI refund"@en ;
    sh:property s14sh:UPIRefund-amountInr,
        s14sh:UPIRefund-completedTimestamp,
        s14sh:UPIRefund-refundForBill,
        s14sh:UPIRefund-refundId,
        s14sh:UPIRefund-refundTrigger,
        s14sh:UPIRefund-refundsTransaction,
        s14sh:UPIRefund-requestedTimestamp ;
    sh:sparql s14sh:UPIRefund-CompletedAfterRequested ;
    sh:targetClass s14:UPIRefund .

s14sh:UPISettlementShape a sh:NodeShape ;
    rdfs:label "Shape for UPI settlement"@en ;
    sh:property s14sh:UPISettlement-grossInr,
        s14sh:UPISettlement-mdrInr,
        s14sh:UPISettlement-netInr,
        s14sh:UPISettlement-refundsInr,
        s14sh:UPISettlement-settlementDate,
        s14sh:UPISettlement-upiCreditCount ;
    sh:sparql s14sh:UPISettlement-NetEqualsGrossMinusDeductions ;
    sh:targetClass s14:UPISettlement .

s14sh:UPITransactionShape a sh:NodeShape ;
    rdfs:label "Shape for UPI transaction (PSP record)"@en ;
    sh:property s14sh:UPITransaction-amountInr,
        s14sh:UPITransaction-initiatedTimestamp,
        s14sh:UPITransaction-pspStatus,
        s14sh:UPITransaction-rrn,
        s14sh:UPITransaction-settledIn,
        s14sh:UPITransaction-statusTimestamp ;
    sh:targetClass s14:UPITransaction .

s14sh:VehicleShape a sh:NodeShape ;
    rdfs:label "Shape for Vehicle"@en ;
    sh:property s14sh:Vehicle-vehicleCode ;
    sh:targetClass s14:Vehicle .

s14sh:WarehouseSlotShape a sh:NodeShape ;
    rdfs:label "Shape for Warehouse slot"@en ;
    sh:property s14sh:WarehouseSlot-slotCode ;
    sh:targetClass s14:WarehouseSlot .

s14sh:WarehouseStockAdjustmentShape a sh:NodeShape ;
    rdfs:label "Shape for Warehouse stock adjustment"@en ;
    sh:property s14sh:WarehouseStockAdjustment-adjustedTimestamp,
        s14sh:WarehouseStockAdjustment-adjustmentReason,
        s14sh:WarehouseStockAdjustment-atSlot,
        s14sh:WarehouseStockAdjustment-caseCount,
        s14sh:WarehouseStockAdjustment-forProduct,
        s14sh:WarehouseStockAdjustment-unitCount,
        s14sh:WarehouseStockAdjustment-valueAtCostInr ;
    sh:sparql s14sh:WarehouseStockAdjustment-ValueAtCost ;
    sh:targetClass s14:WarehouseStockAdjustment .

s14sh:WriteOffShape a sh:NodeShape ;
    rdfs:label "Shape for Write-off"@en ;
    sh:property s14sh:WriteOff-businessDate,
        s14sh:WriteOff-forProduct,
        s14sh:WriteOff-unitCount,
        s14sh:WriteOff-writeOffReason ;
    sh:targetClass s14:WriteOff .

s14sh:Bill-AtMostOneApprovedPayment a sh:SPARQLConstraint ;
    sh:message "A bill has at most one approved attempt."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { ?a s14:paysForBill $this ; s14:tillStatus \"approved\" . ?b s14:paysForBill $this ; s14:tillStatus \"approved\" . FILTER (?a != ?b) }" .

s14sh:Bill-OneApprovedPayment a sh:SPARQLConstraint ;
    sh:message "A bill with payment attempts has exactly one approved attempt (holds for all 30,077 paid bills)."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { ?a s14:paysForBill $this . FILTER NOT EXISTS { ?b s14:paysForBill $this ; s14:tillStatus \"approved\" } }" .

s14sh:Bill-billId a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:billId ;
    sh:pattern "^B[0-9]{6}-[0-9]{6}$" .

s14sh:Bill-billTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:path s14:billTimestamp .

s14sh:CardPaymentAttempt-tender a sh:PropertyShape ;
    sh:hasValue "card" ;
    sh:path s14:tender .

s14sh:CardPaymentAttempt-tillStatus a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "approved" "declined" "failed" ) ;
    sh:path s14:tillStatus .

s14sh:CardPaymentAttempt-upiTransaction a sh:PropertyShape ;
    sh:maxCount 0 ;
    sh:path s14:upiTransaction .

s14sh:CashPaymentAttempt-tender a sh:PropertyShape ;
    sh:hasValue "cash" ;
    sh:path s14:tender .

s14sh:CashPaymentAttempt-tillStatus a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "approved" "declined" "failed" ) ;
    sh:path s14:tillStatus .

s14sh:CashPaymentAttempt-upiTransaction a sh:PropertyShape ;
    sh:maxCount 0 ;
    sh:path s14:upiTransaction .

s14sh:CustomerComplaint-RefundSameTransaction a sh:SPARQLConstraint ;
    sh:message "The resolving refund refunds the same UPI transaction and amount."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:resolvedByRefund ?r ; s14:complaintAboutTransaction ?t ; s14:amountInr ?a . ?r s14:refundsTransaction ?t2 ; s14:amountInr ?b . FILTER (?t != ?t2 || ?a != ?b) }" .

s14sh:CustomerComplaint-amountInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minExclusive 0.0 ;
    sh:path s14:amountInr .

s14sh:CustomerComplaint-complaintAboutBill a sh:PropertyShape ;
    sh:class s14:Bill ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:complaintAboutBill .

s14sh:CustomerComplaint-complaintAboutTransaction a sh:PropertyShape ;
    sh:class s14:UPITransaction ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:complaintAboutTransaction .

s14sh:CustomerComplaint-complaintKind a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "charged twice" "debited but the till said failed" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:complaintKind .

s14sh:CustomerComplaint-complaintTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:complaintTimestamp .

s14sh:CustomerComplaint-resolution a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "refunded after the store matched the credit by hand" "customer's bank returned the money" ) ;
    sh:maxCount 1 ;
    sh:path s14:resolution .

s14sh:CustomerComplaint-resolvedByRefund a sh:PropertyShape ;
    sh:class s14:UPIRefund ;
    sh:maxCount 1 ;
    sh:path s14:resolvedByRefund .

s14sh:CustomerComplaint-resolvedTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:path s14:resolvedTimestamp .

s14sh:DCReplenishedProduct-caseWeightKg a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:path s14:caseWeightKg .

s14sh:DCReplenishedProduct-flowType a sh:PropertyShape ;
    sh:hasValue "DC" ;
    sh:path s14:flowType .

s14sh:DCReplenishedProduct-storedInSlot a sh:PropertyShape ;
    sh:class s14:WarehouseSlot ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:storedInSlot .

s14sh:DailySales-businessDate a sh:PropertyShape ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:businessDate .

s14sh:DailySales-forProduct a sh:PropertyShape ;
    sh:class s14:Product ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forProduct .

s14sh:DailySales-revenueInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 0.0 ;
    sh:path s14:revenueInr .

s14sh:DailySales-unitsSold a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 0 ;
    sh:path s14:unitsSold .

s14sh:DeliveryRoute-routeCode a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:routeCode ;
    sh:pattern "^R-[0-9]{2}$" .

s14sh:DirectStoreDeliveryProduct-caseWeightKg a sh:PropertyShape ;
    sh:maxCount 0 ;
    sh:path s14:caseWeightKg .

s14sh:DirectStoreDeliveryProduct-flowType a sh:PropertyShape ;
    sh:hasValue "DSD" ;
    sh:path s14:flowType .

s14sh:DirectStoreDeliveryProduct-storedInSlot a sh:PropertyShape ;
    sh:maxCount 0 ;
    sh:path s14:storedInSlot .

s14sh:FreshDelivery-UseByAfterDelivery a sh:SPARQLConstraint ;
    sh:message "Use-by date is after the delivery date."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:deliveryTimestamp ?d ; s14:useByDate ?u . FILTER (?u <= xsd:date(?d)) }" .

s14sh:FreshDelivery-crateCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:crateCount .

s14sh:FreshDelivery-deliveryTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:deliveryTimestamp .

s14sh:FreshDelivery-forProduct a sh:PropertyShape ;
    sh:class s14:DirectStoreDeliveryProduct ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forProduct .

s14sh:FreshDelivery-onRoute a sh:PropertyShape ;
    sh:class s14:DeliveryRoute ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:onRoute .

s14sh:FreshDelivery-unitCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:unitCount .

s14sh:FreshDelivery-useByDate a sh:PropertyShape ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:useByDate .

s14sh:GoodsReceipt-ReceivedAfterArrival a sh:SPARQLConstraint ;
    sh:message "Receipt time is not before the shipment's arrival."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:receivedTimestamp ?r ; s14:receivesShipment ?s . ?s s14:arrivedTimestamp ?a . FILTER (?r < ?a) }" .

s14sh:GoodsReceipt-grnId a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:grnId ;
    sh:pattern "^GRN-[0-9]{6}$" .

s14sh:GoodsReceipt-receiptMethod a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "pallet label (SSCC) scan against the shipping notice" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:receiptMethod .

s14sh:GoodsReceipt-receivedTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:receivedTimestamp .

s14sh:GoodsReceipt-receivesShipment a sh:PropertyShape ;
    sh:class s14:Shipment ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:receivesShipment .

s14sh:GoodsReceiptLine-bookedProduct a sh:PropertyShape ;
    sh:class s14:Product ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:bookedProduct .

s14sh:GoodsReceiptLine-bookedUnits a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 0 ;
    sh:path s14:bookedUnits .

s14sh:GoodsReceiptLine-lineNumber a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:lineNumber .

s14sh:GoodsReceiptLine-matchesNoticeLine a sh:PropertyShape ;
    sh:class s14:ShippingNoticeLine ;
    sh:maxCount 1 ;
    sh:path s14:matchesNoticeLine .

s14sh:GoodsReceiptLine-noticedProduct a sh:PropertyShape ;
    sh:class s14:Product ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:noticedProduct .

s14sh:GoodsReceiptLine-noticedUnits a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:noticedUnits .

s14sh:GoodsReceiptLine-onPallet a sh:PropertyShape ;
    sh:class s14:Pallet ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:onPallet .

