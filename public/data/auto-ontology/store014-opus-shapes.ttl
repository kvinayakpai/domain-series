s14sh:SalesLine-GtinMatchesProduct a sh:SPARQLConstraint ;
    sh:message "Scanned GTIN must be the product's GTIN."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:scannedGtin ?g ; s14:forProduct ?pr . ?pr s14:gtin ?pg . FILTER (?g != ?pg) }" .

s14sh:SalesLine-LineAmount a sh:SPARQLConstraint ;
    sh:message "Line amount must equal quantity x unit price (holds on all 35,485 lines)."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:quantity ?q ; s14:unitPriceInr ?p ; s14:lineAmountInr ?a . FILTER (?a != ?q * ?p) }" .

s14sh:SalesLine-PriceIsShelfPrice a sh:SPARQLConstraint ;
    sh:message "Unit price must equal the product's selling price (holds on all lines)."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:unitPriceInr ?p ; s14:forProduct ?pr . ?pr s14:sellingPriceInr ?sp . FILTER (?p != ?sp) }" .

s14sh:SalesLine-forProduct a sh:PropertyShape ;
    sh:class s14:Product ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forProduct .

s14sh:SalesLine-lineAmountInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minExclusive 0.0 ;
    sh:path s14:lineAmountInr .

s14sh:SalesLine-lineNumber a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:lineNumber .

s14sh:SalesLine-partOfBill a sh:PropertyShape ;
