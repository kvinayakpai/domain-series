    sh:path s14:orderId ;
    sh:pattern "^SO-[0-9]{6}$" .

s14sh:StoreOrder-orderReason a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "auto" ) ;
    sh:maxCount 1 ;
    sh:path s14:orderReason .

s14sh:StoreOrderLine-UnitsAreWholeCases a sh:SPARQLConstraint ;
    sh:message "units = cases x units per case."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:unitCount ?u ; s14:caseCount ?c ; s14:forProduct ?p . ?p s14:unitsPerCase ?k . FILTER (?u != ?c * ?k) }" .

s14sh:StoreOrderLine-caseCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:caseCount .

s14sh:StoreOrderLine-forProduct a sh:PropertyShape ;
    sh:class s14:DCReplenishedProduct ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forProduct .

s14sh:StoreOrderLine-partOfStoreOrder a sh:PropertyShape ;
    sh:class s14:StoreOrder ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:partOfStoreOrder .

s14sh:StoreOrderLine-unitCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:unitCount .

s14sh:UPIPaymentAttempt-SameAmountAsPsp a sh:SPARQLConstraint ;
    sh:message "Attempt amount must equal the PSP amount."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:amountInr ?a ; s14:upiTransaction ?u . ?u s14:amountInr ?b . FILTER (?a != ?b) }" .

s14sh:UPIPaymentAttempt-TillPspAgree a sh:SPARQLConstraint ;
    sh:message "When the till has an RRN, approved means PSP success and declined/failed means PSP failed."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:tillStatus ?t ; s14:upiTransaction ?u . ?u s14:pspStatus ?s . FILTER ((?t = \"approved\" && ?s != \"success\") || (?t IN (\"declined\", \"failed\") && ?s != \"failed\")) }" .

s14sh:UPIPaymentAttempt-tender a sh:PropertyShape ;
    sh:hasValue "UPI" ;
    sh:path s14:tender .

s14sh:UPIPaymentAttempt-upiTransaction a sh:PropertyShape ;
    sh:class s14:UPITransaction ;
    sh:maxCount 1 ;
    sh:path s14:upiTransaction .

s14sh:UPIRefund-CompletedAfterRequested a sh:SPARQLConstraint ;
    sh:message "A refund completes after it is requested."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:requestedTimestamp ?a ; s14:completedTimestamp ?b . FILTER (?b < ?a) }" .

s14sh:UPIRefund-amountInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minExclusive 0.0 ;
    sh:path s14:amountInr .

s14sh:UPIRefund-completedTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:path s14:completedTimestamp .

s14sh:UPIRefund-refundForBill a sh:PropertyShape ;
    sh:class s14:Bill ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:refundForBill .

s14sh:UPIRefund-refundId a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:refundId ;
    sh:pattern "^RF-[0-9]{6}$" .

s14sh:UPIRefund-refundTrigger a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "customer complaint" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:refundTrigger .

s14sh:UPIRefund-refundsTransaction a sh:PropertyShape ;
    sh:class s14:UPITransaction ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:refundsTransaction .

s14sh:UPIRefund-requestedTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:requestedTimestamp .

s14sh:UPISettlement-NetEqualsGrossMinusDeductions a sh:SPARQLConstraint ;
    sh:message "net = gross - refunds - MDR (holds on all 29 days)."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:grossInr ?g ; s14:refundsInr ?r ; s14:mdrInr ?m ; s14:netInr ?n . FILTER (?n != ?g - ?r - ?m) }" .

s14sh:UPISettlement-grossInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 0.0 ;
    sh:path s14:grossInr .

s14sh:UPISettlement-mdrInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 0.0 ;
    sh:path s14:mdrInr .

s14sh:UPISettlement-netInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:netInr .

s14sh:UPISettlement-refundsInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 0.0 ;
    sh:path s14:refundsInr .

s14sh:UPISettlement-settlementDate a sh:PropertyShape ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:settlementDate .

s14sh:UPISettlement-upiCreditCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 0 ;
    sh:path s14:upiCreditCount .

s14sh:UPITransaction-amountInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minExclusive 0.0 ;
    sh:path s14:amountInr .

s14sh:UPITransaction-initiatedTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:initiatedTimestamp .

s14sh:UPITransaction-pspStatus a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "success" "failed" "returned" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:pspStatus .

s14sh:UPITransaction-rrn a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:rrn ;
    sh:pattern "^[0-9]{12}$" .

s14sh:UPITransaction-settledIn a sh:PropertyShape ;
    sh:class s14:UPISettlement ;
    sh:maxCount 1 ;
    sh:path s14:settledIn .

s14sh:UPITransaction-statusTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:statusTimestamp .

s14sh:Vehicle-vehicleCode a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:vehicleCode ;
    sh:pattern "^TRK-[0-9]{2}$" .

s14sh:WarehouseSlot-slotCode a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:slotCode ;
    sh:pattern "^[A-Z]-[0-9]{2}-[0-9]{2}$" .

s14sh:WarehouseStockAdjustment-ValueAtCost a sh:SPARQLConstraint ;
    sh:message "value at cost = units x product cost price; units = cases x units per case."@en ;
    sh:prefixes <https://example.org/store014/shapes> ;
    sh:select "SELECT $this WHERE { $this s14:unitCount ?u ; s14:caseCount ?c ; s14:valueAtCostInr ?v ; s14:forProduct ?p . ?p s14:costPriceInr ?k ; s14:unitsPerCase ?n . FILTER (?v != ?u * ?k || ?u != ?c * ?n) }" .

s14sh:WarehouseStockAdjustment-adjustedTimestamp a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:adjustedTimestamp .

s14sh:WarehouseStockAdjustment-adjustmentReason a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:adjustmentReason .

s14sh:WarehouseStockAdjustment-atSlot a sh:PropertyShape ;
    sh:class s14:WarehouseSlot ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:atSlot .

s14sh:WarehouseStockAdjustment-caseCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:caseCount .

s14sh:WarehouseStockAdjustment-forProduct a sh:PropertyShape ;
    sh:class s14:DCReplenishedProduct ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forProduct .

s14sh:WarehouseStockAdjustment-unitCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:unitCount .

s14sh:WarehouseStockAdjustment-valueAtCostInr a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:valueAtCostInr .

s14sh:WriteOff-businessDate a sh:PropertyShape ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:businessDate .

s14sh:WriteOff-forProduct a sh:PropertyShape ;
    sh:class s14:Product ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:forProduct .

s14sh:WriteOff-unitCount a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path s14:unitCount .

s14sh:WriteOff-writeOffReason a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:in ( "expired" "damaged" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path s14:writeOffReason .

<https://example.org/store014/shapes> a owl:Ontology ;
    owl:imports <https://example.org/store014/ontology> ;
    sh:declare [ sh:namespace "https://example.org/store014/ontology#"^^xsd:anyURI ;
            sh:prefix "s14" ],
        [ sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ;
            sh:prefix "xsd" ] .

