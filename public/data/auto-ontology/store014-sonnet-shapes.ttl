@prefix : <http://example.org/store014#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:ProductShape a sh:NodeShape ; sh:targetClass :Product ; rdfs:label "Product shape" ;
  sh:property [ sh:path :hasSku ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :hasGtin ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9]{13}$" ] ;
  sh:property [ sh:path :productName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :packSize ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :caseUnits ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :sellingPriceInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
  sh:property [ sh:path :costInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
  sh:property [ sh:path :flow ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("DC" "DSD") ] .

:DCProductShape a sh:NodeShape ; sh:targetClass :DCProduct ; rdfs:label "DCProduct shape" ;
  sh:property [ sh:path :caseKg ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
  sh:property [ sh:path :hasSlot ; sh:class :StorageSlot ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] .

:BillShape a sh:NodeShape ; sh:targetClass :Bill ; rdfs:label "Bill shape" ;
  sh:property [ sh:path :billId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^B[0-9]{6}-[0-9]{6}$" ] .

:BillLineShape a sh:NodeShape ; sh:targetClass :BillLine ; rdfs:label "BillLine shape" ;
  sh:property [ sh:path :onBill ; sh:class :Bill ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :lineNumber ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :billTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :scannedGtin ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9]{13}$" ] ;
  sh:property [ sh:path :scannedProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :quantity ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :unitPriceInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
  sh:property [ sh:path :lineAmountInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] .

:PaymentAttemptShape a sh:NodeShape ; sh:targetClass :PaymentAttempt ; rdfs:label "PaymentAttempt shape" ;
  sh:property [ sh:path :paysBill ; sh:class :Bill ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :attemptNumber ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :paymentTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :tender ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("cash" "card" "UPI") ] ;
  sh:property [ sh:path :amountInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
  sh:property [ sh:path :tillStatus ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("approved" "declined" "failed" "failed: no response") ] .

:UPIPaymentShape a sh:NodeShape ; sh:targetClass :UPIPayment ; rdfs:label "UPIPayment shape" ;
  sh:property [ sh:path :hasRrn ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:pattern "^[0-9]{12}$" ] ;
  sh:property [ sh:path :reconcilesTo ; sh:class :PSPTransaction ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .

:PSPTransactionShape a sh:NodeShape ; sh:targetClass :PSPTransaction ; rdfs:label "PSPTransaction shape" ;
  sh:property [ sh:path :hasRrn ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9]{12}$" ] ;
  sh:property [ sh:path :initiatedTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :amountInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
  sh:property [ sh:path :pspStatus ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("success" "failed" "returned") ] ;
  sh:property [ sh:path :pspStatusTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] .

:UPIRefundShape a sh:NodeShape ; sh:targetClass :UPIRefund ; rdfs:label "UPIRefund shape" ;
  sh:property [ sh:path :refundId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^RF-[0-9]{6}$" ] ;
  sh:property [ sh:path :refundsTransaction ; sh:class :PSPTransaction ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :refundForBill ; sh:class :Bill ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :amountInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
  sh:property [ sh:path :refundTrigger ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("customer complaint") ] ;
  sh:property [ sh:path :requestedTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :completedTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] .

:CustomerComplaintShape a sh:NodeShape ; sh:targetClass :CustomerComplaint ; rdfs:label "CustomerComplaint shape" ;
  sh:property [ sh:path :complaintTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :complaintKind ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("charged twice" "debited but the till said failed") ] ;
  sh:property [ sh:path :amountInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
  sh:property [ sh:path :complaintBill ; sh:class :Bill ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :complaintAbout ; sh:class :PSPTransaction ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :resolvedTimestamp ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
  sh:property [ sh:path :resolution ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:UPISettlementShape a sh:NodeShape ; sh:targetClass :UPISettlement ; rdfs:label "UPISettlement shape" ;
  sh:property [ sh:path :settlementDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :upiCredits ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :grossInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :refundsInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :mdrInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :netInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] .

:DailySalesShape a sh:NodeShape ; sh:targetClass :DailySales ; rdfs:label "DailySales shape" ;
  sh:property [ sh:path :recordDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :ofProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :unitsSold ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :revenueInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] .

:ForecastShape a sh:NodeShape ; sh:targetClass :Forecast ; rdfs:label "Forecast shape" ;
  sh:property [ sh:path :recordDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :ofProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :forecastUnitsPerDay ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :sigma ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :reorderPoint ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :orderUpTo ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :bookOnHand ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :onOrder ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :orderedUnits ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :forecastMethod ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("28-day mean of recorded sales") ] .

:InventoryBookBalanceShape a sh:NodeShape ; sh:targetClass :InventoryBookBalance ; rdfs:label "InventoryBookBalance shape" ;
  sh:property [ sh:path :recordDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :ofProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :bookOnHand ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] .

:StockCountShape a sh:NodeShape ; sh:targetClass :StockCount ; rdfs:label "StockCount shape" ;
  sh:property [ sh:path :countTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :ofProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :bookBefore ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :countedQuantity ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :adjustmentUnits ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :countTrigger ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("scheduled full count" "manager request after complaints") ] .

:ShelfAuditShape a sh:NodeShape ; sh:targetClass :ShelfAudit ; rdfs:label "ShelfAudit shape" ;
  sh:property [ sh:path :auditTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :ofProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :shelfStatus ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("on shelf" "empty") ] .

:WriteOffShape a sh:NodeShape ; sh:targetClass :WriteOff ; rdfs:label "WriteOff shape" ;
  sh:property [ sh:path :recordDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :ofProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :writeOffUnits ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :writeOffReason ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("expired" "damaged") ] .

:StoreOrderShape a sh:NodeShape ; sh:targetClass :StoreOrder ; rdfs:label "StoreOrder shape" ;
  sh:property [ sh:path :orderId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^SO-[0-9]{6}$" ] ;
  sh:property [ sh:path :ofProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :units ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :cases ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :createdTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :orderReason ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("auto") ] .

:PickConfirmationShape a sh:NodeShape ; sh:targetClass :PickConfirmation ; rdfs:label "PickConfirmation shape" ;
  sh:property [ sh:path :pickTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :pickForOrder ; sh:class :StoreOrder ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :pickInShipment ; sh:class :Shipment ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :lineNumber ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :ofProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :pickedFromSlot ; sh:class :StorageSlot ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :casesOrdered ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :casesConfirmed ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :confirmationMethod ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("slot label scan") ] .

:ShipmentShape a sh:NodeShape ; sh:targetClass :Shipment ; rdfs:label "Shipment shape" ;
  sh:property [ sh:path :shipmentId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^SHP-[0-9]{6}$" ] ;
  sh:property [ sh:path :byVehicle ; sh:class :Vehicle ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :dispatchedTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :slotStart ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :slotEnd ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :arrivedTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :palletCount ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] .

:PalletShape a sh:NodeShape ; sh:targetClass :Pallet ; rdfs:label "Pallet shape" ;
  sh:property [ sh:path :sscc ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9]{18}$" ] ;
  sh:property [ sh:path :onShipment ; sh:class :Shipment ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :cases ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :noticeKg ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
  sh:property [ sh:path :weightCheck ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("not weighed") ] .

:ShippingNoticeLineShape a sh:NodeShape ; sh:targetClass :ShippingNoticeLine ; rdfs:label "ShippingNoticeLine shape" ;
  sh:property [ sh:path :onShipment ; sh:class :Shipment ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :onPallet ; sh:class :Pallet ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :lineNumber ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :noticeForOrder ; sh:class :StoreOrder ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :noticeProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :noticeGtin ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9]{13}$" ] ;
  sh:property [ sh:path :cases ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :units ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] .

:GoodsReceiptShape a sh:NodeShape ; sh:targetClass :GoodsReceipt ; rdfs:label "GoodsReceipt shape" ;
  sh:property [ sh:path :grnId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^GRN-[0-9]{6}$" ] ;
  sh:property [ sh:path :onShipment ; sh:class :Shipment ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :onPallet ; sh:class :Pallet ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :lineNumber ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :receivedTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :asnSku ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :asnUnits ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :bookedProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :unitsBooked ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path :confirmationMethod ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("pallet label (SSCC) scan against the shipping notice") ] .

:FreshDeliveryShape a sh:NodeShape ; sh:targetClass :FreshDelivery ; rdfs:label "FreshDelivery shape" ;
  sh:property [ sh:path :deliveryTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :onRoute ; sh:class :Route ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :ofProduct ; sh:class :DSDProduct ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :units ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :crates ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path :useByDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:WarehouseStockAdjustmentShape a sh:NodeShape ; sh:targetClass :WarehouseStockAdjustment ; rdfs:label "WarehouseStockAdjustment shape" ;
  sh:property [ sh:path :adjustedTimestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :ofProduct ; sh:class :Product ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :adjustmentSlot ; sh:class :StorageSlot ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :cases ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :units ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :valueAtCostInr ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path :adjustmentReason ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("short pick: slot count variance" "cycle count variance") ] .

:RouteShape a sh:NodeShape ; sh:targetClass :Route ; rdfs:label "Route shape" ;
  sh:property [ sh:path :code ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^R-[0-9]{2}$" ] .

:VehicleShape a sh:NodeShape ; sh:targetClass :Vehicle ; rdfs:label "Vehicle shape" ;
  sh:property [ sh:path :code ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^TRK-[0-9]{2}$" ] .

:StorageSlotShape a sh:NodeShape ; sh:targetClass :StorageSlot ; rdfs:label "StorageSlot shape" ;
  sh:property [ sh:path :code ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[A-Z]-[0-9]{2}-[0-9]{2}$" ] .
