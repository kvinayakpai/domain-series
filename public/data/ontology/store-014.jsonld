      },
      "dcterms:creator": {
        "@language": "en",
        "@value": "Why Domain Matters (Vinayak, with his AI assistant)"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "The things a simulated Indian supermarket sells, moves and gets paid for, how they link, the twelve rules that fix Season 1 of Why Domain Matters, and what each record sees."
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "The Store 014 ontology"
      },
      "owl:versionInfo": "1.0",
      "rdfs:seeAlso": {
