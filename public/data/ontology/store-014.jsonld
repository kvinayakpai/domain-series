      "rdfs:domain": {
        "@id": "s14:Forecast"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "predicts"
      },
      "rdfs:range": {
        "@id": "s14:Demand"
      }
    },
    {
      "@id": "s14:quantity",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
