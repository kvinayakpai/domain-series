        "@language": "en",
        "@value": "if extra"
      },
      "rdfs:range": {
        "@id": "s14:Refund"
      }
    },
    {
      "@id": "s14:rrn",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The UPI retrieval reference number of a payment."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "RRN"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "s14:rule-1",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Available means on the shelf. Book stock is a belief – the last count, plus receipts, minus sales and write-offs."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 1"
      },
      "s14:governs": {
        "@id": "s14:Stock"
      },
      "s14:solves": [
        {
          "@id": "s14:kpi-days-of-supply"
        },
        {
          "@id": "s14:kpi-ira"
        },
        {
          "@id": "s14:kpi-osa"
        }
      ]
    },
    {
      "@id": "s14:rule-10",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "One bill, one payment. Every UPI request carries the bill ID, and a debit with no approved payment is a customer charged twice until proven otherwise."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 10"
      },
      "s14:governs": [
        {
          "@id": "s14:Debit"
        },
        {
          "@id": "s14:PaymentAttempt"
        }
      ],
      "s14:solves": [
        {
          "@id": "s14:kpi-charged-twice"
        },
        {
          "@id": "s14:kpi-match-rate"
        }
      ]
    },
    {
      "@id": "s14:rule-11",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A refund answers a debit. The clock starts at the extra debit, not at the complaint."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 11"
      },
      "s14:governs": {
        "@id": "s14:Refund"
      },
      "s14:solves": {
        "@id": "s14:kpi-refund-tat"
      }
    },
    {
      "@id": "s14:rule-12",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Every record either looks at the world or copies another record. Before acting on a KPI, find the record it reads and an observation that can contradict it."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 12"
      },
      "s14:governs": {
        "@id": "s14:Record"
      }
    },
    {
      "@id": "s14:rule-2",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Silence is a question. No sales while the books show stock means someone should look at the shelf."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 2"
      },
      "s14:governs": [
        {
          "@id": "s14:LostSale"
        },
        {
          "@id": "s14:Stock"
        }
      ],
      "s14:solves": [
        {
          "@id": "s14:kpi-ira"
        },
        {
          "@id": "s14:kpi-lost-sales"
        },
        {
          "@id": "s14:kpi-osa"
        }
      ]
    },
    {
      "@id": "s14:rule-3",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Demand is not sales. Demand that finds an empty shelf becomes a lost sale, which no record holds – estimate it and say how."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 3"
      },
      "s14:governs": [
        {
          "@id": "s14:Demand"
        },
        {
          "@id": "s14:LostSale"
        }
      ],
      "s14:solves": [
        {
          "@id": "s14:kpi-days-of-supply"
        },
        {
          "@id": "s14:kpi-lfl"
        },
        {
          "@id": "s14:kpi-lost-sales"
        }
      ]
    },
    {
      "@id": "s14:rule-4",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A forecast predicts demand, so score it against demand, not sales."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 4"
      },
      "s14:governs": {
        "@id": "s14:Forecast"
      },
      "s14:solves": {
        "@id": "s14:kpi-forecast"
      }
    },
    {
      "@id": "s14:rule-5",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Every stock correction has a reason. Mirror-image corrections on lookalike items, neighboring slots or two buildings are one event."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 5"
      },
      "s14:governs": {
        "@id": "s14:StockChange"
      },
      "s14:solves": [
        {
          "@id": "s14:kpi-net-adjustments"
        },
        {
          "@id": "s14:kpi-pick-accuracy"
        },
        {
          "@id": "s14:kpi-shrink"
        }
      ]
    },
    {
      "@id": "s14:rule-6",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Fresh stock expires. Waste and the empty shelf are one decision – count both."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 6"
      },
      "s14:governs": {
        "@id": "s14:StockChange"
      },
      "s14:solves": {
        "@id": "s14:kpi-fresh-waste"
      }
    },
    {
      "@id": "s14:rule-7",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An item is the pack, known by the code on the pack. Match on that code – never on the slot, the pallet label or the product name."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 7"
      },
      "s14:governs": [
        {
          "@id": "s14:Case"
        },
        {
          "@id": "s14:Item"
        },
        {
          "@id": "s14:Pick"
        }
      ],
      "s14:solves": [
        {
          "@id": "s14:kpi-fill-rate"
        },
        {
          "@id": "s14:kpi-otif"
        },
        {
          "@id": "s14:kpi-pick-accuracy"
        }
      ]
    },
    {
      "@id": "s14:rule-8",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A delivery is on time, in full and right – checked case by case at the door, and done only when the stock is on the shelf."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 8"
      },
      "s14:governs": [
        {
          "@id": "s14:Receiving"
        },
        {
          "@id": "s14:Shipment"
        }
      ],
      "s14:solves": [
        {
          "@id": "s14:kpi-fill-rate"
        },
        {
          "@id": "s14:kpi-on-time"
        },
        {
          "@id": "s14:kpi-otif"
        }
      ]
    },
    {
      "@id": "s14:rule-9",
      "@type": "s14:Rule",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A payment has three witnesses – the till, UPI and the banks. A timeout at the till means “not known yet”, and UPI's final status decides."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Rule 9"
      },
      "s14:governs": {
        "@id": "s14:PaymentAttempt"
      },
      "s14:solves": [
        {
          "@id": "s14:kpi-success-rate"
        },
        {
          "@id": "s14:kpi-technical-declines"
        }
      ]
    },
    {
      "@id": "s14:scoredAgainst",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "s14:Forecast"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "scored against"
      }
    },
    {
      "@id": "s14:settlements",
      "@type": "s14:Record",
      "prov:wasDerivedFrom": {
        "@id": "s14:upi-report"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "settlements"
      }
    },
    {
      "@id": "s14:shelf-audits",
      "@type": "s14:Record",
      "rdfs:label": {
        "@language": "en",
        "@value": "shelf audits"
      },
      "s14:looksAt": {
        "@id": "s14:Shelf"
      }
    },
    {
      "@id": "s14:shipping-notice",
      "@type": "s14:Record",
      "prov:wasDerivedFrom": {
        "@id": "s14:pick-confirmations"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "shipping notice"
      }
    },
    {
      "@id": "s14:soldAs",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "s14:Stock"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sold as"
      },
      "rdfs:range": {
        "@id": "s14:Sale"
      }
    },
    {
      "@id": "s14:solves",
      "@type": "owl:AnnotationProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The Season 1 KPI whose blind spot a rule fixes."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "solves"
      }
    },
    {
      "@id": "s14:sscc",
      "@type": [
        "owl:DatatypeProperty",
        "owl:FunctionalProperty"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "The GS1 serial shipping container code on the pallet label."
      },
      "rdfs:domain": {
        "@id": "s14:Pallet"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "SSCC"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "s14:stock-counts",
      "@type": "s14:Record",
      "rdfs:label": {
        "@language": "en",
        "@value": "stock counts"
      },
      "s14:looksAt": [
        {
          "@id": "s14:Backroom"
        },
        {
          "@id": "s14:Shelf"
        }
      ]
    },
    {
      "@id": "s14:takesCase",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "s14:Pick"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "takes"
      },
      "rdfs:range": {
        "@id": "s14:Case"
      }
    },
    {
      "@id": "s14:tender",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {
        "@id": "s14:PaymentAttempt"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "tender"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "s14:till-lines",
      "@type": "s14:Record",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A sale proves the pack was on the shelf. No sale proves nothing."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "till lines"
      },
      "s14:looksAt": {
        "@id": "s14:Shelf"
      }
    },
    {
      "@id": "s14:till-payments",
      "@type": "s14:Record",
      "prov:wasDerivedFrom": {
        "@id": "s14:upi-report"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The provider's answer, or the till's own timeout."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "till payments"
      }
    },
    {
      "@id": "s14:tillStatus",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "s14:PaymentAttempt"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "till status"
      },
      "rdfs:range": {
        "@id": "s14:TillStatus"
      }
    },
    {
      "@id": "s14:unmetAs",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "s14:Demand"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "or, if empty"
      },
      "rdfs:range": {
        "@id": "s14:LostSale"
      }
    },
    {
      "@id": "s14:upi-report",
      "@type": "s14:Record",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Whether the customer was debited and the store credited."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "UPI's report"
      },
      "s14:looksAt": {
        "@id": "s14:Debit"
      }
    },
    {
      "@id": "s14:warehouse-slot-counts",
      "@type": "s14:Record",
      "rdfs:label": {
        "@language": "en",
        "@value": "warehouse slot counts"
      },
      "s14:looksAt": {
        "@id": "s14:WarehouseSlot"
      }
    },
    {
      "@id": "s14:windowEnd",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {
        "@id": "s14:Shipment"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "window ends"
      },
      "rdfs:range": {
        "@id": "xsd:dateTime"
      }
    },
    {
      "@id": "s14:windowStart",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {
        "@id": "s14:Shipment"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "window starts"
      },
      "rdfs:range": {
        "@id": "xsd:dateTime"
      }
    },
    {
      "@id": "s14:within",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "s14:Place"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "within"
      },
      "rdfs:range": {
        "@id": "s14:Site"
      }
    }
  ]
}
