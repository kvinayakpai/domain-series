      "@id": "s14:reason",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {
        "@id": "s14:StockChange"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "reason"
      },
      "rdfs:range": {
