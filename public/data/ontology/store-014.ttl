# The Store 014 ontology, written from src/data/ontology.json by scripts/ontology/build.mjs. Do not edit by hand.
@prefix s14: <https://kvinayakpai.github.io/domain-series/ontology/store-014#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://kvinayakpai.github.io/domain-series/ontology/store-014> a owl:Ontology ;
    dcterms:title "The Store 014 ontology"@en ;
    dcterms:description "The things a simulated Indian supermarket sells, moves and gets paid for, how they link, the twelve rules that fix Season 1 of Why Domain Matters, and what each record sees."@en ;
    dcterms:creator "Why Domain Matters (Vinayak, with his AI assistant)"@en ;
    dcterms:created "2026-11-17"^^xsd:date ;
    owl:versionInfo "1.0" ;
    rdfs:seeAlso <https://kvinayakpai.github.io/domain-series/store-014-ontology/> .

# ---------- annotations ----------
s14:part a owl:AnnotationProperty ; rdfs:label "part of the map"@en ;
    rdfs:comment "Where a thing sits on the map: the core, the truck, the shelf or the money."@en .
s14:looksAt a owl:AnnotationProperty ; rdfs:label "looks at"@en ;
    rdfs:comment "The kind of thing in the world a record observes."@en .
s14:governs a owl:AnnotationProperty ; rdfs:label "governs"@en ; rdfs:comment "The thing a rule is about."@en .
s14:solves a owl:AnnotationProperty ; rdfs:label "solves"@en ; rdfs:comment "The Season 1 KPI whose blind spot a rule fixes."@en .

# ---------- the 22 things ----------
s14:Product a owl:Class ;
    rdfs:label "Product"@en ;
    rdfs:comment "what a customer asks for: whole-wheat atta"@en ;
    s14:part "core" .
s14:Item a owl:Class ;
    rdfs:label "Item"@en ;
    rdfs:comment "the pack: a 5 kg bag, known by the GTIN on it"@en ;
    s14:part "core" .
s14:Place a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:comment "a warehouse slot, the store's shelf or backroom"@en ;
    s14:part "core" .
s14:Customer a owl:Class ;
    rdfs:label "Customer"@en ;
    rdfs:comment "wants items, pays bills, has a bank account"@en ;
    s14:part "core" .
s14:StoreOrder a owl:Class ;
    rdfs:label "Store order"@en ;
    rdfs:comment "cases of an item, for Store 014"@en ;
    s14:part "truck" .
s14:Pick a owl:Class ;
    rdfs:label "Pick"@en ;
    rdfs:comment "cases taken from a warehouse slot"@en ;
    s14:part "truck" .
s14:Case a owl:Class ;
    rdfs:label "Case"@en ;
    rdfs:comment "packs of exactly one item"@en ;
    s14:part "truck" .
s14:Pallet a owl:Class ;
    rdfs:label "Pallet"@en ;
    rdfs:comment "cases, known by the SSCC label"@en ;
    s14:part "truck" .
s14:Shipment a owl:Class ;
    rdfs:label "Shipment"@en ;
    rdfs:comment "pallets on a truck, in a delivery window"@en ;
    s14:part "truck" .
s14:Receiving a owl:Class ;
    rdfs:label "Receiving"@en ;
    rdfs:comment "the store takes in the pallets"@en ;
    s14:part "truck" .
s14:Stock a owl:Class ;
    rdfs:label "Stock"@en ;
    rdfs:comment "packs of an item at a place, now"@en ;
    s14:part "shelf" .
s14:StockChange a owl:Class ;
    rdfs:label "Stock change"@en ;
    rdfs:comment "receipt, sale, write-off or count, with a reason"@en ;
    s14:part "shelf" .
s14:Forecast a owl:Class ;
    rdfs:label "Forecast"@en ;
    rdfs:comment "expected demand, per day"@en ;
    s14:part "shelf" .
s14:Demand a owl:Class ;
    rdfs:label "Demand"@en ;
    rdfs:comment "a customer wants an item"@en ;
    s14:part "shelf" .
s14:Sale a owl:Class ;
    rdfs:label "Sale"@en ;
    rdfs:comment "demand met from the shelf"@en ;
    s14:part "shelf" .
s14:LostSale a owl:Class ;
    rdfs:label "Lost sale"@en ;
    rdfs:comment "demand that found the shelf empty"@en ;
    s14:part "shelf" .
s14:Bill a owl:Class ;
    rdfs:label "Bill"@en ;
    rdfs:comment "one checkout: its lines and total"@en ;
    s14:part "shelf" .
s14:PaymentAttempt a owl:Class ;
    rdfs:label "Payment attempt"@en ;
    rdfs:comment "a UPI request for a bill, with its RRN"@en ;
    s14:part "money" .
s14:Debit a owl:Class ;
    rdfs:label "Debit"@en ;
    rdfs:comment "money taken from the customer's bank"@en ;
    s14:part "money" .
s14:Settlement a owl:Class ;
    rdfs:label "Settlement"@en ;
    rdfs:comment "the store's bank credited, daily"@en ;
    s14:part "money" .
s14:Refund a owl:Class ;
    rdfs:label "Refund"@en ;
    rdfs:comment "an extra debit given back"@en ;
    s14:part "money" .
s14:Complaint a owl:Class ;
    rdfs:label "Complaint"@en ;
    rdfs:comment "a customer reports a debit"@en ;
    s14:part "money" .

# Kinds of place: a taxonomy inside the ontology.
s14:Site a owl:Class ; rdfs:subClassOf s14:Place ; rdfs:label "Site"@en ; rdfs:comment "a building known by its GLN: the warehouse or the store"@en .
s14:WarehouseSlot a owl:Class ; rdfs:subClassOf s14:Place ; rdfs:label "Warehouse slot"@en ; rdfs:comment "a pick face in the warehouse, assigned to one item"@en .
s14:Shelf a owl:Class ; rdfs:subClassOf s14:Place ; rdfs:label "Shelf"@en ; rdfs:comment "a place on the shop floor where shoppers can reach an item"@en .
s14:Backroom a owl:Class ; rdfs:subClassOf s14:Place ; rdfs:label "Backroom"@en ; rdfs:comment "the store room behind the shop floor"@en .
s14:WarehouseSlot owl:disjointWith s14:Shelf , s14:Backroom . s14:Shelf owl:disjointWith s14:Backroom .
s14:Sale owl:disjointWith s14:LostSale .
s14:Product owl:disjointWith s14:Item .

# Rule 7: a case holds packs of exactly one item. Rule 11: a refund answers one debit.
s14:Case rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s14:holdsItem ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass s14:Item ] .
s14:Refund rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s14:answers ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass s14:Debit ] .
s14:PaymentAttempt rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s14:forBill ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass s14:Bill ] .

# Codes a machine can match on: one item per GTIN, one pallet per SSCC, one bill per bill number.
s14:Item owl:hasKey ( s14:gtin ) .
s14:Pallet owl:hasKey ( s14:sscc ) .
s14:Bill owl:hasKey ( s14:billId ) .
s14:Site owl:hasKey ( s14:gln ) .

# ---------- the links on the map ----------
s14:comesInPack a owl:ObjectProperty ; rdfs:label "comes in packs"@en ; rdfs:domain s14:Product ; rdfs:range s14:Item .
s14:pickedAs a owl:ObjectProperty ; rdfs:label "picked as"@en ; rdfs:domain s14:StoreOrder ; rdfs:range s14:Pick .
s14:takesCase a owl:ObjectProperty ; rdfs:label "takes"@en ; rdfs:domain s14:Pick ; rdfs:range s14:Case .
s14:loadedOn a owl:ObjectProperty ; rdfs:label "loaded on"@en ; rdfs:domain s14:Case ; rdfs:range s14:Pallet .
s14:carriedBy a owl:ObjectProperty ; rdfs:label "carried by"@en ; rdfs:domain s14:Pallet ; rdfs:range s14:Shipment .
s14:endsIn a owl:ObjectProperty ; rdfs:label "ends in"@en ; rdfs:domain s14:Shipment ; rdfs:range s14:Receiving .
s14:addsTo a owl:ObjectProperty ; rdfs:label "adds to"@en ; rdfs:domain s14:Receiving ; rdfs:range s14:Stock .
s14:changes a owl:ObjectProperty ; rdfs:label "changes"@en ; rdfs:domain s14:StockChange ; rdfs:range s14:Stock .
s14:predicts a owl:ObjectProperty ; rdfs:label "predicts"@en ; rdfs:domain s14:Forecast ; rdfs:range s14:Demand .
s14:soldAs a owl:ObjectProperty ; rdfs:label "sold as"@en ; rdfs:domain s14:Stock ; rdfs:range s14:Sale .
s14:metAs a owl:ObjectProperty ; rdfs:label "met as"@en ; rdfs:domain s14:Demand ; rdfs:range s14:Sale .
s14:unmetAs a owl:ObjectProperty ; rdfs:label "or, if empty"@en ; rdfs:domain s14:Demand ; rdfs:range s14:LostSale .
s14:lineOn a owl:ObjectProperty ; rdfs:label "a line on"@en ; rdfs:domain s14:Sale ; rdfs:range s14:Bill .
s14:paidBy a owl:ObjectProperty ; rdfs:label "paid by"@en ; rdfs:domain s14:Bill ; rdfs:range s14:PaymentAttempt .
s14:mayEndIn a owl:ObjectProperty ; rdfs:label "may end in"@en ; rdfs:domain s14:PaymentAttempt ; rdfs:range s14:Debit .
s14:creditedIn a owl:ObjectProperty ; rdfs:label "credited in"@en ; rdfs:domain s14:Debit ; rdfs:range s14:Settlement .
s14:returnedBy a owl:ObjectProperty ; rdfs:label "if extra"@en ; rdfs:domain s14:Debit ; rdfs:range s14:Refund .
s14:asksFor a owl:ObjectProperty ; rdfs:label "asks for"@en ; rdfs:domain s14:Complaint ; rdfs:range s14:Refund .

# ---------- more links, behind the map ----------
s14:forBill a owl:ObjectProperty ; owl:inverseOf s14:paidBy ; rdfs:label "for bill"@en ; rdfs:domain s14:PaymentAttempt ; rdfs:range s14:Bill .
s14:fromAttempt a owl:ObjectProperty ; owl:inverseOf s14:mayEndIn ; rdfs:label "from attempt"@en ; rdfs:domain s14:Debit ; rdfs:range s14:PaymentAttempt .
s14:answers a owl:ObjectProperty ; owl:inverseOf s14:returnedBy ; rdfs:label "answers"@en ; rdfs:domain s14:Refund ; rdfs:range s14:Debit .
s14:aboutDebit a owl:ObjectProperty ; rdfs:label "about debit"@en ; rdfs:domain s14:Complaint ; rdfs:range s14:Debit .
s14:packOf a owl:ObjectProperty ; owl:inverseOf s14:comesInPack ; rdfs:label "pack of"@en ; rdfs:domain s14:Item ; rdfs:range s14:Product .
s14:holdsItem a owl:ObjectProperty ; rdfs:label "holds item"@en ; rdfs:domain s14:Case ; rdfs:range s14:Item .
s14:ofItem a owl:ObjectProperty ; rdfs:label "of item"@en ; rdfs:range s14:Item ;
    rdfs:comment "The item a stock figure, stock change, demand, forecast, order or sale is about."@en .
s14:atPlace a owl:ObjectProperty ; rdfs:label "at place"@en ; rdfs:range s14:Place .
s14:within a owl:ObjectProperty ; rdfs:label "within"@en ; rdfs:domain s14:Place ; rdfs:range s14:Site .
s14:fromSlot a owl:ObjectProperty ; rdfs:label "from slot"@en ; rdfs:domain s14:Pick ; rdfs:range s14:WarehouseSlot .
s14:assignedItem a owl:ObjectProperty ; rdfs:label "assigned item"@en ; rdfs:domain s14:WarehouseSlot ; rdfs:range s14:Item .
s14:byCustomer a owl:ObjectProperty ; rdfs:label "by customer"@en ; rdfs:range s14:Customer .
s14:scoredAgainst a owl:ObjectProperty ; rdfs:label "scored against"@en ; rdfs:domain s14:Forecast .
s14:confirmedBy a owl:ObjectProperty ; rdfs:label "confirmed by"@en ; rdfs:domain s14:Pick ; rdfs:range s14:ScanMethod .
s14:checkedBy a owl:ObjectProperty ; rdfs:label "checked by"@en ; rdfs:domain s14:Receiving ; rdfs:range s14:ScanMethod .
s14:basis a owl:ObjectProperty ; rdfs:label "basis"@en ; rdfs:domain s14:Stock ; rdfs:range s14:StockBasis .
s14:tillStatus a owl:ObjectProperty ; rdfs:label "till status"@en ; rdfs:domain s14:PaymentAttempt ; rdfs:range s14:TillStatus .
s14:finalStatus a owl:ObjectProperty ; rdfs:label "final status"@en ; rdfs:domain s14:PaymentAttempt ; rdfs:range s14:UpiStatus ;
    rdfs:comment "UPI's final status for a payment attempt: the one that decides."@en .
s14:fromRecord a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom ; rdfs:label "from record"@en ; rdfs:range s14:Record ;
    rdfs:comment "The record a fact in the knowledge graph came from."@en .

# ---------- codes and values ----------
s14:gtin a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label "GTIN"@en ; rdfs:domain s14:Item ; rdfs:range xsd:string ;
    rdfs:comment "The GS1 trade item number printed on the pack."@en .
s14:sscc a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label "SSCC"@en ; rdfs:domain s14:Pallet ; rdfs:range xsd:string ;
    rdfs:comment "The GS1 serial shipping container code on the pallet label."@en .
s14:gln a owl:DatatypeProperty ; rdfs:label "GLN"@en ; rdfs:domain s14:Site ; rdfs:range xsd:string ; rdfs:comment "The GS1 global location number of a site."@en .
s14:rrn a owl:DatatypeProperty ; rdfs:label "RRN"@en ; rdfs:range xsd:string ; rdfs:comment "The UPI retrieval reference number of a payment."@en .
s14:billId a owl:DatatypeProperty ; rdfs:label "bill number"@en ; rdfs:domain s14:Bill ; rdfs:range xsd:string .
s14:carriesBillId a owl:DatatypeProperty ; rdfs:label "carries bill number"@en ; rdfs:domain s14:PaymentAttempt ; rdfs:range xsd:string ;
    rdfs:comment "The bill number the UPI request itself carried, so the credit can be matched to the bill."@en .
s14:code a owl:DatatypeProperty ; rdfs:label "code"@en ; rdfs:range xsd:string ; rdfs:comment "A system's own code: a SKU, a slot, an order or a receipt number."@en .
s14:tender a owl:DatatypeProperty ; rdfs:label "tender"@en ; rdfs:domain s14:PaymentAttempt ; rdfs:range xsd:string .
s14:quantity a owl:DatatypeProperty ; rdfs:label "quantity"@en ; rdfs:range xsd:integer ; rdfs:comment "Packs (units). Negative for a stock change that takes packs off."@en .
s14:cases a owl:DatatypeProperty ; rdfs:label "cases"@en ; rdfs:range xsd:integer .
s14:packsPerCase a owl:DatatypeProperty ; rdfs:label "packs per case"@en ; rdfs:domain s14:Item ; rdfs:range xsd:integer .
s14:amountInr a owl:DatatypeProperty ; rdfs:label "amount (INR)"@en ; rdfs:range xsd:decimal .
s14:perDay a owl:DatatypeProperty ; rdfs:label "per day"@en ; rdfs:domain s14:Forecast ; rdfs:range xsd:decimal .
s14:at a owl:DatatypeProperty ; rdfs:label "at"@en ; rdfs:range xsd:dateTime ; rdfs:comment "When it happened, or when it was seen."@en .
s14:windowStart a owl:DatatypeProperty ; rdfs:label "window starts"@en ; rdfs:domain s14:Shipment ; rdfs:range xsd:dateTime .
s14:windowEnd a owl:DatatypeProperty ; rdfs:label "window ends"@en ; rdfs:domain s14:Shipment ; rdfs:range xsd:dateTime .
s14:reason a owl:DatatypeProperty ; rdfs:label "reason"@en ; rdfs:domain s14:StockChange ; rdfs:range xsd:string .
s14:method a owl:DatatypeProperty ; rdfs:label "method"@en ; rdfs:range xsd:string ; rdfs:comment "How a forecast or an estimate was made."@en .

# ---------- code lists (SKOS) ----------
s14:ScanMethod a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Scan method"@en .
s14:StockBasis a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Stock basis"@en .
s14:TillStatus a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Till status"@en .
s14:UpiStatus a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "UPI status"@en .
s14:PackCodeScan a s14:ScanMethod ; skos:prefLabel "pack code scan"@en ; skos:definition "A scan of the GTIN on the pack or the case."@en .
s14:SlotLabelScan a s14:ScanMethod ; skos:prefLabel "slot label scan"@en ; skos:definition "A scan of the warehouse slot's label: it proves where the picker stood."@en .
s14:PalletLabelScan a s14:ScanMethod ; skos:prefLabel "pallet label scan"@en ; skos:definition "A scan of the SSCC on the pallet label, matched to the shipping notice."@en .
s14:Seen a s14:StockBasis ; skos:prefLabel "seen"@en ; skos:definition "Stock someone saw: a shelf audit, a count, or a sale at the till."@en .
s14:Believed a s14:StockBasis ; skos:prefLabel "believed"@en ; skos:definition "Stock the books believe: the last count, plus receipts, minus sales and write-offs."@en .
s14:Approved a s14:TillStatus ; skos:prefLabel "approved"@en .
s14:Declined a s14:TillStatus ; skos:prefLabel "declined"@en .
s14:Timeout a s14:TillStatus ; skos:prefLabel "timeout"@en ; skos:definition "No answer in time. Not known yet, not failed."@en .
s14:Success a s14:UpiStatus ; skos:prefLabel "success"@en .
s14:Failure a s14:UpiStatus ; skos:prefLabel "failure"@en .

# ---------- the twelve rules, and the Season 1 KPIs they fix ----------
s14:Rule a owl:Class ; rdfs:label "Rule"@en .
s14:Kpi a owl:Class ; rdfs:label "Season 1 KPI"@en .
s14:kpi-lfl a s14:Kpi ; rdfs:label "Sales"@en .
s14:kpi-osa a s14:Kpi ; rdfs:label "On-shelf availability"@en .
s14:kpi-lost-sales a s14:Kpi ; rdfs:label "Lost sales"@en .
s14:kpi-ira a s14:Kpi ; rdfs:label "Inventory record accuracy"@en .
s14:kpi-shrink a s14:Kpi ; rdfs:label "Shrink"@en .
s14:kpi-forecast a s14:Kpi ; rdfs:label "Forecast accuracy and bias"@en .
s14:kpi-days-of-supply a s14:Kpi ; rdfs:label "Days of supply"@en .
s14:kpi-fresh-waste a s14:Kpi ; rdfs:label "Fresh waste"@en .
s14:kpi-pick-accuracy a s14:Kpi ; rdfs:label "Pick accuracy"@en .
s14:kpi-fill-rate a s14:Kpi ; rdfs:label "Fill rate"@en .
s14:kpi-on-time a s14:Kpi ; rdfs:label "On-time arrival"@en .
s14:kpi-otif a s14:Kpi ; rdfs:label "On time, in full (OTIF)"@en .
s14:kpi-net-adjustments a s14:Kpi ; rdfs:label "Net inventory adjustments"@en .
s14:kpi-success-rate a s14:Kpi ; rdfs:label "Payment success rate"@en .
s14:kpi-technical-declines a s14:Kpi ; rdfs:label "Technical decline rate"@en .
s14:kpi-charged-twice a s14:Kpi ; rdfs:label "Double debits"@en .
s14:kpi-match-rate a s14:Kpi ; rdfs:label "Reconciliation match rate"@en .
s14:kpi-refund-tat a s14:Kpi ; rdfs:label "Refund turnaround"@en .
s14:rule-1 a s14:Rule ;
    rdfs:label "Rule 1"@en ;
    rdfs:comment "Available means on the shelf. Book stock is a belief – the last count, plus receipts, minus sales and write-offs."@en ;
    s14:governs s14:Stock ;
    s14:solves s14:kpi-osa , s14:kpi-days-of-supply , s14:kpi-ira .
s14:rule-2 a s14:Rule ;
    rdfs:label "Rule 2"@en ;
    rdfs:comment "Silence is a question. No sales while the books show stock means someone should look at the shelf."@en ;
    s14:governs s14:Stock , s14:LostSale ;
    s14:solves s14:kpi-osa , s14:kpi-ira , s14:kpi-lost-sales .
s14:rule-3 a s14:Rule ;
    rdfs:label "Rule 3"@en ;
    rdfs:comment "Demand is not sales. Demand that finds an empty shelf becomes a lost sale, which no record holds – estimate it and say how."@en ;
    s14:governs s14:Demand , s14:LostSale ;
    s14:solves s14:kpi-lfl , s14:kpi-lost-sales , s14:kpi-days-of-supply .
s14:rule-4 a s14:Rule ;
    rdfs:label "Rule 4"@en ;
    rdfs:comment "A forecast predicts demand, so score it against demand, not sales."@en ;
    s14:governs s14:Forecast ;
    s14:solves s14:kpi-forecast .
s14:rule-5 a s14:Rule ;
    rdfs:label "Rule 5"@en ;
    rdfs:comment "Every stock correction has a reason. Mirror-image corrections on lookalike items, neighboring slots or two buildings are one event."@en ;
    s14:governs s14:StockChange ;
    s14:solves s14:kpi-shrink , s14:kpi-net-adjustments , s14:kpi-pick-accuracy .
s14:rule-6 a s14:Rule ;
    rdfs:label "Rule 6"@en ;
    rdfs:comment "Fresh stock expires. Waste and the empty shelf are one decision – count both."@en ;
    s14:governs s14:StockChange ;
    s14:solves s14:kpi-fresh-waste .
s14:rule-7 a s14:Rule ;
    rdfs:label "Rule 7"@en ;
    rdfs:comment "An item is the pack, known by the code on the pack. Match on that code – never on the slot, the pallet label or the product name."@en ;
    s14:governs s14:Item , s14:Pick , s14:Case ;
    s14:solves s14:kpi-pick-accuracy , s14:kpi-fill-rate , s14:kpi-otif .
s14:rule-8 a s14:Rule ;
    rdfs:label "Rule 8"@en ;
    rdfs:comment "A delivery is on time, in full and right – checked case by case at the door, and done only when the stock is on the shelf."@en ;
    s14:governs s14:Shipment , s14:Receiving ;
    s14:solves s14:kpi-on-time , s14:kpi-otif , s14:kpi-fill-rate .
s14:rule-9 a s14:Rule ;
    rdfs:label "Rule 9"@en ;
    rdfs:comment "A payment has three witnesses – the till, UPI and the banks. A timeout at the till means “not known yet”, and UPI's final status decides."@en ;
    s14:governs s14:PaymentAttempt ;
    s14:solves s14:kpi-success-rate , s14:kpi-technical-declines .
s14:rule-10 a s14:Rule ;
    rdfs:label "Rule 10"@en ;
    rdfs:comment "One bill, one payment. Every UPI request carries the bill ID, and a debit with no approved payment is a customer charged twice until proven otherwise."@en ;
    s14:governs s14:PaymentAttempt , s14:Debit ;
    s14:solves s14:kpi-charged-twice , s14:kpi-match-rate .
s14:rule-11 a s14:Rule ;
    rdfs:label "Rule 11"@en ;
    rdfs:comment "A refund answers a debit. The clock starts at the extra debit, not at the complaint."@en ;
    s14:governs s14:Refund ;
    s14:solves s14:kpi-refund-tat .
s14:rule-12 a s14:Rule ;
    rdfs:label "Rule 12"@en ;
    rdfs:comment "Every record either looks at the world or copies another record. Before acting on a KPI, find the record it reads and an observation that can contradict it."@en ;
    s14:governs s14:Record .

# ---------- records: who saw what (W3C PROV-O) ----------
s14:Record a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Record"@en ;
    rdfs:comment "A record either looks at the world or copies another record (rule 12)."@en .
s14:till-lines a s14:Record ; rdfs:label "till lines"@en ; s14:looksAt s14:Shelf ; rdfs:comment "A sale proves the pack was on the shelf. No sale proves nothing."@en .
s14:stock-counts a s14:Record ; rdfs:label "stock counts"@en ; s14:looksAt s14:Shelf , s14:Backroom .
s14:shelf-audits a s14:Record ; rdfs:label "shelf audits"@en ; s14:looksAt s14:Shelf .
s14:warehouse-slot-counts a s14:Record ; rdfs:label "warehouse slot counts"@en ; s14:looksAt s14:WarehouseSlot .
s14:upi-report a s14:Record ; rdfs:label "UPI's report"@en ; s14:looksAt s14:Debit ; rdfs:comment "Whether the customer was debited and the store credited."@en .
s14:pick-confirmations a s14:Record ; rdfs:label "pick confirmations"@en ; s14:looksAt s14:WarehouseSlot ; rdfs:comment "Where the picker stood, not what they took."@en .
s14:book-stock a s14:Record ; rdfs:label "book stock"@en ; prov:wasDerivedFrom s14:goods-receipts , s14:till-lines , s14:stock-counts .
s14:shipping-notice a s14:Record ; rdfs:label "shipping notice"@en ; prov:wasDerivedFrom s14:pick-confirmations .
s14:pallet-labels a s14:Record ; rdfs:label "pallet labels"@en ; prov:wasDerivedFrom s14:shipping-notice .
s14:goods-receipts a s14:Record ; rdfs:label "goods receipts"@en ; prov:wasDerivedFrom s14:shipping-notice .
s14:settlements a s14:Record ; rdfs:label "settlements"@en ; prov:wasDerivedFrom s14:upi-report .
s14:till-payments a s14:Record ; rdfs:label "till payments"@en ; prov:wasDerivedFrom s14:upi-report ;
    rdfs:comment "The provider's answer, or the till's own timeout."@en .
s14:forecasts a s14:Record ; rdfs:label "forecasts"@en ; prov:wasDerivedFrom s14:till-lines .
