@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix d: <https://kvinayakpai.github.io/domain-series/ontology/store-014-data#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# SHACL Core shapes for the data-bound layer. They check the structure of the bindings; check_bindings.py checks them against the CSV files.

d:TableShape a sh:NodeShape ; sh:targetClass d:Table ;
  sh:property [ sh:path d:sourceFile ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "\\.csv$" ] ;
  sh:property [ sh:path d:grain ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path d:recordKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "observes" "copies" ) ] ;
  sh:property [ sh:path d:windowKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "june" "till" "none" ) ] ;
  sh:property [ sh:path d:cueSet ; sh:minCount 1 ] ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ] .

d:ColumnShape a sh:NodeShape ; sh:targetClass d:Column ;
  sh:property [ sh:path d:inTable ; sh:minCount 1 ; sh:maxCount 1 ; sh:class d:Table ] ;
  sh:property [ sh:path d:columnName ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path d:kind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "id" "time" "code" "number" "text" ) ] .

d:NumberColumnShape a sh:NodeShape ; sh:targetSubjectsOf d:unit ;
  sh:property [ sh:path d:unit ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path d:additive ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path d:kind ; sh:hasValue "number" ] .

d:CodeValueShape a sh:NodeShape ; sh:targetClass d:CodeValue ;
  sh:property [ sh:path d:ofColumn ; sh:minCount 1 ; sh:maxCount 1 ; sh:class d:Column ] ;
  sh:property [ sh:path d:value ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:altLabel ; sh:minCount 1 ] .

d:UnrecordedShape a sh:NodeShape ; sh:targetClass d:UnrecordedConcept ;
  sh:property [ sh:path d:gap ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "who" "not_happen" "why" "else" "how_long" ) ] ;
  sh:property [ sh:path d:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "not_recorded" "proxy" ) ] ;
  sh:property [ sh:path d:pattern ; sh:minCount 1 ] ;
  sh:property [ sh:path rdfs:comment ; sh:minCount 1 ] .

d:ProductShape a sh:NodeShape ; sh:targetClass d:Product ;
  sh:property [ sh:path d:cueSet ; sh:minCount 1 ] ; sh:property [ sh:path d:value ; sh:minCount 1 ; sh:maxCount 1 ] .

d:FlagShape a sh:NodeShape ; sh:targetClass d:Flag ;
  sh:property [ sh:path d:forTable ; sh:minCount 1 ; sh:maxCount 1 ; sh:class d:Table ] ;
  sh:property [ sh:path d:sql ; sh:minCount 1 ; sh:maxCount 1 ] ; sh:property [ sh:path d:cueSet ; sh:minCount 1 ] .
