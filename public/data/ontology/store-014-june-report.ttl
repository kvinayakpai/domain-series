@prefix june: <https://kvinayakpai.github.io/domain-series/ontology/store-014/june#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix s14: <https://kvinayakpai.github.io/domain-series/ontology/store-014#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode june:debit-617118013344 ;
            sh:resultMessage "Rule 10: one bill, one payment. A debit with no approved payment is a customer charged twice until proven otherwise." ;
            sh:resultPath ( s14:fromAttempt s14:tillStatus ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue s14:Approved ;
                    sh:message "Rule 10: one bill, one payment. A debit with no approved payment is a customer charged twice until proven otherwise." ;
                    sh:path ( s14:fromAttempt s14:tillStatus ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode june:attempt-B260620-110056-1 ;
            sh:resultMessage "Rule 9: a timeout at the till means not known yet. Get UPI's final status before calling it failed or asking the customer to pay again." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape s14:TimeoutShape ;
            sh:value june:attempt-B260620-110056-1 ],
        [ a sh:ValidationResult ;
            sh:focusNode june:pick-SHP-260622-1 ;
            sh:resultMessage "Rule 7: a slot scan proves where the picker stood, not what was picked. Confirm a pick by the code on the pack." ;
            sh:resultPath s14:confirmedBy ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue s14:PackCodeScan ;
                    sh:message "Rule 7: a slot scan proves where the picker stood, not what was picked. Confirm a pick by the code on the pack." ;
                    sh:minCount 1 ;
                    sh:path s14:confirmedBy ] ],
        [ a sh:ValidationResult ;
            sh:focusNode june:attempt-B260620-110056-1 ;
            sh:resultMessage "Rule 10: every UPI request carries the bill number, so its credit can be matched to the bill." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape s14:UpiBillShape ;
            sh:value june:attempt-B260620-110056-1 ],
        [ a sh:ValidationResult ;
            sh:focusNode june:GRN-260609 ;
            sh:resultMessage "Rule 8: check a delivery case by case at the door, by the code on each case, not by the pallet label." ;
            sh:resultPath s14:checkedBy ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:cb2d80f180b6baa788fa2400ac6938d8039f4e6cd92c88d9478e37309fb68afe1be ],
        [ a sh:ValidationResult ;
            sh:focusNode june:store-correction-1 ;
            sh:resultMessage "Rule 5: every stock correction has a reason. Find it before you act, and look for its mirror image." ;
            sh:resultPath s14:reason ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:cb2dacd9af2c9af58fa859c322666b350d4f2bb40cd78ed2eebf9c222e88ff2aa53 ],
        [ a sh:ValidationResult ;
            sh:focusNode june:book-0610 ;
            sh:resultMessage "Rule 1: stock has a place. A stock figure with no place cannot say whether shoppers can reach it." ;
            sh:resultPath s14:atPlace ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Rule 1: stock has a place. A stock figure with no place cannot say whether shoppers can reach it." ;
                    sh:minCount 1 ;
                    sh:path s14:atPlace ] ],
        [ a sh:ValidationResult ;
            sh:focusNode june:GRN-260622 ;
            sh:resultMessage "Rule 8: check a delivery case by case at the door, by the code on each case, not by the pallet label." ;
            sh:resultPath s14:checkedBy ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:cb2d80f180b6baa788fa2400ac6938d8039f4e6cd92c88d9478e37309fb68afe1be ],
        [ a sh:ValidationResult ;
            sh:focusNode june:store-correction-2 ;
            sh:resultMessage "Rule 5: every stock correction has a reason. Find it before you act, and look for its mirror image." ;
            sh:resultPath s14:reason ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:cb2dacd9af2c9af58fa859c322666b350d4f2bb40cd78ed2eebf9c222e88ff2aa53 ],
        [ a sh:ValidationResult ;
            sh:focusNode june:forecast-0610 ;
            sh:resultMessage "Rule 4: a forecast predicts demand, so score it against demand, not sales." ;
            sh:resultPath s14:scoredAgainst ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape [ sh:class s14:Demand ;
                    sh:message "Rule 4: a forecast predicts demand, so score it against demand, not sales." ;
                    sh:path s14:scoredAgainst ] ;
            sh:value june:recorded-sales-5kg ] .

_:cb2d80f180b6baa788fa2400ac6938d8039f4e6cd92c88d9478e37309fb68afe1be sh:hasValue s14:PackCodeScan ;
    sh:message "Rule 8: check a delivery case by case at the door, by the code on each case, not by the pallet label." ;
    sh:minCount 1 ;
    sh:path s14:checkedBy .

_:cb2dacd9af2c9af58fa859c322666b350d4f2bb40cd78ed2eebf9c222e88ff2aa53 sh:message "Rule 5: every stock correction has a reason. Find it before you act, and look for its mirror image." ;
    sh:minCount 1 ;
    sh:path s14:reason .

