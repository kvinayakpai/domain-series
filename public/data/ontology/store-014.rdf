    <skos:prefLabel xml:lang="en">slot label scan</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#lineOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Sale"/>
    <rdfs:label xml:lang="en">a line on</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Bill"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cbd7c96744b860be374134b6eeace4a6009e3d5947219e59b3c009836ad1012775">
    <rdf:first rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#gln"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#assignedItem">
