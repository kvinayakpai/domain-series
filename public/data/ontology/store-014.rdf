  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-pick-accuracy">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Kpi"/>
    <rdfs:label xml:lang="en">Pick accuracy</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-6">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">Fresh stock expires. Waste and the empty shelf are one decision – count both.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 6</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#StockChange"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-fresh-waste"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#cases">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">cases</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
