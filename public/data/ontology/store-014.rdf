<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:prov="http://www.w3.org/ns/prov#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:s14="https://kvinayakpai.github.io/domain-series/ontology/store-014#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-5">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">Every stock correction has a reason. Mirror-image corrections on lookalike items, neighboring slots or two buildings are one event.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 5</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#StockChange"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-net-adjustments"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-pick-accuracy"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-shrink"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Pick">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">cases taken from a warehouse slot</rdfs:comment>
    <rdfs:label xml:lang="en">Pick</rdfs:label>
    <s14:part>truck</s14:part>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1b77f432b4ddb2656f7935f8950b5c5cd354e53840c09f3d72ddf4666bdcc20d2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Debit"/>
    <owl:onProperty rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#answers"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#mayEndIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#PaymentAttempt"/>
    <rdfs:label xml:lang="en">may end in</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Debit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">what a customer asks for: whole-wheat atta</rdfs:comment>
    <rdfs:label xml:lang="en">Product</rdfs:label>
    <owl:disjointWith rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Item"/>
    <s14:part>core</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-fill-rate">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Kpi"/>
    <rdfs:label xml:lang="en">Fill rate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#UpiStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">UPI status</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#asksFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Complaint"/>
    <rdfs:label xml:lang="en">asks for</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Refund"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#carriesBillId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The bill number the UPI request itself carried, so the credit can be matched to the bill.</rdfs:comment>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#PaymentAttempt"/>
    <rdfs:label xml:lang="en">carries bill number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#answers">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Refund"/>
    <rdfs:label xml:lang="en">answers</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Debit"/>
    <owl:inverseOf rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#returnedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#StockChange">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">receipt, sale, write-off or count, with a reason</rdfs:comment>
    <rdfs:label xml:lang="en">Stock change</rdfs:label>
    <s14:part>shelf</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Stock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">packs of an item at a place, now</rdfs:comment>
    <rdfs:label xml:lang="en">Stock</rdfs:label>
    <s14:part>shelf</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#billId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Bill"/>
    <rdfs:label xml:lang="en">bill number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Debit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">money taken from the customer's bank</rdfs:comment>
    <rdfs:label xml:lang="en">Debit</rdfs:label>
    <s14:part>money</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#pick-confirmations">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record"/>
    <rdfs:comment xml:lang="en">Where the picker stood, not what they took.</rdfs:comment>
    <rdfs:label xml:lang="en">pick confirmations</rdfs:label>
    <s14:looksAt rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#WarehouseSlot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Receiving">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">the store takes in the pallets</rdfs:comment>
    <rdfs:label xml:lang="en">Receiving</rdfs:label>
    <s14:part>truck</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-10">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">One bill, one payment. Every UPI request carries the bill ID, and a debit with no approved payment is a customer charged twice until proven otherwise.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 10</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Debit"/>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#PaymentAttempt"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-charged-twice"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-match-rate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Refund">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">an extra debit given back</rdfs:comment>
    <rdfs:label xml:lang="en">Refund</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb1b77f432b4ddb2656f7935f8950b5c5cd354e53840c09f3d72ddf4666bdcc20d2"/>
    <s14:part>money</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">How a forecast or an estimate was made.</rdfs:comment>
    <rdfs:label xml:lang="en">method</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#till-lines">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record"/>
    <rdfs:comment xml:lang="en">A sale proves the pack was on the shelf. No sale proves nothing.</rdfs:comment>
    <rdfs:label xml:lang="en">till lines</rdfs:label>
    <s14:looksAt rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Shelf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#soldAs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Stock"/>
    <rdfs:label xml:lang="en">sold as</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Sale"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#comesInPack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Product"/>
    <rdfs:label xml:lang="en">comes in packs</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Item"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#basis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Stock"/>
    <rdfs:label xml:lang="en">basis</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#StockBasis"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#till-payments">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record"/>
    <rdfs:comment xml:lang="en">The provider's answer, or the till's own timeout.</rdfs:comment>
    <rdfs:label xml:lang="en">till payments</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#upi-report"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-ira">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Kpi"/>
    <rdfs:label xml:lang="en">Inventory record accuracy</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Demand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a customer wants an item</rdfs:comment>
    <rdfs:label xml:lang="en">Demand</rdfs:label>
    <s14:part>shelf</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#PaymentAttempt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a UPI request for a bill, with its RRN</rdfs:comment>
    <rdfs:label xml:lang="en">Payment attempt</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb1653c20fa30f199e5272657e3978860440773124d0ade4128e1c291a9f57cb333"/>
    <s14:part>money</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-11">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">A refund answers a debit. The clock starts at the extra debit, not at the complaint.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 11</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Refund"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-refund-tat"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-9">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">A payment has three witnesses – the till, UPI and the banks. A timeout at the till means “not known yet”, and UPI's final status decides.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 9</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#PaymentAttempt"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-success-rate"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-technical-declines"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#unmetAs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Demand"/>
    <rdfs:label xml:lang="en">or, if empty</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#LostSale"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#paidBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Bill"/>
    <rdfs:label xml:lang="en">paid by</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#PaymentAttempt"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Case">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">packs of exactly one item</rdfs:comment>
    <rdfs:label xml:lang="en">Case</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb34285f7efd00773efdb4fa5396ccb1b70618a0815e5811218303aab8868dafd4e"/>
    <s14:part>truck</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#endsIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Shipment"/>
    <rdfs:label xml:lang="en">ends in</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Receiving"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#packOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Item"/>
    <rdfs:label xml:lang="en">pack of</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Product"/>
    <owl:inverseOf rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#comesInPack"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#byCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">by customer</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Customer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#quantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Packs (units). Negative for a stock change that takes packs off.</rdfs:comment>
    <rdfs:label xml:lang="en">quantity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Sale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">demand met from the shelf</rdfs:comment>
    <rdfs:label xml:lang="en">Sale</rdfs:label>
    <owl:disjointWith rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#LostSale"/>
    <s14:part>shelf</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#tender">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#PaymentAttempt"/>
    <rdfs:label xml:lang="en">tender</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#stock-counts">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record"/>
    <rdfs:label xml:lang="en">stock counts</rdfs:label>
    <s14:looksAt rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Backroom"/>
    <s14:looksAt rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Shelf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#governs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">The thing a rule is about.</rdfs:comment>
    <rdfs:label xml:lang="en">governs</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#checkedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Receiving"/>
    <rdfs:label xml:lang="en">checked by</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#ScanMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-2">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">Silence is a question. No sales while the books show stock means someone should look at the shelf.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 2</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#LostSale"/>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Stock"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-ira"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-lost-sales"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-osa"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Place">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a warehouse slot, the store's shelf or backroom</rdfs:comment>
    <rdfs:label xml:lang="en">Place</rdfs:label>
    <s14:part>core</s14:part>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb142cc3b8787ff7274f70dc306b4eb3e64da2a195bf62d526ac741adf3bc37d5a9">
    <rdf:first rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#billId"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Site">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a building known by its GLN: the warehouse or the store</rdfs:comment>
    <rdfs:label xml:lang="en">Site</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Place"/>
    <owl:hasKey rdf:nodeID="cbd7c96744b860be374134b6eeace4a6009e3d5947219e59b3c009836ad1012775"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#WarehouseSlot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a pick face in the warehouse, assigned to one item</rdfs:comment>
    <rdfs:label xml:lang="en">Warehouse slot</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Place"/>
    <owl:disjointWith rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Backroom"/>
    <owl:disjointWith rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Shelf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-12">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">Every record either looks at the world or copies another record. Before acting on a KPI, find the record it reads and an observation that can contradict it.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 12</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#gln">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The GS1 global location number of a site.</rdfs:comment>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Site"/>
    <rdfs:label xml:lang="en">GLN</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Bill">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">one checkout: its lines and total</rdfs:comment>
    <rdfs:label xml:lang="en">Bill</rdfs:label>
    <owl:hasKey rdf:nodeID="cb142cc3b8787ff7274f70dc306b4eb3e64da2a195bf62d526ac741adf3bc37d5a9"/>
    <s14:part>shelf</s14:part>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb34285f7efd00773efdb4fa5396ccb1b70618a0815e5811218303aab8868dafd4e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Item"/>
    <owl:onProperty rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#holdsItem"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#loadedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Case"/>
    <rdfs:label xml:lang="en">loaded on</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Pallet"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1653c20fa30f199e5272657e3978860440773124d0ade4128e1c291a9f57cb333">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Bill"/>
    <owl:onProperty rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#forBill"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-refund-tat">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Kpi"/>
    <rdfs:label xml:lang="en">Refund turnaround</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Approved">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#TillStatus"/>
    <skos:prefLabel xml:lang="en">approved</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#tillStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#PaymentAttempt"/>
    <rdfs:label xml:lang="en">till status</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#TillStatus"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#forecasts">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record"/>
    <rdfs:label xml:lang="en">forecasts</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#till-lines"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-1">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">Available means on the shelf. Book stock is a belief – the last count, plus receipts, minus sales and write-offs.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 1</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Stock"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-days-of-supply"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-ira"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-osa"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Believed">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#StockBasis"/>
    <skos:definition xml:lang="en">Stock the books believe: the last count, plus receipts, minus sales and write-offs.</skos:definition>
    <skos:prefLabel xml:lang="en">believed</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#changes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#StockChange"/>
    <rdfs:label xml:lang="en">changes</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Stock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-technical-declines">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Kpi"/>
    <rdfs:label xml:lang="en">Technical decline rate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#scoredAgainst">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Forecast"/>
    <rdfs:label xml:lang="en">scored against</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#perDay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Forecast"/>
    <rdfs:label xml:lang="en">per day</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#LostSale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">demand that found the shelf empty</rdfs:comment>
    <rdfs:label xml:lang="en">Lost sale</rdfs:label>
    <s14:part>shelf</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#carriedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Pallet"/>
    <rdfs:label xml:lang="en">carried by</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Shipment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Shipment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">pallets on a truck, in a delivery window</rdfs:comment>
    <rdfs:label xml:lang="en">Shipment</rdfs:label>
    <s14:part>truck</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#takesCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Pick"/>
    <rdfs:label xml:lang="en">takes</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Case"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-8">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">A delivery is on time, in full and right – checked case by case at the door, and done only when the stock is on the shelf.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 8</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Receiving"/>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Shipment"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-fill-rate"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-on-time"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-otif"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#holdsItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Case"/>
    <rdfs:label xml:lang="en">holds item</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Item"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#returnedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Debit"/>
    <rdfs:label xml:lang="en">if extra</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Refund"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-days-of-supply">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Kpi"/>
    <rdfs:label xml:lang="en">Days of supply</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Shelf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a place on the shop floor where shoppers can reach an item</rdfs:comment>
    <rdfs:label xml:lang="en">Shelf</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Place"/>
    <owl:disjointWith rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Backroom"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#StockBasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stock basis</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#part">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Where a thing sits on the map: the core, the truck, the shelf or the money.</rdfs:comment>
    <rdfs:label xml:lang="en">part of the map</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Forecast">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">expected demand, per day</rdfs:comment>
    <rdfs:label xml:lang="en">Forecast</rdfs:label>
    <s14:part>shelf</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#within">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Place"/>
    <rdfs:label xml:lang="en">within</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Item">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">the pack: a 5 kg bag, known by the GTIN on it</rdfs:comment>
    <rdfs:label xml:lang="en">Item</rdfs:label>
    <owl:hasKey rdf:nodeID="cb1a2859ddb159b3d9b8c286ade8e6dfe8c68ad11e5af76d22353aff5211d24acaa"/>
    <s14:part>core</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-fresh-waste">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Kpi"/>
    <rdfs:label xml:lang="en">Fresh waste</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#fromAttempt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Debit"/>
    <rdfs:label xml:lang="en">from attempt</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#PaymentAttempt"/>
    <owl:inverseOf rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#mayEndIn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014">
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-17</dcterms:created>
    <dcterms:creator xml:lang="en">Why Domain Matters (Vinayak, with his AI assistant)</dcterms:creator>
    <dcterms:description xml:lang="en">The things a simulated Indian supermarket sells, moves and gets paid for, how they link, the twelve rules that fix Season 1 of Why Domain Matters, and what each record sees.</dcterms:description>
    <dcterms:title xml:lang="en">The Store 014 ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:seeAlso rdf:resource="https://kvinayakpai.github.io/domain-series/store-014-ontology/"/>
    <owl:versionInfo>1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Settlement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">the store's bank credited, daily</rdfs:comment>
    <rdfs:label xml:lang="en">Settlement</rdfs:label>
    <s14:part>money</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#windowStart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Shipment"/>
    <rdfs:label xml:lang="en">window starts</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#gtin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:comment xml:lang="en">The GS1 trade item number printed on the pack.</rdfs:comment>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Item"/>
    <rdfs:label xml:lang="en">GTIN</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Failure">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#UpiStatus"/>
    <skos:prefLabel xml:lang="en">failure</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#fromRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The record a fact in the knowledge graph came from.</rdfs:comment>
    <rdfs:label xml:lang="en">from record</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#metAs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Demand"/>
    <rdfs:label xml:lang="en">met as</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Sale"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-otif">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Kpi"/>
    <rdfs:label xml:lang="en">On time, in full (OTIF)</rdfs:label>
  </rdf:Description>
