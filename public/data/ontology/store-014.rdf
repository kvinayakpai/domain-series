    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">at place</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Place"/>
