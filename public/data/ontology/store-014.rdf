    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">A forecast predicts demand, so score it against demand, not sales.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 4</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Forecast"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-forecast"/>
  </rdf:Description>
