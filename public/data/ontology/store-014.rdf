    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record"/>
    <rdfs:comment xml:lang="en">Whether the customer was debited and the store credited.</rdfs:comment>
    <rdfs:label xml:lang="en">UPI's report</rdfs:label>
    <s14:looksAt rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Debit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#SlotLabelScan">
