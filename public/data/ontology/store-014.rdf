  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Customer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">wants items, pays bills, has a bank account</rdfs:comment>
    <rdfs:label xml:lang="en">Customer</rdfs:label>
    <s14:part>core</s14:part>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Timeout">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#TillStatus"/>
    <skos:definition xml:lang="en">No answer in time. Not known yet, not failed.</skos:definition>
    <skos:prefLabel xml:lang="en">timeout</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Backroom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">the store room behind the shop floor</rdfs:comment>
    <rdfs:label xml:lang="en">Backroom</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Place"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#packsPerCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Item"/>
    <rdfs:label xml:lang="en">packs per case</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#solves">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">The Season 1 KPI whose blind spot a rule fixes.</rdfs:comment>
    <rdfs:label xml:lang="en">solves</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#creditedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Debit"/>
    <rdfs:label xml:lang="en">credited in</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Settlement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rule</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#goods-receipts">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record"/>
    <rdfs:label xml:lang="en">goods receipts</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#shipping-notice"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#shelf-audits">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record"/>
    <rdfs:label xml:lang="en">shelf audits</rdfs:label>
    <s14:looksAt rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Shelf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Success">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#UpiStatus"/>
    <skos:prefLabel xml:lang="en">success</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-3">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">Demand is not sales. Demand that finds an empty shelf becomes a lost sale, which no record holds – estimate it and say how.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 3</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Demand"/>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#LostSale"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-days-of-supply"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-lfl"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-lost-sales"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#code">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">A system's own code: a SKU, a slot, an order or a receipt number.</rdfs:comment>
    <rdfs:label xml:lang="en">code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#fromSlot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Pick"/>
    <rdfs:label xml:lang="en">from slot</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#WarehouseSlot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#confirmedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Pick"/>
    <rdfs:label xml:lang="en">confirmed by</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#ScanMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#ofItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The item a stock figure, stock change, demand, forecast, order or sale is about.</rdfs:comment>
    <rdfs:label xml:lang="en">of item</rdfs:label>
    <rdfs:range rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Item"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#PalletLabelScan">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#ScanMethod"/>
    <skos:definition xml:lang="en">A scan of the SSCC on the pallet label, matched to the shipping notice.</skos:definition>
    <skos:prefLabel xml:lang="en">pallet label scan</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#Record">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A record either looks at the world or copies another record (rule 12).</rdfs:comment>
    <rdfs:label xml:lang="en">Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#rule-7">
    <rdf:type rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Rule"/>
    <rdfs:comment xml:lang="en">An item is the pack, known by the code on the pack. Match on that code – never on the slot, the pallet label or the product name.</rdfs:comment>
    <rdfs:label xml:lang="en">Rule 7</rdfs:label>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Case"/>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Item"/>
    <s14:governs rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#Pick"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-fill-rate"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-otif"/>
    <s14:solves rdf:resource="https://kvinayakpai.github.io/domain-series/ontology/store-014#kpi-pick-accuracy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kvinayakpai.github.io/domain-series/ontology/store-014#TillStatus">
