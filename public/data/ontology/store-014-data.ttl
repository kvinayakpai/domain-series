<https://kvinayakpai.github.io/domain-series/ontology/store-014-data> a owl:Ontology ;
    rdfs:comment "Data-bound layer of the Store 014 ontology: which table and column each concept lives in, the code lists, measures, synonyms, derived flags and the things the records cannot define. Built from the CSV files by refusal-bench/ontology/build_bindings.py." ;
    owl:imports <https://kvinayakpai.github.io/domain-series/ontology/store-014> .

d:Window a owl:Class ;
    rdfs:label "Window" ;
    rdfs:comment "The dates a table covers." .

d:additive a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

