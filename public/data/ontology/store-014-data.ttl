d:Table a owl:Class ;
    rdfs:label "Table" ;
    rdfs:comment "A CSV file of Store 014 records." ;
    owl:disjointWith d:CodeValue,
        d:Column,
        d:UnrecordedConcept .

d:CodeValue a owl:Class ;
    rdfs:label "CodeValue" ;
    rdfs:comment "One value of a code column; it is the only value the column holds." .

d:Measure a owl:Class ;
    rdfs:label "Measure" ;
    rdfs:comment "A numeric column a question can total, average or rank." .

d:Column a owl:Class ;
    rdfs:label "Column" ;
    rdfs:comment "A column of a table." ;
    owl:disjointWith d:CodeValue .

