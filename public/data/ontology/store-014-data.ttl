d:recordKind a owl:DatatypeProperty .

d:skuColumn a owl:ObjectProperty .

d:sourceFile a owl:DatatypeProperty .

d:sql a owl:DatatypeProperty .

d:status a owl:DatatypeProperty .

d:unit a owl:DatatypeProperty .

d:unrecorded_absent_event a d:UnrecordedConcept ;
    rdfs:label "absent event" ;
    rdfs:comment "nothing records a shopper who did not buy, a product not on the shelf, a payment not retried" ;
    d:gap "not_happen" ;
    d:governedBy s14:rule-3 ;
    d:pattern "\\b(people|shoppers) visited\\b",
        "\\babandon",
        "\\basked (a staff member )?for\\b",
        "\\bbefore an item was scanned\\b",
        "\\bcancel",
        "\\bconversion\\b",
        "\\bentered .* and left\\b",
        "\\bfootfall\\b",
        "\\bgave up\\b",
        "\\bleft (the )?(store|shop)?\\s*without\\b",
        "\\bleft without\\b",
        "\\bleft\\b",
        "\\blost sales?\\b",
        "\\bnever\\b",
        "\\bnot accept",
        "\\bnot done\\b",
        "\\bpicked up\\b",
        "\\bput (it |them )?back\\b",
        "\\bqueue\\b",
        "\\brefus(ed|al)\\b",
        "\\bremov\\w*\\b.*\\bfrom a bill\\b",
        "\\bscheduled .* (were )?not\\b",
        "\\bstockouts? cost\\b",
        "\\bsubstitut",
        "\\btried to pay\\b",
        "\\btrue demand\\b",
        "\\bunpaid\\b",
        "\\bvisitors\\b",
        "\\bvoid",
        "\\bwalked out\\b",
        "\\bwere told there\\b",
        "\\bwithout (buying|a bill|paying)\\b",
        "\\bwould have been\\b" ;
    d:status "not_recorded" .

d:unrecorded_bank_side a d:UnrecordedConcept ;
    rdfs:label "bank side" ;
    rdfs:comment "the customer's bank side of a payment is not in the records" ;
    d:gap "who" ;
    d:governedBy s14:rule-9 ;
    d:pattern "\\bbank statement\\b",
        "\\bbank'?s? (view|side)\\b",
        "\\bcustomer's bank\\b" ;
    d:status "not_recorded" .

d:unrecorded_basket_value a d:StandIn ;
    rdfs:label "basket value" ;
    rdfs:comment "a bill's total is what one checkout cost: a stand-in for what a shopper spent, since no table links bills to a shopper" ;
    d:gap "who" ;
    d:pattern "\\b(average|mean|typical)\\b.*\\b(bill|basket)\\b.*\\b(value|size|amount)\\b",
        "\\b(bill|basket) (value|size)\\b" ;
    d:status "proxy" .

d:unrecorded_cause a d:UnrecordedConcept ;
    rdfs:label "cause" ;
    rdfs:comment "no table records the reason or cause of an event" ;
    d:gap "why" ;
    d:governedBy s14:rule-5 ;
    d:pattern "\\b(main|real|root) reason\\b",
        "\\bbecause of\\b",
        "\\bcause of\\b",
        "\\bwhat caused\\b",
        "\\bwhat explains\\b",
        "\\bwhat inside the till\\b",
        "^\\s*why\\b" ;
    d:status "not_recorded" .

d:unrecorded_external a d:UnrecordedConcept ;
    rdfs:label "external" ;
    rdfs:comment "nothing about competitors, weather, other stores, costs beyond one per product, or anything outside these 11 products" ;
    d:gap "else" ;
    d:pattern "\\b(by car|by bike|on foot)\\b",
        "\\b(home-delivery|online) orders?\\b",
        "\\b(rent|staff costs?|electricity)\\b",
        "\\b(weather|rainfall|rain|temperature)\\b",
        "\\badd to or drop\\b",
        "\\bcategory\\b.*\\bdoing\\b",
        "\\bcheap or expensive\\b",
        "\\bcompetitors?\\b",
        "\\bdiscount\\b",
        "\\belasticity\\b",
        "\\bfestival\\b",
        "\\bfor other stores\\b",
        "\\bheld for other stores\\b",
        "\\bhow much should\\b",
        "\\bhow should\\b",
        "\\bmark(ed)? ?down\\b",
        "\\bmarket share\\b",
        "\\bmaximi[sz]e profit\\b",
        "\\bnew product\\b",
        "\\bother stores?\\b",
        "\\bpayment terms\\b",
        "\\bper square foot\\b",
        "\\bprefer\\b",
        "\\bprofitable\\b",
        "\\bpromotion\\b",
        "\\bsatisf",
        "\\bshould store\\b",
        "\\bstolen\\b",
        "\\btheft\\b",
        "\\bwholesale price\\b",
        "\\bworking capital\\b" ;
    d:status "not_recorded" .

d:unrecorded_forecast_vs_demand a d:UnrecordedConcept ;
    rdfs:label "forecast vs demand" ;
    rdfs:comment "a forecast can only be scored against recorded sales, not demand" ;
    d:gap "not_happen" ;
    d:governedBy s14:rule-4 ;
    d:pattern "\\baccurate\\b.*\\bforecast\\b",
        "\\bforecast\\b.*\\b(accura|real|true|against)" ;
    d:status "not_recorded" .

d:unrecorded_list_margin a d:StandIn ;
    rdfs:label "list margin" ;
    rdfs:comment "selling price minus the single cost per product is a list margin, not a real margin" ;
    d:gap "else" ;
    d:pattern "\\bgross margin\\b",
        "\\bmargin\\b" ;
    d:status "proxy" .

d:unrecorded_person_identity a d:UnrecordedConcept ;
    rdfs:label "person identity" ;
    rdfs:comment "no table identifies a customer, cashier, supplier, driver or household" ;
    d:gap "who" ;
    d:pattern "\\b(cashier|staff member|delivery driver|supplier'?s?)\\b",
        "\\b(different|distinct|unique) (customers|shoppers|people)\\b",
        "\\b(repeat (rate|customers)|churn|lifetime value|age and gender|best customers)\\b",
        "\\b(shoppers?|customers?) .* more than once\\b",
        "\\bapproved\\b.*\\bwrite-?offs\\b",
        "\\bbuy .* every week\\b",
        "\\bhouseholds?\\b",
        "\\bmore than once\\b.*\\b(shoppers?|customers?)\\b",
        "\\bwhich (customers?|shoppers?|staff|cashiers?|suppliers?|households?|drivers?|delivery drivers?|segments?)\\b",
        "\\bwho\\b" ;
    d:status "not_recorded" .

d:unrecorded_restock_times a d:UnrecordedConcept ;
    rdfs:label "restock times" ;
    rdfs:comment "restock time on the shelf is not recorded (only receipts at the back door)" ;
    d:gap "not_happen" ;
    d:governedBy s14:rule-1 ;
    d:pattern "\\brestock",
        "\\bshelf was (restocked|empty for)\\b" ;
    d:status "not_recorded" .

d:unrecorded_shelf_hours a d:StandIn ;
    rdfs:label "shelf hours" ;
    rdfs:comment "shelf audits are 11:00 snapshots twice a week, not hours off the shelf" ;
    d:gap "not_happen" ;
    d:pattern "\\bat 3 pm\\b",
        "\\bhours\\b.*\\boff the shelf\\b",
        "\\bon the shelf at\\b",
        "\\bshelf look empty\\b" ;
    d:status "proxy" .

d:unrecorded_shopper_count a d:StandIn ;
    rdfs:label "shopper count" ;
    rdfs:comment "a bill is not a shopper: bills are the nearest stand-in" ;
    d:gap "who" ;
    d:pattern "\\bhow many (shoppers|customers|people)\\b(?! complaints)" ;
    d:status "proxy" .

