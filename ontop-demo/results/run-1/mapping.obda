[MappingDeclaration] @collection [[
mappingId	MAPPING-ID1
target		<http://example.org/store014/stock_counts/count_ts={count_ts};sku={sku}> a <http://example.org/store014/stock_counts> ; <http://example.org/store014/stock_counts#count_ts> {count_ts}^^xsd:dateTime ; <http://example.org/store014/stock_counts#sku> {sku}^^xsd:string ; <http://example.org/store014/stock_counts#book_before> {book_before}^^xsd:integer ; <http://example.org/store014/stock_counts#counted> {counted}^^xsd:integer ; <http://example.org/store014/stock_counts#adjustment> {adjustment}^^xsd:integer ; <http://example.org/store014/stock_counts#trigger> {trigger}^^xsd:string . 
