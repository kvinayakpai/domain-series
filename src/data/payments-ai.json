{
 "about": "What a data team can find in the payment records, scored against the answer key. Generated by scripts/analysis/payments.py from public/data/india-grocery.",
 "tests": {
  "generic": [
   {
    "name": "Till payments: bill and attempt are unique",
    "sql": "SELECT bill_id, attempt, count(*) AS n FROM till_payments GROUP BY ALL HAVING count(*) > 1",
    "failing_rows": 0,
    "pass": true,
    "examples": []
   },
   {
    "name": "Till payments: amounts positive, tender and status from the allowed lists",
    "sql": "SELECT * FROM till_payments WHERE amount_inr <= 0 OR tender NOT IN ('UPI', 'card', 'cash') OR till_status NOT IN ('approved', 'declined', 'failed', 'failed: no response')",
    "failing_rows": 0,
    "pass": true,
    "examples": []
   },
   {
    "name": "Till payments: every bill ends with exactly one approved payment",
    "sql": "SELECT bill_id, sum(CASE WHEN till_status = 'approved' THEN 1 ELSE 0 END) AS approved FROM till_payments GROUP BY bill_id HAVING approved <> 1",
    "failing_rows": 0,
    "pass": true,
    "examples": []
   },
   {
    "name": "Till payments: approved UPI payments carry an RRN; card and cash carry none",
    "sql": "SELECT * FROM till_payments WHERE (tender = 'UPI' AND till_status = 'approved' AND rrn IS NULL) OR (tender <> 'UPI' AND rrn IS NOT NULL)",
    "failing_rows": 0,
    "pass": true,
    "examples": []
   },
   {
    "name": "Provider report: RRN unique, amounts positive, status from the allowed list",
    "sql": "SELECT rrn, count(*) AS n FROM psp_upi GROUP BY rrn HAVING count(*) > 1 UNION ALL SELECT rrn, 1 FROM psp_upi WHERE amount_inr <= 0 OR status NOT IN ('success', 'failed', 'returned')",
    "failing_rows": 0,
    "pass": true,
    "examples": []
   },
   {
    "name": "Every UPI payment the till approved is a success in the provider's report, for the same amount",
    "sql": "SELECT t.* FROM till_payments t LEFT JOIN psp_upi p USING (rrn) WHERE t.tender = 'UPI' AND t.till_status = 'approved' AND (p.rrn IS NULL OR p.status <> 'success' OR p.amount_inr <> t.amount_inr)",
    "failing_rows": 0,
    "pass": true,
    "examples": []
   },
   {
    "name": "Settlements: each day's credits and gross are the previous day's successes",
    "sql": "WITH s AS (SELECT CAST(status_ts AS DATE) + 1 AS settlement_date, count(*) AS credits, round(sum(amount_inr), 2) AS gross FROM psp_upi WHERE status = 'success' GROUP BY ALL) SELECT x.settlement_date, x.upi_credits, s.credits, x.gross_inr, s.gross FROM settlements x LEFT JOIN s USING (settlement_date) WHERE x.upi_credits <> coalesce(s.credits, 0) OR abs(x.gross_inr - coalesce(s.gross, 0)) > 0.01",
    "failing_rows": 0,
    "pass": true,
    "examples": []
   },
   {
    "name": "Settlements: net is gross minus refunds and fees",
    "sql": "SELECT * FROM settlements WHERE abs(net_inr - (gross_inr - refunds_inr - mdr_inr)) > 0.01",
    "failing_rows": 0,
    "pass": true,
    "examples": []
   },
   {
    "name": "Refunds: each names a success in the provider's report, for the same amount",
    "sql": "SELECT r.* FROM refunds r LEFT JOIN psp_upi p USING (rrn) WHERE p.rrn IS NULL OR p.status <> 'success' OR p.amount_inr <> r.amount_inr",
    "failing_rows": 0,
    "pass": true,
    "examples": []
   },
   {
    "name": "Complaints: each names a bill in the till's records",
    "sql": "SELECT c.* FROM complaints c WHERE c.bill_id NOT IN (SELECT bill_id FROM till_payments)",
    "failing_rows": 0,
    "pass": true,
    "examples": []
   }
