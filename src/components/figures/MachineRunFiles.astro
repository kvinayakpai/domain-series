---
// The files from running NVIDIA's Auto-Ontology on Store 014 (public/data/auto-ontology/), for the bonus
// post. Written by auto-ontology-demo/summarize.py from one run of .github/workflows/auto-ontology-demo.yml.
import run from '../../data/auto-ontology-run.json';

const FILES: [string, string][] = [
  ['store014-draft-terms.json', `The ${run.term_count} terms the small open model drafted, each with its description and its tables`],
  ['store014-nemotron-draft-terms.json', `The ${run.with_nvidia_models.term_count} terms NVIDIA's own model drafted, each with its description and its tables`],
  ['store014-run.json', 'The runs: the models, how long each step took, the joins, the coverage checks and every answer, checked against the records'],
  ['store014-ontop-ontology.owl', 'The OWL file Ontop wrote from the 21 tables: one class for each table, no links'],
  ['store014-opus-ontology.ttl', 'The OWL ontology a fresh Claude Opus agent wrote from the database alone'],
  ['store014-opus-shapes.ttl', 'The SHACL shapes the same agent wrote'],
  ['store014-sonnet-ontology.ttl', 'The OWL ontology a fresh Claude Sonnet agent wrote from the database alone'],
  ['store014-sonnet-shapes.ttl', 'The SHACL shapes the same agent wrote'],
  ['store014-model-sweep.csv', 'Every run of the model test: the model, the pack, whether the extra line was added, how it was scored, and its answers on shoppers and lost sales'],
  ['store014-expert-instructions.txt', "What I gave it from this season's ontology: what each table is, the joins and the twelve rules, each with what it means for these tables"],
];
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/kvinayakpai/domain-series';
---
<aside class="run-files" aria-labelledby="run-files-title">
  <h2 id="run-files-title">The run</h2>
  <ul>
    {FILES.map(([f, what]) => (
      <li><a href={`${base}data/auto-ontology/${f}`}>{f}</a> <span>{what}</span></li>
    ))}
  </ul>
  <p>The workflow that ran it on GitHub's machine is in the series' <a href={`${repo}/tree/main/auto-ontology-demo`}>GitHub repository</a>, and <a href={`${repo}/tree/auto-ontology-demo/auto-ontology-demo/results`}>every run's results and logs</a> are kept there too.</p>
</aside>
<style>
  .run-files { margin: 2rem 0; padding: 1rem 1.1rem; background: var(--panel); border-left: 3px solid var(--ink); font-family: var(--font-sign); }
  .run-files h2 { font-size: 1.25rem; margin: 0 0 0.5rem; }
  .run-files ul { list-style: none; margin: 0; padding: 0; }
  .run-files li { padding: 0.3rem 0; border-top: 1px solid var(--rule); overflow-wrap: anywhere; }
  .run-files li a { font-weight: 600; }
  .run-files li span { display: block; color: var(--muted); font-size: 0.92rem; }
  .run-files p { margin: 0.7rem 0 0; font-size: 0.95rem; color: var(--muted); }
</style>
