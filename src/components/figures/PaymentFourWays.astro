---
import data from '../../data/payments.json';
const slow = data.story.slowdown.four_ways;
const june = data.story.june.four_ways;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const pct1 = (v: number) => `${(Math.round(v * 1000) / 10).toFixed(1)}%`;
const rows = [
  ['The till', 'till', 'UPI attempts the till marked approved'],
  ['The bank', 'bank', 'UPI attempts that ended as a credit to the store, late ones included'],
  ['Bills paid', 'bills_paid', 'Bills the store was paid for, one way or another'],
  ['Customers charged once', 'charged_once', 'Bills where no customer’s money moved twice'],
] as const;
---
<figure class="figure">
  <div class="table-wrap">
    <table class="four-ways pay-ways">
      <caption>Payment success at Store 014, measured four ways</caption>
      <thead><tr><th scope="col"><span class="visually-hidden">Measure</span></th><th scope="col">Sat 20 June, 18:20–19:50</th><th scope="col">All of June</th><th scope="col"><span class="visually-hidden">What it counts</span></th></tr></thead>
      <tbody>
        {rows.map(([a, key, how]) => <tr><th scope="row">{a}</th><td class="n">{pct(slow[key])}</td><td class="n small">{pct1(june[key])}</td><td class="how">{how}</td></tr>)}
      </tbody>
    </table>
  </div>
</figure>
