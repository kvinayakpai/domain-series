---
import data from '../../data/retail.json';
const rows = data.milk;
const best = rows.reduce((a, b) => (b.net_inr > a.net_inr ? b : a));
const signed = (f: number) => (Math.abs(f - 1) < 1e-9 ? 'As today' : `${f > 1 ? '+' : '−'}${Math.round(Math.abs(f - 1) * 100)}%`);
const inr = (v: number) => `${v < 0 ? '−' : ''}₹${Math.abs(Math.round(v)).toLocaleString('en-IN')}`;
---
<figure class="figure">
  <div class="table-wrap">
    <table class="milk-table">
      <caption>Toned milk at Store 014 in June, by standing order</caption>
      <thead>
        <tr><th scope="col">Standing order</th><th scope="col">Pouches thrown away</th><th scope="col">Pouches wanted, not found</th><th scope="col">Milk margin after waste</th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class={r.factor === 1 ? 'today' : r === best ? 'best' : undefined}>
            <th scope="row">{signed(r.factor)}</th>
            <td>{r.expired.toLocaleString('en-IN')}</td>
            <td>{r.lost.toLocaleString('en-IN')}</td>
            <td>{inr(r.net_inr)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption>Same customers in every row; only the order changes. Margin assumes ₹{rows[0].margin_per_unit_inr.toFixed(2)} earned per pouch sold and ₹{rows[0].cost_per_unit_inr.toFixed(2)} lost per pouch thrown away.</figcaption>
</figure>
