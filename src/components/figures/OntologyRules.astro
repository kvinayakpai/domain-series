---
// The twelve rules of the Store 014 ontology (src/data/ontology.json), each with the Season 1 KPIs it
// fixes, named as in src/lib/kpis.ts. One source for the rules, so the post and the map cannot drift.
import ontology from '../../data/ontology.json';
import { DOMAINS } from '../../lib/kpis';

const names = new Map(DOMAINS.flatMap((d) => d.kpis).map((k) => [k.id, k.name]));
const fixes = (ids: string[]) => {
  if (!ids.length) return 'All eighteen';
  const list = ids.map((id) => {
    const name = names.get(id);
    if (!name) throw new Error(`ontology rule names an unknown KPI: ${id}`);
    return name;
  });
  return list.map((n, i) => (i === 0 ? n : n.charAt(0).toLowerCase() + n.slice(1))).join(', ');
};
---
<ol class="ontology-rules">
  {ontology.rules.map((r) => (
    <li id={`rule-${r.n}`}>
      <span class="n">{r.n}</span>
      <p class="text">{r.text}</p>
      <p class="fixes"><span>Fixes:</span> {fixes(r.solves)}</p>
    </li>
  ))}
</ol>
<style>
  .ontology-rules { list-style: none; margin: 1.6rem 0; padding: 0; }
  .ontology-rules li { display: grid; grid-template-columns: 2.4rem 1fr; column-gap: 0.8rem; padding: 0.75rem 0; border-top: 1px solid var(--rule); }
  .ontology-rules li:last-child { border-bottom: 1px solid var(--rule); }
  .ontology-rules .n { grid-row: span 2; width: 2.1rem; height: 2.1rem; border-radius: 50%; background: var(--c-reality, #d4621c); color: #fff; font-family: var(--font-sign); font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .ontology-rules .text { margin: 0; }
  .ontology-rules .fixes { margin: 0.25rem 0 0; font-family: var(--font-sign); font-size: 0.95rem; color: var(--muted); }
  .ontology-rules .fixes span { font-weight: 650; color: var(--ink); }
</style>
