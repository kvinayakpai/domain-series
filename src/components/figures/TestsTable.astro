---
// The table behind the three "tests, two ways" figures (TestResults, LogisticsTests, PaymentsTests):
// the pipeline's data tests, which pass, above the tests that ask about the world, which do not.
// Each wrapper works out its rows from its own domain's JSON; this draws them. Styles: global.css (.tests).
interface Row { name: string; result: string; pass?: boolean; sql?: string }
interface Props { caption: string; generic: Row[]; world: Row[]; sql?: boolean }
const { caption, generic, world, sql = false } = Astro.props;
const passed = generic.filter((t) => t.pass).length;
---
<figure class="figure">
  <div class="table-wrap">
    <table class="ledger tests">
      <caption>{caption}</caption>
      <tbody>
        <tr class="group"><th colspan="2" scope="colgroup">The pipeline's data tests: {passed} of {generic.length} pass</th></tr>
        {generic.map((t) => (
          <tr>
            <th scope="row">{t.name}{sql && <details class="sql"><summary>SQL</summary><code>{t.sql}</code></details>}</th>
            <td class={t.pass ? 'ok' : 'no'}>{t.result}</td>
          </tr>
        ))}
        <tr class="group"><th colspan="2" scope="colgroup">Tests that ask about the world: 0 of {world.length} pass</th></tr>
        {world.map((t) => <tr><th scope="row">{t.name}</th><td class="no">{t.result}</td></tr>)}
      </tbody>
    </table>
  </div>
  <figcaption><slot /></figcaption>
</figure>
