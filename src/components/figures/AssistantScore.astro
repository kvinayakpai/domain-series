---
// Seven questions at the Monday review, answered by the same scripted assistant with the schema
// only and with a domain layer, each scored against the answer key.
import retailAi from '../../data/retail-ai.json';
import logisticsAi from '../../data/logistics-ai.json';
import paymentsAi from '../../data/payments-ai.json';

interface Props { post?: 'retail' | 'logistics' | 'payments' }
const { post = 'retail' } = Astro.props;
const a = ({ retail: retailAi, logistics: logisticsAi, payments: paymentsAi }[post]).assistant as unknown as typeof retailAi.assistant;
const mark = (ok: boolean) => (ok ? 'Right' : 'Wrong');
const words: Record<number, string> = { 6: 'Six', 7: 'Seven', 8: 'Eight' };
const when = { retail: 'on Monday 15 June', logistics: 'at the supplier review on Monday 29 June', payments: 'at the month-end review on Monday 29 June' }[post];
const caption = post === 'payments'
  ? 'The assistant is scripted so the run can be repeated: for each question it runs the queries the question calls for and composes the answer from what they return. With the schema only it has the till’s payments, the settlements, the refunds and the complaints. The domain layer adds definitions, three rules, the provider’s UPI report and two views built from them. The technical companion shows every query.'
  : post === 'logistics'
  ? 'The assistant is scripted so the run can be repeated: for each question it runs the queries the question calls for and composes the answer from what they return. With the schema only it has the shipments, shipping notice, goods receipts, orders, book stock, sales, forecasts and store counts. The domain layer adds definitions, three rules, the pick confirmations, pallets, warehouse adjustments and till lines, and five views built from them. The technical companion shows every query.'
  : 'The assistant is scripted so the run can be repeated: for each question it runs the queries the question calls for and composes the answer from what they return. With the schema only it has the sales, book stock, forecast and order tables. The domain layer adds definitions, the till lines, shelf audits, receipts and counts, and four views built from them. The technical companion shows every query.';
---
<figure class="figure">
  <div class="table-wrap">
    <table class="ledger assistant">
      <caption>{words[a.score.of] ?? a.score.of} questions {when}: {a.score.naive} of {a.score.of} right with the schema only, {a.score.domain} of {a.score.of} with the domain layer</caption>
      <thead>
        <tr><th scope="col">Question</th><th scope="col">Schema only</th><th scope="col">With the domain layer</th><th scope="col" class="why">Answer key</th></tr>
      </thead>
      <tbody>
        {a.questions.map((q) => (
          <tr>
            <th scope="row">{q.question}</th>
            <td><span class={q.naive.right ? 'ok' : 'no'}>{mark(q.naive.right)}</span> {q.naive.short}</td>
            <td><span class={q.domain.right ? 'ok' : 'no'}>{mark(q.domain.right)}</span> {q.domain.short}</td>
            <td class="why">{q.gold.short}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <details class="assistant-full">
    <summary>Every answer in full</summary>
    <dl>
      {a.questions.map((q) => (
        <div>
          <dt>{q.question}</dt>
          <dd><span>Schema only.</span> {q.naive.answer}</dd>
          <dd><span>With the domain layer.</span> {q.domain.answer}</dd>
        </div>
      ))}
    </dl>
  </details>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .assistant th[scope='row'] { font-weight: 450; }
  .assistant td { white-space: normal; }
  .assistant .ok, .assistant .no { font-weight: 650; margin-right: 0.25rem; }
  .assistant .ok { color: var(--ok); }
  .assistant .no { color: var(--correction); }
  .assistant-full { margin: 0.6rem 0 0.4rem; font-size: 0.95rem; }
  .assistant-full summary { cursor: pointer; font-family: var(--font-sign); font-weight: 600; color: var(--record); }
  .assistant-full dl { margin: 0.6rem 0 0; }
  .assistant-full div { padding: 0.5rem 0; border-top: 1px solid var(--rule); }
  .assistant-full dt { font-weight: 600; }
  .assistant-full dd { margin: 0.2rem 0 0; }
  .assistant-full dd span { font-family: var(--font-sign); color: var(--muted); }
</style>
