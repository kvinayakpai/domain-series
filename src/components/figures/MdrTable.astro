---
import data from '../../data/payments.json';
const m = data.story.mdr_on_june_bills;
const inr = (v: number) => `₹${Math.round(v).toLocaleString('en-IN')}`;
const inr2 = (v: number) => `₹${v.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const fee = (amount: number) => (amount > m.rule.above ? Math.min(m.rule.cap, amount * m.rule.rate) : 0);
const examples = [1999, 2000, 2001, 5000, 75000, 100000];
---
<figure class="figure">
  <div class="table-wrap">
    <table class="milk-table">
      <caption>The UPI merchant fee that began on 15 October 2026, on Store 014’s June bills</caption>
      <tbody>
        <tr><th scope="row">UPI bills in June</th><td>{m.upi_bills.toLocaleString('en-IN')}, worth {inr(m.upi_value_inr)}</td></tr>
        <tr><th scope="row">Of those, above ₹2,000</th><td>{m.bills_above.toLocaleString('en-IN')}, worth {inr(m.value_above_inr)}</td></tr>
        <tr class="best"><th scope="row">Fee at 0.4%, capped at ₹300</th><td>{inr(m.fee_inr)} a month</td></tr>
      </tbody>
    </table>
  </div>
  <div class="table-wrap">
    <table class="milk-table">
      <caption>The fee on one payment</caption>
      <thead><tr><th scope="col">Payment</th>{examples.map((a) => <th scope="col">{inr(a)}</th>)}</tr></thead>
      <tbody><tr><th scope="row">Fee</th>{examples.map((a) => <td>{inr2(fee(a))}</td>)}</tr></tbody>
    </table>
  </div>
  <figcaption>The fee applies to the whole payment once it is above ₹2,000, so a ₹2,001 basket costs the store ₹8.00 to accept and a ₹2,000 basket costs nothing. Merchants that receive up to ₹1 lakh a month through UPI QR are exempt; Store 014 is not.</figcaption>
</figure>
