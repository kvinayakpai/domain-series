---
// The Store 014 ontology's files (public/data/ontology/), for the technical detour: each file, what it
// holds and its size. Written by scripts/ontology/build.mjs and check.py; see the README.
import { statSync } from 'node:fs';
import path from 'node:path';

const FILES: [string, string][] = [
  ['store-014.ttl', 'The ontology: OWL in Turtle'],
  ['store-014.jsonld', 'The same ontology in JSON-LD'],
  ['store-014.rdf', 'The same ontology in RDF/XML'],
  ['store-014.nt', 'The same ontology in N-Triples'],
  ['store-014-shapes.ttl', 'The rules as SHACL shapes'],
  ['store-014-june.ttl', 'June’s three incidents, as a knowledge graph'],
  ['store-014-june-report.ttl', 'pySHACL’s report on the June graph'],
  ['store-014-queries.rq', 'The three SPARQL questions'],
  ['store-014.html', 'The documentation page pyLODE wrote'],
  ['store-014-graph.html', 'The ontology as an interactive graph, drawn by vis-network'],
];
const dir = path.join(process.cwd(), 'public', 'data', 'ontology');
const kb = (f: string) => `${Math.max(1, Math.round(statSync(path.join(dir, f)).size / 1024))} KB`;
const base = import.meta.env.BASE_URL;
---
<aside class="ontology-files" aria-labelledby="ontology-files-title">
  <h2 id="ontology-files-title">The files</h2>
  <ul>
    {FILES.map(([f, what]) => (
      <li><a href={`${base}data/ontology/${f}`}>{f}</a> <span>{what} · {kb(f)}</span></li>
    ))}
  </ul>
  <p>The scripts that write and check them are in the series’ <a href="https://github.com/kvinayakpai/domain-series/tree/main/scripts/ontology">GitHub repository</a>.</p>
</aside>
<style>
  .ontology-files { margin: 2rem 0; padding: 1rem 1.1rem; background: var(--panel); border-left: 3px solid var(--ink); font-family: var(--font-sign); }
  .ontology-files h2 { font-size: 1.25rem; margin: 0 0 0.5rem; }
  .ontology-files ul { list-style: none; margin: 0; padding: 0; }
  .ontology-files li { padding: 0.3rem 0; border-top: 1px solid var(--rule); overflow-wrap: anywhere; }
  .ontology-files li a { font-weight: 600; }
  .ontology-files li span { display: block; color: var(--muted); font-size: 0.92rem; }
  .ontology-files p { margin: 0.7rem 0 0; font-size: 0.95rem; color: var(--muted); }
</style>
