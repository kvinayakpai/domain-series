---
// On-shelf availability of 5 kg atta in June under five definitions: three a data team can compute
// from the records, two only the answer key can give.
import ai from '../../data/retail-ai.json';

const o = ai.availability;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const fromRecords = [
  ['On the books', pct(o.on_the_books), 'Open hours with at least one bag in the book stock'],
  ['Shelf audits', pct(o.shelf_audits), `${o.audits} audits, Tuesdays and Fridays at 11:00`],
  ['Books and tills', pct(o.books_and_tills), 'Open hours with stock on the books, outside the gaps the tills show'],
];
const fromTruth = [
  ['On the shelf', pct(o.true_open_hours), 'Open hours with at least one bag on the shelf'],
  ['Demand served', pct(o.true_demand_served), 'Bags shoppers wanted that they found'],
];
---
<figure class="figure">
  <table class="four-ways five-ways">
    <caption>On-shelf availability of 5 kg atta in June, five ways</caption>
    <tbody>
      <tr class="group"><th colspan="3" scope="colgroup">From the store's records</th></tr>
      {fromRecords.map(([a, b, c]) => <tr><th scope="row">{a}</th><td class="n">{b}</td><td class="how">{c}</td></tr>)}
      <tr class="group"><th colspan="3" scope="colgroup">From the answer key</th></tr>
      {fromTruth.map(([a, b, c]) => <tr><th scope="row">{a}</th><td class="n">{b}</td><td class="how">{c}</td></tr>)}
    </tbody>
  </table>
</figure>

<style>
  .five-ways tr.group th { font-size: 0.85rem; color: var(--muted); font-weight: 500; padding-top: 1rem; border-top: 0; }
</style>
