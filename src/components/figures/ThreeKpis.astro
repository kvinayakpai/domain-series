---
// The three KPIs the series is built around, each measured twice at Store 014, with how long the
// gap took to find. Used by the opener; the numbers come from src/lib/kpis.ts.
import { getCollection } from 'astro:content';
import { heroKpi } from '../../lib/kpis';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts')).filter((p) => heroKpi(p.data.slug)).sort((a, b) => a.data.order - b.data.order);
const rows = posts.map((p) => ({ post: p, kpi: heroKpi(p.data.slug)!.kpi }));
---
<figure class="figure">
  <div class="table-wrap">
    <table class="ledger three-kpis">
      <caption>Three KPIs at Store 014, measured twice</caption>
      <thead>
        <tr>
          <th scope="col">KPI</th>
          <th scope="col">Reported</th>
          <th scope="col">Observed</th>
          <th scope="col" class="found">Time to find the gap</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ post, kpi }) => (
          <tr>
            <th scope="row">
              <a href={`${base}${post.data.slug}/`}>{kpi.name}</a>
              <span class="where">{kpi.hero!.scope}</span>
            </th>
            <td><span class="v rec">{kpi.reported!.value}</span> <span class="how">{kpi.reported!.how}</span></td>
            <td><span class="v gap">{kpi.observed!.value}</span> <span class="how">{kpi.observed!.how}</span></td>
            <td class="found">{kpi.hero!.found}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption>Reported: the value Store 014’s systems compute. Observed: the value the world’s answer key gives for the same thing. Each row links to the post about it.</figcaption>
</figure>

<style>
  .three-kpis th[scope='row'] { font-weight: 600; min-width: 10rem; }
  .three-kpis th[scope='row'] a { color: var(--ink); }
  .three-kpis .where { display: block; font-weight: 400; color: var(--muted); font-size: 0.85rem; }
  .three-kpis td { vertical-align: top; min-width: 7rem; }
  .three-kpis .v { display: block; font-size: 1.45rem; font-weight: 650; font-stretch: 85%; line-height: 1.15; width: max-content; }
  .three-kpis .v.rec { font-family: var(--font-record); font-weight: 400; font-size: 1.25rem; }
  .three-kpis .how { display: block; color: var(--muted); font-size: 0.85rem; line-height: 1.35; margin-top: 0.15rem; }
  .three-kpis td.found { font-size: 0.9rem; line-height: 1.4; min-width: 12rem; }
  .three-kpis thead th { color: var(--muted); font-weight: 500; font-size: 0.88rem; }
  @media (max-width: 540px) { .three-kpis td.found { min-width: 9rem; } }
</style>
