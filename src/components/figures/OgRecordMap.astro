---
// The Oil & Gas season's eighteen KPIs on one map: the record each KPI reads, and the record that
// saw its March problem. In every row the two were never joined. HTML only, so it reflows on a phone.
import { OG_KPIS, ogKpiNumber } from '../../lib/oil-gas';

const MAP: Record<string, [string, string]> = {
  'og-production': ['an allocation that shares out the field’s meter by each well’s last test', 'the pump’s own data, every day'],
  'og-production-efficiency': ['a plan set in November, net of expected losses', 'the wells’ latest tests'],
  'og-deferment': ['a log of stops, with the causes known at the time', 'the pump’s data, and the teardown after the pull'],
  'og-decline': ['the meter’s monthly totals', 'the hours each well ran, and the pump’s data'],
  'og-esp-run-life': ['the average of the pumps that failed', 'each well’s teardown history'],
  'og-lifting-cost': ['this month’s spend', 'the maintenance backlog'],
  'og-throughput': ['the pipeline’s meters', 'the field’s water reading'],
  'og-loss-gain': ['each day’s gap against a band', 'the sign of the gap, day after day'],
  'og-tank-stock': ['the book against the gauge', 'a manual dip'],
  'og-methane': ['emission factors', 'the gas balance, and a satellite'],
  'og-ship-waiting': ['the port’s schedule', 'the ship’s notice of readiness'],
  'og-utilization': ['the crude unit’s meter', 'the crude slate against the plan'],
  'og-margin': ['the price screens', 'the premiums and freight paid'],
  'og-diesel-yield': ['the product meters', 'the VGO tank'],
  'og-energy-intensity': ['energy a barrel', 'a model of what the same runs should use'],
  'og-availability': ['the downtime log', 'the trip log, by equipment tag'],
  'og-turnaround': ['the schedule', 'the deferral list'],
  'og-process-safety': ['the release log', 'overdue inspections and Tier 3 challenges'],
};
const PLACES = [
  { part: 'well', name: 'The well: Field 014' },
  { part: 'pipe', name: 'The pipe & ship' },
  { part: 'refinery', name: 'The refinery: Refinery 014' },
];
const missing = OG_KPIS.filter((k) => !MAP[k.id]);
if (missing.length) throw new Error(`OgRecordMap: no row for ${missing.map((k) => k.id).join(', ')}`);
---
<figure class="figure">
  <div class="table-wrap">
    <table class="ledger og-map">
      <caption>Who saw what: the record each KPI reads, and the record that saw its problem in March 2026</caption>
      <thead><tr><th scope="col">KPI</th><th scope="col">Reads</th><th scope="col">Saw the problem</th></tr></thead>
      {PLACES.map((p) => (
        <tbody>
          <tr class="group"><th colspan="3" scope="colgroup">{p.name}</th></tr>
          {OG_KPIS.filter((k) => k.part === p.part).map((k) => (
            <tr class="kpi-row">
              <th scope="row"><span class="kn">{ogKpiNumber(k.id)}</span> {k.name}</th>
              <td class="reads">{MAP[k.id][0]}</td>
              <td class="saw">{MAP[k.id][1]}</td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
  <figcaption>In every row the two records were never joined. The KPIs read copies, plans, averages and ratios. The records that saw the problems sit closest to the equipment, and no report put them beside the KPI they could have corrected.</figcaption>
</figure>

<style>
  .og-map tr.group th { font-size: 0.9rem; color: var(--muted); font-weight: 600; padding-top: 1rem; }
  .og-map tbody th[scope='row'] { font-weight: 600; min-width: 9rem; }
  .og-map .kn { display: inline-block; min-width: 1.4rem; font-size: 0.78rem; font-weight: 600; color: var(--muted); }
  .og-map td { font-size: 0.93rem; line-height: 1.4; }
  .og-map td.reads { color: var(--record); }
  .og-map td.saw { color: var(--ink); font-weight: 550; }
  @media (max-width: 540px) {
    .og-map thead { display: none; }
    .og-map tr.kpi-row { display: grid; grid-template-columns: 1fr; padding: 0.4rem 0; border-bottom: 1px solid var(--rule); }
    .og-map tr.kpi-row th, .og-map tr.kpi-row td { border-bottom: 0; padding: 0.05rem 0; }
    .og-map td.reads::before { content: 'Reads: '; color: var(--muted); font-weight: 400; }
    .og-map td.saw::before { content: 'Saw it: '; color: var(--muted); font-weight: 400; }
  }
</style>
