---
// Static figure: 5 kg atta, each day of June. What the tills recorded, what shoppers wanted, the
// store's forecast, and the forecast trained on unconstrained demand. Bands mark the censored
// hours: runs the gap detector flagged, and hours with no stock on the books. Two drawings for
// wide and narrow screens.
import ai from '../../data/retail-ai.json';

const series = ai.forecast.series_5kg;
const n = series.length;
const grid = ai.detector.grid['ATTA-WW-5KG'];
// Runs of censored open hours, as [first, last] hour indices (15 open hours a day).
const censored = [...grid.censored['0.001']].map((c, i) => c === '1' || grid.no_stock[i] === '1');
const runs: [number, number][] = [];
censored.forEach((on, i) => {
  if (on && (i === 0 || !censored[i - 1])) runs.push([i, i]);
  else if (on) runs[runs.length - 1][1] = i;
});
const yMax = Math.ceil(Math.max(...series.map((d) => Math.max(d.recorded, d.true, d.naive, d.aware))) / 10) * 10;
const yTicks = Array.from({ length: yMax / 10 + 1 }, (_, k) => k * 10);
const label = (iso: string) => new Date(`${iso.slice(0, 10)}T12:00:00+05:30`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });

function geometry(W: number, H: number, tickEvery: number) {
  const m = { l: 30, r: 8, t: 10, b: 26 };
  const iw = W - m.l - m.r, ih = H - m.t - m.b;
  const band = iw / n;
  const x = (i: number) => i * band + band / 2;
  const xPos = (pos: number) => pos * band;
  const y = (v: number) => ih - (v / yMax) * ih;
  const bw = Math.max(3, band * 0.56);
  const bars = series.map((d, i) => {
    const top = y(d.recorded);
    const r = Math.min(2, bw / 2, ih - top);
    const x0 = x(i) - bw / 2;
    return d.recorded > 0
      ? `M${x0.toFixed(1)},${ih}V${(top + r).toFixed(1)}Q${x0.toFixed(1)},${top.toFixed(1)} ${(x0 + r).toFixed(1)},${top.toFixed(1)}H${(x0 + bw - r).toFixed(1)}Q${(x0 + bw).toFixed(1)},${top.toFixed(1)} ${(x0 + bw).toFixed(1)},${(top + r).toFixed(1)}V${ih}Z`
      : '';
  });
  const line = (key: 'true' | 'naive' | 'aware') =>
    series.map((d, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(d[key]).toFixed(1)}`).join('');
  // An open hour i sits at day i / 15 along the axis: open hours run 07:00 to 22:00.
  const bands = runs.map(([a, b]) => ({ x: xPos(a / 15), w: xPos((b + 1) / 15) - xPos(a / 15) }));
  const ticks = series.map((d, i) => ({ x: x(i), text: label(d.date), show: i % tickEvery === 0 }));
  return { W, H, m, iw, ih, y, bars, bands, ticks, lines: { true: line('true'), naive: line('naive'), aware: line('aware') } };
}
const views = [
  { cls: 'fig-wide', g: geometry(640, 270, 7) },
  { cls: 'fig-narrow', g: geometry(340, 250, 7) },
];
const end = ai.forecast.by_sku['ATTA-WW-5KG'].month_end;
const avgWanted = end.true_june_mean;
---
<figure class="figure">
  {views.map(({ cls, g }) => (
    <div class={`chart ${cls}`}>
      <svg viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-label="5 kg atta in June 2026, day by day: bags the tills recorded, bags shoppers wanted, the store's forecast and the forecast trained on unconstrained demand">
        <g transform={`translate(${g.m.l},${g.m.t})`}>
          {g.bands.map((b) => <rect class="band" x={b.x} y="0" width={b.w} height={g.ih} />)}
          {yTicks.map((v) => (
            <g>
              <line class="grid" x1="0" x2={g.iw} y1={g.y(v)} y2={g.y(v)} />
              <text class="tick" x="-6" y={g.y(v) + 4} text-anchor="end">{v}</text>
            </g>
          ))}
          {g.bars.map((d) => d && <path d={d} style="fill: var(--c-record); opacity: 0.38" />)}
          <line class="axis" x1="0" x2={g.iw} y1={g.ih} y2={g.ih} />
          {g.ticks.filter((t) => t.show).map((t) => <text class="tick" x={t.x} y={g.ih + 18} text-anchor="middle">{t.text}</text>)}
          <path class="line" d={g.lines.true} style="stroke: var(--c-reality); stroke-width: 1.5; opacity: 0.75" />
          <line class="ref" x1="0" x2={g.iw} y1={g.y(avgWanted)} y2={g.y(avgWanted)} style="stroke-dasharray: 2 3" />
          <text class="tick" x={g.iw} y={g.y(avgWanted) - 5} text-anchor="end">wanted, June average {avgWanted}</text>
          <path class="line" d={g.lines.naive} style="stroke: var(--c-record); stroke-dasharray: 5 3" />
          <path class="line" d={g.lines.aware} style="stroke: var(--c-misplaced)" />
        </g>
      </svg>
    </div>
  ))}
  <ul class="chart-legend">
    <li><span class="key-rect" style="background: var(--c-record); opacity: 0.38"></span>Bags the tills recorded</li>
    <li><span class="key-line" style="background: var(--c-reality)"></span>Bags shoppers wanted</li>
    <li><span class="key-ref"></span>Their June average</li>
    <li><span class="key-line dashed" style="color: var(--c-record)"></span>Store's forecast</li>
    <li><span class="key-line" style="background: var(--c-misplaced)"></span>Forecast on unconstrained demand</li>
    <li><span class="key-band"></span>Censored hours</li>
  </ul>
  <figcaption>5 kg atta at Store 014, each day of June, with the forecast in use that day. The store's forecast, the 28-day mean of recorded sales, learns the gaps as falling demand: made on 28 June, it is {end.naive} bags a day. Filling the censored hours (the gaps the tills show, and the hours with no stock on the books) with the sales the detector expected keeps it at {end.aware}. Shoppers wanted {avgWanted} a day.</figcaption>
  <details class="table-view">
    <summary>Show the numbers</summary>
    <div class="table-wrap">
      <table>
        <caption>Bags per day, and the forecast made the night before</caption>
        <thead><tr><th scope="col">Day</th><th scope="col">Recorded</th><th scope="col">Wanted</th><th scope="col">Store's forecast</th><th scope="col">On unconstrained demand</th></tr></thead>
        <tbody>{series.map((d) => <tr><th scope="row">{label(d.date)}</th><td>{d.recorded}</td><td>{d.true}</td><td>{d.naive}</td><td>{d.aware}</td></tr>)}</tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .fig-narrow { display: none; }
  @media (max-width: 540px) {
    .fig-wide { display: none; }
    .fig-narrow { display: block; }
  }
</style>
