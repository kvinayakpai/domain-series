---
// The questions Store 014's data cannot answer, by group, from src/data/store014-gaps.json.
import gaps from '../../data/store014-gaps.json';
---
<div class="gaps-list">
  {gaps.list.map((g, gi) => (
    <details>
      <summary><strong>{gi + 1}. {g.group}</strong> <span>({g.items.length} questions)</span></summary>
      <div class="table-wrap">
        <table class="ledger">
          <thead><tr><th class="n">#</th><th>Question</th><th>Why the data cannot answer it</th><th>What would answer it</th></tr></thead>
          <tbody>
            {g.items.map((q) => (
              <tr>
                <td class="n">{q.n}</td>
                <td>{q.test ? '★ ' : ''}{q.question}{q.kind === 'P' ? <em> (rough proxy only)</em> : ''}</td>
                <td>{q.why_not}</td>
                <td>{q.would_answer_it}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  ))}
</div>
<style>
  .gaps-list { margin: 1.2rem 0; font-family: var(--font-sign); }
  .gaps-list details { border-top: 1px solid var(--rule); padding: 0.4rem 0; }
  .gaps-list summary { cursor: pointer; padding: 0.35rem 0; }
  .gaps-list summary span { color: var(--muted); }
  .gaps-list em { color: var(--muted); font-style: normal; font-size: 0.92em; }
</style>
