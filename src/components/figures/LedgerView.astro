---
// What June's three failures cost, and what the store's ledger showed of them (finale.json).
import f from '../../data/finale.json';

const inr0 = (v: number) => `₹${Math.round(v).toLocaleString('en-IN')}`;
const curly = (s: string) => s.replace(/'/g, '’');
const [shelf, truck, money] = f.incidents;
const rows = [
  { i: shelf, cost: `${shelf.cost}, ${inr0(shelf.cost_inr)} at the shelf price` },
  { i: truck, cost: `${truck.cost}, ${inr0(truck.cost_inr)} at the shelf price` },
  { i: money, cost: `${money.cost}, from ${money.harm.split(' on ')[1]}` },
];
---
<figure class="figure">
  <div class="table-wrap">
    <table class="ledger shows">
      <caption>June’s three failures: what they cost, and what the ledger showed</caption>
      <thead><tr><th scope="col">Failure</th><th scope="col">What it cost</th><th scope="col">What the ledger showed</th></tr></thead>
      <tbody>
        {rows.map(({ i, cost }) => (
          <tr><th scope="row">{i.title} <span class="when">{i.when}</span></th><td>{cost}</td><td>{curly(i.ledger)}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption>Bags at the shelf price customers would have paid. The stock corrections at cost, as the store books them.</figcaption>
</figure>

<style>
  .shows th[scope='row'] { min-width: 10rem; font-weight: 550; }
  .shows .when { display: block; font-weight: 400; color: var(--muted); font-size: 0.85rem; }
  .shows td { white-space: normal; min-width: 9rem; }
</style>
