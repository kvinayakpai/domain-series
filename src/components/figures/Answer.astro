---
// One answer from the assistant, quoted as it was produced, with what it was given.
interface Props { text: string; who: string; caption?: string; grounded?: boolean }
const { text, who, caption, grounded = false } = Astro.props;
---
<figure class={`answer${grounded ? ' grounded' : ''}`}>
  <p class="who">{who}</p>
  <blockquote><p>{text}</p></blockquote>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .answer { margin: 1.4rem 0; padding: 0.9rem 1.1rem; background: var(--panel); border-left: 3px solid var(--record); }
  .answer.grounded { border-left-color: var(--c-misplaced); }
  .answer .who { margin: 0 0 0.35rem; font-family: var(--font-sign); font-size: 0.9rem; color: var(--muted); font-weight: 600; }
  .answer blockquote { margin: 0; }
  .answer blockquote p { margin: 0; font-family: var(--font-sign); font-size: 1.04rem; line-height: 1.5; color: var(--ink); }
  .answer figcaption { margin-top: 0.5rem; font-family: var(--font-sign); font-size: 0.86rem; color: var(--muted); }
</style>
