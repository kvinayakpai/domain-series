---
// Video player and media links for a post. Captions are burned into the videos
// (they are made to be watched muted); the .srt files are for platforms that take one.
interface Props { kind: 'links' | 'walkthrough' | 'short' }
const { kind } = Astro.props;
const media = `${import.meta.env.BASE_URL}media/`;
---
{kind === 'links' && (
  <aside class="media-links" aria-label="Watch or present this post">
    <p>Prefer to watch or present it?</p>
    <ul>
      <li><a href={`${media}retail-short.mp4`}>One-minute video</a>, vertical, captioned</li>
      <li><a href="#walkthrough">Two-minute walkthrough</a> of the post and the demo</li>
      <li><a href={`${media}retail-slides.pdf`}>Slides as a PDF</a>, 14 pages, with the same numbers</li>
    </ul>
  </aside>
)}
{kind === 'walkthrough' && (
  <figure class="figure video" id="walkthrough">
    <video controls preload="none" playsinline width="1920" height="1080" poster={`${media}retail-walkthrough-poster.jpg`}>
      <source src={`${media}retail-walkthrough.mp4`} type="video/mp4" />
      <a href={`${media}retail-walkthrough.mp4`}>Download the walkthrough video</a>
    </video>
    <figcaption>A two-minute walkthrough of this post and the demo, captioned. <a href={`${media}retail-walkthrough.srt`}>Captions as SRT</a>.</figcaption>
  </figure>
)}
{kind === 'short' && (
  <figure class="figure video vertical">
    <video controls preload="none" playsinline width="1080" height="1920" poster={`${media}retail-short-poster.jpg`}>
      <source src={`${media}retail-short.mp4`} type="video/mp4" />
      <a href={`${media}retail-short.mp4`}>Download the video</a>
    </video>
    <figcaption>The one-minute version, captioned. <a href={`${media}retail-short.srt`}>Captions as SRT</a>.</figcaption>
  </figure>
)}

<style>
  .media-links { border-left: 3px solid var(--record); background: var(--panel); padding: 0.7rem 1rem; margin: 1.6rem 0; font-family: var(--font-sign); }
  .media-links p { margin: 0 0 0.3rem; font-weight: 600; }
  .media-links ul { margin: 0; padding-left: 1.1rem; }
  .media-links li { margin: 0.15rem 0; }
  .video video { display: block; width: 100%; height: auto; background: var(--ink); border-radius: 4px; }
  .video.vertical video { max-width: 22rem; }
</style>
