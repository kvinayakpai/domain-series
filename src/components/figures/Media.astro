---
// Video player and media links for a post. Captions are burned into the videos
// (they are made to be watched muted); the .srt files are for platforms that take one.
interface Props {
  kind: 'links' | 'walkthrough' | 'short';
  post?: string; // file prefix in public/media, e.g. "retail"
  shortLabel?: string;
  walkLabel?: string;
  pages?: number; // slides in the PDF
}
const { kind, post = 'retail', shortLabel = 'One-minute video', walkLabel = 'Two-minute walkthrough', pages = 14 } = Astro.props;
const media = `${import.meta.env.BASE_URL}media/`;
const walkWords = walkLabel.charAt(0).toLowerCase() + walkLabel.slice(1);
---
{kind === 'links' && (
  <aside class="media-links" aria-label="Watch or present this post">
    <p>Prefer to watch or present it?</p>
    <ul>
      <li><a href={`${media}${post}-short.mp4`}>{shortLabel}</a>, vertical, captioned</li>
      <li><a href="#walkthrough">{walkLabel}</a> of the post and the demo</li>
      <li><a href={`${media}${post}-slides.pdf`}>Slides as a PDF</a>, {pages} pages, with the same numbers</li>
    </ul>
  </aside>
)}
{kind === 'walkthrough' && (
  <figure class="figure video" id="walkthrough">
    <video controls preload="none" playsinline width="1920" height="1080" poster={`${media}${post}-walkthrough-poster.jpg`}>
      <source src={`${media}${post}-walkthrough.mp4`} type="video/mp4" />
      <a href={`${media}${post}-walkthrough.mp4`}>Download the walkthrough video</a>
    </video>
    <figcaption>A {walkWords} of this post and the demo, captioned. <a href={`${media}${post}-walkthrough.srt`}>Captions as SRT</a>.</figcaption>
  </figure>
)}
{kind === 'short' && (
  <figure class="figure video vertical">
    <video controls preload="none" playsinline width="1080" height="1920" poster={`${media}${post}-short-poster.jpg`}>
      <source src={`${media}${post}-short.mp4`} type="video/mp4" />
      <a href={`${media}${post}-short.mp4`}>Download the video</a>
    </video>
    <figcaption>The short version, captioned. <a href={`${media}${post}-short.srt`}>Captions as SRT</a>.</figcaption>
  </figure>
)}

<style>
  .media-links { border-left: 3px solid var(--record); background: var(--panel); padding: 0.7rem 1rem; margin: 1.6rem 0; font-family: var(--font-sign); }
  .media-links p { margin: 0 0 0.3rem; font-weight: 600; }
  .media-links ul { margin: 0; padding-left: 1.1rem; }
  .media-links li { margin: 0.15rem 0; }
  .video video { display: block; width: 100%; height: auto; background: var(--ink); border-radius: 4px; }
  .video.vertical video { max-width: 22rem; }
</style>
