---
// KPIs measured twice at Store 014: as its systems report them and as the world's answer key observed
// them. Each name links to the KPI's own post, or to its entry on the KPI page until the post exists.
// Numbers come from src/lib/kpis.ts.
import { getCollection } from 'astro:content';
import { DOMAINS } from '../../lib/kpis';

interface Props { ids: string[] }
const base = import.meta.env.BASE_URL;
const posts = await getCollection('posts', (p) => !!p.data.kpi && !p.data.draft);
const all = DOMAINS.flatMap((d) => d.kpis);
const rows = Astro.props.ids.map((id) => {
  const k = all.find((x) => x.id === id);
  if (!k?.reported || !k.observed) throw new Error(`KpiPairs: ${id} is not measured twice`);
  const post = posts.find((p) => p.data.kpi === id);
  return { k, reported: k.reported, observed: k.observed, href: post ? `${base}${post.data.slug}/` : `${base}kpis/#${id}` };
});
---
<figure class="figure kpi-pairs">
  <ul>
    {rows.map(({ k, reported, observed, href }) => (
      <li>
        <p class="kp-name"><a href={href}>{k.name}</a>{k.hero && <span>{k.hero.scope}</span>}</p>
        <dl>
          <div><dt>Reported</dt><dd><span class="kp-v rec">{reported.value}</span><span class="kp-how">{reported.how}</span></dd></div>
          <div><dt>Observed</dt><dd><span class="kp-v gap">{observed.value}</span><span class="kp-how">{observed.how}</span></dd></div>
        </dl>
      </li>
    ))}
  </ul>
  <figcaption>Reported: what Store 014’s systems computed. Observed: the same thing in the simulation’s answer key.</figcaption>
</figure>

<style>
  .kpi-pairs ul { list-style: none; margin: 0 0 0.6rem; padding: 0; }
  .kpi-pairs li { border-top: 1px solid var(--rule); padding: 0.75rem 0 0.8rem; }
  .kpi-pairs li:last-child { border-bottom: 1px solid var(--rule); }
  .kp-name { margin: 0 0 0.45rem; font-family: var(--font-sign); line-height: 1.3; }
  .kp-name a { font-weight: 650; font-size: 1.1rem; }
  .kp-name span { display: block; color: var(--muted); font-size: 0.9rem; }
  .kpi-pairs dl { display: grid; grid-template-columns: 1fr 1fr; gap: 0.2rem 1rem; margin: 0; }
  .kpi-pairs dl div { display: grid; align-content: start; gap: 0.1rem; }
  .kpi-pairs dt { font-family: var(--font-sign); font-size: 0.85rem; color: var(--muted); }
  .kpi-pairs dd { margin: 0; display: grid; gap: 0.15rem; justify-items: start; }
  .kp-v { font-family: var(--font-sign); font-size: 1.7rem; font-weight: 650; font-stretch: 85%; line-height: 1.1; }
  .kp-v.rec { font-family: var(--font-record); font-weight: 400; font-size: 1.45rem; }
  .kp-how { font-family: var(--font-sign); color: var(--muted); font-size: 0.88rem; line-height: 1.3; }
  .kpi-pairs figcaption { font-family: var(--font-sign); font-size: 0.88rem; color: var(--muted); }
</style>
