---
import data from '../../data/logistics.json';
const k = data.scenarios.find((x) => x.key === 'none|label')!.kpis;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const rows = [
  ['The DC’s report', 'dc_report', 'Deliveries dispatched on schedule with every line shipped as ordered, by its pick confirmations'],
  ['The scorecard, per line', 'by_line', 'Order lines that arrived in the 06:00–06:30 slot and in full, by the store’s goods receipt'],
  ['The scorecard, per delivery', 'scorecard', 'Deliveries in the slot with every line in full, by the goods receipt'],
  ['What the shelf got', 'at_the_shelf', 'Deliveries in the slot with every case what the store ordered'],
] as const;
---
<figure class="figure">
  <table class="four-ways">
    <caption>On-time-in-full for the DC’s 25 deliveries to Store 014 in June, measured four ways</caption>
    <tbody>
      {rows.map(([a, key, how]) => <tr><th scope="row">{a}</th><td class="n">{pct(k.otif[key])}</td><td class="how">{how} ({k.good[key]} of {k.out_of[key]})</td></tr>)}
    </tbody>
  </table>
</figure>
