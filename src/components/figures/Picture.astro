---
// A full-width picture with alt text, for posts that open, summarise or conclude with an image.
// Images live in public/images/<post>/ and are served from the site base path. A dense picture, like
// the full ontology map, can be opened at full size (zoom). A tall whiteboard, drawn narrow so its words
// stay readable on a phone, keeps that width on a wide screen too (narrow).
interface Props { src: string; alt: string; width?: number; height?: number; zoom?: boolean; narrow?: boolean }
const { src, alt, width = 1200, height = 675, zoom = false, narrow = false } = Astro.props;
const url = `${import.meta.env.BASE_URL}${src.replace(/^\//, '')}`;
---
<figure class:list={['figure', 'picture', { narrow }]}>
  {zoom ? (
    <a class="zoom" href={url} aria-label="Open the picture at full size">
      <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    </a>
  ) : (
    <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  )}
  {zoom && <figcaption>Tap or click the picture to open it at full size.</figcaption>}
</figure>
<style>
  .picture { margin: 2rem 0; }
  .picture.narrow { max-width: 30rem; margin-left: auto; margin-right: auto; }
  .picture img { display: block; width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--rule); }
  .picture .zoom { display: block; cursor: zoom-in; }
  .picture figcaption { font-family: var(--font-sign); font-size: 0.9rem; color: var(--muted); margin-top: 0.4rem; }
</style>
