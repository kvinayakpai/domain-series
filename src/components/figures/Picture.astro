---
// A full-width picture with alt text, for posts that open, summarise or conclude with an image.
// Images live in public/images/<post>/ and are served from the site base path.
interface Props { src: string; alt: string; width?: number; height?: number }
const { src, alt, width = 1200, height = 675 } = Astro.props;
const url = `${import.meta.env.BASE_URL}${src.replace(/^\//, '')}`;
---
<figure class="figure picture">
  <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
</figure>
<style>
  .picture { margin: 2rem 0; }
  .picture img { display: block; width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--rule); }
</style>
