---
// The domain layer the assistant is given, written out as the YAML a team would keep beside the schema.
import retailAi from '../../data/retail-ai.json';
import logisticsAi from '../../data/logistics-ai.json';

interface Props { post?: 'retail' | 'logistics' }
const { post = 'retail' } = Astro.props;
const ai = (post === 'logistics' ? logisticsAi : retailAi) as typeof retailAi;
const d = ai.assistant.domain_layer;
const words: Record<number, string> = { 3: 'three', 4: 'four', 5: 'five' };
const observes = post === 'logistics' ? 'the records that observe the goods independently of the pick' : 'the tables that observe the shelf';
const quote = (s: string) => `"${s.replace(/"/g, '\\"')}"`;
const yaml = [
  post === 'logistics' ? '# Given to the assistant with the shipping schema' : '# Given to the assistant with the warehouse schema',
  'definitions:',
  ...Object.entries(d.definitions).map(([k, v]) => `  ${k.replace(/ /g, '_')}: ${quote(v as string)}`),
  'rules:',
  ...d.rules.map((r: string) => `  - ${quote(r)}`),
  'views:',
  ...Object.entries(d.views).map(([k, v]) => `  ${k}: ${quote(v as string)}`),
  `tables_added: [${d.tables_added.join(', ')}]`,
].join('\n');
---
<figure class="figure">
  <pre class="yaml"><code>{yaml}</code></pre>
  <figcaption>The domain layer: definitions, {words[d.rules.length] ?? d.rules.length} rules, {words[Object.keys(d.views).length] ?? Object.keys(d.views).length} views and {observes}. The schema-only assistant has {ai.assistant.schema_only_tables.join(', ')}.</figcaption>
</figure>

<style>
  .yaml { margin: 0; padding: 0.9rem 1rem; background: var(--panel); border-left: 3px solid var(--c-misplaced); overflow-x: auto; font-family: var(--font-record); font-size: 0.8rem; line-height: 1.55; white-space: pre-wrap; }
</style>
