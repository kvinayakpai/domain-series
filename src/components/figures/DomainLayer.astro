---
// The domain layer the assistant is given, written out as the YAML a team would keep beside the schema.
import ai from '../../data/retail-ai.json';

const d = ai.assistant.domain_layer;
const quote = (s: string) => `"${s.replace(/"/g, '\\"')}"`;
const yaml = [
  '# Given to the assistant with the warehouse schema',
  'definitions:',
  ...Object.entries(d.definitions).map(([k, v]) => `  ${k.replace(/ /g, '_')}: ${quote(v as string)}`),
  'rules:',
  ...d.rules.map((r: string) => `  - ${quote(r)}`),
  'views:',
  ...Object.entries(d.views).map(([k, v]) => `  ${k}: ${quote(v as string)}`),
  `tables_added: [${d.tables_added.join(', ')}]`,
].join('\n');
---
<figure class="figure">
  <pre class="yaml"><code>{yaml}</code></pre>
  <figcaption>The domain layer: definitions, three rules, four views and the tables that observe the shelf. The schema-only assistant has {ai.assistant.schema_only_tables.join(', ')}.</figcaption>
</figure>

<style>
  .yaml { margin: 0; padding: 0.9rem 1rem; background: var(--panel); border-left: 3px solid var(--c-misplaced); overflow-x: auto; font-family: var(--font-record); font-size: 0.8rem; line-height: 1.55; white-space: pre-wrap; }
</style>
