---
import data from '../../data/retail.json';
const o = data.scenarios.find((x) => x.key === 'off|today')!.kpis.osa;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const rows = [
  ['The system showed stock', pct(o.system_in_stock), 'Open hours with at least one bag on the books'],
  ['Shelf audits found it', pct(o.shelf_audit), `${o.audits.length} audits, Tuesdays and Fridays at 11:00`],
  ['It was on the shelf', pct(o.open_hours_on_shelf), 'Open hours with at least one bag on the shelf'],
  ['Customers found it', pct(o.demand_served), 'Bags customers wanted that were on the shelf'],
];
---
<figure class="figure">
  <table class="four-ways">
    <caption>On-shelf availability of 5 kg atta in June, measured four ways</caption>
    <tbody>
      {rows.map(([a, b, c]) => <tr><th scope="row">{a}</th><td class="n">{b}</td><td class="how">{c}</td></tr>)}
    </tbody>
  </table>
</figure>
