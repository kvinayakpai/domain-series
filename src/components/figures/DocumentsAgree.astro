---
// Static figure: every record of the 22 June pallet line, and what was on the pallet.
import data from '../../data/logistics.json';
const st = data.story;
const pick = st.picks.find((p) => p.sku === st.line.sku)!;
const pallet = st.pallets.find((p) => p.sscc === st.line.sscc)!;
const t = (iso: string) => iso.slice(11, 16);
const oneKg = data.one_kg;
const rows = [
  ['Pick confirmation', `${t(pick.pick_ts)}, slot ${pick.slot}: ${pick.cases_confirmed} cases of atta 5 kg, confirmed by ${pick.confirmed_by}`],
  ['Shipping notice', `Line ${st.line.line}: ${st.line.cases} cases of atta 5 kg, ${st.line.units} bags, GTIN ${st.line.gtin}`],
  ['Pallet label', `SSCC ${st.line.sscc}, ${pallet.cases} cases, ${pallet.notice_kg} kg by the notice`],
  ['Trip log', `Left ${t(st.shipment.dispatched_ts)}, arrived ${t(st.shipment.arrived_ts)}, slot ${t(st.shipment.slot_start)}–${t(st.shipment.slot_end)}: on time`],
  ['Goods receipt', `${st.receipt.grn_id}, ${t(st.receipt.received_ts)}: ${st.receipt.units_booked} bags of atta 5 kg booked`],
];
---
<figure class="figure">
  <div class="table-wrap">
    <table class="docs">
      <caption>Line {st.line.line} of the 22 June delivery, in every record that mentions it</caption>
      <tbody>
        {rows.map(([a, b]) => <tr><th scope="row">{a}</th><td class="rec">{b}</td></tr>)}
        <tr class="truth"><th scope="row">On the pallet</th><td><span class="gap">{st.actual.units_actual / oneKg.case_units} bales of atta 1 kg, {st.actual.units_actual} packs</span></td></tr>
      </tbody>
    </table>
  </div>
  <figcaption>Every record is generated from the first one, so they agree with each other and with nothing else. The scan at 03:00 confirmed the slot the picker stood at, not the bales the picker took.</figcaption>
</figure>
