---
// The rule to give an AI agent before it acts on a KPI. The text lives in src/lib/kpis.ts, so the
// KPI post, the KPI page and domain-kpis.yaml say the same thing.
import { DOMAINS } from '../lib/kpis';

interface Props { kpi: string }
const k = DOMAINS.flatMap((d) => d.kpis).find((x) => x.id === Astro.props.kpi);
if (!k) throw new Error(`AgentRule: no KPI ${Astro.props.kpi}`);
---
<aside class="agent-rule" aria-label="The rule to give an AI agent">
  <p class="agent-rule-head">Tell your agent</p>
  <p class="agent-rule-text">{k.agent}</p>
</aside>

<style>
  .agent-rule { margin: 1.4rem 0 1.6rem; padding: 0.8rem 1rem 0.85rem; border-left: 3px solid var(--record); background: var(--panel); }
  .agent-rule p { margin: 0; }
  .agent-rule-head { font-family: var(--font-sign); font-size: 0.92rem; color: var(--muted); font-weight: 600; }
  .agent-rule-text { font-family: var(--font-sign); font-size: 1.2rem; line-height: 1.35; font-weight: 550; margin-top: 0.2rem !important; }
</style>
