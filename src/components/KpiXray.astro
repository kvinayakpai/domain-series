---
// The KPI a post is built around, measured twice: as Store 014's systems report it, and as the
// answer key observed it. With what the gap cost and how long it took to find. Shown in the
// post's header; the full library is at /kpis/.
import { heroKpi, KPI_COUNT } from '../lib/kpis';

interface Props { post: string }
const x = heroKpi(Astro.props.post);
const base = import.meta.env.BASE_URL;
const k = x?.kpi;
---
{k && k.hero && k.reported && k.observed && (
  <aside class="xray" aria-label={`The KPI behind this post: ${k.name}`}>
    <p class="xray-head"><strong>{k.name}</strong> <span>{k.hero.scope}</span></p>
    <dl class="xray-pair">
      <div>
        <dt>Reported</dt>
        <dd><span class="xray-num rec">{k.reported.value}</span> <span class="xray-how">{k.reported.how}</span></dd>
      </div>
      <div>
        <dt>Observed</dt>
        <dd><span class="xray-num gap">{k.observed.value}</span> <span class="xray-how">{k.observed.how}</span></dd>
      </div>
    </dl>
    <p class="xray-line"><span>The gap cost</span> {k.hero.cost}.</p>
    <p class="xray-line"><span>Found</span> {k.hero.found}</p>
    <p class="xray-more"><a href={`${base}kpis/#${k.id}`}>This KPI and {KPI_COUNT - 1} more, x-rayed</a></p>
  </aside>
)}
