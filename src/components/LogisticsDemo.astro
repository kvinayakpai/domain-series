---
import data from '../data/logistics.json';
const base = import.meta.env.BASE_URL;
const files = `${base}data/india-grocery/`;
const story = data.story;
const personas = [
  ['dc', 'DC shift supervisor'],
  ['transport', 'Transport manager'],
  ['receiving', 'Receiving clerk'],
  ['scorecard', 'OTIF scorecard'],
  ['stock', 'Stock controller'],
  ['truth', 'What actually happened'],
];
---
<section id="logistics" class="demo" data-logistics-demo aria-labelledby="logistics-title">
  <header class="demo-head">
    <h2 id="logistics-title">Logistics: the delivery</h2>
    <dl class="pair">
      <div><dt>The record says</dt><dd class="rec">Delivered on time, in full.</dd></div>
      <div><dt>What actually happened</dt><dd><span class="gap">One pallet line held the wrong pack size.</span></dd></div>
    </dl>
    <p class="demo-intro">The warehouse truck to Store 014 on Monday 22 June 2026, and the week after it. Pick whose view you want, then change how the warehouse checks its picks and how the store receives, and watch every view update.</p>
  </header>

  <form class="controls" aria-label="What the warehouse and the store change" onsubmit="return false">
    <fieldset>
      <legend>At the warehouse</legend>
      <div class="seg">
        <label><input type="radio" name="dc" value="none" checked /><span>As today</span></label>
        <label><input type="radio" name="dc" value="pick_scan" /><span>Scan every case at pick</span></label>
        <label><input type="radio" name="dc" value="check_weigh" /><span>Weigh every pallet</span></label>
      </div>
      <p class="hint">Today a picker confirms each line by scanning the slot’s label. A case scan checks the item itself. A dispatch scale compares each pallet with the weight its shipping notice implies.</p>
    </fieldset>
    <fieldset>
      <legend>At the store</legend>
      <div class="seg">
        <label><input type="radio" name="receiving" value="label" checked /><span>As today: scan the pallet label</span></label>
        <label><input type="radio" name="receiving" value="case_scan" /><span>Scan every case</span></label>
      </div>
      <p class="hint">Scanning the pallet label books whatever the shipping notice says. Scanning every case books what actually arrived and reports any difference to the warehouse.</p>
    </fieldset>
  </form>

  <div class="outcome" data-outcome aria-live="polite"></div>

  <div class="personas">
    <div class="tabs" role="tablist" aria-label="Whose view">
      {personas.map(([key, label], i) => (
        <button type="button" role="tab" id={`lg-tab-${key}`} data-persona={key} aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls="lg-panel" tabindex={i === 0 ? 0 : -1} class={key === 'truth' ? 'tab-truth' : undefined}>{label}</button>
      ))}
    </div>
    <div id="lg-panel" class="panel" role="tabpanel" data-panel tabindex="0">
      <noscript>
        <p>This demo needs JavaScript. In short: on 22 June the warehouse shipped {story.line.cases} cases of 1 kg atta labelled as 5 kg. The store booked {story.line.units} bags of 5 kg it did not have, so its 5 kg shelf stood empty for {story.episode?.empty_open_hours} open hours while every record called the delivery on time and in full. The records are linked below.</p>
      </noscript>
    </div>
  </div>

  <details class="drawer">
    <summary>The records behind it</summary>
    <div class="drawer-bar">
      <div class="seg buttons" role="group" aria-label="Which records">
        <button type="button" data-rec="deliveries" aria-pressed="true">Deliveries in June</button>
        <button type="button" data-rec="notice" aria-pressed="false">Shipping notices, 20–28 June</button>
        <button type="button" data-rec="picks" aria-pressed="false">Pick confirmations, 20–28 June</button>
        <button type="button" data-rec="adjustments" aria-pressed="false">Stock corrections</button>
      </div>
      <label class="reveal"><input type="checkbox" name="lg-reveal" /> Show what the records hide</label>
    </div>
    <div data-records></div>
    <p class="downloads">
      Download June’s shipping records as CSV:
      <a href={`${files}shipments-june.csv`} download>trucks</a>,
      <a href={`${files}dc-pick-confirmations-june.csv`} download>pick confirmations</a>,
      <a href={`${files}shipping-notice-lines-june.csv`} download>shipping notices</a>,
      <a href={`${files}pallets-june.csv`} download>pallet labels</a>,
      <a href={`${files}goods-receipts-june.csv`} download>goods receipts</a>,
      <a href={`${files}dc-stock-adjustments-june.csv`} download>warehouse corrections</a>,
      <a href={`${files}stock-counts-june.csv`} download>store counts</a>,
      <a href={`${files}store-orders-june.csv`} download>store orders</a>,
      <a href={`${files}products.csv`} download>products</a>.
      <a href={`${base}data/#logistics-records`}>What each file holds, and four exercises</a>.
      <a href={`${files}answer-key-logistics.json`} download>Answer key</a> (spoilers).
    </p>
  </details>
</section>

<script>
  import { mountLogisticsDemo } from '../lib/logistics-demo';
  const root = document.querySelector<HTMLElement>('[data-logistics-demo]');
  if (root) mountLogisticsDemo(root);
</script>
