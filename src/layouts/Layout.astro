---
interface Props { title: string; description?: string; }
const { title, description = 'One domain, one blog post, one end-to-end demo.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Domain series</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href={`${base}styles.css`} />
  </head>
  <body>
    <header class="site">
      <a href={base}>Domain series</a>
      <nav aria-label="Posts">
        <a href={`${base}retail/`}>Retail</a>
        <a href={`${base}logistics/`}>Logistics</a>
        <a href={`${base}payments/`}>Payments</a>
        <a href={`${base}demo/`}>Demo</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site">Synthetic data, fixed seed 42. Modelled on the Domain Explorer project patterns; not read from its tables.</footer>
  </body>
</html>
