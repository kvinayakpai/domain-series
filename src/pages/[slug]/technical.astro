---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const companions = await getCollection('companions');
  const posts = await getCollection('posts');
  return companions.map((companion) => ({
    params: { slug: companion.data.post },
    props: { companion, post: posts.find((p) => p.data.slug === companion.data.post)! },
  }));
}

const { companion, post } = Astro.props;
const { Content } = await render(companion);
const base = import.meta.env.BASE_URL;
const c = companion.data;
const shown = c.updatedDate ?? c.pubDate;
const fmt = (x: Date) => x.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });
const repo = 'kvinayakpai/domain-series';
---
<Layout title={c.title} description={c.description} image={c.image ?? post.data.image} type="article" published={c.pubDate}>
  <article class="companion">
    <header>
      <p class="kicker"><a href={`${base}${post.data.slug}/`}>{post.data.title}</a>: the technical companion</p>
      <h1>{c.title}</h1>
      <p class="byline">{post.data.author}, <time datetime={shown.toISOString().slice(0, 10)}>{c.updatedDate ? `updated ${fmt(shown)}` : fmt(shown)}</time></p>
      {c.notebook && (
        <ul class="notebook-links" aria-label="The notebook">
          <li><a href={`https://colab.research.google.com/github/${repo}/blob/main/public/${c.notebook}`}>Open the notebook in Colab</a></li>
          <li><a href={`https://github.com/${repo}/blob/main/public/${c.notebook}`}>View it on GitHub</a></li>
          <li><a href={`${base}${c.notebook}`} download>Download it</a></li>
        </ul>
      )}
    </header>
    <Content />
    <p>Back to <a href={`${base}${post.data.slug}/`}>{post.data.title}</a>, or <a href={`${base}demo/#${post.data.demoAnchor}`}>try it in the demo</a>.</p>
  </article>
</Layout>

<style>
  .kicker { font-family: var(--font-sign); color: var(--muted); font-size: 1rem; margin: 0 0 0.3rem; }
  .notebook-links { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; padding: 0; margin: 1rem 0 0; font-family: var(--font-sign); }
</style>
