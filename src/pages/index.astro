---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<Layout title="Home">
  <h1>Why domain matters</h1>
  <p class="hook">A series on how the same operational problem looks different to each person who owns part of it, told through three domains and one shared demo.</p>
  {posts.map((p) => (
    <a class="card" href={`${base}${p.data.slug}/`}>
      <strong>{p.data.order}. {p.data.title}</strong><br />
      <span>{p.data.description}</span>
    </a>
  ))}
  <a class="card" href={`${base}demo/`}><strong>Demo: One grocery basket, three domains</strong><br /><span>Follow one dairy item through shelf, movement and money.</span></a>
</Layout>
