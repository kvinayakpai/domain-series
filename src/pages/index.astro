---
// The series' contents: the opener, then the parts in reading order, each post with the line that
// says what actually happened.
import Layout, { SITE_NAME } from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { DOMAINS } from '../lib/kpis';
import { PARTS } from '../lib/series';

const all = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
const opener = all.find((p) => p.data.part === 'start');
const kpiOf = (id?: string) => DOMAINS.flatMap((d) => d.kpis).find((k) => k.id === id);
const blurb: Record<string, string> = {
  shelf: 'Retail. One item, 5 kg atta, goes missing from its shelf while the books say it is there.',
  truck: 'Logistics. A truck arrives on time with one pallet line of the wrong pack size.',
  money: 'Payments. On a slow Saturday evening, the tills call paid UPI payments failed.',
  together: 'Who saw what across all three, and two practical posts for data and AI teams.',
};
const parts = PARTS.filter((p) => p.id !== 'start').map((p) => ({ ...p, posts: all.filter((x) => x.data.part === p.id) }));
const count = all.length;
const base = import.meta.env.BASE_URL;
---
<Layout title={SITE_NAME} wide>
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Why domain matters</h1>
    <p class="lede">Every KPI is computed from a record, and every record has a blind spot. AI agents now act on those numbers. This series shows, one KPI at a time, what a record cannot see and how a data or AI team can catch it.</p>
    {opener && (
      <p class="start"><a href={`${base}${opener.data.slug}/`}>Start here: {opener.data.title}</a> <span>Three numbers from one supermarket, each computed correctly and each wrong about what it measures.</span></p>
    )}
  </section>

  <section class="contents" aria-labelledby="contents-title">
    <h2 id="contents-title">The series, in {count} short posts</h2>
    <p class="contents-note">Every post is about one idea, and every claim in it links to its evidence. The numbers come from Store 014, a supermarket in Bengaluru simulated hour by hour through June 2026, so each one can be checked against what really happened.</p>
    {parts.map((p) => (
      <section class="part" aria-labelledby={`part-${p.id}`}>
        <h3 id={`part-${p.id}`}>{p.name}</h3>
        <p class="part-blurb">{blurb[p.id]}</p>
        <ol class="part-posts">
          {p.posts.map((x) => {
            const k = kpiOf(x.data.kpi);
            return (
              <li class={k ? 'is-kpi' : 'is-story'}>
                <a href={`${base}${x.data.slug}/`}>{k ? k.name : x.data.title}</a>
                <span class="note">{x.data.reality}</span>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </section>

  <section class="how" aria-labelledby="how-title">
    <h2 id="how-title">Take it further</h2>
    <p><a href={`${base}kpis/`}>All eighteen KPIs, x-rayed</a> on one page, with the rule an AI agent needs for each. For practitioners, technical companions for <a href={`${base}retail/technical/`}>retail</a>, <a href={`${base}logistics/technical/`}>logistics</a> and <a href={`${base}payments/technical/`}>payments</a> have the SQL, the models and a notebook. <a href={`${base}kit/`}>The kit</a> has the tests as a dbt project, the domain layers as YAML and a benchmark with an answer key, and <a href={`${base}demo/`}>the demo</a> replays the month.</p>
  </section>
</Layout>

<style>
  .hero { max-width: 56rem; }
  .hero h1 { font-size: clamp(2.6rem, 8vw, 4.6rem); }
  .hero .lede { max-width: 40rem; }
  .start { max-width: 40rem; margin-top: 1.4rem; padding: 0.8rem 1rem; background: var(--panel); border-left: 3px solid var(--ink); font-family: var(--font-sign); }
  .start a { font-weight: 650; font-size: 1.15rem; }
  .start span { display: block; color: var(--muted); font-size: 0.95rem; margin-top: 0.2rem; }
  .contents { max-width: 44rem; margin-top: 3rem; }
  .contents-note { color: var(--muted); font-family: var(--font-sign); font-size: 1rem; }
  .part { margin-top: 2rem; }
  .part h3 { font-size: 1.45rem; font-stretch: 85%; margin: 0; }
  .part-blurb { margin: 0.25rem 0 0.6rem; color: var(--muted); font-family: var(--font-sign); }
  .part-posts { list-style: none; margin: 0; padding: 0; font-family: var(--font-sign); counter-reset: post; }
  .part-posts li { padding: 0.55rem 0; border-top: 1px solid var(--rule); }
  .part-posts li:last-child { border-bottom: 1px solid var(--rule); }
  .part-posts a { display: inline-block; font-weight: 600; font-size: 1.08rem; }
  .part-posts .is-story a { font-weight: 700; color: var(--ink); }
  .part-posts .note { display: block; color: var(--muted); font-size: 0.95rem; line-height: 1.4; margin-top: 0.1rem; }
  .how { max-width: 40rem; margin-top: 3rem; }
</style>
