---
// Season 2's contents: "Ontology is all about domain knowledge". The opener, then the nineteen posts
// of the plan by part (src/lib/ontology.ts), each linked once it is out. A problem post lists the
// Season 1 KPIs it solves, named as in src/lib/kpis.ts.
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ON_POSTS, ON_SEASON, ON_POST_COUNT } from '../../lib/ontology';
import { PARTS } from '../../lib/series';
import { DOMAINS } from '../../lib/kpis';

const posts = (await getCollection('posts', (p) => !p.data.draft && PARTS.find((x) => x.id === p.data.part)?.season === 'ontology'))
  .sort((a, b) => a.data.order - b.data.order);
const postFor = (slug: string) => posts.find((p) => p.data.slug === slug);
const opener = postFor(ON_POSTS[0].slug);
const kpiName = new Map(DOMAINS.flatMap((d) => d.kpis).map((k) => [k.id, k.name]));
const solves = (ids: string[]) => ids.map((id, i) => {
  const name = kpiName.get(id);
  if (!name) throw new Error(`the Season 2 plan names an unknown KPI: ${id}`);
  return i === 0 ? name : name.charAt(0).toLowerCase() + name.slice(1);
}).join(', ');
const blurb: Record<string, string> = {
  'on-start': 'What an ontology is, why AI agents need one now, and the full Store 014 ontology on one page.',
  'on-detour': 'For practitioners: the same ontology in open standards. Skip it if you are not technical – the season reads fine without it.',
  'on-retail': 'Season 1’s shelf problems, and the part of the ontology that solves each.',
  'on-logistics': 'Season 1’s truck problems, from the warehouse slot to the store’s door.',
  'on-payments': 'Season 1’s money problems, from the till to the bank and back.',
  'on-together': 'What a machine could draft from the tables, and how to start a domain ontology of your own.',
};
const parts = PARTS.filter((p) => p.season === 'ontology').map((p) => ({ ...p, plan: ON_POSTS.filter((x) => x.part === p.id) }));
const out = ON_POSTS.filter((x) => postFor(x.slug)).length;
const base = import.meta.env.BASE_URL;
---
<Layout title={ON_SEASON.name} description="Season 2 of Why Domain Matters: what an ontology is, why AI agents need one, the full ontology of Store 014 on one page, and how it solves each Season 1 problem in retail, logistics and payments." image="og/ontology.png" wide>
  <section class="hero" aria-labelledby="hero-title">
    <p class="season">Why domain matters · season two</p>
    <h1 id="hero-title">{ON_SEASON.name}</h1>
    <p class="lede">Season 1 found eighteen KPIs at Store 014 that were computed correctly and still missed what happened. Every fix was a piece of domain knowledge. This season writes that knowledge down as one ontology – the things, the links and the rules – and then shows how it solves each Season 1 problem in retail, logistics and payments.</p>
    {opener && (
      <p class="opener"><a href={`${base}${opener.data.slug}/`}>Start here: {opener.data.title}</a> <span>{ON_POSTS[0].note}</span></p>
    )}
  </section>

  <section class="contents" aria-labelledby="contents-title">
    <h2 id="contents-title">Sixteen short posts</h2>
    <p class="contents-note">{out === ON_POST_COUNT ? `All ${ON_POST_COUNT} posts are out.` : `${out} of ${ON_POST_COUNT} out so far.`} Three posts to start, a technical detour, ten that take the Season 1 problems one part at a time, and five to finish: what a machine would draft, how well AI models used the knowledge, the whole experiment, who else sells an ontology, and how to begin. The numbers come from Store 014, the simulated supermarket of Season 1.</p>
    {parts.map((p) => (
      <section class="on-part" aria-labelledby={`on-part-${p.id}`}>
        <h3 id={`on-part-${p.id}`}>{p.name}</h3>
        <p class="part-blurb">{blurb[p.id]}</p>
        <ol class="on-posts">
          {p.plan.map((x) => {
            const post = postFor(x.slug);
            const note = x.solves ? `Solves: ${solves(x.solves)}` : x.note;
            return (
              <li class={post ? 'is-out' : 'is-coming'}>
                {post ? <a href={`${base}${post.data.slug}/`}>{x.title}</a> : <span class="coming">{x.title}</span>}
                <span class="note">{note}{post ? '' : ' · Coming soon'}</span>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </section>
</Layout>

<style>
  .hero { max-width: 56rem; }
  .season { font-family: var(--font-sign); font-weight: 600; color: var(--muted); margin: 0; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.9rem; }
  .hero h1 { font-size: clamp(2.4rem, 7vw, 4.2rem); margin-top: 0.3rem; }
  .hero .lede { max-width: 40rem; }
  .opener { max-width: 40rem; margin-top: 1.4rem; padding: 0.8rem 1rem; background: var(--panel); border-left: 3px solid var(--ink); font-family: var(--font-sign); }
  .opener a { font-weight: 650; font-size: 1.15rem; }
  .opener span { display: block; color: var(--muted); font-size: 0.95rem; margin-top: 0.2rem; }
  .contents { max-width: 44rem; margin-top: 3rem; }
  .contents-note { color: var(--muted); font-family: var(--font-sign); font-size: 1rem; }
  .on-part { margin-top: 2rem; }
  .on-part h3 { font-size: 1.45rem; font-stretch: 85%; margin: 0; }
  .part-blurb { margin: 0.25rem 0 0.6rem; color: var(--muted); font-family: var(--font-sign); }
  .on-posts { list-style: none; margin: 0; padding: 0; font-family: var(--font-sign); }
  .on-posts li { padding: 0.55rem 0; border-top: 1px solid var(--rule); }
  .on-posts li:last-child { border-bottom: 1px solid var(--rule); }
  .on-posts a { display: inline-block; font-weight: 600; font-size: 1.08rem; }
  .on-posts .coming { font-weight: 600; font-size: 1.08rem; color: var(--muted); }
  .on-posts .note { display: block; color: var(--muted); font-size: 0.95rem; line-height: 1.4; margin-top: 0.1rem; }
</style>
