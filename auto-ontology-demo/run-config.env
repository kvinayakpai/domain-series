# Which models the next run uses. Changing this file starts a run.
#   nvidia: NVIDIA's own hosted models, as Auto-Ontology ships. Needs the NVIDIA_API_KEY
#           repository secret (a free key from build.nvidia.com).
#   ollama: small open models on GitHub's own machine, through model_adapter.py. No key.
#   gemini: Google's Gemini models through their OpenAI-compatible endpoint. Needs the
#           GEMINI_API_KEY_DOMAIN_SERIES repository secret. Embeddings and reranking are always
#           local (as with EMBEDDINGS=local below), whatever EMBEDDINGS says.
MODELS=gemini
# With MODELS=gemini: the model for drafting and answering, and a lighter one for the simple calls.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_NON_REASONING_MODEL=gemini-3.8-flash
# With MODELS=nvidia, where embeddings and reranking come from:
#   nvidia: NVIDIA's hosted embedding and reranking models, as Auto-Ontology ships.
#   local:  the same local embedding model (served by Ollama, padded to 2048) and cosine
#           reranking that the Ollama runs used, so only the chat model differs from them.
#           Run 9 used NVIDIA's embedding model and never got past ingest: the endpoint
#           answered 503 and 504 for half an hour.
EMBEDDINGS=local
