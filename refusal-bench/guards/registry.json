 "person_columns": [],
 "terms": [
  {
   "id": "person_identity",
   "gap": "who",
   "status": "not_recorded",
   "note": "no table identifies a customer, cashier, supplier, driver or household",
   "patterns": [
    "\\bwho\\b",
    "\\bwhich (customers?|shoppers?|staff|cashiers?|suppliers?|households?|drivers?|delivery drivers?|segments?)\\b",
    "\\b(different|distinct|unique) (customers|shoppers|people)\\b",
    "\\b(repeat (rate|customers)|churn|lifetime value|age and gender|best customers)\\b",
    "\\bhouseholds?\\b",
    "\\b(cashier|staff member|delivery driver|supplier'?s?)\\b",
    "\\bbuy .* every week\\b",
    "\\bmore than once\\b.*\\b(shoppers?|customers?)\\b",
    "\\b(shoppers?|customers?) .* more than once\\b",
    "\\bapproved\\b.*\\bwrite-?offs\\b"
   ]
  },
  {
   "id": "shopper_count",
   "gap": "who",
   "status": "proxy",
   "note": "a bill is not a shopper: bills are the nearest stand-in",
   "patterns": [
    "\\bhow many (shoppers|customers|people)\\b(?! complaints)"
   ]
  },
  {
   "id": "cause",
   "gap": "why",
   "status": "not_recorded",
   "note": "no table records the reason or cause of an event",
   "patterns": [
    "^\\s*why\\b",
    "\\bwhat caused\\b",
    "\\b(main|real|root) reason\\b",
    "\\bcause of\\b",
    "\\bwhat inside the till\\b",
    "\\bbecause of\\b",
    "\\bwhat explains\\b"
   ]
  },
  {
   "id": "absent_event",
   "gap": "not_happen",
   "status": "not_recorded",
   "note": "nothing records a shopper who did not buy, a product not on the shelf, a payment not retried",
   "patterns": [
    "\\babandon",
    "\\bvoid",
    "\\bcancel",
    "\\brefus(ed|al)\\b",
    "\\bwalked out\\b",
    "\\bleft (the )?(store|shop)?\\s*without\\b",
    "\\bleft without\\b",
    "\\bwithout (buying|a bill|paying)\\b",
    "\\bput (it |them )?back\\b",
    "\\bwould have been\\b",
    "\\btrue demand\\b",
    "\\blost sales?\\b",
    "\\bnever\\b",
    "\\bnot done\\b",
    "\\bnot accept",
    "\\bwere told there\\b",
    "\\bentered .* and left\\b",
    "\\bgave up\\b",
    "\\bsubstitut",
    "\\bremov\\w*\\b.*\\bfrom a bill\\b",
    "\\bbefore an item was scanned\\b",
    "\\bstockouts? cost\\b",
    "\\basked (a staff member )?for\\b",
    "\\btried to pay\\b",
    "\\bscheduled .* (were )?not\\b",
    "\\bconversion\\b",
    "\\bfootfall\\b",
    "\\b(people|shoppers) visited\\b",
    "\\bvisitors\\b",
    "\\bpicked up\\b",
    "\\bqueue\\b",
    "\\bunpaid\\b",
    "\\bleft\\b"
   ]
  },
  {
   "id": "external",
   "gap": "else",
   "status": "not_recorded",
   "note": "nothing about competitors, weather, other stores, costs beyond one per product, or anything outside these 11 products",
   "patterns": [
    "\\bcompetitors?\\b",
    "\\b(weather|rainfall|rain|temperature)\\b",
    "\\b(rent|staff costs?|electricity)\\b",
    "\\bfestival\\b",
    "\\bmarket share\\b",
    "\\bsatisf",
    "\\belasticity\\b",
    "\\bother stores?\\b",
    "\\bwholesale price\\b",
    "\\b(by car|by bike|on foot)\\b",
    "\\b(home-delivery|online) orders?\\b",
    "\\bprefer\\b",
    "\\bprofitable\\b",
    "\\bmaximi[sz]e profit\\b",
    "\\bworking capital\\b",
    "\\bpayment terms\\b",
    "\\bper square foot\\b",
    "\\badd to or drop\\b",
    "\\bcheap or expensive\\b",
    "\\bpromotion\\b",
    "\\bdiscount\\b",
    "\\bhow should\\b",
    "\\bshould store\\b",
    "\\bmark(ed)? ?down\\b",
    "\\bcategory\\b.*\\bdoing\\b",
    "\\bnew product\\b",
    "\\bheld for other stores\\b",
    "\\bfor other stores\\b",
    "\\bhow much should\\b",
    "\\bstolen\\b",
    "\\btheft\\b"
   ]
  },
  {
   "id": "list_margin",
   "gap": "else",
   "status": "proxy",
   "note": "selling price minus the single cost per product is a list margin, not a real margin",
   "patterns": [
    "\\bgross margin\\b",
    "\\bmargin\\b"
   ]
  },
  {
   "id": "basket_value",
   "gap": "who",
   "status": "proxy",
   "note": "a bill's total is what one checkout cost: a stand-in for what a shopper spent, since no table links bills to a shopper",
   "patterns": [
    "\\b(average|mean|typical)\\b.*\\b(bill|basket)\\b.*\\b(value|size|amount)\\b",
    "\\b(bill|basket) (value|size)\\b"
   ]
  },
  {
   "id": "shelf_hours",
   "gap": "not_happen",
   "status": "proxy",
   "note": "shelf audits are 11:00 snapshots twice a week, not hours off the shelf",
   "patterns": [
    "\\bhours\\b.*\\boff the shelf\\b",
    "\\bat 3 pm\\b",
    "\\bshelf look empty\\b",
    "\\bon the shelf at\\b"
   ]
  },
  {
   "id": "forecast_vs_demand",
   "gap": "not_happen",
   "status": "not_recorded",
   "note": "a forecast can only be scored against recorded sales, not demand",
   "patterns": [
    "\\bforecast\\b.*\\b(accura|real|true|against)",
    "\\baccurate\\b.*\\bforecast\\b"
   ]
  },
  {
   "id": "bank_side",
   "gap": "who",
   "status": "not_recorded",
   "note": "the customer's bank side of a payment is not in the records",
   "patterns": [
    "\\bbank statement\\b",
    "\\bcustomer's bank\\b",
    "\\bbank'?s? (view|side)\\b"
   ]
  },
  {
   "id": "restock_times",
   "gap": "not_happen",
   "status": "not_recorded",
   "note": "restock time on the shelf is not recorded (only receipts at the back door)",
   "patterns": [
    "\\brestock",
    "\\bshelf was (restocked|empty for)\\b"
   ]
  }
