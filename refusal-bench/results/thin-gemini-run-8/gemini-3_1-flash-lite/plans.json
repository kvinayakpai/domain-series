 "S9N09": "{\"from\": \"dc-stock-adjustments-june\", \"joins\": [{\"table\": \"products\", \"type\": \"inner\", \"on\": [[{\"col\": \"dc-stock-adjustments-june.sku\"}, {\"col\": \"products.sku\"}]]}], \"where\": [{\"op\": \"or\", \"args\": [{\"op\": \"=\", \"args\": [{\"col\": \"products.name\"}, {\"lit\": \"Whole wheat atta 10 kg\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"products.name\"}, {\"lit\": \"Whole wheat atta 1 kg\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"products.name\"}, {\"lit\": \"Whole wheat atta 5 kg\"}]}]}], \"select\": [{\"as\": \"sku\", \"expr\": {\"col\": \"dc-stock-adjustments-june.sku\"}}, {\"as\": \"total_value\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"dc-stock-adjustments-june.value_at_cost_inr\"}}}, {\"as\": \"total_units\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"dc-stock-adjustments-june.units\"}}}], \"group_by\": [{\"col\": \"dc-stock-adjustments-june.sku\"}]}",
 "S9N10": "{\"from\": \"pallets-june\", \"joins\": [{\"table\": \"shipments-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"pallets-june.shipment_id\"}, {\"col\": \"shipments-june.shipment_id\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"shipments-june.dispatched_ts\"}}, {\"lit\": \"2026-06-22\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"pallets-june.weight_check\"}, {\"lit\": \"not weighed\"}]}], \"select\": [{\"as\": \"sscc\", \"expr\": {\"col\": \"pallets-june.sscc\"}}]}",
