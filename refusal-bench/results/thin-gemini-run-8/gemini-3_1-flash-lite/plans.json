 "S8N34": "{\"from\": \"customer-complaints-june\", \"joins\": [{\"table\": \"pos-payments-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"customer-complaints-june.rrn\"}, {\"col\": \"pos-payments-june.rrn\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"customer-complaints-june.kind\"}, {\"lit\": \"charged twice\"}]}], \"select\": [{\"as\": \"avg_wait_days\", \"expr\": {\"agg\": \"avg\", \"arg\": {\"fn\": \"days_between\", \"args\": [{\"col\": \"customer-complaints-june.resolved_ts\"}, {\"col\": \"customer-complaints-june.complaint_ts\"}]}}}, {\"as\": \"unrefunded_count\", \"expr\": {\"agg\": \"count\", \"arg\": {\"col\": \"customer-complaints-june.complaint\"}}}, {\"as\": \"total_complaints\", \"expr\": {\"agg\": \"count\", \"arg\": {\"col\": \"customer-complaints-june.complaint\"}}}], \"having\": [{\"op\": \"is_null\", \"arg\": {\"col\": \"customer-complaints-june.resolved_ts\"}}]}",
