{
 "S8N01": "{\"from\": \"daily-sales-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"daily-sales-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \">=\", \"args\": [{\"col\": \"daily-sales-june.date\"}, {\"lit\": \"2026-06-01\"}]}, {\"op\": \"<=\", \"args\": [{\"col\": \"daily-sales-june.date\"}, {\"lit\": \"2026-06-28\"}]}], \"select\": [{\"as\": \"total_units\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"daily-sales-june.units_sold\"}}}]}",
 "S8N02": "{\"from\": \"shelf-audits-june\", \"joins\": [{\"table\": \"inventory-book-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"shelf-audits-june.sku\"}, {\"col\": \"inventory-book-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"col\": \"inventory-book-june.date\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"shelf-audits-june.status\"}, {\"lit\": \"empty\"}]}, {\"op\": \">\", \"args\": [{\"col\": \"inventory-book-june.book_on_hand_close\"}, {\"lit\": 0}]}], \"select\": [{\"as\": \"audit_ts\", \"expr\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"as\": \"sku\", \"expr\": {\"col\": \"shelf-audits-june.sku\"}}, {\"as\": \"book_stock\", \"expr\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}]}",
