 "S9N04": "{\"from\": \"daily-sales-june\", \"joins\": [{\"table\": \"forecasts-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"daily-sales-june.sku\"}, {\"col\": \"forecasts-june.sku\"}], [{\"col\": \"daily-sales-june.date\"}, {\"col\": \"forecasts-june.date\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"daily-sales-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \">=\", \"args\": [{\"col\": \"daily-sales-june.date\"}, {\"lit\": \"2026-06-01\"}]}, {\"op\": \"<=\", \"args\": [{\"col\": \"daily-sales-june.date\"}, {\"lit\": \"2026-06-28\"}]}], \"select\": [{\"as\": \"total_sales\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"daily-sales-june.units_sold\"}}}, {\"as\": \"total_forecast\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"forecasts-june.forecast_units_per_day\"}}}]}",
 "S9N05": "{\"from\": \"daily-sales-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"daily-sales-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"daily-sales-june.date\"}}, {\"lit\": \"2026-06-11\"}]}, {\"op\": \"=\", \"args\": [{\"fn\": \"hour\", \"arg\": {\"col\": \"daily-sales-june.date\"}}, {\"lit\": 14}]}, {\"op\": \"=\", \"args\": [{\"col\": \"daily-sales-june.units_sold\"}, {\"lit\": 0}]}], \"select\": [{\"as\": \"sku\", \"expr\": {\"col\": \"daily-sales-june.sku\"}}, {\"as\": \"units_sold\", \"expr\": {\"col\": \"daily-sales-june.units_sold\"}}]}",
