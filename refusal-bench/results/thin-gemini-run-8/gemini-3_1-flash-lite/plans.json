 "S8N19": "{\"from\": \"shipments-june\", \"joins\": [{\"table\": \"shipping-notice-lines-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"shipments-june.shipment_id\"}, {\"col\": \"shipping-notice-lines-june.shipment_id\"}]]}, {\"table\": \"goods-receipts-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"shipping-notice-lines-june.shipment_id\"}, {\"col\": \"goods-receipts-june.shipment_id\"}], [{\"col\": \"shipping-notice-lines-june.sku\"}, {\"col\": \"goods-receipts-june.sku_booked\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"shipments-june.arrived_ts\"}}, {\"lit\": \"2026-06-22\"}]}], \"select\": [{\"as\": \"shipment_id\", \"expr\": {\"col\": \"shipments-june.shipment_id\"}}, {\"as\": \"on_time\", \"expr\": {\"op\": \"<=\", \"args\": [{\"col\": \"shipments-june.arrived_ts\"}, {\"col\": \"shipments-june.slot_end\"}]}}, {\"as\": \"in_full\", \"expr\": {\"op\": \"=\", \"args\": [{\"agg\": \"sum\", \"arg\": {\"col\": \"shipping-notice-lines-june.units\"}}, {\"agg\": \"sum\", \"arg\": {\"col\": \"goods-receipts-june.units_booked\"}}]}}], \"group_by\": [{\"col\": \"shipments-june.shipment_id\"}, {\"col\": \"shipments-june.arrived_ts\"}, {\"col\": \"shipments-june.slot_end\"}]}",
