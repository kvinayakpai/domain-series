 "S8N04": "{\"from\": \"stock-counts-june\", \"joins\": [{\"table\": \"inventory-book-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"stock-counts-june.sku\"}, {\"col\": \"inventory-book-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"stock-counts-june.count_ts\"}}, {\"col\": \"inventory-book-june.date\"}]]}], \"where\": [{\"op\": \">\", \"args\": [{\"fn\": \"abs\", \"arg\": {\"op\": \"-\", \"args\": [{\"col\": \"stock-counts-june.counted\"}, {\"col\": \"inventory-book-june.book_on_hand_close\"}]}}, {\"op\": \"*\", \"args\": [{\"lit\": 0.02}, {\"col\": \"inventory-book-june.book_on_hand_close\"}]}]}], \"select\": [{\"as\": \"sku\", \"expr\": {\"col\": \"stock-counts-june.sku\"}}, {\"as\": \"count_ts\", \"expr\": {\"col\": \"stock-counts-june.count_ts\"}}, {\"as\": \"counted\", \"expr\": {\"col\": \"stock-counts-june.counted\"}}, {\"as\": \"book_stock\", \"expr\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}]}",
 "S8N05": "{\"from\": \"daily-sales-june\", \"joins\": [{\"table\": \"products\", \"type\": \"inner\", \"on\": [[{\"col\": \"daily-sales-june.sku\"}, {\"col\": \"products.sku\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"products.flow\"}, {\"lit\": \"DC\"}]}], \"group_by\": [{\"col\": \"daily-sales-june.sku\"}], \"select\": [{\"as\": \"sku\", \"expr\": {\"col\": \"daily-sales-june.sku\"}}, {\"as\": \"week1\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"op\": \"*\", \"args\": [{\"col\": \"daily-sales-june.units_sold\"}, {\"op\": \"=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"daily-sales-june.date\"}}, {\"lit\": \"2026-06-01\"}]}]}}}}, {\"as\": \"week2\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"op\": \"*\", \"args\": [{\"col\": \"daily-sales-june.units_sold\"}, {\"op\": \"=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"daily-sales-june.date\"}}, {\"lit\": \"2026-06-08\"}]}]}}}], \"having\": [{\"op\": \"<\", \"args\": [{\"ref\": \"week2\"}, {\"op\": \"*\", \"args\": [{\"ref\": \"week1\"}, {\"lit\": 0.5}]}]}]}",
 "S8N06": "{\"from\": \"pos-lines-may-june\", \"joins\": [{\"table\": \"write-offs-june\", \"type\": \"left\", \"on\": [[{\"fn\": \"day\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}, {\"col\": \"write-offs-june.date\"}], [{\"col\": \"pos-lines-may-june.sku_scanned\"}, {\"col\": \"write-offs-june.sku\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-lines-may-june.sku_scanned\"}, {\"lit\": \"MILK-TONED-500ML\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"write-offs-june.sku\"}, {\"lit\": \"MILK-TONED-500ML\"}]}], \"group_by\": [{\"fn\": \"day\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}], \"select\": [{\"as\": \"day\", \"expr\": {\"fn\": \"day\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}}, {\"as\": \"last_sale_time\", \"expr\": {\"agg\": \"max\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}}, {\"as\": \"total_write_offs\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"write-offs-june.units\"}}}]}",
 "S8N07": "{\"from\": \"daily-sales-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"daily-sales-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"between\", \"arg\": {\"fn\": \"day\", \"arg\": {\"col\": \"daily-sales-june.date\"}}, \"low\": \"2026-06-08\", \"high\": \"2026-06-14\"}], \"select\": [{\"as\": \"date\", \"expr\": {\"fn\": \"day\", \"arg\": {\"col\": \"daily-sales-june.date\"}}}, {\"as\": \"units_sold\", \"expr\": {\"col\": \"daily-sales-june.units_sold\"}}, {\"as\": \"revenue_inr\", \"expr\": {\"col\": \"daily-sales-june.revenue_inr\"}}], \"order_by\": [{\"by\": \"date\", \"dir\": \"asc\"}]}",
