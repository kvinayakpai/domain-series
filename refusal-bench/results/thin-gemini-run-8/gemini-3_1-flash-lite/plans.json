 "S8N31": "{\"from\": \"pos-payments-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"approved\"}]}], \"group_by\": [{\"col\": \"pos-payments-june.bill_id\"}], \"having\": [{\"op\": \">\", \"args\": [{\"agg\": \"count\", \"arg\": \"*\"}, {\"lit\": 1}]}], \"select\": [{\"as\": \"bill_id\", \"expr\": {\"col\": \"pos-payments-june.bill_id\"}}, {\"as\": \"payment_count\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}, {\"as\": \"total_customers\", \"expr\": {\"agg\": \"count_distinct\", \"arg\": {\"col\": \"pos-payments-june.bill_id\"}}}]}",
 "S8N32": "{\"from\": \"pos-payments-june\", \"joins\": [{\"table\": \"psp-upi-report-june\", \"type\": \"left\", \"on\": [[{\"col\": \"pos-payments-june.rrn\"}, {\"col\": \"psp-upi-report-june.rrn\"}]]}, {\"table\": \"upi-refunds-june\", \"type\": \"left\", \"on\": [[{\"col\": \"pos-payments-june.bill_id\"}, {\"col\": \"upi-refunds-june.bill_id\"}]]}], \"where\": [{\"op\": \"in\", \"arg\": {\"col\": \"pos-payments-june.till_status\"}, \"values\": [{\"lit\": \"failed\"}, {\"lit\": \"failed: no response\"}]}, {\"op\": \"=\", \"arg\": {\"fn\": \"day\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}, \"values\": [{\"lit\": \"2026-06-20\"}]}, {\"op\": \"between\", \"arg\": {\"fn\": \"hour\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}, \"low\": 18, \"high\": 19}], \"select\": [{\"as\": \"bill_id\", \"expr\": {\"col\": \"pos-payments-june.bill_id\"}}, {\"as\": \"till_status\", \"expr\": {\"col\": \"pos-payments-june.till_status\"}}, {\"as\": \"psp_status\", \"expr\": {\"col\": \"psp-upi-report-june.status\"}}, {\"as\": \"refund_amount\", \"expr\": {\"col\": \"upi-refunds-june.amount_inr\"}}]}",
