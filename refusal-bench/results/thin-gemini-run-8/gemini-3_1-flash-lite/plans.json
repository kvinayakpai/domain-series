 "S8N10": "{\"from\": \"shelf-audits-june\", \"joins\": [{\"table\": \"inventory-book-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"shelf-audits-june.sku\"}, {\"col\": \"inventory-book-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"col\": \"inventory-book-june.date\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"shelf-audits-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \">=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"lit\": \"2026-06-01\"}]}, {\"op\": \"<=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"lit\": \"2026-06-28\"}]}], \"select\": [{\"as\": \"audit_date\", \"expr\": {\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}}, {\"as\": \"shelf_status\", \"expr\": {\"col\": \"shelf-audits-june.status\"}}, {\"as\": \"book_stock\", \"expr\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}]}",
 "S8N11": "{\"from\": \"daily-sales-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"daily-sales-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \">=\", \"args\": [{\"col\": \"daily-sales-june.date\"}, {\"lit\": \"2026-06-01\"}]}], \"group_by\": [{\"col\": \"daily-sales-june.date\"}], \"select\": [{\"as\": \"date\", \"expr\": {\"col\": \"daily-sales-june.date\"}}, {\"as\": \"daily_demand\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"daily-sales-june.units_sold\"}}}]}",
 "S8N12": "{\"from\": \"shelf-audits-june\", \"joins\": [{\"table\": \"products\", \"type\": \"inner\", \"on\": [[{\"col\": \"shelf-audits-june.sku\"}, {\"col\": \"products.sku\"}]]}, {\"table\": \"daily-sales-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"shelf-audits-june.sku\"}, {\"col\": \"daily-sales-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"col\": \"daily-sales-june.date\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"products.name\"}, {\"lit\": \"Whole wheat atta 5 kg\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"shelf-audits-june.status\"}, {\"lit\": \"empty\"}]}], \"select\": [{\"as\": \"shoppers_missed\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}, {\"as\": \"lost_sales\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"daily-sales-june.revenue_inr\"}}}]}",
 "S8E13": "{\"from\": \"shipments-june\", \"where\": [{\"op\": \">=\", \"args\": [{\"fn\": \"hour\", \"arg\": {\"col\": \"shipments-june.arrived_ts\"}}, {\"lit\": 6}]}, {\"op\": \"<\", \"args\": [{\"fn\": \"hour\", \"arg\": {\"col\": \"shipments-june.arrived_ts\"}}, {\"lit\": 7}]}, {\"op\": \">=\", \"args\": [{\"col\": \"shipments-june.arrived_ts\"}, {\"col\": \"shipments-june.slot_start\"}]}, {\"op\": \"<=\", \"args\": [{\"col\": \"shipments-june.arrived_ts\"}, {\"col\": \"shipments-june.slot_end\"}]}], \"select\": [{\"as\": \"count\", \"expr\": {\"agg\": \"count\", \"arg\": {\"col\": \"shipments-june.shipment_id\"}}}]}",
 "S8N14": "{\"from\": \"pallets-june\", \"joins\": [{\"table\": \"goods-receipts-june\", \"type\": \"left\", \"on\": [[{\"col\": \"pallets-june.sscc\"}, {\"col\": \"goods-receipts-june.sscc\"}]]}], \"where\": [{\"op\": \"or\", \"args\": [{\"op\": \"!=\", \"args\": [{\"col\": \"pallets-june.weight_check\"}, {\"lit\": \"not weighed\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"goods-receipts-june.receipt_method\"}, {\"lit\": \"pallet label (SSCC) scan against the shipping notice\"}]}]}], \"select\": [{\"as\": \"count\", \"expr\": {\"agg\": \"count\", \"arg\": {\"col\": \"pallets-june.sscc\"}}}]}",
 "S8N15": "{\"from\": \"store-orders-june\", \"joins\": [{\"table\": \"shipping-notice-lines-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"store-orders-june.order_id\"}, {\"col\": \"shipping-notice-lines-june.order_id\"}], [{\"col\": \"store-orders-june.sku\"}, {\"col\": \"shipping-notice-lines-june.sku\"}]]}], \"select\": [{\"as\": \"case_fill_rate\", \"expr\": {\"op\": \"/\", \"args\": [{\"agg\": \"sum\", \"arg\": {\"col\": \"shipping-notice-lines-june.cases\"}}, {\"agg\": \"sum\", \"arg\": {\"col\": \"store-orders-june.cases\"}}]}}]}",
 "S8N16": "{\"from\": \"dc-stock-adjustments-june\", \"joins\": [{\"table\": \"stock-counts-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"dc-stock-adjustments-june.sku\"}, {\"col\": \"stock-counts-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"dc-stock-adjustments-june.adjusted_ts\"}}, {\"fn\": \"day\", \"arg\": {\"col\": \"stock-counts-june.count_ts\"}}]]}, {\"table\": \"products\", \"type\": \"inner\", \"on\": [[{\"col\": \"dc-stock-adjustments-june.sku\"}, {\"col\": \"products.sku\"}]]}], \"where\": [{\"op\": \"in\", \"arg\": {\"col\": \"products.name\"}, \"values\": [\"Whole wheat atta 10 kg\", \"Whole wheat atta 1 kg\", \"Whole wheat atta 5 kg\"]}], \"select\": [{\"as\": \"gross_dc_cost\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"dc-stock-adjustments-june.value_at_cost_inr\"}}}, {\"as\": \"net_store_cost\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"op\": \"*\", \"args\": [{\"col\": \"stock-counts-june.adjustment\"}, {\"col\": \"products.cost_inr\"}]}}}]}",
