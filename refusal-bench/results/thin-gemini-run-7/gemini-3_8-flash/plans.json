{
 "S8N01": "{\"cannot\": \"The timeframe is ambiguous between all of June 2026 and the week of 8 June, and the sales records do not cover the full month of June 2026.\"}",
 "S8N02": "{\"cannot\": \"The schema records daily closing book stock in inventory-book-june, but does not track hourly book stock.\"}",
 "S8N03": "```json\n{\"from\": \"inventory-book-june\", \"where\": [{\"op\": \"<\", \"args\": [{\"col\": \"inventory-book-june.book_on_hand_close\"}, {\"lit\": 0}]}], \"group_by\": [{\"fn\": \"day\", \"arg\": {\"col\": \"inventory-book-june.date\"}}], \"select\": [{\"as\": \"day\", \"expr\": {\"fn\": \"day\", \"arg\": {\"col\": \"inventory-book-june.date\"}}}], \"order_by\": [{\"by\": \"day\", \"dir\": \"asc\"}]}\n```",
 "S8N04": "```json\n{\"from\": \"stock-counts-june\", \"where\": [{\"op\": \">\", \"args\": [{\"op\": \"/\", \"args\": [{\"fn\": \"abs\", \"arg\": {\"col\": \"stock-counts-june.adjustment\"}}, {\"col\": \"stock-counts-june.book_before\"}]}, {\"lit\": 0.02}]}], \"select\": [{\"as\": \"count_ts\", \"expr\": {\"col\": \"stock-counts-june.count_ts\"}}, {\"as\": \"sku\", \"expr\": {\"col\": \"stock-counts-june.sku\"}}]}\n```",
 "S8N05": "{\"cannot\": \"Comparing sales between week 1 and week 2 requires either a self-join, conditional aggregation (CASE WHEN), or window functions, none of which are supported by the query planner (a table can appear only once, and CASE/window expressions are not available).\"}",
