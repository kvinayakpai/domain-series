{
 "S8N01": "{\"from\": \"daily-sales-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"daily-sales-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"between\", \"arg\": {\"fn\": \"day\", \"arg\": {\"col\": \"daily-sales-june.date\"}}, \"low\": \"2026-06-01\", \"high\": \"2026-06-30\"}], \"select\": [{\"as\": \"units\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"daily-sales-june.units_sold\"}}}]}",
 "S8N02": "{\"cannot\": \"There is no hourly book stock in the records; the book stock table holds only one closing figure per product per day.\"}",
 "S8N03": "{\"from\": \"inventory-book-june\", \"where\": [{\"op\": \"<\", \"args\": [{\"col\": \"inventory-book-june.book_on_hand_close\"}, {\"lit\": 0}]}], \"group_by\": [{\"col\": \"inventory-book-june.date\"}], \"select\": [{\"as\": \"date\", \"expr\": {\"col\": \"inventory-book-june.date\"}}, {\"as\": \"items_below_zero\", \"expr\": {\"agg\": \"count_distinct\", \"arg\": {\"col\": \"inventory-book-june.sku\"}}}], \"order_by\": [{\"by\": \"date\", \"dir\": \"asc\"}]}",
 "S8N04": "{\"from\": \"stock-counts-june\", \"where\": [{\"op\": \"!=\", \"args\": [{\"col\": \"stock-counts-june.book_before\"}, {\"lit\": 0}]}, {\"op\": \">\", \"args\": [{\"fn\": \"abs\", \"arg\": {\"op\": \"/\", \"args\": [{\"op\": \"-\", \"args\": [{\"col\": \"stock-counts-june.counted\"}, {\"col\": \"stock-counts-june.book_before\"}]}, {\"col\": \"stock-counts-june.book_before\"}]}}, {\"lit\": 0.02}]}], \"select\": [{\"as\": \"count_ts\", \"expr\": {\"col\": \"stock-counts-june.count_ts\"}}, {\"as\": \"sku\", \"expr\": {\"col\": \"stock-counts-june.sku\"}}, {\"as\": \"book_before\", \"expr\": {\"col\": \"stock-counts-june.book_before\"}}, {\"as\": \"counted\", \"expr\": {\"col\": \"stock-counts-june.counted\"}}, {\"as\": \"adjustment\", \"expr\": {\"col\": \"stock-counts-june.adjustment\"}}, {\"as\": \"trigger\", \"expr\": {\"col\": \"stock-counts-june.trigger\"}}], \"order_by\": [{\"by\": \"count_ts\", \"dir\": \"asc\"}]}",
 "S8N05": "{\"cannot\": \"Comparing each item's week-1 sales with its week-2 sales needs two separate sums per item side by side, which this plan form cannot express (no week function or conditional sums, and a table can appear only once); the question also does not define which dates are week 1 and week 2.\"}",
 "S8N06": "{\"from\": \"pos-lines-may-june\", \"joins\": [{\"table\": \"write-offs-june\", \"type\": \"left\", \"on\": [[{\"col\": \"pos-lines-may-june.sku_scanned\"}, {\"col\": \"write-offs-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}, {\"col\": \"write-offs-june.date\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-lines-may-june.sku_scanned\"}, {\"lit\": \"MILK-TONED-500ML\"}]}], \"group_by\": [{\"fn\": \"day\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}], \"select\": [{\"as\": \"day\", \"expr\": {\"fn\": \"day\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}}, {\"as\": \"last_sale_ts\", \"expr\": {\"agg\": \"max\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}}, {\"as\": \"written_off_units\", \"expr\": {\"agg\": \"max\", \"arg\": {\"col\": \"write-offs-june.units\"}}}], \"order_by\": [{\"by\": \"day\", \"dir\": \"asc\"}]}",
 "S8N07": "{\"from\": \"shelf-audits-june\", \"joins\": [{\"table\": \"inventory-book-june\", \"type\": \"left\", \"on\": [[{\"col\": \"shelf-audits-june.sku\"}, {\"col\": \"inventory-book-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"col\": \"inventory-book-june.date\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"shelf-audits-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"between\", \"arg\": {\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, \"low\": \"2026-06-08\", \"high\": \"2026-06-14\"}], \"select\": [{\"as\": \"audit_ts\", \"expr\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"as\": \"shelf_status\", \"expr\": {\"col\": \"shelf-audits-june.status\"}}, {\"as\": \"book_stock\", \"expr\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}], \"order_by\": [{\"by\": \"audit_ts\", \"dir\": \"asc\"}]}",
 "S8N08": "{\"from\": \"shelf-audits-june\", \"joins\": [{\"table\": \"inventory-book-june\", \"type\": \"left\", \"on\": [[{\"col\": \"shelf-audits-june.sku\"}, {\"col\": \"inventory-book-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"col\": \"inventory-book-june.date\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"shelf-audits-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"lit\": \"2026-06-11\"}]}], \"select\": [{\"as\": \"audit_ts\", \"expr\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"as\": \"shelf_status\", \"expr\": {\"col\": \"shelf-audits-june.status\"}}, {\"as\": \"book_stock\", \"expr\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}], \"order_by\": [{\"by\": \"audit_ts\", \"dir\": \"asc\"}]}",
 "S8N09": "{\"cannot\": \"The till records carry no shopper identity, so they cannot show any shopper moving from 5 kg to 1 kg atta.\"}",
 "S8N10": "{\"from\": \"shelf-audits-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"shelf-audits-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}], \"group_by\": [{\"col\": \"shelf-audits-june.status\"}], \"select\": [{\"as\": \"shelf_status\", \"expr\": {\"col\": \"shelf-audits-june.status\"}}, {\"as\": \"audits\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}",
 "S8N11": "{\"cannot\": \"The records hold recorded sales, not demand; on days the item was off the shelf, demand that went unsold is not recorded anywhere.\"}",
 "S8N12": "{\"cannot\": \"No table records shoppers who left without the item or sales that did not happen.\"}",
 "S8E13": "{\"from\": \"shipments-june\", \"where\": [{\"op\": \"between\", \"arg\": {\"fn\": \"day\", \"arg\": {\"col\": \"shipments-june.arrived_ts\"}}, \"low\": \"2026-06-01\", \"high\": \"2026-06-30\"}, {\"op\": \">=\", \"args\": [{\"col\": \"shipments-june.arrived_ts\"}, {\"col\": \"shipments-june.slot_start\"}]}, {\"op\": \"<=\", \"args\": [{\"col\": \"shipments-june.arrived_ts\"}, {\"col\": \"shipments-june.slot_end\"}]}], \"select\": [{\"as\": \"deliveries_inside_slot\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}",
 "S8N14": "{\"from\": \"pallets-june\", \"joins\": [{\"table\": \"goods-receipts-june\", \"type\": \"left\", \"on\": [[{\"col\": \"pallets-june.sscc\"}, {\"col\": \"goods-receipts-june.sscc\"}]]}], \"where\": [{\"op\": \"or\", \"args\": [{\"op\": \"!=\", \"args\": [{\"col\": \"pallets-june.weight_check\"}, {\"lit\": \"not weighed\"}]}, {\"op\": \"!=\", \"args\": [{\"col\": \"goods-receipts-june.receipt_method\"}, {\"lit\": \"pallet label (SSCC) scan against the shipping notice\"}]}]}], \"select\": [{\"as\": \"pallets_weighed_or_case_scanned\", \"expr\": {\"agg\": \"count_distinct\", \"arg\": {\"col\": \"pallets-june.sscc\"}}}]}",
 "S8N15": "{\"from\": \"store-orders-june\", \"joins\": [{\"table\": \"shipping-notice-lines-june\", \"type\": \"left\", \"on\": [[{\"col\": \"store-orders-june.order_id\"}, {\"col\": \"shipping-notice-lines-june.order_id\"}], [{\"col\": \"store-orders-june.sku\"}, {\"col\": \"shipping-notice-lines-june.sku\"}]]}], \"select\": [{\"as\": \"cases_ordered\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"store-orders-june.cases\"}}}, {\"as\": \"cases_on_notices\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"shipping-notice-lines-june.cases\"}}}, {\"as\": \"case_fill_rate\", \"expr\": {\"op\": \"/\", \"args\": [{\"agg\": \"sum\", \"arg\": {\"col\": \"shipping-notice-lines-june.cases\"}}, {\"agg\": \"sum\", \"arg\": {\"col\": \"store-orders-june.cases\"}}]}}]}",
 "S8N16": "{\"cannot\": \"Warehouse corrections (with value at cost) and store count corrections (in packs) sit in two separate tables that would have to be stacked, not joined; this plan form has no union, so one plan cannot total both.\"}",
 "S8N17": "{\"cannot\": \"There is no product-family column, and matching corrections across different products of a family would need the products table twice; this plan form cannot express it.\"}",
 "S8N18": "{\"from\": \"goods-receipts-june\", \"joins\": [{\"table\": \"stock-counts-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"goods-receipts-june.sku_booked\"}, {\"col\": \"stock-counts-june.sku\"}]]}], \"where\": [{\"op\": \"between\", \"arg\": {\"fn\": \"days_between\", \"args\": [{\"col\": \"goods-receipts-june.received_ts\"}, {\"col\": \"stock-counts-june.count_ts\"}]}, \"low\": 0, \"high\": 7}, {\"op\": \"<\", \"args\": [{\"col\": \"stock-counts-june.adjustment\"}, {\"lit\": 0}]}], \"select\": [{\"as\": \"grn_id\", \"expr\": {\"col\": \"goods-receipts-june.grn_id\"}}, {\"as\": \"line\", \"expr\": {\"col\": \"goods-receipts-june.line\"}}, {\"as\": \"sku\", \"expr\": {\"col\": \"goods-receipts-june.sku_booked\"}}, {\"as\": \"units_booked\", \"expr\": {\"col\": \"goods-receipts-june.units_booked\"}}, {\"as\": \"received_ts\", \"expr\": {\"col\": \"goods-receipts-june.received_ts\"}}, {\"as\": \"count_ts\", \"expr\": {\"col\": \"stock-counts-june.count_ts\"}}, {\"as\": \"count_adjustment\", \"expr\": {\"col\": \"stock-counts-june.adjustment\"}}], \"order_by\": [{\"by\": \"received_ts\", \"dir\": \"asc\"}], \"limit\": 200}",
 "S8N19": "{\"from\": \"shipments-june\", \"joins\": [{\"table\": \"goods-receipts-june\", \"type\": \"left\", \"on\": [[{\"col\": \"shipments-june.shipment_id\"}, {\"col\": \"goods-receipts-june.shipment_id\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"shipments-june.arrived_ts\"}}, {\"lit\": \"2026-06-22\"}]}], \"group_by\": [{\"col\": \"shipments-june.shipment_id\"}, {\"col\": \"shipments-june.slot_start\"}, {\"col\": \"shipments-june.slot_end\"}, {\"col\": \"shipments-june.arrived_ts\"}], \"select\": [{\"as\": \"shipment_id\", \"expr\": {\"col\": \"shipments-june.shipment_id\"}}, {\"as\": \"slot_start\", \"expr\": {\"col\": \"shipments-june.slot_start\"}}, {\"as\": \"slot_end\", \"expr\": {\"col\": \"shipments-june.slot_end\"}}, {\"as\": \"arrived_ts\", \"expr\": {\"col\": \"shipments-june.arrived_ts\"}}, {\"as\": \"notice_units\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"goods-receipts-june.asn_units\"}}}, {\"as\": \"units_booked\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"goods-receipts-june.units_booked\"}}}]}",
 "S8N20": "{\"cannot\": \"In-full cannot be verified: no pallet was weighed at dispatch and receipts were booked by pallet-label scan against the shipping notice, so received quantities copy the notice; an OTIF figure would also need a per-shipment result rolled up again, which this form cannot express.\"}",
 "S8N21": "{\"from\": \"shelf-audits-june\", \"joins\": [{\"table\": \"inventory-book-june\", \"type\": \"left\", \"on\": [[{\"col\": \"shelf-audits-june.sku\"}, {\"col\": \"inventory-book-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"col\": \"inventory-book-june.date\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"shelf-audits-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"between\", \"arg\": {\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, \"low\": \"2026-06-23\", \"high\": \"2026-06-26\"}], \"select\": [{\"as\": \"audit_ts\", \"expr\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"as\": \"shelf_status\", \"expr\": {\"col\": \"shelf-audits-june.status\"}}, {\"as\": \"book_stock\", \"expr\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}], \"order_by\": [{\"by\": \"audit_ts\", \"dir\": \"asc\"}]}",
 "S8N22": "{\"cannot\": \"The records cannot establish theft; no table records who removed stock or why.\"}",
 "S8N23": "{\"cannot\": \"No record shows a discrepancy on any delivery line: pallets were not weighed and receipts were booked from the pallet label against the shipping notice, so the data cannot identify which delivery, pallet or line to claim against.\"}",
 "S8N24": "{\"cannot\": \"No table records shoppers who wanted the item and did not find it.\"}",
 "S8A25": "{\"from\": \"pos-payments-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}], \"select\": [{\"as\": \"upi_attempts\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}",
 "S8E26": "{\"from\": \"pos-payments-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"failed: no response\"}]}, {\"op\": \"is_null\", \"arg\": {\"col\": \"pos-payments-june.rrn\"}}], \"select\": [{\"as\": \"timeouts_without_rrn\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}",
 "S8N27": "{\"from\": \"psp-upi-report-june\", \"joins\": [{\"table\": \"pos-payments-june\", \"type\": \"left\", \"on\": [[{\"col\": \"psp-upi-report-june.rrn\"}, {\"col\": \"pos-payments-june.rrn\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"psp-upi-report-june.status\"}, {\"lit\": \"success\"}]}, {\"op\": \"or\", \"args\": [{\"op\": \"is_null\", \"arg\": {\"col\": \"pos-payments-june.attempt\"}}, {\"op\": \"!=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"approved\"}]}]}], \"select\": [{\"as\": \"rrn\", \"expr\": {\"col\": \"psp-upi-report-june.rrn\"}}, {\"as\": \"bill_ref\", \"expr\": {\"col\": \"psp-upi-report-june.bill_ref\"}}, {\"as\": \"amount_inr\", \"expr\": {\"col\": \"psp-upi-report-june.amount_inr\"}}, {\"as\": \"initiated_ts\", \"expr\": {\"col\": \"psp-upi-report-june.initiated_ts\"}}, {\"as\": \"status_ts\", \"expr\": {\"col\": \"psp-upi-report-june.status_ts\"}}, {\"as\": \"till_status\", \"expr\": {\"col\": \"pos-payments-june.till_status\"}}], \"order_by\": [{\"by\": \"initiated_ts\", \"dir\": \"asc\"}], \"limit\": 200}",
 "S8N28": "{\"from\": \"pos-payments-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"failed: no response\"}]}], \"group_by\": [{\"fn\": \"day\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}, {\"fn\": \"hour\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}], \"select\": [{\"as\": \"day\", \"expr\": {\"fn\": \"day\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}}, {\"as\": \"hour\", \"expr\": {\"fn\": \"hour\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}}, {\"as\": \"timeouts\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}], \"having\": [{\"op\": \">=\", \"args\": [{\"ref\": \"timeouts\"}, {\"lit\": 3}]}], \"order_by\": [{\"by\": \"timeouts\", \"dir\": \"desc\"}], \"limit\": 200}",
 "S8N29": "{\"from\": \"pos-payments-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"approved\"}]}, {\"op\": \">\", \"args\": [{\"col\": \"pos-payments-june.amount_inr\"}, {\"lit\": 2000}]}], \"select\": [{\"as\": \"bills\", \"expr\": {\"agg\": \"count_distinct\", \"arg\": {\"col\": \"pos-payments-june.bill_id\"}}}, {\"as\": \"mdr_at_0_4_pct\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"op\": \"*\", \"args\": [{\"col\": \"pos-payments-june.amount_inr\"}, {\"lit\": 0.004}]}}}, {\"as\": \"largest_amount\", \"expr\": {\"agg\": \"max\", \"arg\": {\"col\": \"pos-payments-june.amount_inr\"}}}]}",
 "S8N30": "{\"from\": \"psp-upi-report-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"psp-upi-report-june.status\"}, {\"lit\": \"success\"}]}], \"group_by\": [{\"col\": \"psp-upi-report-june.bill_ref\"}], \"select\": [{\"as\": \"bill_ref\", \"expr\": {\"col\": \"psp-upi-report-june.bill_ref\"}}, {\"as\": \"successful_debits\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}, {\"as\": \"amount_inr\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"psp-upi-report-june.amount_inr\"}}}], \"having\": [{\"op\": \">=\", \"args\": [{\"ref\": \"successful_debits\"}, {\"lit\": 3}]}], \"order_by\": [{\"by\": \"successful_debits\", \"dir\": \"desc\"}], \"limit\": 200}",
 "S8N31": "{\"from\": \"psp-upi-report-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"psp-upi-report-june.status\"}, {\"lit\": \"success\"}]}], \"group_by\": [{\"col\": \"psp-upi-report-june.bill_ref\"}], \"select\": [{\"as\": \"bill_ref\", \"expr\": {\"col\": \"psp-upi-report-june.bill_ref\"}}, {\"as\": \"successful_debits\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}, {\"as\": \"amount_inr\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"psp-upi-report-june.amount_inr\"}}}], \"having\": [{\"op\": \">=\", \"args\": [{\"ref\": \"successful_debits\"}, {\"lit\": 2}]}], \"order_by\": [{\"by\": \"successful_debits\", \"dir\": \"desc\"}], \"limit\": 200}",
 "S8N32": "{\"from\": \"pos-payments-june\", \"joins\": [{\"table\": \"psp-upi-report-june\", \"type\": \"left\", \"on\": [[{\"col\": \"pos-payments-june.bill_id\"}, {\"col\": \"psp-upi-report-june.bill_ref\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}, {\"op\": \"in\", \"arg\": {\"col\": \"pos-payments-june.till_status\"}, \"values\": [\"failed\", \"failed: no response\"]}, {\"op\": \"between\", \"arg\": {\"col\": \"pos-payments-june.ts\"}, \"low\": \"2026-06-20T18:20\", \"high\": \"2026-06-20T19:50\"}], \"select\": [{\"as\": \"bill_id\", \"expr\": {\"col\": \"pos-payments-june.bill_id\"}}, {\"as\": \"attempt\", \"expr\": {\"col\": \"pos-payments-june.attempt\"}}, {\"as\": \"till_ts\", \"expr\": {\"col\": \"pos-payments-june.ts\"}}, {\"as\": \"till_status\", \"expr\": {\"col\": \"pos-payments-june.till_status\"}}, {\"as\": \"till_rrn\", \"expr\": {\"col\": \"pos-payments-june.rrn\"}}, {\"as\": \"psp_rrn\", \"expr\": {\"col\": \"psp-upi-report-june.rrn\"}}, {\"as\": \"psp_status\", \"expr\": {\"col\": \"psp-upi-report-june.status\"}}, {\"as\": \"psp_status_ts\", \"expr\": {\"col\": \"psp-upi-report-june.status_ts\"}}], \"order_by\": [{\"by\": \"till_ts\", \"dir\": \"asc\"}], \"limit\": 200}",
 "S8N33": "{\"from\": \"psp-upi-report-june\", \"joins\": [{\"table\": \"pos-payments-june\", \"type\": \"left\", \"on\": [[{\"col\": \"psp-upi-report-june.rrn\"}, {\"col\": \"pos-payments-june.rrn\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"psp-upi-report-june.status\"}, {\"lit\": \"success\"}]}, {\"op\": \"or\", \"args\": [{\"op\": \"is_null\", \"arg\": {\"col\": \"pos-payments-june.attempt\"}}, {\"op\": \"!=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"approved\"}]}]}, {\"op\": \"between\", \"arg\": {\"fn\": \"day\", \"arg\": {\"col\": \"psp-upi-report-june.initiated_ts\"}}, \"low\": \"2026-06-20\", \"high\": \"2026-06-21\"}], \"select\": [{\"as\": \"rrn\", \"expr\": {\"col\": \"psp-upi-report-june.rrn\"}}, {\"as\": \"bill_ref\", \"expr\": {\"col\": \"psp-upi-report-june.bill_ref\"}}, {\"as\": \"amount_inr\", \"expr\": {\"col\": \"psp-upi-report-june.amount_inr\"}}, {\"as\": \"initiated_ts\", \"expr\": {\"col\": \"psp-upi-report-june.initiated_ts\"}}, {\"as\": \"status_ts\", \"expr\": {\"col\": \"psp-upi-report-june.status_ts\"}}, {\"as\": \"till_status\", \"expr\": {\"col\": \"pos-payments-june.till_status\"}}], \"order_by\": [{\"by\": \"initiated_ts\", \"dir\": \"asc\"}], \"limit\": 200}",
 "S8N34": "{\"from\": \"customer-complaints-june\", \"joins\": [{\"table\": \"psp-upi-report-june\", \"type\": \"left\", \"on\": [[{\"col\": \"customer-complaints-june.rrn\"}, {\"col\": \"psp-upi-report-june.rrn\"}]]}, {\"table\": \"upi-refunds-june\", \"type\": \"left\", \"on\": [[{\"col\": \"customer-complaints-june.rrn\"}, {\"col\": \"upi-refunds-june.rrn\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"customer-complaints-june.kind\"}, {\"lit\": \"charged twice\"}]}], \"select\": [{\"as\": \"bill_id\", \"expr\": {\"col\": \"customer-complaints-june.bill_id\"}}, {\"as\": \"rrn\", \"expr\": {\"col\": \"customer-complaints-june.rrn\"}}, {\"as\": \"extra_debit_ts\", \"expr\": {\"col\": \"psp-upi-report-june.status_ts\"}}, {\"as\": \"complaint_ts\", \"expr\": {\"col\": \"customer-complaints-june.complaint_ts\"}}, {\"as\": \"refund_completed_ts\", \"expr\": {\"col\": \"upi-refunds-june.completed_ts\"}}, {\"as\": \"days_from_debit\", \"expr\": {\"fn\": \"days_between\", \"args\": [{\"col\": \"psp-upi-report-june.status_ts\"}, {\"col\": \"upi-refunds-june.completed_ts\"}]}}, {\"as\": \"days_from_complaint\", \"expr\": {\"fn\": \"days_between\", \"args\": [{\"col\": \"customer-complaints-june.complaint_ts\"}, {\"col\": \"upi-refunds-june.completed_ts\"}]}}, {\"as\": \"resolution\", \"expr\": {\"col\": \"customer-complaints-june.resolution\"}}], \"order_by\": [{\"by\": \"extra_debit_ts\", \"dir\": \"asc\"}], \"limit\": 200}",
 "S8N35": "{\"from\": \"pos-payments-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}], \"group_by\": [{\"col\": \"pos-payments-june.till_status\"}], \"select\": [{\"as\": \"till_status\", \"expr\": {\"col\": \"pos-payments-june.till_status\"}}, {\"as\": \"attempts\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}",
 "S8N36": "{\"from\": \"psp-upi-report-june\", \"joins\": [{\"table\": \"pos-payments-june\", \"type\": \"left\", \"on\": [[{\"col\": \"psp-upi-report-june.rrn\"}, {\"col\": \"pos-payments-june.rrn\"}]]}, {\"table\": \"upi-refunds-june\", \"type\": \"left\", \"on\": [[{\"col\": \"psp-upi-report-june.rrn\"}, {\"col\": \"upi-refunds-june.rrn\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"psp-upi-report-june.status\"}, {\"lit\": \"success\"}]}, {\"op\": \"or\", \"args\": [{\"op\": \"is_null\", \"arg\": {\"col\": \"pos-payments-june.attempt\"}}, {\"op\": \"!=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"approved\"}]}]}, {\"op\": \"is_null\", \"arg\": {\"col\": \"upi-refunds-june.refund_id\"}}], \"select\": [{\"as\": \"rrn\", \"expr\": {\"col\": \"psp-upi-report-june.rrn\"}}, {\"as\": \"bill_ref\", \"expr\": {\"col\": \"psp-upi-report-june.bill_ref\"}}, {\"as\": \"amount_inr\", \"expr\": {\"col\": \"psp-upi-report-june.amount_inr\"}}, {\"as\": \"debited_ts\", \"expr\": {\"col\": \"psp-upi-report-june.status_ts\"}}, {\"as\": \"till_status\", \"expr\": {\"col\": \"pos-payments-june.till_status\"}}], \"order_by\": [{\"by\": \"debited_ts\", \"dir\": \"asc\"}], \"limit\": 200}",
 "S8N37": "{\"cannot\": \"What was really on a delivery is not recorded: pallets were not weighed and receipts were booked from the pallet label against the shipping notice, and the question bundles several parts (cause, shipment, line, true contents) that one plan in this form cannot express.\"}",
 "S8N38": "{\"cannot\": \"Testing all 12 joins needs 12 separate queries; one plan in this form covers one join.\"}",
 "S9N01": "{\"cannot\": \"The records hold no shelf-space data, and choosing a reallocation is a decision the records cannot make.\"}",
 "S9N02": "{\"cannot\": \"No table records shoppers who walked out without the item.\"}",
 "S9N03": "{\"cannot\": \"The sales records cover only 2026-06-01 to 2026-06-28; there is no June 2023 data.\"}",
 "S9N04": "{\"cannot\": \"Shopper demand is not recorded (only sales, which stop when the shelf is empty), so the records cannot say how much to tune the forecast to match demand.\"}",
 "S9N05": "{\"from\": \"shelf-audits-june\", \"joins\": [{\"table\": \"inventory-book-june\", \"type\": \"left\", \"on\": [[{\"col\": \"shelf-audits-june.sku\"}, {\"col\": \"inventory-book-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"col\": \"inventory-book-june.date\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"shelf-audits-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"lit\": \"2026-06-11\"}]}], \"select\": [{\"as\": \"audit_ts\", \"expr\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"as\": \"shelf_status\", \"expr\": {\"col\": \"shelf-audits-june.status\"}}, {\"as\": \"book_stock\", \"expr\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}], \"order_by\": [{\"by\": \"audit_ts\", \"dir\": \"asc\"}]}",
 "S9N06": "{\"cannot\": \"No table records cashiers or shoplifters; the records cannot attribute missing stock to a person.\"}",
 "S9N07": "{\"cannot\": \"Till records hold no shoppers who left without an item, and a what-if order cut is not in the records.\"}",
 "S9N08": "{\"cannot\": \"No table records who removed stock; the records cannot identify a thief.\"}",
 "S9N09": "{\"from\": \"dc-stock-adjustments-june\", \"where\": [{\"op\": \"in\", \"arg\": {\"col\": \"dc-stock-adjustments-june.sku\"}, \"values\": [\"ATTA-WW-10KG\", \"ATTA-WW-1KG\", \"ATTA-WW-5KG\"]}], \"select\": [{\"as\": \"net_value_at_cost_inr\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"dc-stock-adjustments-june.value_at_cost_inr\"}}}, {\"as\": \"gross_value_at_cost_inr\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"fn\": \"abs\", \"arg\": {\"col\": \"dc-stock-adjustments-june.value_at_cost_inr\"}}}}, {\"as\": \"adjustments\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}",
 "S9N10": "{\"from\": \"pallets-june\", \"joins\": [{\"table\": \"shipments-june\", \"type\": \"inner\", \"on\": [[{\"col\": \"pallets-june.shipment_id\"}, {\"col\": \"shipments-june.shipment_id\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"shipments-june.dispatched_ts\"}}, {\"lit\": \"2026-06-22\"}]}], \"select\": [{\"as\": \"shipment_id\", \"expr\": {\"col\": \"pallets-june.shipment_id\"}}, {\"as\": \"sscc\", \"expr\": {\"col\": \"pallets-june.sscc\"}}, {\"as\": \"weight_check\", \"expr\": {\"col\": \"pallets-june.weight_check\"}}]}",
 "S9N11": "{\"cannot\": \"A future change in how pallets are checked is not in the records, so they cannot say how an OTIF score would change.\"}",
 "S9N12": "{\"cannot\": \"In-full cannot be verified: no pallet was weighed at dispatch and receipts were booked by pallet-label scan against the shipping notice, so received quantities copy the notice; an OTIF figure would also need a per-shipment result rolled up again, which this form cannot express.\"}",
 "S9N13": "{\"from\": \"psp-upi-report-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"psp-upi-report-june.status\"}, {\"lit\": \"success\"}]}], \"group_by\": [{\"col\": \"psp-upi-report-june.bill_ref\"}], \"select\": [{\"as\": \"bill_ref\", \"expr\": {\"col\": \"psp-upi-report-june.bill_ref\"}}, {\"as\": \"successful_debits\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}, {\"as\": \"amount_inr\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"psp-upi-report-june.amount_inr\"}}}], \"having\": [{\"op\": \">=\", \"args\": [{\"ref\": \"successful_debits\"}, {\"lit\": 2}]}], \"order_by\": [{\"by\": \"successful_debits\", \"dir\": \"desc\"}], \"limit\": 200}",
 "S9N14": "{\"from\": \"pos-payments-june\", \"joins\": [{\"table\": \"psp-upi-report-june\", \"type\": \"left\", \"on\": [[{\"col\": \"pos-payments-june.rrn\"}, {\"col\": \"psp-upi-report-june.rrn\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"failed: no response\"}]}], \"group_by\": [{\"col\": \"psp-upi-report-june.status\"}], \"select\": [{\"as\": \"psp_status\", \"expr\": {\"col\": \"psp-upi-report-june.status\"}}, {\"as\": \"timeouts\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}",
 "S9N15": "{\"from\": \"pos-payments-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"failed: no response\"}]}], \"group_by\": [{\"fn\": \"day\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}, {\"fn\": \"hour\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}], \"select\": [{\"as\": \"day\", \"expr\": {\"fn\": \"day\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}}, {\"as\": \"hour\", \"expr\": {\"fn\": \"hour\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}}, {\"as\": \"timeouts\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}], \"having\": [{\"op\": \">=\", \"args\": [{\"ref\": \"timeouts\"}, {\"lit\": 3}]}], \"order_by\": [{\"by\": \"timeouts\", \"dir\": \"desc\"}], \"limit\": 200}",
 "S9N16": "{\"from\": \"psp-upi-report-june\", \"joins\": [{\"table\": \"pos-payments-june\", \"type\": \"left\", \"on\": [[{\"col\": \"psp-upi-report-june.rrn\"}, {\"col\": \"pos-payments-june.rrn\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"psp-upi-report-june.status\"}, {\"lit\": \"success\"}]}, {\"op\": \"or\", \"args\": [{\"op\": \"is_null\", \"arg\": {\"col\": \"pos-payments-june.attempt\"}}, {\"op\": \"!=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"approved\"}]}]}, {\"op\": \"between\", \"arg\": {\"fn\": \"day\", \"arg\": {\"col\": \"psp-upi-report-june.initiated_ts\"}}, \"low\": \"2026-06-20\", \"high\": \"2026-06-21\"}], \"select\": [{\"as\": \"rrn\", \"expr\": {\"col\": \"psp-upi-report-june.rrn\"}}, {\"as\": \"bill_ref\", \"expr\": {\"col\": \"psp-upi-report-june.bill_ref\"}}, {\"as\": \"amount_inr\", \"expr\": {\"col\": \"psp-upi-report-june.amount_inr\"}}, {\"as\": \"initiated_ts\", \"expr\": {\"col\": \"psp-upi-report-june.initiated_ts\"}}, {\"as\": \"status_ts\", \"expr\": {\"col\": \"psp-upi-report-june.status_ts\"}}, {\"as\": \"till_status\", \"expr\": {\"col\": \"pos-payments-june.till_status\"}}], \"order_by\": [{\"by\": \"initiated_ts\", \"dir\": \"asc\"}], \"limit\": 200}",
 "S9N17": "{\"from\": \"upi-refunds-june\", \"joins\": [{\"table\": \"psp-upi-report-june\", \"type\": \"left\", \"on\": [[{\"col\": \"upi-refunds-june.rrn\"}, {\"col\": \"psp-upi-report-june.rrn\"}]]}], \"where\": [{\"op\": \"or\", \"args\": [{\"op\": \">\", \"args\": [{\"fn\": \"days_between\", \"args\": [{\"col\": \"psp-upi-report-june.initiated_ts\"}, {\"col\": \"upi-refunds-june.completed_ts\"}]}, {\"lit\": 5}]}, {\"op\": \"is_null\", \"arg\": {\"col\": \"upi-refunds-june.completed_ts\"}}]}], \"select\": [{\"as\": \"refund_id\", \"expr\": {\"col\": \"upi-refunds-june.refund_id\"}}, {\"as\": \"rrn\", \"expr\": {\"col\": \"upi-refunds-june.rrn\"}}, {\"as\": \"debited_ts\", \"expr\": {\"col\": \"psp-upi-report-june.initiated_ts\"}}, {\"as\": \"requested_ts\", \"expr\": {\"col\": \"upi-refunds-june.requested_ts\"}}, {\"as\": \"completed_ts\", \"expr\": {\"col\": \"upi-refunds-june.completed_ts\"}}, {\"as\": \"days_from_debit\", \"expr\": {\"fn\": \"days_between\", \"args\": [{\"col\": \"psp-upi-report-june.initiated_ts\"}, {\"col\": \"upi-refunds-june.completed_ts\"}]}}], \"order_by\": [{\"by\": \"days_from_debit\", \"dir\": \"desc\"}], \"limit\": 200}"
}