{"S8N01": "{\"from\": \"daily-sales-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"daily-sales-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"between\", \"arg\": {\"col\": \"daily-sales-june.date\"}, \"low\": \"2026-06-01\", \"high\": \"2026-06-30\"}], \"select\": [{\"as\": \"bags\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"daily-sales-june.units_sold\"}}}]}", "S8N02": "{\"cannot\": \"The records only hold a daily closing book stock (inventory-book-june), not an hourly book, so audits cannot be compared with an hourly book.\"}", "S8N03": "{\"from\": \"inventory-book-june\", \"where\": [{\"op\": \"<\", \"args\": [{\"col\": \"inventory-book-june.book_on_hand_close\"}, {\"lit\": 0}]}], \"select\": [{\"as\": \"date\", \"expr\": {\"col\": \"inventory-book-june.date\"}}, {\"as\": \"sku\", \"expr\": {\"col\": \"inventory-book-june.sku\"}}, {\"as\": \"book_on_hand_close\", \"expr\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}], \"order_by\": [{\"by\": \"date\", \"dir\": \"asc\"}], \"limit\": 200}", "S8N04": "{\"from\": \"stock-counts-june\", \"where\": [{\"op\": \">\", \"args\": [{\"col\": \"stock-counts-june.book_before\"}, {\"lit\": 0}]}, {\"op\": \">\", \"args\": [{\"fn\": \"abs\", \"arg\": {\"op\": \"/\", \"args\": [{\"op\": \"-\", \"args\": [{\"col\": \"stock-counts-june.counted\"}, {\"col\": \"stock-counts-june.book_before\"}]}, {\"col\": \"stock-counts-june.book_before\"}]}}, {\"lit\": 0.02}]}], \"select\": [{\"as\": \"count_ts\", \"expr\": {\"col\": \"stock-counts-june.count_ts\"}}, {\"as\": \"sku\", \"expr\": {\"col\": \"stock-counts-june.sku\"}}, {\"as\": \"book_before\", \"expr\": {\"col\": \"stock-counts-june.book_before\"}}, {\"as\": \"counted\", \"expr\": {\"col\": \"stock-counts-june.counted\"}}, {\"as\": \"adjustment\", \"expr\": {\"col\": \"stock-counts-june.adjustment\"}}], \"order_by\": [{\"by\": \"count_ts\", \"dir\": \"asc\"}], \"limit\": 200}", "S8N05": "{\"cannot\": \"Comparing each product's week 1 sales with its week 2 sales needs two separate period totals side by side, which this plan form cannot express (no week function, no conditional totals, a table can appear once).\"}", "S8N06": "{\"from\": \"pos-lines-may-june\", \"joins\": [{\"table\": \"write-offs-june\", \"type\": \"left\", \"on\": [[{\"col\": \"pos-lines-may-june.sku_scanned\"}, {\"col\": \"write-offs-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}, {\"fn\": \"day\", \"arg\": {\"col\": \"write-offs-june.date\"}}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-lines-may-june.sku_scanned\"}, {\"lit\": \"MILK-TONED-500ML\"}]}], \"group_by\": [{\"fn\": \"day\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}, {\"col\": \"write-offs-june.reason\"}], \"select\": [{\"as\": \"day\", \"expr\": {\"fn\": \"day\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}}, {\"as\": \"last_sale_ts\", \"expr\": {\"agg\": \"max\", \"arg\": {\"col\": \"pos-lines-may-june.bill_ts\"}}}, {\"as\": \"write_off_reason\", \"expr\": {\"col\": \"write-offs-june.reason\"}}, {\"as\": \"pouches_written_off\", \"expr\": {\"agg\": \"max\", \"arg\": {\"col\": \"write-offs-june.units\"}}}], \"order_by\": [{\"by\": \"day\", \"dir\": \"asc\"}], \"limit\": 200}", "S8N07": "{\"from\": \"daily-sales-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"daily-sales-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"between\", \"arg\": {\"col\": \"daily-sales-june.date\"}, \"low\": \"2026-06-01\", \"high\": \"2026-06-28\"}], \"group_by\": [{\"col\": \"daily-sales-june.date\"}], \"select\": [{\"as\": \"date\", \"expr\": {\"col\": \"daily-sales-june.date\"}}, {\"as\": \"units_sold\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"daily-sales-june.units_sold\"}}}], \"order_by\": [{\"by\": \"date\", \"dir\": \"asc\"}], \"limit\": 200}", "S8N08": "{\"from\": \"inventory-book-june\", \"joins\": [{\"table\": \"shelf-audits-june\", \"type\": \"left\", \"on\": [[{\"col\": \"inventory-book-june.sku\"}, {\"col\": \"shelf-audits-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"inventory-book-june.date\"}}, {\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"inventory-book-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"inventory-book-june.date\"}, {\"lit\": \"2026-06-11\"}]}], \"select\": [{\"as\": \"date\", \"expr\": {\"col\": \"inventory-book-june.date\"}}, {\"as\": \"book_on_hand_close\", \"expr\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}, {\"as\": \"audit_ts\", \"expr\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"as\": \"shelf_status\", \"expr\": {\"col\": \"shelf-audits-june.status\"}}]}", "S8N09": "{\"cannot\": \"The records have no customer identifier linking a shopper's purchases over time, so switching between 5 kg and 1 kg atta cannot be observed.\"}", "S8N10": "{\"from\": \"shelf-audits-june\", \"joins\": [{\"table\": \"inventory-book-june\", \"type\": \"left\", \"on\": [[{\"col\": \"shelf-audits-june.sku\"}, {\"col\": \"inventory-book-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"fn\": \"day\", \"arg\": {\"col\": \"inventory-book-june.date\"}}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"shelf-audits-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}], \"group_by\": [{\"col\": \"shelf-audits-june.status\"}], \"select\": [{\"as\": \"shelf_status\", \"expr\": {\"col\": \"shelf-audits-june.status\"}}, {\"as\": \"audits\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}, {\"as\": \"avg_book_close\", \"expr\": {\"agg\": \"avg\", \"arg\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}}]}", "S8N11": "{\"from\": \"daily-sales-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"daily-sales-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"between\", \"arg\": {\"col\": \"daily-sales-june.date\"}, \"low\": \"2026-06-01\", \"high\": \"2026-06-28\"}], \"group_by\": [{\"col\": \"daily-sales-june.date\"}], \"select\": [{\"as\": \"date\", \"expr\": {\"col\": \"daily-sales-june.date\"}}, {\"as\": \"units_sold\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"daily-sales-june.units_sold\"}}}], \"order_by\": [{\"by\": \"date\", \"dir\": \"asc\"}], \"limit\": 200}", "S8N12": "{\"cannot\": \"Shoppers who left without atta and the sales lost are not recorded anywhere; the tills only record what was sold.\"}", "S8E13": "{\"from\": \"shipments-june\", \"where\": [{\"op\": \">=\", \"args\": [{\"col\": \"shipments-june.arrived_ts\"}, {\"col\": \"shipments-june.slot_start\"}]}, {\"op\": \"<=\", \"args\": [{\"col\": \"shipments-june.arrived_ts\"}, {\"col\": \"shipments-june.slot_end\"}]}], \"select\": [{\"as\": \"on_time_deliveries\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}", "S8N14": "{\"from\": \"pallets-june\", \"group_by\": [{\"col\": \"pallets-june.weight_check\"}], \"select\": [{\"as\": \"weight_check\", \"expr\": {\"col\": \"pallets-june.weight_check\"}}, {\"as\": \"pallets\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}", "S8N15": "{\"from\": \"store-orders-june\", \"joins\": [{\"table\": \"shipping-notice-lines-june\", \"type\": \"left\", \"on\": [[{\"col\": \"store-orders-june.order_id\"}, {\"col\": \"shipping-notice-lines-june.order_id\"}], [{\"col\": \"store-orders-june.sku\"}, {\"col\": \"shipping-notice-lines-june.sku\"}]]}], \"select\": [{\"as\": \"cases_ordered\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"store-orders-june.cases\"}}}, {\"as\": \"cases_on_notices\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"shipping-notice-lines-june.cases\"}}}, {\"as\": \"case_fill_rate\", \"expr\": {\"op\": \"/\", \"args\": [{\"agg\": \"sum\", \"arg\": {\"col\": \"shipping-notice-lines-june.cases\"}}, {\"agg\": \"sum\", \"arg\": {\"col\": \"store-orders-june.cases\"}}]}}]}", "S8N16": "{\"cannot\": \"Warehouse corrections (dc-stock-adjustments-june, valued at cost) and store corrections (stock-counts-june, in packs) are different tables with no join that does not multiply rows, so one net and gross value across both cannot be computed in a single plan.\"}", "S8N17": "{\"cannot\": \"Matching warehouse and store corrections by opposite sign, within 15% in cases and within 7 days needs range and tolerance joins and a product-family mapping, which this plan form (equality joins only) cannot express.\"}", "S8N18": "{\"cannot\": \"Linking each goods receipt to the next stock count within a week needs a time-window join and comparison of receipt quantity with a later count change, which this plan form cannot express.\"}", "S8N19": "{\"from\": \"shipments-june\", \"joins\": [{\"table\": \"dc-pick-confirmations-june\", \"type\": \"left\", \"on\": [[{\"col\": \"shipments-june.shipment_id\"}, {\"col\": \"dc-pick-confirmations-june.shipment_id\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"fn\": \"day\", \"arg\": {\"col\": \"shipments-june.arrived_ts\"}}, {\"lit\": \"2026-06-22\"}]}], \"group_by\": [{\"col\": \"shipments-june.shipment_id\"}, {\"col\": \"shipments-june.arrived_ts\"}, {\"col\": \"shipments-june.slot_start\"}, {\"col\": \"shipments-june.slot_end\"}], \"select\": [{\"as\": \"shipment_id\", \"expr\": {\"col\": \"shipments-june.shipment_id\"}}, {\"as\": \"arrived_ts\", \"expr\": {\"col\": \"shipments-june.arrived_ts\"}}, {\"as\": \"slot_start\", \"expr\": {\"col\": \"shipments-june.slot_start\"}}, {\"as\": \"slot_end\", \"expr\": {\"col\": \"shipments-june.slot_end\"}}, {\"as\": \"cases_ordered\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"dc-pick-confirmations-june.cases_ordered\"}}}, {\"as\": \"cases_confirmed\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"dc-pick-confirmations-june.cases_confirmed\"}}}]}", "S8N20": "{\"from\": \"shipments-june\", \"joins\": [{\"table\": \"dc-pick-confirmations-june\", \"type\": \"left\", \"on\": [[{\"col\": \"shipments-june.shipment_id\"}, {\"col\": \"dc-pick-confirmations-june.shipment_id\"}]]}], \"group_by\": [{\"col\": \"shipments-june.shipment_id\"}, {\"col\": \"shipments-june.arrived_ts\"}, {\"col\": \"shipments-june.slot_start\"}, {\"col\": \"shipments-june.slot_end\"}], \"select\": [{\"as\": \"shipment_id\", \"expr\": {\"col\": \"shipments-june.shipment_id\"}}, {\"as\": \"arrived_ts\", \"expr\": {\"col\": \"shipments-june.arrived_ts\"}}, {\"as\": \"slot_start\", \"expr\": {\"col\": \"shipments-june.slot_start\"}}, {\"as\": \"slot_end\", \"expr\": {\"col\": \"shipments-june.slot_end\"}}, {\"as\": \"cases_ordered\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"dc-pick-confirmations-june.cases_ordered\"}}}, {\"as\": \"cases_confirmed\", \"expr\": {\"agg\": \"sum\", \"arg\": {\"col\": \"dc-pick-confirmations-june.cases_confirmed\"}}}], \"order_by\": [{\"by\": \"shipment_id\", \"dir\": \"asc\"}], \"limit\": 200}", "S8N21": "{\"from\": \"shelf-audits-june\", \"joins\": [{\"table\": \"inventory-book-june\", \"type\": \"left\", \"on\": [[{\"col\": \"shelf-audits-june.sku\"}, {\"col\": \"inventory-book-june.sku\"}], [{\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"fn\": \"day\", \"arg\": {\"col\": \"inventory-book-june.date\"}}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"shelf-audits-june.sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}, {\"op\": \"between\", \"arg\": {\"fn\": \"day\", \"arg\": {\"col\": \"shelf-audits-june.audit_ts\"}}, \"low\": \"2026-06-23\", \"high\": \"2026-06-26\"}], \"select\": [{\"as\": \"audit_ts\", \"expr\": {\"col\": \"shelf-audits-june.audit_ts\"}}, {\"as\": \"shelf_status\", \"expr\": {\"col\": \"shelf-audits-june.status\"}}, {\"as\": \"book_on_hand_close\", \"expr\": {\"col\": \"inventory-book-june.book_on_hand_close\"}}], \"order_by\": [{\"by\": \"audit_ts\", \"dir\": \"asc\"}], \"limit\": 200}", "S8N22": "{\"cannot\": \"The records do not say who or what caused a stock shortfall; theft cannot be established or ruled out from these tables.\"}", "S8N23": "{\"from\": \"goods-receipts-june\", \"joins\": [{\"table\": \"shipping-notice-lines-june\", \"type\": \"left\", \"on\": [[{\"col\": \"goods-receipts-june.sscc\"}, {\"col\": \"shipping-notice-lines-june.sscc\"}], [{\"col\": \"goods-receipts-june.asn_sku\"}, {\"col\": \"shipping-notice-lines-june.sku\"}]]}, {\"table\": \"pallets-june\", \"type\": \"left\", \"on\": [[{\"col\": \"goods-receipts-june.sscc\"}, {\"col\": \"pallets-june.sscc\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"goods-receipts-june.asn_sku\"}, {\"lit\": \"ATTA-WW-5KG\"}]}], \"select\": [{\"as\": \"shipment_id\", \"expr\": {\"col\": \"goods-receipts-june.shipment_id\"}}, {\"as\": \"sscc\", \"expr\": {\"col\": \"goods-receipts-june.sscc\"}}, {\"as\": \"line\", \"expr\": {\"col\": \"goods-receipts-june.line\"}}, {\"as\": \"received_ts\", \"expr\": {\"col\": \"goods-receipts-june.received_ts\"}}, {\"as\": \"asn_units\", \"expr\": {\"col\": \"goods-receipts-june.asn_units\"}}, {\"as\": \"units_booked\", \"expr\": {\"col\": \"goods-receipts-june.units_booked\"}}, {\"as\": \"sku_booked\", \"expr\": {\"col\": \"goods-receipts-june.sku_booked\"}}, {\"as\": \"notice_units\", \"expr\": {\"col\": \"shipping-notice-lines-june.units\"}}, {\"as\": \"notice_kg\", \"expr\": {\"col\": \"pallets-june.notice_kg\"}}, {\"as\": \"weight_check\", \"expr\": {\"col\": \"pallets-june.weight_check\"}}], \"order_by\": [{\"by\": \"received_ts\", \"dir\": \"asc\"}], \"limit\": 200}", "S8N24": "{\"cannot\": \"Shoppers' unmet demand (bags wanted but not found) is not recorded; the records only show bags sold.\"}", "S8A25": "{\"from\": \"pos-payments-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}], \"select\": [{\"as\": \"upi_attempts\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}", "S8E26": "{\"from\": \"pos-payments-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"failed: no response\"}]}, {\"op\": \"is_null\", \"arg\": {\"col\": \"pos-payments-june.rrn\"}}], \"select\": [{\"as\": \"timeouts_without_rrn\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}]}", "S8N27": "{\"from\": \"psp-upi-report-june\", \"joins\": [{\"table\": \"pos-payments-june\", \"type\": \"left\", \"on\": [[{\"col\": \"psp-upi-report-june.rrn\"}, {\"col\": \"pos-payments-june.rrn\"}]]}], \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"psp-upi-report-june.status\"}, {\"lit\": \"success\"}]}, {\"op\": \"or\", \"args\": [{\"op\": \"is_null\", \"arg\": {\"col\": \"pos-payments-june.rrn\"}}, {\"op\": \"!=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"approved\"}]}]}], \"select\": [{\"as\": \"rrn\", \"expr\": {\"col\": \"psp-upi-report-june.rrn\"}}, {\"as\": \"bill_ref\", \"expr\": {\"col\": \"psp-upi-report-june.bill_ref\"}}, {\"as\": \"amount_inr\", \"expr\": {\"col\": \"psp-upi-report-june.amount_inr\"}}, {\"as\": \"initiated_ts\", \"expr\": {\"col\": \"psp-upi-report-june.initiated_ts\"}}, {\"as\": \"till_status\", \"expr\": {\"col\": \"pos-payments-june.till_status\"}}], \"order_by\": [{\"by\": \"initiated_ts\", \"dir\": \"asc\"}], \"limit\": 200}", "S8N28": "{\"from\": \"pos-payments-june\", \"where\": [{\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.tender\"}, {\"lit\": \"UPI\"}]}, {\"op\": \"=\", \"args\": [{\"col\": \"pos-payments-june.till_status\"}, {\"lit\": \"failed: no response\"}]}], \"group_by\": [{\"fn\": \"day\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}, {\"fn\": \"hour\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}], \"having\": [{\"op\": \">=\", \"args\": [{\"ref\": \"timeouts\"}, {\"lit\": 3}]}], \"select\": [{\"as\": \"day\", \"expr\": {\"fn\": \"day\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}}, {\"as\": \"hour\", \"expr\": {\"fn\": \"hour\", \"arg\": {\"col\": \"pos-payments-june.ts\"}}}, {\"as\": \"timeouts\", \"expr\": {\"agg\": \"count\", \"arg\": \"*\"}}], \"order_by\": [{\"by\": \"timeouts\", \"dir\