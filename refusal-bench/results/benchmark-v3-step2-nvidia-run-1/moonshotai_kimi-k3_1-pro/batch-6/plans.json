 "Q269": {
  "plans": [
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "select": [
     {
      "as": "first_bill_day",
      "expr": {
       "fn": "day",
       "arg": {
        "agg": "min",
        "arg": {
         "col": "pos-payments-june.ts"
        }
       }
      }
     },
     {
      "as": "last_bill_day",
      "expr": {
       "fn": "day",
       "arg": {
        "agg": "max",
        "arg": {
         "col": "pos-payments-june.ts"
        }
       }
      }
     },
     {
      "as": "days_with_approved_bills",
      "expr": {
       "agg": "count_distinct",
       "arg": {
        "fn": "day",
        "arg": {
         "col": "pos-payments-june.ts"
        }
       }
      }
     }
    ],
    "layer": "knowledge",
    "covers": "Checks the 30-versus-28 premise using approved June payments: the first and last billing dates and how many distinct dates have bills; actual opening days and any open day with no recorded payment are not recorded."
   },
   {
    "from": "upi-settlements-june",
    "select": [
     {
      "as": "first_settlement_date",
      "expr": {
       "agg": "min",
       "arg": {
        "col": "upi-settlements-june.settlement_date"
       }
      }
     },
     {
      "as": "last_settlement_date",
      "expr": {
       "agg": "max",
       "arg": {
        "col": "upi-settlements-june.settlement_date"
       }
      }
     },
     {
      "as": "settlement_dates_recorded",
      "expr": {
       "agg": "count_distinct",
       "arg": {
        "col": "upi-settlements-june.settlement_date"
       }
      }
     }
    ],
    "layer": "knowledge",
    "covers": "Checks the later end of June using recorded UPI settlement dates through 2026-06-30; settlements are evidence of activity, not a store opening calendar, so they cannot prove the store stayed open for 30 days."
   }
  ]
 },
