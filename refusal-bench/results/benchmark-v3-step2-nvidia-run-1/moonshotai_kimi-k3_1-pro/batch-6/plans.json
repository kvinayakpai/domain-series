     "arg": "*"
    }
   }
  ],
  "layer": "schema",
  "covers": "Counts products with a selling price above 100 rupees."
 },
 "Q244": {
  "from": "daily-sales-june",
  "joins": [
   {
    "table": "products",
    "type": "inner",
    "on": [
     [
      {
       "col": "daily-sales-june.sku"
      },
      {
       "col": "products.sku"
      }
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "=",
    "args": [
     {
      "col": "daily-sales-june.sku"
     },
     {
      "lit": "RICE-SM-5KG"
     }
    ]
   },
   {
    "op": "between",
    "arg": {
     "fn": "day",
     "arg": {
      "col": "daily-sales-june.date"
     }
    },
    "low": "2026-06-01",
    "high": "2026-06-28"
   }
  ],
  "group_by": [],
  "select": [
   {
    "as": "rice_units_sold",
    "expr": {
     "agg": "sum",
     "arg": {
      "col": "daily-sales-june.units_sold"
     }
    }
   },
   {
    "as": "rice_revenue_inr",
    "expr": {
     "agg": "sum",
     "arg": {
      "col": "daily-sales-june.revenue_inr"
     }
    }
   },
   {
    "as": "rice_list_cost_inr",
    "expr": {
     "agg": "sum",
     "arg": {
      "op": "*",
      "args": [
       {
        "col": "daily-sales-june.units_sold"
       },
       {
        "col": "products.cost_inr"
       }
      ]
     }
    }
   },
   {
    "as": "rice_list_margin_inr",
    "expr": {
     "op": "-",
     "args": [
      {
       "agg": "sum",
       "arg": {
        "col": "daily-sales-june.revenue_inr"
       }
      },
      {
       "agg": "sum",
       "arg": {
        "op": "*",
        "args": [
         {
          "col": "daily-sales-june.units_sold"
         },
         {
          "col": "products.cost_inr"
         }
        ]
       }
      }
     ]
    }
   }
  ],
  "having": [],
  "order_by": [],
  "limit": 1,
  "layer": "knowledge",
  "covers": "List-margin stand-in for Sona masoori rice 5 kg (RICE-SM-5KG) over recorded June 2026 days 2026-06-01 to 2026-06-28: revenue minus units sold times the single product cost; true profit is not recorded because other costs, margins and expenses are unavailable, and sales cover only the eleven followed items."
 },
 "Q245": {
  "from": "products",
