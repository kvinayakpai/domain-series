    }
   }
  ],
  "layer": "schema",
  "covers": "The recorded cost per product for Sugar 1 kg (SUGAR-1KG), in rupees."
 },
 "Q246": {
  "from": "products",
  "where": [],
  "group_by": [],
  "select": [
   {
    "as": "sku",
    "expr": {
     "col": "products.sku"
    }
   },
   {
    "as": "product_name",
    "expr": {
     "col": "products.name"
    }
   },
   {
    "as": "price_inr",
    "expr": {
     "col": "products.price_inr"
    }
   },
   {
    "as": "cost_inr",
    "expr": {
     "col": "products.cost_inr"
    }
   },
   {
    "as": "gross_margin_pct",
    "expr": {
     "fn": "round",
     "arg": {
      "op": "*",
      "args": [
       {
        "op": "/",
        "args": [
         {
          "op": "-",
          "args": [
           {
            "col": "products.price_inr"
           },
           {
            "col": "products.cost_inr"
           }
          ]
         },
         {
          "col": "products.price_inr"
         }
        ]
       },
       {
        "lit": 100
       }
      ]
     }
    }
   }
  ],
  "having": [],
  "order_by": [
   {
    "by": "gross_margin_pct",
    "dir": "desc"
   }
  ],
  "limit": 200,
  "layer": "knowledge",
  "covers": "List margin proxy: price_inr minus the single recorded cost_inr per product, divided by price_inr, for every SKU ranked highest to lowest; this is not a real gross margin because actual costs, fees, waste and other expenses are not recorded (list_margin)."
 },
 "Q247": {
  "plans": [
   {
    "from": "pos-lines-may-june",
    "where": [
     {
      "op": ">=",
      "args": [
       {
        "col": "pos-lines-may-june.bill_ts"
       },
       {
        "lit": "2026-06-01"
       }
      ]
     },
     {
      "op": "<",
      "args": [
       {
        "col": "pos-lines-may-june.bill_ts"
       },
       {
        "lit": "2026-07-01"
       }
      ]
     }
    ],
    "select": [
     {
      "as": "june_lines",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "lines_not_qty_times_price",
      "expr": {
       "agg": "sum",
       "arg": {
        "op": "-",
        "args": [
         {
          "col": "pos-lines-may-june.line_amount"
         },
         {
          "op": "*",
          "args": [
           {
            "col": "pos-lines-may-june.qty"
           },
           {
            "col": "pos-lines-may-june.unit_price"
           }
          ]
         }
        ]
       }
      }
     }
    ],
    "layer": "ontology",
    "covers": "Checks the stated line_amount = qty * unit_price premise on June till lines; this arithmetic identity alone cannot establish whether unit_price was discounted, so the second plan compares it with the product list price."
   },
   {
    "from": "pos-lines-may-june",
    "joins": [
     {
      "table": "products",
      "type": "inner",
      "on": [
       [
        {
         "col": "pos-lines-may-june.sku_scanned"
        },
        {
         "col": "products.sku"
        }
       ]
      ]
     }
    ],
    "where": [
     {
      "op": ">=",
      "args": [
       {
        "col": "pos-lines-may-june.bill_ts"
       },
       {
        "lit": "2026-06-01"
       }
      ]
     },
     {
      "op": "<",
      "args": [
       {
        "col": "pos-lines-may-june.bill_ts"
       },
       {
        "lit": "2026-07-01"
       }
      ]
     },
     {
      "op": "<",
      "args": [
       {
        "col": "pos-lines-may-june.unit_price"
       },
       {
        "col": "products.price_inr"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-lines-may-june.sku_scanned"
     },
     {
      "col": "products.name"
     },
     {
      "col": "products.price_inr"
     },
     {
      "col": "pos-lines-may-june.unit_price"
     }
    ],
    "select": [
     {
      "as": "sku",
      "expr": {
       "col": "pos-lines-may-june.sku_scanned"
      }
     },
     {
      "as": "product",
      "expr": {
       "col": "products.name"
      }
     },
     {
      "as": "list_price_inr",
      "expr": {
       "col": "products.price_inr"
      }
     },
     {
      "as": "charged_unit_price_inr",
      "expr": {
       "col": "pos-lines-may-june.unit_price"
      }
     },
     {
      "as": "lines_below_list",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "units_below_list",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "pos-lines-may-june.qty"
       }
      }
     },
     {
      "as": "first_seen",
      "expr": {
       "agg": "min",
       "arg": {
        "col": "pos-lines-may-june.bill_ts"
       }
      }
     },
     {
      "as": "last_seen",
      "expr": {
       "agg": "max",
       "arg": {
        "col": "pos-lines-may-june.bill_ts"
       }
      }
     }
    ],
    "order_by": [
     {
      "by": "sku",
      "dir": "asc"
     },
     {
      "by": "charged_unit_price_inr",
      "dir": "asc"
     }
    ],
    "limit": 200,
    "layer": "ontology",
    "covers": "Finds June lines for the eleven followed items whose unit price is below products.price_inr, using a below-list charged price as the recorded evidence of a discount; no rows means no such discount is recorded."
   }
  ]
 },
 "Q248": {
  "cannot": "The records list only one 5 kg atta product, ATTA-WW-5KG (Whole wheat atta 5 kg), and no table records a brand or manufacturer for any product."
 },
 "Q249": {
  "cannot": "No table records a markdown or a reduced selling price, so units of BREAD-WHITE-400G sold at a markdown before expiring cannot be identified; daily-sales-june and pos-lines-may-june record sales but no markdown flag, and write-offs-june records expired units, not sales."
 },
 "Q251": {
  "cannot": "No table records staff, shifts, staffing levels or workload per hour, and no recorded stand-in can determine how many staff are needed in each hour."
 },
 "Q252": {
  "cannot": "No table identifies a delivery driver or links a person to a route; fresh-deliveries-june records route R-07 and delivery times but no driver identity, so the driver on 2026-06-10 cannot be named."
 },
 "Q253": {
  "cannot": "No table identifies a cashier, and the records hold no bill sequence or bill numbering that would identify the 5,000th bill of June 2026; bills can only be counted from approved payments, with no cashier attached."
 },
 "Q255": {
  "cannot": "No table identifies a supplier (person_identity); fresh-deliveries-june records route R-12 and sku CURD-500G but no supplier, and products has no supplier column, so the supplier who delivered the curd cannot be named from the records."
 },
 "Q256": {
