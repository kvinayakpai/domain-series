{
 "Q151": {
  "from": "fresh-deliveries-june",
  "joins": [
   {
    "table": "products",
    "type": "inner",
    "on": [
     [
      {
       "col": "fresh-deliveries-june.sku"
      },
      {
       "col": "products.sku"
      }
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "in",
    "arg": {
     "col": "fresh-deliveries-june.sku"
    },
    "values": [
     "MILK-FC-500ML",
     "MILK-TONED-500ML",
     "CURD-500G",
     "BREAD-WHITE-400G"
    ]
   }
  ],
  "group_by": [
   {
    "col": "fresh-deliveries-june.sku"
   },
   {
    "col": "products.name"
   }
  ],
  "select": [
   {
    "as": "sku",
    "expr": {
     "col": "fresh-deliveries-june.sku"
    }
   },
   {
    "as": "product",
    "expr": {
     "col": "products.name"
    }
   },
   {
    "as": "deliveries",
    "expr": {
     "agg": "count",
     "arg": "*"
    }
   },
   {
    "as": "min_shelf_life_days_on_arrival",
    "expr": {
     "agg": "min",
     "arg": {
      "fn": "days_between",
      "args": [
       {
        "fn": "day",
        "arg": {
         "col": "fresh-deliveries-june.delivery_ts"
        }
       },
       {
        "col": "fresh-deliveries-june.use_by"
       }
      ]
     }
    }
   },
   {
    "as": "avg_shelf_life_days_on_arrival",
    "expr": {
     "agg": "avg",
     "arg": {
      "fn": "days_between",
      "args": [
       {
        "fn": "day",
        "arg": {
         "col": "fresh-deliveries-june.delivery_ts"
        }
       },
       {
        "col": "fresh-deliveries-june.use_by"
       }
      ]
     }
    }
   },
   {
    "as": "max_shelf_life_days_on_arrival",
    "expr": {
     "agg": "max",
     "arg": {
      "fn": "days_between",
      "args": [
       {
        "fn": "day",
        "arg": {
         "col": "fresh-deliveries-june.delivery_ts"
        }
       },
       {
        "col": "fresh-deliveries-june.use_by"
       }
      ]
     }
    }
   }
  ],
  "order_by": [
   {
    "by": "product",
    "dir": "asc"
   }
  ],
  "layer": "ontology",
  "covers": "For each milk, curd and bread product, calculates use_by minus the delivery date in days and summarizes the delivery count, minimum, average and maximum shelf life on arrival."
 },
 "Q152": {
  "from": "shipping-notice-lines-june",
  "group_by": [
   {
    "col": "shipping-notice-lines-june.sscc"
   }
  ],
  "select": [
   {
    "as": "sscc",
    "expr": {
     "col": "shipping-notice-lines-june.sscc"
    }
   },
   {
    "as": "sku_count",
    "expr": {
     "agg": "count_distinct",
     "arg": {
      "col": "shipping-notice-lines-june.sku"
     }
    }
   }
  ],
  "having": [
   {
    "op": ">",
    "args": [
     {
      "ref": "sku_count"
     },
     {
      "lit": 1
     }
    ]
   }
  ],
  "layer": "schema",
  "covers": "Counts distinct SKUs per SSCC pallet label in the shipping-notice lines and keeps labels carrying more than one SKU."
 },
 "Q153": {
  "from": "store-orders-june",
  "joins": [
   {
    "table": "shipping-notice-lines-june",
    "type": "inner",
    "on": [
     [
      {
       "col": "store-orders-june.order_id"
      },
      {
       "col": "shipping-notice-lines-june.order_id"
      }
     ],
     [
      {
       "col": "store-orders-june.sku"
      },
      {
       "col": "shipping-notice-lines-june.sku"
      }
     ]
    ]
   },
   {
    "table": "goods-receipts-june",
    "type": "inner",
    "on": [
     [
      {
       "col": "shipping-notice-lines-june.shipment_id"
      },
      {
       "col": "goods-receipts-june.shipment_id"
      }
     ],
     [
      {
       "col": "shipping-notice-lines-june.sku"
      },
      {
       "col": "goods-receipts-june.sku_booked"
      }
     ]
    ]
   }
  ],
  "where": [
   {
    "op": ">=",
    "args": [
     {
      "col": "store-orders-june.created_ts"
     },
     {
      "lit": "2026-06-01"
     }
    ]
   },
   {
    "op": "<",
    "args": [
     {
      "col": "store-orders-june.created_ts"
     },
     {
      "lit": "2026-07-01"
     }
    ]
   }
  ],
  "group_by": [],
  "select": [
   {
    "as": "avg_lead_time_hours",
    "expr": {
     "agg": "avg",
     "arg": {
      "fn": "hours_between",
      "args": [
       {
        "col": "store-orders-june.created_ts"
       },
       {
        "col": "goods-receipts-june.received_ts"
       }
      ]
     }
    }
   }
  ],
  "having": [],
  "order_by": [],
  "limit": 200,
  "layer": "ontology",
  "covers": "Average lead time in hours from store order creation to goods receipt for orders created in June 2026, joining orders to shipping-notice lines on order_id and sku, then to goods receipts on shipment_id and sku."
 },
 "Q154": {
  "from": "goods-receipts-june",
  "where": [
   {
    "op": "or",
    "args": [
     {
      "op": "!=",
      "args": [
       {
        "col": "goods-receipts-june.asn_units"
       },
       {
        "col": "goods-receipts-june.units_booked"
       }
      ]
     },
     {
      "op": "!=",
      "args": [
       {
        "col": "goods-receipts-june.asn_sku"
       },
       {
        "col": "goods-receipts-june.sku_booked"
       }
      ]
     }
    ]
   }
  ],
  "select": [
   {
    "as": "lines_not_matching_notice",
    "expr": {
     "agg": "count",
     "arg": "*"
    }
   }
  ],
  "layer": "schema",
  "covers": "Checks the stated premise by counting June goods-receipt lines where booked units or booked SKU differ from the shipping notice; this tests receipt-against-notice agreement, not warehouse shipment completeness or physical item correctness."
 },
 "Q155": {
  "cannot": "No table records an actual pallet weight: pallets-june has only notice_kg and weight_check = 'not weighed', so a 160 kg shortfall on 22 June cannot be checked, and no pallet date column exists to select that day."
 },
 "Q156": {
  "from": "dc-pick-confirmations-june",
  "where": [
   {
    "op": "=",
    "args": [
     {
      "col": "dc-pick-confirmations-june.confirmed_by"
     },
     {
      "lit": "slot label scan"
     }
    ]
   },
   {
    "op": "between",
    "arg": {
     "col": "dc-pick-confirmations-june.pick_ts"
    },
    "low": "2026-06-01",
    "high": "2026-06-28"
   }
  ],
  "select": [
   {
    "as": "pick_confirmations",
    "expr": {
     "agg": "count",
     "arg": "*"
    }
   }
  ],
  "layer": "schema",
  "covers": "Counts June 2026 pick confirmations recorded with the only available confirmation method, 'slot label scan', which is the recorded stand-in for case-barcode scanning."
 },
 "Q157": {
  "from": "dc-pick-confirmations-june",
  "joins": [
   {
    "table": "shipments-june",
    "type": "inner",
    "on": [
     [
      {
       "col": "dc-pick-confirmations-june.shipment_id"
      },
      {
       "col": "shipments-june.shipment_id"
      }
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "=",
    "args": [
     {
      "col": "dc-pick-confirmations-june.sku"
     },
     {
      "lit": "ATTA-WW-1KG"
     }
    ]
   },
   {
    "op": "=",
    "args": [
     {
      "fn": "day",
      "arg": {
       "col": "shipments-june.dispatched_ts"
      }
     },
     {
      "lit": "2026-06-22"
     }
    ]
   }
  ],
  "group_by": [
   {
    "col": "dc-pick-confirmations-june.shipment_id"
   }
  ],
  "select": [
   {
    "as": "shipment_id",
    "expr": {
     "col": "dc-pick-confirmations-june.shipment_id"
    }
   },
   {
    "as": "cases_confirmed",
    "expr": {
     "agg": "sum",
     "arg": {
      "col": "dc-pick-confirmations-june.cases_confirmed"
     }
    }
   }
  ],
  "order_by": [
   {
    "by": "shipment_id",
    "dir": "asc"
   }
  ],
  "limit": 200,
  "layer": "knowledge",
  "covers": "Sums confirmed pick cases for ATTA-WW-1KG on shipments dispatched on 2026-06-22 as a stand-in for cases actually loaded; no table records physical loading onto a truck, and pick confirmations alone do not prove loading."
 },
 "Q158": {
  "cannot": "No single table can answer this: shipments-june records only the truck's arrival and slot, not which products it carried or whether the 5 kg atta reached the shelf, and shelf availability would require shelf-audits-june (11:00 snapshots only, not the 07:00 opening)."
 },
 "Q159": {
  "cannot": "No table records warehouse stock on hand by slot on a date: dc-stock-adjustments-june holds only corrections for 2026-06-23 to 2026-06-25, and dc-pick-confirmations-june holds picks, not balances, so units of ATTA-WW-1KG in slot A-07-04 on 2026-06-21 cannot be derived."
 },
 "Q160": {
  "from": "fresh-deliveries-june",
  "where": [
   {
    "op": "=",
    "args": [
     {
      "col": "fresh-deliveries-june.sku"
     },
     {
      "lit": "ATTA-WW-5KG"
     }
    ]
   },
   {
    "op": "=",
    "args": [
     {
      "fn": "day",
      "arg": {
       "col": "fresh-deliveries-june.delivery_ts"
      }
     },
     {
      "lit": "2026-06-22"
     }
    ]
   }
  ],
  "select": [
   {
    "as": "use_by",
    "expr": {
     "col": "fresh-deliveries-june.use_by"
    }
   }
  ],
  "layer": "schema",
  "covers": "Expiry dates (use_by) of ATTA-WW-5KG fresh deliveries on 2026-06-22."
 },
 "Q161": {
  "cannot": "No table records a shopper who gave up and left without paying, and no table identifies shoppers; pos-payments-june records only payment attempts (including UPI declined/failed attempts in June 2026), not whether a bill was later paid, retried, or abandoned, so the count of shoppers who left without paying cannot be planned even as a stand-in."
 },
 "Q162": {
  "plans": [
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.tender"
     }
    ],
    "select": [
     {
      "as": "tender",
      "expr": {
       "col": "pos-payments-june.tender"
      }
     },
     {
      "as": "approved_payments",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "takings_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     },
     {
      "as": "average_payment_inr",
      "expr": {
       "agg": "avg",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     }
    ],
    "layer": "knowledge",
    "covers": "Recorded approved-payment counts, takings and average payment value by tender; the records hold no cash-handling or card-processing cost, and no per-payment UPI cost, so the actual cost to serve each tender is not recorded."
   },
   {
    "from": "upi-settlements-june",
    "select": [
     {
      "as": "settlement_days",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "upi_credits",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "upi-settlements-june.upi_credits"
       }
      }
     },
     {
      "as": "gross_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "upi-settlements-june.gross_inr"
       }
      }
     },
     {
      "as": "mdr_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "upi-settlements-june.mdr_inr"
       }
      }
     },
     {
      "as": "refunds_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "upi-settlements-june.refunds_inr"
       }
      }
     },
     {
      "as": "net_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "upi-settlements-june.net_inr"
       }
      }
     },
     {
      "as": "mdr_per_upi_credit_inr",
      "expr": {
       "op": "/",
       "args": [
        {
         "agg": "sum",
         "arg": {
          "col": "upi-settlements-june.mdr_inr"
         }
        },
        {
         "agg": "sum",
         "arg": {
          "col": "upi-settlements-june.upi_credits"
         }
        }
       ]
      }
     },
     {
      "as": "mdr_share_of_gross",
      "expr": {
       "op": "/",
       "args": [
        {
         "agg": "sum",
         "arg": {
          "col": "upi-settlements-june.mdr_inr"
         }
        },
        {
         "agg": "sum",
         "arg": {
          "col": "upi-settlements-june.gross_inr"
         }
        }
       ]
      }
     }
    ],
    "layer": "knowledge",
    "covers": "Recorded June UPI settlement MDR as a labelled stand-in for UPI service cost, including MDR per provider credit and as a share of gross settlements; settlement credits are not matched to individual payments, and equivalent cash and card costs are not recorded."
   }
  ]
 },
 "Q163": {
  "plans": [
   {
    "from": "customer-complaints-june",
    "where": [
     {
      "op": "between",
      "arg": {
       "fn": "day",
       "arg": {
        "col": "customer-complaints-june.complaint_ts"
       }
      },
      "low": "2026-06-01",
      "high": "2026-06-30"
     }
    ],
    "group_by": [
     {
      "col": "customer-complaints-june.kind"
     },
     {
      "col": "customer-complaints-june.resolution"
     }
    ],
    "select": [
     {
      "as": "kind",
      "expr": {
       "col": "customer-complaints-june.kind"
      }
     },
     {
      "as": "resolution",
      "expr": {
       "col": "customer-complaints-june.resolution"
      }
     },
     {
      "as": "complaints",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "amount_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "customer-complaints-june.amount_inr"
       }
      }
     },
     {
      "as": "first_complaint",
      "expr": {
       "agg": "min",
       "arg": {
        "col": "customer-complaints-june.complaint_ts"
       }
      }
     },
     {
      "as": "last_complaint",
      "expr": {
       "agg": "max",
       "arg": {
        "col": "customer-complaints-june.complaint_ts"
       }
      }
     }
    ],
    "order_by": [
     {
      "by": "complaints",
      "dir": "desc"
     }
    ],
    "limit": 20,
    "layer": "knowledge",
    "covers": "Recorded June complaint types and resolutions only; no table records a till fault, staff action, or cause, and a manual-match refund is not proof of staff error."
   },
   {
    "from": "psp-upi-report-june",
    "joins": [
     {
      "table": "pos-payments-june",
      "type": "left",
      "on": [
       [
        {
         "col": "psp-upi-report-june.rrn"
        },
        {
         "col": "pos-payments-june.rrn"
        }
       ],
       [
        {
         "col": "pos-payments-june.till_status"
        },
        {
         "lit": "approved"
        }
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "psp-upi-report-june.status"
       },
       {
        "lit": "success"
       }
      ]
     },
     {
      "op": "between",
      "arg": {
       "fn": "day",
       "arg": {
        "col": "psp-upi-report-june.status_ts"
       }
      },
      "low": "2026-06-01",
      "high": "2026-06-30"
     },
     {
      "op": "is_null",
      "arg": {
       "col": "pos-payments-june.rrn"
      }
     }
    ],
    "group_by": [
     {
      "fn": "day",
      "arg": {
       "col": "psp-upi-report-june.status_ts"
      }
     }
    ],
    "select": [
     {
      "as": "day",
      "expr": {
       "fn": "day",
       "arg": {
        "col": "psp-upi-report-june.status_ts"
       }
      }
     },
     {
      "as": "extra_debits",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "amount_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "psp-upi-report-june.amount_inr"
       }
      }
     }
    ],
    "order_by": [
     {
      "by": "day",
      "dir": "asc"
     }
    ],
    "limit": 31,
    "layer": "knowledge",
    "covers": "Uses the Extra debit definition (provider success with no approved till payment on the same rrn) to date and size the recorded double-charge evidence; the underlying till or staff cause is not recorded."
   },
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.tender"
       },
       {
        "lit": "UPI"
       }
      ]
     },
     {
      "op": "between",
      "arg": {
       "fn": "day",
       "arg": {
        "col": "pos-payments-june.ts"
       }
      },
      "low": "2026-06-01",
      "high": "2026-06-30"
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.till_status"
     }
    ],
    "select": [
     {
      "as": "till_status",
      "expr": {
       "col": "pos-payments-june.till_status"
      }
     },
     {
      "as": "attempts",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "order_by": [
     {
      "by": "attempts",
      "dir": "desc"
     }
    ],
    "limit": 10,
    "layer": "knowledge",
    "covers": "June UPI till outcomes, including failures and no-response timeouts, are the nearest recorded till evidence; they do not identify why staff or the till behaved that way."
   }
  ]
 },
