 "Q275": {
  "from": "daily-sales-june",
  "joins": [
   {
    "table": "products",
    "type": "inner",
    "on": [
     [
      {
       "col": "daily-sales-june.sku"
      },
      {
       "col": "products.sku"
      }
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "between",
    "arg": {
     "col": "daily-sales-june.date"
    },
    "low": "2026-06-01",
    "high": "2026-06-28"
   },
   {
    "op": "in",
    "arg": {
     "col": "products.sku"
    },
    "values": [
     "ATTA-WW-10KG",
     "ATTA-WW-1KG",
     "ATTA-WW-5KG"
    ]
   }
  ],
  "group_by": [
   {
    "col": "products.sku"
   }
  ],
  "select": [
   {
    "as": "sku",
    "expr": {
     "col": "products.sku"
    }
   },
   {
    "as": "units_sold",
    "expr": {
     "agg": "sum",
     "arg": {
      "col": "daily-sales-june.units_sold"
     }
    }
   },
   {
    "as": "pack_kg",
    "expr": {
     "col": "products.pack"
    }
   },
   {
    "as": "kilograms_sold",
    "expr": {
     "op": "*",
     "args": [
      {
       "ref": "units_sold"
      },
      {
       "fn": "round",
       "arg": {
        "col": "products.pack"
       }
      }
     ]
    }
   }
  ],
  "order_by": [
   {
    "by": "kilograms_sold",
    "dir": "desc"
   }
  ],
  "limit": 200,
  "layer": "ontology",
  "covers": "Uses the recorded sales of the three atta SKUs in June 2026 and multiplies units sold by each product's pack size in kilograms (products.pack), since daily-sales-june records units rather than kilograms."
 },
