 "Q244": {
  "plans": [
   {
    "from": "daily-sales-june",
    "joins": [
     {
      "table": "products",
      "type": "inner",
      "on": [
       [
        {
         "col": "daily-sales-june.sku"
        },
        {
         "col": "products.sku"
        }
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "between",
      "arg": {
       "col": "daily-sales-june.date"
      },
      "low": "2026-06-01",
      "high": "2026-06-28"
     },
     {
      "op": "=",
      "args": [
       {
        "col": "products.sku"
       },
       {
        "lit": "RICE-SM-5KG"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "products.sku"
     }
    ],
    "select": [
     {
      "as": "revenue_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "daily-sales-june.revenue_inr"
       }
      }
     },
     {
      "as": "units_sold",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "daily-sales-june.units_sold"
       }
      }
     },
     {
      "as": "cost_inr",
      "expr": {
       "col": "products.cost_inr"
      }
     },
     {
      "as": "list_margin_inr",
      "expr": {
       "op": "*",
       "args": [
        {
         "op": "-",
         "args": [
          {
           "col": "products.price_inr"
          },
          {
           "col": "products.cost_inr"
          }
         ]
        },
        {
         "agg": "sum",
         "arg": {
          "col": "daily-sales-june.units_sold"
         }
        }
       ]
      }
     }
    ],
    "having": [],
    "order_by": [],
    "limit": 200,
    "layer": "knowledge",
    "covers": "Uses recorded June sales of RICE-SM-5KG and the single listed cost per unit to compute a list-margin proxy (selling price minus cost times units sold); actual profit is not recorded, and daily-sales-june covers only the eleven followed items, not the whole store."
   }
  ]
 },
