       ]
      },
      {
       "col": "products.price_inr"
      }
     ]
    }
   }
  ],
  "having": [],
  "order_by": [
   {
    "by": "gross_margin_pct",
    "dir": "desc"
   }
  ],
  "limit": 200,
  "layer": "knowledge",
  "covers": "Uses the list_margin proxy (selling price minus the single recorded cost per product) for every SKU in products; actual realized gross margin is not recorded because actual sale prices, discounts, and other costs are not held."
 },
