 "Q202": {
  "plans": [
   {
    "from": "pos-payments-june",
    "where": {
     "op": "and",
     "args": [
      {
       "op": "=",
       "args": [
        {
         "col": "pos-payments-june.tender"
        },
        {
         "lit": "UPI"
        }
       ]
      },
      {
       "op": "=",
       "args": [
        {
         "col": "pos-payments-june.till_status"
        },
        {
         "lit": "approved"
        }
       ]
      }
     ]
    },
    "group_by": [
     {
      "col": "pos-payments-june.bill_id"
     }
    ],
    "select": [
     {
      "as": "bill_id",
      "expr": {
       "col": "pos-payments-june.bill_id"
      }
     },
     {
      "as": "approved_count",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "having": [
     {
      "op": ">",
      "args": [
       {
        "ref": "approved_count"
       },
       {
        "lit": 2
       }
      ]
     }
    ],
    "layer": "knowledge",
    "covers": "Customer identity is not recorded; a bill stands in for a shopper. The plan finds bills with more than two approved UPI payments, which would indicate three or more charges for a single bill. The records do not record a customer, so 'customers' cannot be identified."
   },
