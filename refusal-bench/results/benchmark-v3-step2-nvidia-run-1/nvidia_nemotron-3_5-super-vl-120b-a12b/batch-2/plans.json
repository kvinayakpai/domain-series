 "Q060": {
  "cannot": "No table records theft, shrinkage, or a cause for stock differences; only adjustments, counts, receipts, sales and write-offs exist, so stolen stock cannot be separated from counting error."
 },
 "Q061": {
  "plans": [
   {
    "from": "shelf-audits-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "shelf-audits-june.sku"
       },
       {
        "lit": "ATTA-WW-5KG"
       }
      ]
     },
     {
      "op": "between",
      "arg": {
       "col": "shelf-audits-june.audit_ts"
      },
      "low": "2026-06-01",
      "high": "2026-06-30"
     }
    ],
    "group_by": [
     {
      "col": "shelf-audits-june.audit_ts"
     }
    ],
    "select": [
     {
      "as": "audit_date",
      "expr": {
       "fn": "day",
       "arg": {
        "col": "shelf-audits-june.audit_ts"
       }
      }
     },
     {
      "as": "status",
      "expr": {
       "col": "shelf-audits-june.status"
      }
     }
    ],
    "order_by": [
     {
      "by": "audit_date",
      "dir": "asc"
     }
    ],
    "layer": "knowledge",
    "covers": "Restock times are not recorded; shelf audits are 11:00 snapshots twice a week, not hours off the shelf, so only audit dates and on-shelf/empty status can be shown, not when restocking happened or how long it took."
   }
  ]
 },
