 "Q056": {
  "from": "pos-lines-may-june",
  "joins": [
   {
    "table": "products",
    "type": "inner",
    "on": [
     {
      "col": "pos-lines-may-june.sku_scanned"
     },
     {
      "col": "products.sku"
     }
    ]
   }
  ],
  "where": [],
  "group_by": [
   {
    "col": "products.name"
   }
  ],
  "select": [
   {
    "as": "product_name",
    "expr": {
     "col": "products.name"
    }
   },
   {
    "as": "revenue_inr",
    "expr": {
     "agg": "sum",
     "arg": {
      "col": "pos-lines-may-june.line_amount"
     }
    }
   }
  ],
  "having": [],
  "order_by": [
   {
    "by": "revenue_inr",
    "dir": "desc"
   }
  ],
  "limit": 200,
  "layer": "ontology",
  "covers": "Revenue by product name computed by joining till lines to products on the product code (sku), not on name, because name is not a join key; covers only the eleven followed items."
 },
 "Q057": {
