 "Q111": {
  "plans": [
   {
    "from": "pos-lines-may-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-lines-may-june.sku_scanned"
       },
       {
        "lit": "MILK-TONED-500ML"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-lines-may-june.bill_id"
     }
    ],
    "select": [
     {
      "as": "bill_id",
      "expr": {
       "col": "pos-lines-may-june.bill_id"
      }
     },
     {
      "as": "units_sold",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "pos-lines-may-june.qty"
       }
      }
     },
     {
      "as": "bill_date",
      "expr": {
       "fn": "day",
       "arg": {
        "col": "pos-lines-may-june.bill_ts"
       }
      }
     }
    ],
    "order_by": [
     {
      "by": "bill_date",
      "dir": "asc"
     }
    ],
    "layer": "knowledge",
    "covers": "No table links a sold unit to a fresh-delivery batch or use_by date; only the bill-level stand-in for units sold is recorded."
   },
   {
    "from": "fresh-deliveries-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "fresh-deliveries-june.sku"
       },
       {
        "lit": "MILK-TONED-500ML"
       }
      ]
     }
    ],
    "group_by": [
     {
      "fn": "day",
      "arg": {
       "col": "fresh-deliveries-june.use_by"
      }
     }
    ],
    "select": [
     {
      "as": "use_by_date",
      "expr": {
       "fn": "day",
       "arg": {
        "col": "fresh-deliveries-june.use_by"
       }
      }
     },
     {
      "as": "units_delivered",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "fresh-deliveries-june.units"
       }
      }
     },
     {
      "as": "delivery_date",
      "expr": {
       "fn": "day",
       "arg": {
        "col": "fresh-deliveries-june.delivery_ts"
       }
      }
     }
    ],
    "order_by": [
     {
      "by": "use_by_date",
      "dir": "asc"
     }
    ],
    "layer": "knowledge",
    "covers": "Fresh deliveries are recorded, but no record links delivered units to the units sold on a bill, so the exact batch per sold unit cannot be determined."
   }
  ]
 },
 "Q112": {
  "plans": [
   {
    "from": "shelf-audits-june",
    "where": [
     {
      "op": "and",
      "args": [
       {
        "op": "=",
        "args": [
         {
          "col": "shelf-audits-june.status"
         },
         {
          "lit": "empty"
         }
        ]
       },
       {
        "op": "between",
        "arg": {
         "col": "shelf-audits-june.audit_ts"
        },
        "low": "2026-06-01",
        "high": "2026-06-30"
       }
      ]
     }
    ],
    "group_by": [
     {
      "fn": "hour",
      "arg": {
       "col": "shelf-audits-june.audit_ts"
      }
     }
    ],
    "select": [
     {
      "as": "hour",
      "expr": {
       "fn": "hour",
       "arg": {
        "col": "shelf-audits-june.audit_ts"
       }
      }
     },
     {
      "as": "empty_audits",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "order_by": [
     {
      "by": "empty_audits",
      "dir": "desc"
     }
    ],
    "limit": 200,
    "layer": "knowledge",
    "covers": "Shelf audits are 11:00 snapshots twice a week, not continuous shelf hours; no record identifies shift, so morning/evening cannot be determined from the data."
   }
