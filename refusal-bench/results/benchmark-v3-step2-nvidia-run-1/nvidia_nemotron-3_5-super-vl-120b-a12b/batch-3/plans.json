    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "shelf-audits-june.status"
       },
       {
        "lit": "empty"
       }
      ]
     }
    ],
    "select": [
     {
      "as": "sku",
      "expr": {
       "col": "shelf-audits-june.sku"
      }
     }
    ],
    "layer": "schema",
    "covers": "SKUs that had at least one 'empty' shelf-audit row in June 2026"
   }
  ]
 },
