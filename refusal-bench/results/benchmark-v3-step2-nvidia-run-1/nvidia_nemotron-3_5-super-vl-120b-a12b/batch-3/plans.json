    "layer": "knowledge",
    "covers": "SKUs with no write-offs row and no 'empty' shelf audit in June 2026; shelf audits are 11:00 snapshots twice a week, not continuous shelf presence, so an SKU with no 'empty' row may still have been empty between audits."
   },
   {
    "from": "write-offs-june",
    "select": [
     {
      "as": "sku",
      "expr": {
       "col": "write-offs-june.sku"
      }
     }
