 "Q154": {
  "plans": [
   {
    "from": "goods-receipts-june",
    "where": [
     {
      "op": "and",
      "args": [
       {
        "op": "=",
        "args": [
         {
          "col": "goods-receipts-june.asn_units"
         },
         {
          "col": "goods-receipts-june.units_booked"
         }
        ]
       },
       {
        "op": "=",
        "args": [
         {
          "col": "goods-receipts-june.asn_sku"
         },
         {
          "col": "goods-receipts-june.sku_booked"
         }
        ]
       }
      ]
     },
     {
      "op": "between",
      "arg": {
       "col": "goods-receipts-june.received_ts"
      },
      "low": "2026-06-01",
      "high": "2026-06-28"
     }
    ],
    "group_by": [],
    "select": [
     {
      "as": "total_lines",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "matching_lines",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "layer": "schema",
    "covers": "Goods-receipt lines show asn_units = units_booked and asn_sku = sku_booked for every line in June, but this only confirms booking matched the shipping notice; it does not record what the warehouse actually shipped, so 100% right items shipped cannot be verified."
   }
  ]
 },
