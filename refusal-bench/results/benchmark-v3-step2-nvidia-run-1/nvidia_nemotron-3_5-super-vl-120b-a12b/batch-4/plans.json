 "Q157": {
  "plans": [
   {
    "from": "dc-pick-confirmations-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "dc-pick-confirmations-june.sku"
       },
       {
        "lit": "ATTA-WW-1KG"
       }
      ]
     },
     {
      "op": "=",
      "args": [
       {
        "fn": "day",
        "arg": {
         "col": "dc-pick-confirmations-june.pick_ts"
        }
       },
       {
        "lit": "2026-06-22"
       }
      ]
     },
     {
      "op": "is_null",
      "args": [
       {
        "col": "dc-pick-confirmations-june.shipment_id"
       }
      ]
     }
    ],
    "group_by": [],
    "select": [
     {
      "as": "cases_confirmed",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "dc-pick-confirmations-june.cases_confirmed"
       }
      }
     },
     {
      "as": "cases_ordered",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "dc-pick-confirmations-june.cases_ordered"
       }
      }
     },
     {
      "as": "lines",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "layer": "knowledge",
    "covers": "The records do not say which pick confirmations were loaded onto a truck; only pick confirmations exist, with no load event and no shipment link for loaded cases. The plan sums cases confirmed on 22 June for ATTA-WW-1KG as the closest recorded stand-in, and flags that actual loading is not recorded."
   }
  ]
 },
