 "Q162": {
  "plans": [
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "in",
      "args": [
       {
        "col": "pos-payments-june.tender"
       },
       {
        "values": [
         "cash",
         "upi",
         "card"
        ]
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.tender"
     }
    ],
    "select": [
     {
      "as": "tender",
      "expr": {
       "col": "pos-payments-june.tender"
      }
     },
     {
      "as": "attempts",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "total_amount_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     },
     {
      "as": "avg_amount_inr",
      "expr": {
       "agg": "avg",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     },
     {
      "as": "min_amount_inr",
      "expr": {
       "agg": "min",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     },
     {
      "as": "max_amount_inr",
      "expr": {
       "agg": "max",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     }
    ],
    "order_by": [
     {
      "by": "tender",
      "dir": "asc"
     }
    ],
    "layer": "knowledge",
    "covers": "The records hold per-payment amounts by tender but no cost to serve per payment (no cash handling cost, no UPI or card processing fee, no labour or terminal cost). The plan gives recorded evidence only: count, total, average, min and max amount per tender; cost per tender is not recorded."
   }
  ]
 },
