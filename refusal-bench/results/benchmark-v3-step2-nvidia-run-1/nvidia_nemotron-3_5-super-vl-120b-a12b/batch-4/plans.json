{
 "Q151": {
  "plans": [
   {
    "from": "fresh-deliveries-june",
    "joins": [
     {
      "table": "products",
      "type": "inner",
      "on": [
       {
        "col": "fresh-deliveries-june.sku"
       },
       {
        "col": "products.sku"
       }
      ]
     }
    ],
    "where": {
     "op": "in",
     "arg": {
      "col": "products.name"
     },
     "values": [
      "Full cream milk 500 ml pouch",
      "Toned milk 500 ml pouch",
      "Curd 500 g pouch",
      "White bread 400 g"
     ]
    },
    "group_by": [
     {
      "col": "fresh-deliveries-june.sku"
     },
     {
      "col": "products.name"
     },
     {
      "col": "fresh-deliveries-june.delivery_ts"
     },
     {
      "col": "fresh-deliveries-june.use_by"
     }
    ],
    "select": [
     {
      "as": "sku",
      "expr": {
       "col": "fresh-deliveries-june.sku"
      }
     },
     {
      "as": "product_name",
      "expr": {
       "col": "products.name"
      }
     },
     {
      "as": "delivery_date",
      "expr": {
       "fn": "day",
       "arg": {
        "col": "fresh-deliveries-june.delivery_ts"
       }
      }
     },
     {
      "as": "use_by_date",
      "expr": {
       "col": "fresh-deliveries-june.use_by"
      }
     },
     {
      "as": "days_of_shelf_life_on_arrival",
      "expr": {
       "fn": "days_between",
       "args": [
        {
         "fn": "day",
         "arg": {
          "col": "fresh-deliveries-june.delivery_ts"
         }
        },
        {
         "col": "fresh-deliveries-june.use_by"
        }
       ]
      }
     }
    ],
    "layer": "ontology",
    "covers": "Days of shelf life on arrival for milk, curd, and bread fresh deliveries, computed as use_by date minus delivery date."
   }
  ]
 },
 "Q152": {
  "from": "shipping-notice-lines-june",
  "group_by": [
   {
    "col": "shipping-notice-lines-june.sscc"
   }
  ],
  "select": [
   {
    "as": "sscc",
    "expr": {
     "col": "shipping-notice-lines-june.sscc"
    }
   },
   {
    "as": "distinct_skus",
    "expr": {
     "agg": "count_distinct",
     "arg": {
      "col": "shipping-notice-lines-june.sku"
     }
    }
   }
  ],
  "having": [
   {
    "op": ">",
    "args": [
     {
      "ref": "distinct_skus"
     },
     {
      "lit": 1
     }
    ]
   }
  ],
  "layer": "schema",
  "covers": "Counts distinct sscc pallet labels whose shipping-notice lines contain more than one SKU."
 },
