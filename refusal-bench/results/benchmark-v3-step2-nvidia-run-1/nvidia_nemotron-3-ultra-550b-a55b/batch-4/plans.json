 "Q161": {
  "cannot": "The records do not identify shoppers, nor do they record whether a shopper retried payment with another tender after a UPI decline or failure. A bill is the nearest stand-in for a shopper, but there is no link from a failed UPI attempt to a later approved payment on the same bill, and no record of a shopper leaving without paying."
 },
 "Q162": {
  "plans": [
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.tender"
     }
    ],
    "select": [
     {
      "as": "tender",
      "expr": {
       "col": "pos-payments-june.tender"
      }
     },
     {
      "as": "approved_count",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "total_amount_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     },
     {
      "as": "avg_amount_inr",
      "expr": {
       "agg": "avg",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     }
    ],
    "order_by": [
     {
      "by": "tender",
      "dir": "asc"
     }
    ],
    "limit": 200,
    "layer": "knowledge",
    "covers": "Recorded approved payment counts and amounts by tender (cash, UPI, card). MDR and refunds for UPI are recorded in upi-settlements-june; cash handling costs and card interchange fees are not recorded."
   },
   {
    "from": "upi-settlements-june",
    "where": [],
    "group_by": [],
    "select": [
     {
      "as": "total_gross_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "upi-settlements-june.gross_inr"
       }
      }
     },
     {
      "as": "total_mdr_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "upi-settlements-june.mdr_inr"
       }
      }
     },
     {
      "as": "total_refunds_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "upi-settlements-june.refunds_inr"
       }
      }
     },
     {
      "as": "total_net_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "upi-settlements-june.net_inr"
       }
      }
     },
     {
      "as": "total_credits",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "upi-settlements-june.upi_credits"
       }
      }
     }
    ],
    "order_by": [],
    "limit": 1,
    "layer": "knowledge",
    "covers": "Recorded UPI settlement totals: gross credits, MDR, refunds, net credited, and transaction count. MDR is the only recorded UPI cost; cash handling costs and card fees are not recorded."
   }
  ]
 },
 "Q163": {
  "plans": [
   {
    "from": "customer-complaints-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "customer-complaints-june.kind"
       },
       {
        "lit": "charged twice"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "customer-complaints-june.kind"
     }
    ],
    "select": [
     {
      "as": "complaint_kind",
      "expr": {
       "col": "customer-complaints-june.kind"
      }
     },
     {
      "as": "count",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "total_amount_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "customer-complaints-june.amount_inr"
       }
      }
     },
     {
      "as": "resolution_types",
      "expr": {
       "agg": "count_distinct",
       "arg": {
        "col": "customer-complaints-june.resolution"
       }
      }
     }
    ],
    "layer": "knowledge",
    "covers": "Records show complaints of 'charged twice' but do not record the till or staff behaviour that caused the double charges; cause is not recorded."
   },
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.tender"
       },
       {
        "lit": "UPI"
       }
      ]
     },
     {
      "op": "in",
      "arg": {
       "col": "pos-payments-june.till_status"
      },
      "values": [
       "failed",
       "failed: no response"
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.till_status"
     }
    ],
    "select": [
     {
      "as": "till_status",
      "expr": {
       "col": "pos-payments-june.till_status"
      }
     },
     {
      "as": "count",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "total_amount_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     }
    ],
    "layer": "knowledge",
    "covers": "Records show UPI payment attempts with till_status 'failed' or 'failed: no response' (timeouts) but do not record the till or staff behaviour that caused double charges; cause is not recorded."
   },
   {
    "from": "customer-complaints-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "customer-complaints-june.kind"
       },
       {
        "lit": "charged twice"
       }
      ]
     }
    ],
    "select": [
     {
      "as": "complaint_ts",
      "expr": {
       "col": "customer-complaints-june.complaint_ts"
      }
     },
     {
      "as": "resolved_ts",
      "expr": {
       "col": "customer-complaints-june.resolved_ts"
      }
     },
     {
      "as": "resolution",
      "expr": {
       "col": "customer-complaints-june.resolution"
      }
     },
     {
      "as": "amount_inr",
      "expr": {
       "col": "customer-complaints-june.amount_inr"
      }
     },
     {
      "as": "bill_id",
      "expr": {
       "col": "customer-complaints-june.bill_id"
      }
     },
     {
      "as": "rrn",
      "expr": {
       "col": "customer-complaints-june.rrn"
      }
     }
    ],
    "order_by": [
     {
      "by": "complaint_ts",
      "dir": "asc"
     }
    ],
    "limit": 200,
    "layer": "knowledge",
    "covers": "Individual 'charged twice' complaints with timestamps, resolutions, amounts, bill IDs and RRNs; the records do not capture the till or staff behaviour that caused the double charges."
   }
  ]
 },
