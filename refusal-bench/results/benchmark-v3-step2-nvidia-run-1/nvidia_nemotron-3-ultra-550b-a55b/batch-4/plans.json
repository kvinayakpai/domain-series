 "Q165": {
  "cannot": "Fraud is not recorded in any table. The records contain payment attempts, complaints about double debits, and refunds, but none of them are labelled as fraud. A plan can only count recorded events or labelled stand-ins; fraud is neither."
 },
 "Q166": {
  "cannot": "No record captures shopper identity, motivation, or the reason a shopper chooses cash, card, or UPI. The tables only show the tender used per payment attempt (pos-payments-june.tender) and its outcome, not the shopper's choice rationale."
 },
 "Q167": {
  "cannot": "Cash banked (bank deposit records) is not recorded in any table. Only cash payments at the till (pos-payments-june with tender='cash') are recorded."
 },
 "Q168": {
  "cannot": "The customer's bank statement is not recorded in any table. The records hold the store's till view (pos-payments-june), the UPI provider view (psp-upi-report-june), and refunds (upi-refunds-june), but not the customer's bank side."
 },
