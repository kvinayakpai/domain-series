{
 "Q151": {
  "from": "fresh-deliveries-june",
  "joins": [
   {
    "table": "products",
    "type": "inner",
    "on": [
     [
      "fresh-deliveries-june.sku",
      "products.sku"
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "in",
    "arg": {
     "col": "products.name"
    },
    "values": [
     "Full cream milk 500 ml pouch",
     "Toned milk 500 ml pouch",
     "Curd 500 g pouch",
     "White bread 400 g"
    ]
   }
  ],
  "group_by": [
   {
    "col": "products.name"
   },
   {
    "col": "fresh-deliveries-june.delivery_ts"
   },
   {
    "col": "fresh-deliveries-june.use_by"
   }
  ],
  "select": [
   {
    "as": "product",
    "expr": {
     "col": "products.name"
    }
   },
   {
    "as": "delivery_date",
    "expr": {
     "fn": "day",
     "arg": {
      "col": "fresh-deliveries-june.delivery_ts"
     }
    }
   },
   {
    "as": "use_by_date",
    "expr": {
     "col": "fresh-deliveries-june.use_by"
    }
   },
   {
    "as": "shelf_life_days",
    "expr": {
     "fn": "days_between",
     "args": [
      {
       "fn": "day",
       "arg": {
        "col": "fresh-deliveries-june.delivery_ts"
       }
      },
      {
       "col": "fresh-deliveries-june.use_by"
      }
     ]
    }
   }
  ],
  "order_by": [
   {
    "by": "product",
    "dir": "asc"
   },
   {
    "by": "delivery_date",
    "dir": "asc"
   }
  ],
  "limit": 200,
  "layer": "ontology",
  "covers": "Days of shelf life on arrival for milk (full cream and toned), curd, and white bread from fresh deliveries, using use_by minus delivery date."
 },
 "Q152": {
  "cannot": "shipping-notice-lines-june has one row per product line on a shipping notice; it does not record which pallet (SSCC) a line was loaded on. Pallet-to-SKU mapping is not in this table."
 },
 "Q153": {
  "from": "store-orders-june",
  "joins": [
   {
    "table": "goods-receipts-june",
    "type": "inner",
    "on": [
     [
      "store-orders-june.order_id",
      "goods-receipts-june.order_id"
     ],
     [
      "store-orders-june.sku",
      "goods-receipts-june.sku_booked"
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "between",
    "arg": {
     "col": "store-orders-june.created_ts"
    },
    "low": "2026-06-01",
    "high": "2026-06-27T23:59:59"
   }
  ],
  "group_by": [],
  "select": [
   {
    "as": "avg_lead_time_hours",
    "expr": {
     "agg": "avg",
     "arg": {
      "fn": "hours_between",
      "args": [
       {
        "col": "store-orders-june.created_ts"
       },
       {
        "col": "goods-receipts-june.received_ts"
       }
      ]
     }
    }
   }
  ],
  "having": [],
  "order_by": [],
  "limit": 1,
  "layer": "ontology",
  "covers": "Average lead time in hours from store order creation to goods receipt for June 2026 orders, using order_id and sku to join store-orders-june to goods-receipts-june."
 },
 "Q154": {
  "from": "goods-receipts-june",
  "joins": [],
  "where": [
   {
    "op": "or",
    "args": [
     {
      "op": "!=",
      "args": [
       {
        "col": "goods-receipts-june.asn_units"
       },
       {
        "col": "goods-receipts-june.units_booked"
       }
      ]
     },
     {
      "op": "!=",
      "args": [
       {
        "col": "goods-receipts-june.asn_sku"
       },
       {
        "col": "goods-receipts-june.sku_booked"
       }
      ]
     }
    ]
   }
  ],
  "group_by": [],
  "select": [
   {
    "as": "mismatch_count",
    "expr": {
     "agg": "count",
     "arg": "*"
    }
   }
  ],
  "having": [],
  "order_by": [],
  "limit": 1,
  "layer": "schema",
  "covers": "Count of goods-receipt lines where ASN units differ from booked units or ASN SKU differs from booked SKU in June"
 },
 "Q155": {
  "from": "pallets-june",
  "joins": [
   {
    "table": "shipments-june",
    "type": "inner",
    "on": [
     [
      "pallets-june.shipment_id",
      "shipments-june.shipment_id"
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "=",
    "args": [
     {
      "fn": "day",
      "arg": {
       "col": "shipments-june.arrived_ts"
      }
     },
     {
      "lit": "2026-06-22"
     }
    ]
   }
  ],
  "group_by": [
   {
    "col": "pallets-june.sscc"
   },
   {
    "col": "pallets-june.notice_kg"
   }
  ],
  "select": [
   {
    "as": "sscc",
    "expr": {
     "col": "pallets-june.sscc"
    }
   },
   {
    "as": "notice_kg",
    "expr": {
     "col": "pallets-june.notice_kg"
    }
   },
   {
    "as": "shipment_id",
    "expr": {
     "col": "pallets-june.shipment_id"
    }
   },
   {
    "as": "arrived_ts",
    "expr": {
     "col": "shipments-june.arrived_ts"
    }
   }
  ],
  "order_by": [
   {
    "by": "notice_kg",
    "dir": "asc"
   }
  ],
  "limit": 200,
  "layer": "knowledge",
  "covers": "Actual pallet weight is not recorded; only notice_kg from the shipping notice is available. A 160 kg underweight pallet cannot be identified without a weighed weight to compare against."
 },
 "Q156": {
