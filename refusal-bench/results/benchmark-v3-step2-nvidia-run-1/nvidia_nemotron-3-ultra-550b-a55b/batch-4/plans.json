 "Q157": {
  "from": "dc-pick-confirmations-june",
  "joins": [
   {
    "table": "shipments-june",
    "type": "inner",
    "on": [
     [
      "dc-pick-confirmations-june.shipment_id",
      "shipments-june.shipment_id"
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "=",
    "args": [
     {
      "col": "dc-pick-confirmations-june.sku"
     },
     {
      "lit": "ATTA-WW-1KG"
     }
    ]
   },
   {
    "op": "=",
    "args": [
     {
      "fn": "day",
      "arg": {
       "col": "shipments-june.dispatched_ts"
      }
     },
     {
      "lit": "2026-06-22"
     }
    ]
   }
  ],
  "group_by": [],
  "select": [
   {
    "as": "total_cases_loaded",
    "expr": {
     "agg": "sum",
     "arg": {
      "col": "dc-pick-confirmations-june.cases_confirmed"
     }
    }
   }
  ],
  "having": [],
  "order_by": [],
  "limit": 1,
  "layer": "ontology",
  "covers": "Sum of cases_confirmed for ATTA-WW-1KG on pick lines belonging to the shipment dispatched on 22 June 2026, using the ontology link pickedAs (order -> pick) and carriedBy (pallet -> shipment) to connect pick confirmations to the truck departure."
 },
 "Q158": {
  "cannot": "No record shows when the 5 kg atta from SHP-260622 was put on the shelf. shipments-june only has the truck arrival time; shelf-audits-june are 11:00 snapshots on Tuesdays and Fridays, and inventory-book-june is a closing belief. Restock time on the shelf is not recorded."
 },
 "Q159": {
  "cannot": "Warehouse slot-level stock on a specific date is not recorded. The records show pick confirmations (dc-pick-confirmations-june) and stock adjustments (dc-stock-adjustments-june) at the slot level, but no table holds the on-hand quantity per slot per day. The inventory-book-june table has daily book stock at SKU level only, not by slot. Products table gives the fixed slot for ATTA-WW-1KG (dc_slot), but not the quantity on 21 June 2026."
 },
