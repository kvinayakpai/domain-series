{
 "Q103": {
  "plans": [
   {
    "from": "products",
    "joins": [
     {
      "table": "write-offs-june",
      "type": "left",
      "on": [
       [
        "products.sku",
        "write-offs-june.sku"
       ]
      ]
     },
     {
      "table": "shelf-audits-june",
      "type": "left",
      "on": [
       [
        "products.sku",
        "shelf-audits-june.sku"
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "is_null",
      "arg": {
       "col": "write-offs-june.sku"
      }
     },
     {
      "op": "or",
      "args": [
       {
        "op": "is_null",
        "arg": {
         "col": "shelf-audits-june.sku"
        }
       },
       {
        "op": "!=",
        "args": [
         {
          "col": "shelf-audits-june.status"
         },
         {
          "lit": "empty"
         }
        ]
       }
      ]
     }
    ],
    "group_by": [
     "products.sku",
     "products.name"
    ],
    "select": [
     {
      "as": "sku",
      "expr": {
       "col": "products.sku"
      }
     },
     {
      "as": "name",
      "expr": {
       "col": "products.name"
      }
     }
    ],
    "layer": "knowledge",
    "covers": "Products with no write-offs and no 'empty' shelf audit rows; shelf audits only cover 11:00 snapshots twice a week, not continuous shelf presence."
   }
  ]
 },
