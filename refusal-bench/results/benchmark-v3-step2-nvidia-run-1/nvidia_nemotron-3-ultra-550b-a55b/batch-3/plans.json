    "layer": "knowledge",
    "covers": "Shows the forecast record's ordered_units and its inputs (book_on_hand, on_order, reorder_point, order_up_to, forecast) for the three dates. The reason (cause) for ordering 0 is not recorded; book_on_hand is a belief, not the shelf. Shelf audits are only on Tuesdays and Fridays at 11:00, so 10–12 June have no shelf observation."
   },
   {
    "from": "shelf-audits-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "shelf-audits-june.sku"
       },
       {
        "lit": "ATTA-WW-5KG"
       }
      ]
     },
     {
      "op": ">=",
      "args": [
       {
        "col": "shelf-audits-june.audit_ts"
       },
       {
        "lit": "2026-06-01"
       }
      ]
     },
     {
      "op": "<=",
      "args": [
       {
        "col": "shelf-audits-june.audit_ts"
       },
       {
        "lit": "2026-06-12"
       }
      ]
     }
    ],
    "select": [
     {
      "as": "audit_ts",
      "expr": {
       "col": "shelf-audits-june.audit_ts"
      }
     },
     {
      "as": "status",
      "expr": {
       "col": "shelf-audits-june.status"
      }
     }
    ],
    "order_by": [
     {
      "by": "audit_ts",
      "dir": "asc"
     }
    ],
    "layer": "knowledge",
    "covers": "Shows the only recorded shelf observations (11:00 audits on Tuesdays and Fridays) for ATTA-WW-5KG up to 12 June. There is no audit on 10, 11 or 12 June, so the premise that the shelf was empty on those days is not recorded."
   },
   {
    "from": "daily-sales-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "daily-sales-june.sku"
       },
       {
        "lit": "ATTA-WW-5KG"
       }
      ]
     },
     {
      "op": "in",
      "arg": {
       "col": "daily-sales-june.date"
      },
      "values": [
       "2026-06-10",
       "2026-06-11",
       "2026-06-12"
      ]
     }
    ],
    "select": [
     {
      "as": "date",
      "expr": {
       "col": "daily-sales-june.date"
      }
     },
     {
      "as": "units_sold",
      "expr": {
       "col": "daily-sales-june.units_sold"
      }
     },
     {
      "as": "revenue_inr",
      "expr": {
       "col": "daily-sales-june.revenue_inr"
      }
     }
    ],
    "order_by": [
     {
      "by": "date",
      "dir": "asc"
     }
    ],
    "layer": "knowledge",
    "covers": "Shows recorded sales for the three dates. Zero sales while book_on_hand > 0 would be a signal of an empty shelf (Rule 2), but demand and lost sales are not recorded (Rule 3)."
   }
  ]
 },
 "Q107": {
  "plans": [
   {
    "from": "stock-counts-june",
    "joins": [
     {
      "table": "products",
      "type": "inner",
      "on": [
       [
        "stock-counts-june.sku",
        "products.sku"
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "stock-counts-june.trigger"
       },
       {
        "lit": "scheduled full count"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "stock-counts-june.sku"
     },
     {
      "col": "products.name"
     }
    ],
    "select": [
     {
      "as": "sku",
      "expr": {
       "col": "stock-counts-june.sku"
      }
     },
     {
      "as": "product_name",
      "expr": {
       "col": "products.name"
      }
     },
     {
      "as": "total_shrink_packs",
      "expr": {
       "agg": "sum",
       "arg": {
        "op": "*",
        "args": [
         {
          "lit": -1
         },
         {
          "col": "stock-counts-june.adjustment"
         }
        ]
       }
      }
     }
    ],
    "having": [
     {
      "op": ">",
      "args": [
       {
        "ref": "total_shrink_packs"
       },
       {
        "lit": 0
       }
      ]
     }
    ],
    "order_by": [
     {
      "by": "total_shrink_packs",
      "dir": "desc"
     }
    ],
    "limit": 1,
    "layer": "knowledge",
    "covers": "Shrink measured as negative adjustments from scheduled full counts only; theft is not recorded and cannot be inferred from shrink alone (cause [not_recorded; why])."
   }
  ]
 },
