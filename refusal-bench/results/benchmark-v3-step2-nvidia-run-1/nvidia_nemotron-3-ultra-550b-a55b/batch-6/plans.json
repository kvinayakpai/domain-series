 "Q246": {
  "from": "products",
  "joins": [],
  "where": [],
  "group_by": [],
  "select": [
   {
    "as": "sku",
    "expr": {
     "col": "products.sku"
    }
   },
   {
    "as": "name",
    "expr": {
     "col": "products.name"
    }
   },
   {
    "as": "gross_margin_pct",
    "expr": {
     "op": "/",
     "args": [
      {
       "op": "-",
       "args": [
        {
         "col": "products.price_inr"
        },
        {
         "col": "products.cost_inr"
        }
       ]
      },
      {
       "col": "products.price_inr"
      }
     ]
    }
   }
  ],
  "having": [],
  "order_by": [
   {
    "by": "gross_margin_pct",
    "dir": "desc"
   }
  ],
  "limit": 200,
  "layer": "knowledge",
  "covers": "List margin from products table (price_inr minus cost_inr) divided by price_inr; real margin is not recorded because overheads, markdowns, waste and true cost per unit sold are not in the records."
 },
 "Q247": {
  "from": "pos-lines-may-june",
  "where": [
   {
    "op": "!=",
    "args": [
     {
      "col": "pos-lines-may-june.line_amount"
     },
     {
      "op": "*",
      "args": [
       {
        "col": "pos-lines-may-june.qty"
       },
       {
        "col": "pos-lines-may-june.unit_price"
       }
      ]
     }
    ]
   },
   {
    "op": "and",
    "args": [
     {
      "op": ">=",
      "args": [
       {
        "fn": "day",
        "arg": {
         "col": "pos-lines-may-june.bill_ts"
        }
       },
       {
        "lit": "2026-06-01"
       }
      ]
     },
     {
      "op": "<=",
      "args": [
       {
        "fn": "day",
        "arg": {
         "col": "pos-lines-may-june.bill_ts"
        }
       },
       {
        "lit": "2026-06-28"
       }
      ]
     }
    ]
   }
  ],
  "select": [
   {
    "as": "discount_rows",
    "expr": {
     "agg": "count",
     "arg": "*"
    }
   }
  ],
  "layer": "schema",
  "covers": "Check if any June 2026 till line has line_amount different from qty * unit_price, which would indicate a discount."
 },
 "Q248": {
  "cannot": "The records do not contain brand or manufacturer information for any product. The products table lists SKU, name, pack, price, cost, case units, case kg, flow, and DC slot, but no brand or manufacturer fields. No other table provides this information."
 },
 "Q249": {
  "cannot": "Markdown sales are not recorded. The records contain daily-sales-june (units and revenue per day per SKU) and pos-lines-may-june (till lines for the eleven followed items with unit_price and qty), but no column or table flags a sale as a markdown, promotion, or clearance before expiry. Without a markdown indicator, recorded evidence cannot separate markdown units from regular units for BREAD-WHITE-400G in June 2026."
 },
 "Q251": {
  "cannot": "Staffing levels, shift rosters, or labour hours are not recorded in any table for Store 014."
 },
 "Q252": {
  "cannot": "No table records the driver assigned to a fresh-delivery route. fresh-deliveries-june has route and delivery_ts but no driver column; shipments-june has a vehicle column for DC shipments, not for fresh routes. Driver identity is not recorded."
 },
 "Q253": {
  "cannot": "no table records a cashier identity; pos-payments-june has no cashier column and person_identity is not recorded"
 },
 "Q255": {
  "cannot": "No table records the supplier for a fresh delivery. fresh-deliveries-june has route, sku, delivery_ts, crates, units, use_by but no supplier column. products has sku, name, flow (DSD for curd) but no supplier field. shipping-notice-lines-june and shipments-june cover DC shipments, not DSD fresh routes. Therefore the supplier identity is not recorded."
 },
 "Q256": {
  "cannot": "The stock-counts-june table records the trigger as 'manager request after complaints' but does not record which manager made the request. No table in the schema contains manager identity."
 },
