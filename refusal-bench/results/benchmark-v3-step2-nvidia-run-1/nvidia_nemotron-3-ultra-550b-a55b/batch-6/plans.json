 "Q287": {
  "from": "pos-payments-june",
  "joins": [
   {
    "table": "psp-upi-report-june",
    "type": "left",
    "on": [
     [
      "pos-payments-june.rrn",
      "psp-upi-report-june.rrn"
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "=",
    "args": [
     {
      "col": "pos-payments-june.tender"
     },
     {
      "lit": "UPI"
     }
    ]
   },
   {
    "op": "=",
    "args": [
     {
      "col": "pos-payments-june.till_status"
     },
     {
      "lit": "failed: no response"
     }
    ]
   }
  ],
  "select": [
   {
    "as": "rrn",
    "expr": {
     "col": "pos-payments-june.rrn"
    }
   },
   {
    "as": "bill_id",
    "expr": {
     "col": "pos-payments-june.bill_id"
    }
   },
   {
    "as": "attempt",
    "expr": {
     "col": "pos-payments-june.attempt"
    }
   },
   {
    "as": "till_status",
    "expr": {
     "col": "pos-payments-june.till_status"
    }
   },
   {
    "as": "psp_status",
    "expr": {
     "col": "psp-upi-report-june.status"
    }
   },
   {
    "as": "psp_status_ts",
    "expr": {
     "col": "psp-upi-report-june.status_ts"
    }
   },
   {
    "as": "final_status",
    "expr": {
     "op": "or",
     "args": [
      {
       "col": "psp-upi-report-june.status"
      },
      {
       "lit": "no provider record"
      }
     ]
    }
   }
  ],
  "order_by": [
   {
    "by": "attempt",
    "dir": "asc"
   }
  ],
  "limit": 200,
  "layer": "ontology",
  "covers": "Joins pos-payments-june (till view) to psp-upi-report-june (provider view) on rrn for UPI attempts with till_status 'failed: no response' (timeouts). The provider status is the final status per Rule 9; if no provider row exists, final_status is 'no provider record'."
 },
 "Q288": {
  "plans": [
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.bill_id"
     }
    ],
    "select": [
     {
      "as": "bill_id",
      "expr": {
       "col": "pos-payments-june.bill_id"
      }
     },
     {
      "as": "approved_count",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "having": [
     {
      "op": ">",
      "args": [
       {
        "ref": "approved_count"
       },
       {
        "lit": 1
       }
      ]
     }
    ],
    "layer": "ontology",
    "covers": "Check if any bill has more than one approved payment (double charge indicator) using the rule that every June bill has exactly one approved payment."
   },
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.bill_id"
     }
    ],
    "select": [
     {
      "as": "bill_id",
      "expr": {
       "col": "pos-payments-june.bill_id"
      }
     },
     {
      "as": "approved_count",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "having": [
     {
      "op": "=",
      "args": [
       {
        "ref": "approved_count"
       },
       {
        "lit": 0
       }
      ]
     }
    ],
    "layer": "ontology",
    "covers": "Check if any bill has zero approved payments (missing payment) using the rule that every June bill has exactly one approved payment."
   },
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "select": [
     {
      "as": "distinct_bills_with_approved",
      "expr": {
       "agg": "count_distinct",
       "arg": {
        "col": "pos-payments-june.bill_id"
       }
      }
     }
    ],
    "layer": "ontology",
    "covers": "Count distinct bills with at least one approved payment to compare with the stated 30077 bills."
   }
  ]
 },
