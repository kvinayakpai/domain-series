 "Q281": {
  "plans": [
   {
    "from": "pos-payments-june",
    "joins": [
     {
      "table": "psp-upi-report-june",
      "type": "inner",
      "on": [
       [
        "pos-payments-june.rrn",
        "psp-upi-report-june.rrn"
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "psp-upi-report-june.status"
       },
       {
        "lit": "success"
       }
      ]
     },
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "failed: no response"
       }
      ]
     }
    ],
    "group_by": [],
    "select": [
     {
      "as": "bill_id",
      "expr": {
       "col": "pos-payments-june.bill_id"
      }
     },
     {
      "as": "rrn",
      "expr": {
       "col": "pos-payments-june.rrn"
      }
     },
     {
      "as": "amount_inr",
      "expr": {
       "col": "pos-payments-june.amount_inr"
      }
     },
     {
      "as": "provider_status_ts",
      "expr": {
       "col": "psp-upi-report-june.status_ts"
      }
     }
    ],
    "having": [],
    "order_by": [],
    "limit": 200,
    "layer": "knowledge",
    "covers": "Identifies the 26 extra debits (provider success with no approved till payment) as recorded evidence; the refund action itself is not recorded and must be executed outside the system."
   },
   {
    "from": "upi-refunds-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "trigger"
       },
       {
        "lit": "customer complaint"
       }
      ]
     }
    ],
    "group_by": [],
    "select": [
     {
      "as": "refund_id",
      "expr": {
       "col": "refund_id"
      }
     },
     {
      "as": "bill_id",
      "expr": {
       "col": "bill_id"
      }
     },
     {
      "as": "rrn",
      "expr": {
       "col": "rrn"
      }
     },
     {
      "as": "amount_inr",
      "expr": {
       "col": "amount_inr"
      }
     },
     {
      "as": "completed_ts",
      "expr": {
       "col": "completed_ts"
      }
     }
    ],
    "having": [],
    "order_by": [],
    "limit": 200,
    "layer": "knowledge",
    "covers": "Shows any refunds already recorded for these bills/RRNs; refunds are only logged when triggered by a customer complaint, not automatically for extra debits."
   }
  ]
 },
