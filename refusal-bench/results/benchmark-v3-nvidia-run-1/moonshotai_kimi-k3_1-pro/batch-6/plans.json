 "Q269": {
  "plans": [
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "select": [
     {
      "as": "first_open_day",
      "expr": {
       "fn": "day",
       "arg": {
        "agg": "min",
        "arg": {
         "col": "pos-payments-june.ts"
        }
       }
      }
     },
     {
      "as": "last_open_day",
      "expr": {
       "fn": "day",
       "arg": {
        "agg": "max",
        "arg": {
         "col": "pos-payments-june.ts"
        }
       }
      }
     },
     {
      "as": "days_with_approved_payments",
      "expr": {
       "agg": "count_distinct",
       "arg": {
        "fn": "day",
        "arg": {
         "col": "pos-payments-june.ts"
        }
       }
      }
     }
    ],
    "layer": "knowledge",
    "covers": "Checks the 30-versus-28 premise using approved-payment days as a stand-in for days open; the records cover June 1-28 and hold no explicit opening calendar or closure record, so they cannot prove the store was shut on June 29-30."
   },
   {
    "from": "upi-settlements-june",
    "select": [
     {
      "as": "first_settlement_date",
      "expr": {
       "agg": "min",
       "arg": {
        "col": "upi-settlements-june.settlement_date"
       }
      }
     },
     {
      "as": "last_settlement_date",
      "expr": {
       "agg": "max",
       "arg": {
        "col": "upi-settlements-june.settlement_date"
       }
      }
     },
     {
      "as": "settlement_days",
      "expr": {
       "agg": "count_distinct",
       "arg": {
        "col": "upi-settlements-june.settlement_date"
       }
      }
     },
     {
      "as": "june_29_or_30_settlement_rows",
      "expr": {
       "agg": "sum",
       "arg": {
        "op": "+",
        "args": [
         {
          "lit": 0
         },
         {
          "lit": 0
         }
        ]
       }
      }
     }
    ],
    "where": [
     {
      "op": "between",
      "arg": {
       "col": "upi-settlements-june.settlement_date"
      },
      "low": "2026-06-01",
      "high": "2026-06-30"
     }
    ],
    "layer": "knowledge",
    "covers": "Checks whether settlement records extend to June 29-30; settlements are evidence of credited UPI money, not direct proof that the store was open, and no opening calendar is recorded."
   }
  ]
 },
