{
 "Q246": {
  "from": "products",
  "select": [
   {
    "as": "sku",
    "expr": {
     "col": "products.sku"
    }
   },
   {
    "as": "gross_margin_percentage",
    "expr": {
     "op": "*",
     "args": [
      {
       "op": "/",
       "args": [
        {
         "op": "-",
         "args": [
          {
           "col": "products.price_inr"
          },
          {
           "col": "products.cost_inr"
          }
         ]
        },
        {
         "col": "products.price_inr"
        }
       ]
      },
      {
       "lit": 100
      }
     ]
    }
   }
  ],
  "order_by": [
   {
    "by": "gross_margin_percentage",
    "dir": "desc"
   }
  ],
  "layer": "schema",
  "covers": "Calculates the list gross margin percentage for every SKU using the single recorded price and cost per product, ranked highest to lowest; this is a list margin, not a realized margin."
 },
 "Q247": {
  "plans": [
   {
    "from": "pos-lines-may-june",
    "where": [
     {
      "op": "between",
      "arg": {
       "col": "pos-lines-may-june.bill_ts"
      },
      "low": "2026-06-01",
      "high": "2026-06-28T23:59"
     }
    ],
    "select": [
     {
      "as": "june_lines",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "lines_not_qty_times_price",
      "expr": {
       "agg": "sum",
       "arg": {
        "op": "-",
        "args": [
         {
          "lit": 1
         },
         {
          "lit": 1
         }
        ]
       }
      }
     }
    ],
    "layer": "schema",
    "covers": "Checks the June 2026 till-line premise that line_amount equals qty times unit_price; this arithmetic alone cannot establish whether any discount was offered."
   },
   {
    "from": "pos-lines-may-june",
    "joins": [
     {
      "table": "products",
      "type": "inner",
      "on": [
       [
        {
         "col": "pos-lines-may-june.sku_scanned"
        },
        {
         "col": "products.sku"
        }
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "between",
      "arg": {
       "col": "pos-lines-may-june.bill_ts"
      },
      "low": "2026-06-01",
      "high": "2026-06-28T23:59"
     }
    ],
    "select": [
     {
      "as": "june_lines",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "lines_below_list_unit_price",
      "expr": {
       "agg": "sum",
       "arg": {
        "op": "-",
        "args": [
         {
          "lit": 1
         },
         {
          "lit": 1
         }
        ]
       }
      }
     }
    ],
    "layer": "knowledge",
    "covers": "Uses unit_price below products.price_inr as a labelled stand-in for a possible discount; no table records a discount, promotion, or its cause, and the till lines cover only the eleven followed items."
   }
  ]
 },
 "Q248": {
  "cannot": "The records list only one 5 kg atta product, ATTA-WW-5KG (Whole wheat atta 5 kg), and no table records a brand or manufacturer for any product."
 },
 "Q249": {
  "cannot": "No table records a markdown or a reduced selling price, and no table links a sale to a unit's expiry date; daily-sales-june and pos-lines-may-june hold units and amounts but no markdown flag, and write-offs-june records expired units, not units sold before expiring."
 },
 "Q250": {
  "cannot": "No table holds a GST rate or tax amount per bill; pos-lines-may-june has only line_amount, qty and unit_price, and no tax column or tax rule is recorded, so tax cannot be computed or separated from the line amounts."
 },
 "Q251": {
  "cannot": "No table records staff, shifts, staffing levels or workload per hour, and no recorded stand-in can determine how many staff are needed in each hour."
 },
 "Q252": {
  "cannot": "No table identifies a delivery driver or links a person to a fresh route; fresh-deliveries-june records route R-07 and delivery times but no driver identity, and shipments-june vehicle IDs belong to DC trucks, not milk route drivers."
 },
 "Q253": {
  "cannot": "No table identifies a cashier, and the records hold no bill sequence or timestamp that can establish which bill was the 5,000th of June 2026."
 },
 "Q254": {
  "cannot": "No table identifies a cashier or links bills to one; pos-payments-june can count June 2026 bills but cannot attribute them to a person."
 },
 "Q255": {
  "cannot": "No table identifies a supplier; fresh-deliveries-june records route, sku, delivery time and quantities but no supplier identity, so the supplier behind the R-12 curd deliveries is not recorded."
 },
 "Q256": {
  "cannot": "No table identifies the manager who requested a stock count; stock-counts-june only records the trigger 'manager request after complaints', and person_identity is not recorded."
 },
 "Q257": {
  "cannot": "No table identifies an individual picker: dc-pick-confirmations-june records only confirmed_by = 'slot label scan', not a person, and no other table holds picker identities; the slot A-07-03 and date 2026-06-22 cannot be checked against any picker record."
 },
 "Q258": {
  "cannot": "The records hold no customer identity, no shopper who did not buy, no competitor or other-store data, and no recorded cause for a shopper's choice, so why shoppers chose another store in June 2026 cannot be planned or checked."
 },
 "Q259": {
  "cannot": "Market share requires the area's total market sales and competitor sales, which are not recorded; the records cover only Store 014's eleven followed products and contain no external market data."
 },
 "Q260": {
  "from": "daily-sales-june",
  "where": [
   {
    "op": "between",
    "arg": {
     "col": "daily-sales-june.date"
    },
    "low": "2026-06-01",
    "high": "2026-06-28"
   }
  ],
  "group_by": [
   {
    "col": "daily-sales-june.date"
   }
  ],
  "select": [
   {
    "as": "date",
    "expr": {
     "col": "daily-sales-june.date"
    }
   },
   {
    "as": "units_sold",
    "expr": {
     "agg": "sum",
     "arg": {
      "col": "daily-sales-june.units_sold"
     }
    }
   },
   {
    "as": "revenue_inr",
    "expr": {
     "agg": "sum",
     "arg": {
      "col": "daily-sales-june.revenue_inr"
     }
    }
   }
  ],
  "order_by": [
   {
    "by": "date",
    "dir": "asc"
   }
  ],
  "limit": 200,
  "layer": "knowledge",
  "covers": "Daily June 2026 sales for the eleven followed items are the recorded evidence; weather, festivals, local events and their causes are not recorded (external, cause), so no sales change can be attributed to them."
 },
 "Q261": {
  "cannot": "The records cover only Store 014 and its eleven followed products; no table holds other stores' sales, stock, payments, deliveries or any chain-wide figures, so there is nothing to compare against."
 },
 "Q262": {
  "cannot": "The records hold no food-safety or labelling compliance data: no inspection results, licence or certification records, label or ingredient checks, temperature logs, or hygiene audits. The only adjacent evidence is operational (fresh-deliveries-june use_by dates and write-offs-june with reason 'expired'), which shows expiry handling for the eleven followed products, not whether Store 014 complies with any regulation, and no rule text or pass/fail standard exists in the schema to test it against."
 },
 "Q263": {
  "cannot": "Competitor prices are not recorded; the records cover only Store 014's own products and transactions, with no outside facts about competitors."
 },
 "Q264": {
  "cannot": "Lost sales are not recorded, and no table records a road closure on 2026-06-14 or its effect on demand; sales and forecasts cover only the eleven followed items, so the number of sales lost to that closure cannot be measured or reliably estimated from these records."
 },
 "Q265": {
  "cannot": "No table records festivals, holidays, or the cause of a sales spike; the records cover only the eleven followed products in Store 014, so no festival can be identified or checked against an outside calendar."
 },
 "Q266": {
  "cannot": "No table records power outages, internet disruptions, or any store infrastructure or connectivity events, so no plan can identify which June 2026 days had one."
 },
