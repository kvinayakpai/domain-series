      }
     },
     {
      "op": "or",
      "args": [
       {
        "op": "!=",
        "args": [
         {
          "col": "pos-payments-june.till_status"
         },
         {
          "lit": "approved"
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "select": [
   {
    "as": "rrn",
    "expr": {
     "col": "psp-upi-report-june.rrn"
    }
   },
   {
    "as": "amount_inr",
    "expr": {
     "col": "psp-upi-report-june.amount_inr"
    }
   },
   {
    "as": "initiated_ts",
    "expr": {
     "col": "psp-upi-report-june.initiated_ts"
    }
   },
   {
    "as": "status_ts",
    "expr": {
     "col": "psp-upi-report-june.status_ts"
    }
   }
  ],
  "layer": "ontology",
  "covers": "Extra debit: a provider success whose rrn has no approved till payment. A timeout ('failed: no response') has no rrn, so it cannot be joined to the provider report."
 },
