 "Q205": {
  "cannot": "The records do not contain a 'suspense' status, account, or flag for UPI credits. upi-settlements-june shows daily gross, MDR, refunds and net credited amounts but no field that identifies which credits are held back. psp-upi-report-june has transaction statuses (success, failed, returned) but no settlement or suspense indicator. Without a column that marks a credit as 'in suspense', the premise cannot be checked against the data."
 },
 "Q206": {
  "plans": [
   {
    "from": "customer-complaints-june",
    "joins": [
     {
      "table": "upi-refunds-june",
      "type": "left",
      "on": [
       [
        "customer-complaints-june.bill_id",
        "upi-refunds-june.bill_id"
       ]
      ]
     },
     {
      "table": "pos-payments-june",
      "type": "left",
      "on": [
       [
        "customer-complaints-june.bill_id",
        "pos-payments-june.bill_id"
       ]
      ]
     },
     {
      "table": "psp-upi-report-june",
      "type": "left",
      "on": [
       [
        "pos-payments-june.rrn",
        "psp-upi-report-june.rrn"
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "customer-complaints-june.kind"
       },
       {
        "lit": "charged twice"
       }
      ]
     },
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.tender"
       },
       {
        "lit": "UPI"
       }
      ]
     },
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     },
     {
      "op": "=",
      "args": [
       {
        "col": "psp-upi-report-june.status"
       },
       {
        "lit": "success"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "customer-complaints-june.complaint_ts"
     },
     {
      "col": "customer-complaints-june.bill_id"
     },
     {
      "col": "psp-upi-report-june.status_ts"
     },
     {
      "col": "upi-refunds-june.completed_ts"
     }
    ],
    "select": [
     {
      "as": "complaint_ts",
      "expr": {
       "col": "customer-complaints-june.complaint_ts"
      }
     },
     {
      "as": "extra_debit_ts",
      "expr": {
       "col": "psp-upi-report-june.status_ts"
      }
     },
     {
      "as": "refund_completed_ts",
      "expr": {
       "col": "upi-refunds-june.completed_ts"
      }
     },
     {
      "as": "wait_from_extra_debit_hours",
      "expr": {
       "fn": "hours_between",
       "args": [
        {
         "col": "psp-upi-report-june.status_ts"
        },
        {
         "col": "upi-refunds-june.completed_ts"
        }
       ]
      }
     },
     {
      "as": "wait_from_complaint_hours",
      "expr": {
       "fn": "hours_between",
       "args": [
        {
         "col": "customer-complaints-june.complaint_ts"
        },
        {
         "col": "upi-refunds-june.completed_ts"
        }
       ]
      }
     },
     {
      "as": "unrefunded",
      "expr": {
       "op": "is_null",
       "arg": {
        "col": "upi-refunds-june.completed_ts"
       }
      }
     }
    ],
    "order_by": [
     {
      "by": "complaint_ts",
      "dir": "asc"
     }
    ],
    "limit": 200,
    "layer": "ontology",
    "covers": "Uses ontology definitions: extra debit = provider success with no approved till payment; refund wait from extra debit (provider status_ts) and from complaint (complaint_ts); unrefunded at month end = no completed_ts by 2026-06-30."
   }
  ]
 },
