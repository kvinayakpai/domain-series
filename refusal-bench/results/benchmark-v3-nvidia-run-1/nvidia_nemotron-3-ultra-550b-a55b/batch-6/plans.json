 "Q268": {
  "plans": [
   {
    "from": "pos-payments-june",
    "joins": [
     {
      "table": "pos-lines-may-june",
      "type": "inner",
      "on": [
       [
        "pos-payments-june.bill_id",
        "pos-lines-may-june.bill_id"
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.bill_id"
     }
    ],
    "select": [
     {
      "as": "bill_id",
      "expr": {
       "col": "pos-payments-june.bill_id"
      }
     },
     {
      "as": "payment_sum",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     },
     {
      "as": "lines_sum",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "pos-lines-may-june.line_amount"
       }
      }
     }
    ],
    "having": [
     {
      "op": "!=",
      "args": [
       {
        "ref": "payment_sum"
       },
       {
        "ref": "lines_sum"
       }
      ]
     }
    ],
    "limit": 1,
    "layer": "ontology",
    "covers": "Check if approved payment amount equals sum of line amounts for the 11 followed items (bill join)"
   },
   {
    "from": "pos-payments-june",
    "joins": [
     {
      "table": "customer-complaints-june",
      "type": "inner",
      "on": [
       [
        "pos-payments-june.bill_id",
        "customer-complaints-june.bill_id"
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.bill_id"
     }
    ],
    "select": [
     {
      "as": "bill_id",
      "expr": {
       "col": "pos-payments-june.bill_id"
      }
     },
     {
      "as": "payment_amount",
      "expr": {
       "col": "pos-payments-june.amount_inr"
      }
     },
     {
      "as": "complaint_amount",
      "expr": {
       "col": "customer-complaints-june.amount_inr"
      }
     }
    ],
    "having": [
     {
      "op": "!=",
      "args": [
       {
        "ref": "payment_amount"
       },
       {
        "ref": "complaint_amount"
       }
      ]
     }
    ],
    "limit": 1,
    "layer": "ontology",
    "covers": "Check if complaint amount matches approved payment amount (bill join)"
   },
   {
    "from": "pos-payments-june",
    "joins": [
     {
      "table": "upi-refunds-june",
      "type": "inner",
      "on": [
       [
        "pos-payments-june.bill_id",
        "upi-refunds-june.bill_id"
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.bill_id"
     }
    ],
    "select": [
     {
      "as": "bill_id",
      "expr": {
       "col": "pos-payments-june.bill_id"
      }
     },
     {
      "as": "payment_amount",
      "expr": {
       "col": "pos-payments-june.amount_inr"
      }
     },
     {
      "as": "refund_amount",
      "expr": {
       "col": "upi-refunds-june.amount_inr"
      }
     }
    ],
    "having": [
     {
      "op": "!=",
      "args": [
       {
        "ref": "payment_amount"
       },
       {
        "ref": "refund_amount"
       }
      ]
     }
    ],
    "limit": 1,
    "layer": "ontology",
    "covers": "Check if refund amount matches approved payment amount (bill join)"
   },
   {
    "from": "pos-payments-june",
    "joins": [
     {
      "table": "psp-upi-report-june",
      "type": "inner",
      "on": [
       [
        "pos-payments-june.rrn",
        "psp-upi-report-june.rrn"
       ]
      ]
     }
    ],
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "pos-payments-june.till_status"
       },
       {
        "lit": "approved"
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.rrn"
     }
    ],
    "select": [
     {
      "as": "rrn",
      "expr": {
       "col": "pos-payments-june.rrn"
      }
     },
     {
      "as": "payment_amount",
      "expr": {
       "col": "pos-payments-june.amount_inr"
      }
     },
     {
      "as": "upi_amount",
      "expr": {
       "col": "psp-upi-report-june.amount_inr"
      }
     }
    ],
    "having": [
     {
      "op": "!=",
      "args": [
       {
        "ref": "payment_amount"
       },
       {
        "ref": "upi_amount"
       }
      ]
     }
    ],
    "limit": 1,
    "layer": "ontology",
    "covers": "Check if UPI provider amount matches approved payment amount (rrn join)"
   }
  ]
