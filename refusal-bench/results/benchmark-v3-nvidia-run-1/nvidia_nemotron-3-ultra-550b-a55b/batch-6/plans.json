 "Q248": {
  "cannot": "The records list products by SKU and name (e.g., ATTA-WW-5KG = Whole wheat atta 5 kg) but do not contain a brand or manufacturer field for any product."
 },
 "Q249": {
  "cannot": "No table records markdown prices, markdown events, or which sales occurred at a markdown. daily-sales-june and pos-lines-may-june record units sold and revenue at the scanned price, but cannot distinguish markdown from regular price. write-offs-june records units written off as expired, not sold. Therefore the number of units sold at a markdown before expiring cannot be determined from the records."
 },
 "Q250": {
  "cannot": "GST rate or tax amount is not recorded in any table. pos-lines-may-june has line_amount and unit_price but no tax column. products has price_inr and cost_inr but no tax rate. No table holds tax information."
 },
 "Q251": {
  "cannot": "No table records staffing levels, shift schedules, labor hours, or footfall by hour. The available tables cover sales, inventory, shipments, payments, and complaints, but none contain staff counts or shift data."
 },
 "Q252": {
  "cannot": "No table records the driver assigned to a fresh-delivery route. fresh-deliveries-june has route and delivery_ts but no driver column; shipments-june has a vehicle column for DC shipments, not for fresh routes. The driver identity is not recorded."
 },
 "Q253": {
  "cannot": "No table records a cashier for any bill. pos-payments-june has bill_id and tender but no cashier column. products, pos-lines-may-june, and all other tables also lack a cashier field. The question asks for a person identity that is not recorded."
 },
 "Q254": {
  "cannot": "No table records a cashier identity. pos-payments-june and pos-lines-may-june have bill_id but no cashier column. person_identity is not recorded."
 },
 "Q255": {
  "cannot": "No table records the supplier for fresh deliveries. fresh-deliveries-june has route, sku, delivery_ts, crates, units, use_by but no supplier column. products has sku, name, flow (DC/DSD) but no supplier. shipping-notice-lines-june and goods-receipts-june have sku and shipment_id but no supplier. shipments-june has vehicle but not supplier. No join path reaches a supplier name."
 },
 "Q256": {
  "cannot": "The stock-counts-june table records the trigger as 'manager request after complaints' but does not record which manager made the request. No table in the schema contains manager identity."
 },
 "Q257": {
  "cannot": "No table records which individual picker performed a pick at slot A-07-03 on 22 June 2026. The dc-pick-confirmations-june table has a column 'confirmed_by' with only the value 'slot label scan' (a method, not a person), and no column identifies a picker by name or ID."
 },
 "Q258": {
  "cannot": "No record captures shopper choice, competitor actions, or reasons for not visiting Store 014. The data only cover internal operations for eleven followed products."
 },
 "Q259": {
  "cannot": "Market share requires competitor sales or total market size in the area, which are not recorded in any table. The records cover only this store's eleven followed products and its internal operations."
 },
 "Q260": {
  "cannot": "Weather, festivals, and local events are external factors not recorded in any table. Sales data for the eleven followed items exists in daily-sales-june and pos-lines-may-june, but no table links dates to weather, festivals, or local events, so their impact on sales cannot be determined from the records."
 },
 "Q261": {
  "cannot": "No records for other stores in the chain exist in the data. Only Store 014's tables are available."
 },
 "Q262": {
  "cannot": "No table records food-safety inspections, labelling checks, use-by compliance beyond the fresh-deliveries use_by date, or any regulatory outcome for Store 014."
 },
 "Q263": {
  "cannot": "Competitor pricing is not recorded in any table. The records cover only this store's products, sales, inventory, shipments, payments and complaints for the eleven followed items."
 },
 "Q264": {
  "cannot": "Lost sales are not recorded. The road closure on 14 June 2026 is an external event not in the records. Demand and lost sales are not recorded; only sales of the eleven followed items are recorded."
 },
 "Q265": {
  "cannot": "No table records festivals, holidays, or external events that could explain a sales spike. The records cover only the eleven followed products and internal operations."
 },
 "Q266": {
  "cannot": "No table records power outages or internet disruptions at Store 014."
 },
