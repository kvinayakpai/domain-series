   },
   {
    "from": "shelf-audits-june",
    "where": [
     {
      "op": "=",
      "args": [
       {
        "col": "shelf-audits-june.sku"
       },
       {
        "lit": "ATTA-WW-5KG"
       }
      ]
     },
     {
      "op": "between",
      "arg": {
       "col": "shelf-audits-june.audit_ts"
      },
      "low": "2026-06-02",
      "high": "2026-06-26"
     }
    ],
    "group_by": [
     {
      "fn": "day",
      "arg": {
       "col": "shelf-audits-june.audit_ts"
      }
     }
    ],
    "select": [
     {
      "as": "audit_date",
      "expr": {
       "fn": "day",
       "arg": {
        "col": "shelf-audits-june.audit_ts"
       }
      }
     },
     {
      "as": "empty_audits",
      "expr": {
       "agg": "count",
       "arg": {
        "op": "=",
        "args": [
         {
          "col": "shelf-audits-june.status"
         },
         {
          "lit": "empty"
         }
        ]
       }
      }
     },
     {
      "as": "total_audits",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "order_by": [
     {
      "by": "audit_date",
      "dir": "asc"
     }
    ],
    "limit": 12,
    "layer": "schema",
    "covers": "Shelf audit status (on shelf/empty) at 11:00 twice a week for 5 kg atta. Empty audits show the shelf was empty at audit time; they do not count shoppers who walked out (KNOWLEDGE: absent_event, shelf_hours)."
   }
  ]
 },
 "Q281": {
