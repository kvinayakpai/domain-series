          },
          {
           "col": "shipments-june.slot_start"
          }
         ]
        },
        {
         "op": "=",
         "args": [
          {
           "lit": "before_slot_start"
          },
          {
           "lit": "before_slot_start"
          }
         ]
        }
       ]
      },
      {
       "op": "and",
       "args": [
        {
         "op": ">",
         "args": [
          {
           "col": "shipments-june.arrived_ts"
          },
          {
           "col": "shipments-june.slot_end"
          }
         ]
        },
        {
         "op": "=",
         "args": [
          {
           "lit": "after_slot_end"
          },
          {
           "lit": "after_slot_end"
          }
         ]
        }
       ]
      },
      {
       "op": "and",
       "args": [
        {
         "op": ">=",
         "args": [
          {
           "col": "shipments-june.arrived_ts"
          },
          {
           "col": "shipments-june.slot_start"
          }
         ]
        },
        {
