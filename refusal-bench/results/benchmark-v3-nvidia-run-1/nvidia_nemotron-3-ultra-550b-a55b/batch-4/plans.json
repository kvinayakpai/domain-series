 "Q153": {
  "from": "store-orders-june",
  "joins": [
   {
    "table": "goods-receipts-june",
    "type": "inner",
    "on": [
     [
      "store-orders-june.order_id",
      "goods-receipts-june.order_id"
     ],
     [
      "store-orders-june.sku",
      "goods-receipts-june.sku_booked"
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "between",
    "arg": {
     "col": "store-orders-june.created_ts"
    },
    "low": "2026-06-01",
    "high": "2026-06-27T23:59:59"
   }
  ],
  "group_by": [],
  "select": [
   {
    "as": "avg_lead_time_hours",
    "expr": {
     "agg": "avg",
     "arg": {
      "fn": "hours_between",
      "args": [
       {
        "col": "store-orders-june.created_ts"
       },
       {
        "col": "goods-receipts-june.received_ts"
       }
      ]
     }
    }
   }
  ],
  "having": [],
  "order_by": [],
  "limit": 1,
  "layer": "ontology",
  "covers": "Average lead time in hours from store order creation to goods receipt for June 2026 orders, using ontology link pickedAs (order -> pick) and endsIn (shipment -> receiving) via order_id and sku join."
 },
