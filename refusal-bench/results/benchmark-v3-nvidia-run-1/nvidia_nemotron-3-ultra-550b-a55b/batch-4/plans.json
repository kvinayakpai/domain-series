 },
 "Q151": {
  "from": "fresh-deliveries-june",
  "joins": [
   {
    "table": "products",
    "type": "inner",
    "on": [
     [
      "fresh-deliveries-june.sku",
      "products.sku"
     ]
    ]
   }
  ],
  "where": [
   {
    "op": "in",
    "arg": {
     "col": "products.name"
    },
    "values": [
     "Full cream milk 500 ml pouch",
     "Toned milk 500 ml pouch",
     "Curd 500 g pouch",
     "White bread 400 g"
    ]
   }
  ],
  "group_by": [
   {
    "col": "products.name"
   },
   {
    "col": "fresh-deliveries-june.delivery_ts"
   },
   {
    "col": "fresh-deliveries-june.use_by"
   }
  ],
  "select": [
   {
    "as": "product",
    "expr": {
     "col": "products.name"
    }
   },
   {
    "as": "delivery_date",
    "expr": {
     "fn": "day",
     "arg": {
      "col": "fresh-deliveries-june.delivery_ts"
     }
    }
   },
   {
    "as": "use_by_date",
    "expr": {
     "col": "fresh-deliveries-june.use_by"
    }
   },
   {
    "as": "shelf_life_days",
    "expr": {
     "op": "-",
     "args": [
      {
       "col": "fresh-deliveries-june.use_by"
      },
      {
       "fn": "day",
       "arg": {
        "col": "fresh-deliveries-june.delivery_ts"
       }
      }
     ]
    }
   }
  ],
  "order_by": [
   {
    "by": "product",
    "dir": "asc"
   },
   {
    "by": "delivery_date",
    "dir": "asc"
   }
  ],
  "limit": 200,
  "layer": "schema",
  "covers": "Shelf life in days (use_by minus delivery date) for milk, curd, and bread on each fresh delivery arrival."
 },
