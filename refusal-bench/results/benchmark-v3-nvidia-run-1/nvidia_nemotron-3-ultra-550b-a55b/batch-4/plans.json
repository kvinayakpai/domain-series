    ]
   },
   {
    "op": "<",
    "args": [
     {
      "col": "shipments-june.arrived_ts"
     },
     {
      "lit": "2026-07-01"
     }
    ]
   }
  ],
  "group_by": [],
  "select": [
   {
    "as": "shipment_id",
    "expr": {
