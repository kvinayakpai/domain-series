 "Q210": {
  "from": "pos-payments-june",
  "joins": [
   {
    "table": "psp-upi-report-june",
    "type": "inner",
    "on": [
     {
      "col": "pos-payments-june.rrn"
     },
     {
      "col": "psp-upi-report-june.rrn"
     }
    ]
   }
  ],
  "where": {
   "op": "and",
   "args": [
    {
     "op": "in",
     "arg": {
      "col": "pos-payments-june.tender"
     },
     "values": [
      "UPI"
     ]
    },
    {
     "op": "in",
     "arg": {
      "col": "pos-payments-june.till_status"
     },
     "values": [
      "failed: no response"
     ]
    },
    {
     "op": "between",
     "arg": {
      "col": "pos-payments-june.ts"
     },
     "low": "2026-06-01",
     "high": "2026-06-28"
    }
   ]
  },
  "group_by": [
   {
    "col": "pos-payments-june.attempt"
   }
  ],
  "select": [
   {
    "as": "attempt_id",
    "expr": {
     "col": "pos-payments-june.attempt"
    }
   },
   {
    "as": "bill_id",
    "expr": {
     "col": "pos-payments-june.bill_id"
    }
   },
   {
    "as": "till_ts",
    "expr": {
     "col": "pos-payments-june.ts"
    }
   },
   {
    "as": "till_status",
    "expr": {
     "col": "pos-payments-june.till_status"
    }
   },
   {
    "as": "bank_status",
    "expr": {
     "col": "psp-upi-report-june.status"
    }
   },
   {
    "as": "bank_status_ts",
    "expr": {
     "col": "psp-upi-report-june.status_ts"
    }
   }
  ],
  "order_by": [
   {
    "by": "attempt_id",
    "dir": "asc"
   }
  ],
