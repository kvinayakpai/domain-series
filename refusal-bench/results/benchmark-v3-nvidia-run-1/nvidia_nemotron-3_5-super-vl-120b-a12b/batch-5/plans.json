 "Q203": {
  "plans": [
   {
    "from": "customer-complaints-june",
    "where": {
     "op": "=",
     "args": [
      {
       "col": "customer-complaints-june.kind"
      },
      {
       "lit": "charged twice"
      }
     ]
    },
    "select": [
     {
      "as": "complaint_count",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "layer": "ontology",
    "covers": "complaints of being charged twice are the recorded evidence of possible double payment; the actual double payment must be checked against till payments and provider records"
   },
   {
    "from": "pos-payments-june",
    "joins": [
     {
      "table": "psp-upi-report-june",
      "type": "inner",
      "on": [
       {
        "col": "pos-payments-june.rrn"
       },
       {
        "col": "psp-upi-report-june.rrn"
       }
      ]
     }
    ],
    "where": {
     "op": "and",
     "args": [
      {
       "op": "=",
       "args": [
        {
         "col": "pos-payments-june.tender"
        },
        {
         "lit": "UPI"
        }
       ]
      },
      {
       "op": "!=",
       "args": [
        {
         "col": "pos-payments-june.till_status"
        },
        {
         "lit": "approved"
        }
       ]
      },
      {
       "op": "=",
       "args": [
        {
         "col": "psp-upi-report-june.status"
        },
        {
         "lit": "success"
        }
       ]
      }
     ]
    },
    "select": [
     {
      "as": "extra_debit_count",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "layer": "ontology",
    "covers": "an extra debit is a provider success whose rrn has no approved till payment; this counts bills charged twice in June"
   }
  ]
 },
