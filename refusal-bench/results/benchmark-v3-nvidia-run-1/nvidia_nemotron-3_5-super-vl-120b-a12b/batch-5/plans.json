 "Q209": {
  "plans": [
   {
    "from": "pos-payments-june",
    "where": {
     "op": "and",
     "args": [
      {
       "op": "=",
       "args": [
        {
         "col": "pos-payments-june.tender"
        },
        {
         "lit": "UPI"
        }
       ]
      },
      {
       "op": "in",
       "args": [
        {
         "col": "pos-payments-june.till_status"
        },
        {
         "values": [
          "approved",
          "declined",
          "failed",
          "failed: no response"
         ]
        }
       ]
      }
     ]
    },
    "group_by": [
     {
      "col": "pos-payments-june.bill_id"
     }
    ],
    "select": [
     {
      "as": "bill_id",
      "expr": {
       "col": "pos-payments-june.bill_id"
      }
     },
     {
      "as": "approved_count",
      "expr": {
       "agg": "count",
       "arg": {
        "op": "=",
        "args": [
         {
          "col": "pos-payments-june.till_status"
         },
         {
          "lit": "approved"
         }
        ]
       }
      }
     },
     {
      "as": "attempt_count",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "having": [
     {
      "op": ">",
      "args": [
       {
        "ref": "approved_count"
       },
       {
        "lit": 1
       }
      ]
     }
    ],
    "order_by": [
     {
      "by": "bill_id",
      "dir": "asc"
     }
    ],
    "limit": 200,
    "layer": "schema",
    "covers": "Checks whether any June bill has more than one approved payment, which would indicate a customer charged twice; zero such bills confirms the premise."
   },
