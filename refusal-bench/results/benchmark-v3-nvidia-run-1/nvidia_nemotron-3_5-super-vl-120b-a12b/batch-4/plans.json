 "Q161": {
  "plans": [
   {
    "from": "pos-payments-june",
    "where": {
     "op": "and",
     "args": [
      {
       "op": "in",
       "arg": {
        "col": "pos-payments-june.tender"
       },
       "values": [
        "UPI"
       ]
      },
      {
       "op": "in",
       "arg": {
        "col": "pos-payments-june.till_status"
       },
       "values": [
        "declined",
        "failed",
        "failed: no response"
       ]
      },
      {
       "op": "between",
       "arg": {
        "col": "pos-payments-june.ts"
       },
       "low": "2026-06-01",
       "high": "2026-06-30"
      }
     ]
    },
    "select": [
     {
      "as": "declined_or_failed_upi_attempts",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     }
    ],
    "layer": "knowledge",
    "covers": "Shoppers who gave up and left without paying are not recorded; only declined or failed UPI attempts can be counted as the recorded evidence."
   }
  ]
 },
 "Q162": {
  "plans": [
   {
    "from": "pos-payments-june",
    "where": [
     {
      "op": "in",
      "args": [
       {
        "col": "pos-payments-june.tender"
       },
       {
        "values": [
         "cash",
         "upi",
         "card"
        ]
       }
      ]
     }
    ],
    "group_by": [
     {
      "col": "pos-payments-june.tender"
     }
    ],
    "select": [
     {
      "as": "tender",
      "expr": {
       "col": "pos-payments-june.tender"
      }
     },
     {
      "as": "attempts",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "total_amount_inr",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     },
     {
      "as": "avg_amount_inr",
      "expr": {
       "agg": "avg",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     },
     {
      "as": "min_amount_inr",
      "expr": {
       "agg": "min",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     },
     {
      "as": "max_amount_inr",
      "expr": {
       "agg": "max",
       "arg": {
        "col": "pos-payments-june.amount_inr"
       }
      }
     }
    ],
    "order_by": [
     {
      "by": "tender",
      "dir": "asc"
     }
    ],
    "layer": "schema",
    "covers": "Recorded payment amounts by tender for June; cost per payment is not recorded, so only per-payment value can be shown."
   }
  ]
 },
