{
 "Q148": {
  "from": "shipments-june",
  "where": {
   "op": "or",
   "args": [
    {
     "op": "<",
     "args": [
      {
       "col": "shipments-june.arrived_ts"
      },
      {
       "col": "shipments-june.slot_start"
      }
     ]
    },
    {
     "op": ">",
     "args": [
      {
       "col": "shipments-june.arrived_ts"
      },
      {
       "col": "shipments-june.slot_end"
      }
     ]
    }
   ]
  },
  "select": [
   {
    "as": "shipment_id",
    "expr": {
     "col": "shipments-june.shipment_id"
    }
   },
   {
    "as": "arrived_ts",
    "expr": {
     "col": "shipments-june.arrived_ts"
    }
   },
   {
    "as": "slot_start",
    "expr": {
     "col": "shipments-june.slot_start"
    }
   },
   {
    "as": "slot_end",
    "expr": {
     "col": "shipments-june.slot_end"
    }
   },
   {
    "as": "side",
    "expr": {
     "op": "+",
     "args": [
      {
       "lit": "arrived before slot_start"
      },
      {
       "lit": " / arrived after slot_end"
      }
     ]
    }
   }
  ],
  "order_by": [
   {
    "by": "shipment_id",
    "dir": "asc"
   }
  ],
  "limit": 200,
  "layer": "schema",
  "covers": "shipments-june covers all June 2026 arrivals (2026-06-01 to 2026-06-28) with slot_start and slot_end"
 },
