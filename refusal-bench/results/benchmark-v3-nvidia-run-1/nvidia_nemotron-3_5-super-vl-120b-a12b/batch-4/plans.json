 },
 "Q150": {
  "from": "dc-pick-confirmations-june",
  "where": [
   {
    "op": "<",
    "args": [
     {
      "col": "dc-pick-confirmations-june.cases_confirmed"
     },
     {
      "col": "dc-pick-confirmations-june.cases_ordered"
     }
    ]
   }
  ],
  "group_by": [
   {
    "col": "dc-pick-confirmations-june.sku"
   }
  ],
  "select": [
   {
    "as": "short_pick_count",
    "expr": {
     "agg": "count",
     "arg": "*"
    }
   },
   {
    "as": "sku",
    "expr": {
     "col": "dc-pick-confirmations-june.sku"
    }
   }
  ],
  "order_by": [
   {
    "by": "short_pick_count",
    "dir": "desc"
   }
  ],
  "layer": "schema",
  "covers": "Counts pick confirmations where cases confirmed is less than cases ordered and lists the short-picked SKUs from dc-pick-confirmations-june."
 },
 "Q151": {
  "from": "fresh-deliveries-june",
  "where": {
   "op": "in",
   "arg": {
    "col": "fresh-deliveries-june.sku"
   },
   "values": [
    "MILK-FC-500ML",
    "MILK-TONED-500ML",
    "CURD-500G",
    "BREAD-WHITE-400G"
   ]
  },
  "select": [
   {
    "as": "sku",
    "expr": {
     "col": "fresh-deliveries-june.sku"
    }
   },
   {
    "as": "delivery_date",
    "expr": {
     "fn": "day",
     "arg": {
      "col": "fresh-deliveries-june.delivery_ts"
     }
    }
   },
   {
    "as": "use_by_date",
    "expr": {
     "fn": "day",
     "arg": {
      "col": "fresh-deliveries-june.use_by"
     }
    }
   },
   {
    "as": "days_of_shelf_life_on_arrival",
    "expr": {
     "fn": "days_between",
     "args": [
      {
       "fn": "day",
       "arg": {
        "col": "fresh-deliveries-june.delivery_ts"
       }
      },
      {
       "fn": "day",
       "arg": {
        "col": "fresh-deliveries-june.use_by"
       }
      }
     ]
    }
   }
  ],
  "layer": "schema",
  "covers": "Days of shelf life on arrival for milk, curd, and bread from fresh-deliveries-june, computed as use_by date minus delivery date."
 },
 "Q152": {
