{
 "Q246": {
  "from": "products",
  "select": [
   {
    "as": "sku",
    "expr": {
     "col": "products.sku"
    }
   },
   {
    "as": "gross_margin_pct",
    "expr": {
     "op": "/",
     "args": [
      {
       "op": "-",
       "args": [
        {
         "col": "products.price_inr"
        },
        {
         "col": "products.cost_inr"
        }
       ]
      },
      {
       "col": "products.price_inr"
      }
     ]
    }
   }
  ],
  "order_by": [
   {
    "by": "gross_margin_pct",
    "dir": "desc"
   }
  ],
  "layer": "schema",
  "covers": "price_inr and cost_inr are per-product attributes in products; no join or aggregation needed."
 },
 "Q247": {
  "plans": [
   {
    "from": "pos-lines-may-june",
    "where": {
     "op": "and",
     "args": [
      {
       "op": ">=",
       "args": [
        {
         "fn": "day",
         "arg": {
          "col": "pos-lines-may-june.bill_ts"
         }
        },
        {
         "lit": "2026-06-01"
        }
       ]
      },
      {
       "op": "<=",
       "args": [
        {
         "fn": "day",
         "arg": {
          "col": "pos-lines-may-june.bill_ts"
         }
        },
        {
         "lit": "2026-06-30"
        }
       ]
      }
     ]
    },
    "select": [
     {
      "as": "line_count",
      "expr": {
       "agg": "count",
       "arg": "*"
      }
     },
     {
      "as": "mismatch_count",
      "expr": {
       "agg": "count",
       "arg": {
        "op": "*",
        "args": [
         {
          "col": "pos-lines-may-june.qty"
         },
         {
          "col": "pos-lines-may-june.unit_price"
         }
        ]
       }
      }
     },
     {
      "as": "amount_sum",
      "expr": {
       "agg": "sum",
       "arg": {
        "col": "pos-lines-may-june.line_amount"
       }
      }
     },
     {
      "as": "computed_sum",
      "expr": {
       "agg": "sum",
       "arg": {
        "op": "*",
        "args": [
         {
          "col": "pos-lines-may-june.qty"
         },
         {
          "col": "pos-lines-may-june.unit_price"
         }
        ]
       }
      }
     }
    ],
    "group_by": [],
    "layer": "schema",
    "covers": "Checks whether line_amount equals qty * unit_price for every June till line; any mismatch would indicate a discount or other adjustment."
   }
  ]
 },
